+        k=r.get("kind"); a=(r.get("auditor") or "?").split("-")[0].split("/")[0]
+        if k in ("caught","missed"):
+            tot[a]+=1
+            if k=="missed": by[a]+=1
+    line=" | ".join(f"{a}:{by[a]}/{tot[a]}" for a in tot if tot[a]>=5)
