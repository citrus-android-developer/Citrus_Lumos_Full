+#!/usr/bin/env bash
+# Git pre-commit hook — 架構圖同步硬擋 (L2)
+#
+# ★精簡版★:自完整版 scripts/hooks/pre-commit 移植,三處改動——
+#   ① 移除 `lumos cochange check --staged` advisory 段:精簡版未交付
+#      cochange 子命令,留著只會每次 commit 靜默失敗。
+#   ② should_exclude 的 vendored 白名單瘦身為只留 scripts/hooks/*:
+#      完整版白名單裡的 scripts/lumos、scripts/test_lumos.py、
+#      scripts/merge-claude-settings.py、scripts/graph-rename.sh、
+#      scripts/fetch-notesmd.sh、scripts/templates/* 精簡版皆不交付,
+#      是死條件。
+#   ③ 保留源 repo 守門(skills/lumos-project-notes 存在時不豁免)。
+#   ——移植後本檔對 lumos 執行檔零依賴(純 bash + git):~/.lumos-slim
+#      被砍或 PATH 壞掉,這道閘仍然在。
+#
+# 為什麼是 git hook 而不是 Claude Code PreToolUse:
+#   PreToolUse 攔 `git commit` 時,staged 區在 -a/-am 與 `git commit <path>`
+#   場景下看到的是空的(-a 在 git 程序內部才 stage),造成 silent 漏網。
+#   git 在 pre-commit 時已決定最終 staged 內容,所有 commit 形態
+#   (-a/-am/<path>/--amend)都涵蓋。
+#
+# Bypass: `git commit --no-verify`(業界標準、code review 看得到)
+#
+# 安裝: install.py ★不會★碰這支——要用自己掛(見 README〈選配〉節)。啟用(二擇一):
+#   git config core.hooksPath <本包 clone 的絕對路徑>/hooks
+#   或複製進專案 scripts/hooks/ 後 git config core.hooksPath scripts/hooks
+# 停用:
+#   git config --unset core.hooksPath
+
+set -u
+
+# 找專案 root (避免在 submodule / worktree 出錯)
+REPO_ROOT="$(git rev-parse --show-toplevel)"
+cd "$REPO_ROOT" || exit 0
+
+# 找架構圖目錄 (docs/{slug}-knowledge/)
+GRAPH_ROOT=""
+if [[ -d docs ]]; then
+  for d in docs/*-knowledge; do
+    [[ -d "$d" ]] && GRAPH_ROOT="$d" && break
+  done
+  [[ -z "$GRAPH_ROOT" && -d docs/knowledge ]] && GRAPH_ROOT="docs/knowledge"
+fi
+
+# Gate 0: 架構圖不存在 → 放行
+# ★精簡版預期行為★:install.py 不 scaffold 架構圖,所以在第一批節點建出來之前,
+# 即使 hooksPath 開著本 hook 也是完全靜默的 no-op。這是設計不是壞掉。
+[[ -z "$GRAPH_ROOT" ]] && exit 0
+
+# 判斷「這份檔案清單裡有沒有架構圖目錄底下的 .md」
+# ★不要用 grep -qE "^${GRAPH_ROOT}/.*\.md$" 做這件事★(2026-08-11 終審複審):
+# GRAPH_ROOT 是從檔案系統掃出來的目錄名,可能含 ERE 元字元——`docs/c++-knowledge`
+# 對一個 C++ 專案完全正常。內插進 ERE 後 grep 以 rc=2(語法錯誤)收場,而 `if`
+# 只看「非 0」→ 一律讀成「沒有架構圖 .md」。後果:pre-commit 的 Gate 3 永遠擋、
+# post-commit 把每一筆 commit 都記成 bypass,而且兩者都沒有任何錯誤訊息。
+# 改用 bash 樣式比對:左邊是資料,右邊只有 `/*.md` 是樣式,`"$GRAPH_ROOT"` 加了
+# 引號就是字面比對——不需要跳脫,也不必外掛 sed(hook 執行時的 PATH 可能很小)。
+# 語意與原 ERE 相同(`*` 在 [[ ]] 樣式裡一樣跨 `/`,含子目錄)。
+# ★本函式在 pre-commit / post-commit 兩支必須逐字一致★(與 should_exclude 同款
+# 約束):兩邊判定不一致會產生幽靈 bypass 或漏記。
+has_graph_md() {
+  local _line
+  while IFS= read -r _line; do
+    [[ "$_line" == "$GRAPH_ROOT"/*.md ]] && return 0
+  done <<< "$1"
+  return 1
+}
+
+# 拿最終 staged (git 在 pre-commit 時 staged 已確定,-a/-am/path 都涵蓋)
+# core.quotePath=off: 避免 git 對中文/non-ASCII 路徑加雙引號 ("docs/.../節點.md"),
+# 否則下面 has_graph_md 的 "${GRAPH_ROOT}/*.md" 比對不到 → 架構圖檔已 staged 仍誤判
+# 為未同步擋下
+STAGED="$(git -c core.quotePath=off diff --cached --name-only)"
+[[ -z "$STAGED" ]] && exit 0  # 空 commit 不擋
+
+# Gate 1: 架構圖污染指紋
+# 攔 notesmd-cli `frontmatter --edit` 的副作用: 日期欄位加引號 (Obsidian property
+# 型別 date→text 靜默損傷,且通常伴隨整篇 frontmatter 鍵序重排)。
+# 必須放在 Gate 2 之前 — 污染 commit 是 docs-only,Gate 2 的 code 判定對它直接放行。
+if has_graph_md "$STAGED"; then
+  polluted="$(git -c core.quotePath=off diff --cached -- "$GRAPH_ROOT" \
+    | grep -E '^\+[[:space:]]*(date|created|updated|decided|ended):[[:space:]]*"[0-9]{4}-[0-9]{2}-[0-9]{2}"' || true)"
+  if [[ -n "$polluted" ]]; then
+    {
+      echo ""
+      echo "🚫 架構圖污染指紋: frontmatter 日期欄位被加引號 (典型來源 = notesmd-cli frontmatter --edit)"
+      echo "   Obsidian property 型別會從 date 變 text,且通常伴隨整篇鍵序重排 — diff 不可審"
+      echo ""
+      echo "$polluted" | head -5 | sed 's/^/   /'
+      echo ""
+      echo "   檢視: git diff --cached -- ${GRAPH_ROOT}"
+      echo "   還原: git checkout -- <file>"
+      echo "   確屬刻意 (極罕見) → git commit --no-verify"
+      echo ""
+    } >&2
+    exit 1
+  fi
+fi
+
+# Gate 2: code 副檔名
+CODE_EXTS_RE='\.(cs|vue|js|ts|tsx|jsx|mjs|sql|py|kt|kts|java|swift|go|rs|c|cc|cpp|h|hpp)$'
+
+# 排除路徑
+should_exclude() {
+  local path="$1"
+  case "$path" in
+    docs/*|*/node_modules/*|*/bin/*|*/obj/*|*/.git/*|*/dist/*|*/build/*|*/__pycache__/*) return 0;;
+    *package-lock.json|*yarn.lock|*pnpm-lock.yaml) return 0;;
+    # 本 hook 自己所在的目錄:精簡版唯一會被安裝器放進專案的東西。
+    # ★精確白名單,非 scripts/* 整夾★——專案自有 scripts/foo.py 仍照擋。
+    # ★源 repo 守門★:在 lumos 來源 repo 本身(有 skills/lumos-project-notes),
+    # 這些檔=產品碼,豁免不適用(否則源 repo 自家改 hook 不帶架構圖會靜默放行)。
+    scripts/hooks/*)
+      [[ -d "skills/lumos-project-notes" ]] && return 1   # 源 repo:不豁免
+      return 0;;
+  esac
+  return 1
+}
+
+src_files=()
+while IFS= read -r f; do
+  [[ -z "$f" ]] && continue
+  if ! [[ "$f" =~ $CODE_EXTS_RE ]]; then continue; fi
+  if should_exclude "$f"; then continue; fi
+  src_files+=("$f")
+done <<< "$STAGED"
+
+# Gate 2: 沒 code → 放行
+[[ ${#src_files[@]} -eq 0 ]] && exit 0
+
+# Gate 3: 有架構圖 .md staged → 放行
+if has_graph_md "$STAGED"; then
+  exit 0
+fi
+
+# ── 印警告並擋 ──
+{
+  echo ""
+  echo "🚫 Pre-commit graph sync gate: commit 改了原始碼但沒同步架構圖"
+  echo ""
+  echo "Staged code files (${#src_files[@]}):"
+  for f in "${src_files[@]:0:10}"; do echo "   • $f"; done
