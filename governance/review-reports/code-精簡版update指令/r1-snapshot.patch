+  echo "   2. 確認此 commit 不需架構圖 (typo/格式/註解/WIP) → 加 --no-verify 跳過"
+  echo "      例: git commit --no-verify -m 'fix: typo in PointService'"
+  echo ""
+} >&2
+
+exit 1
