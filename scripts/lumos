def load_test_profile(repo_root):
    """讀 <repo>/.lumos/config.json 的 test_profile(預設 csharp-xunit;向後相容)。
    支援欄位級 inline 覆蓋(exts/scaffold_ext/method_regex)當逃生口。"""
    import json
    prof = dict(TEST_PROFILES["csharp-xunit"])
    cfg_path = repo_root / ".lumos" / "config.json"
    if not cfg_path.exists():
        return prof
    try:
        cfg = json.loads(cfg_path.read_text(encoding="utf-8"))
    except Exception as e:
        print(f"⚠ .lumos/config.json 解析失敗,用 csharp-xunit 預設: {e}", file=sys.stderr)
        return prof
    name = cfg.get("test_profile") or "csharp-xunit"   # null/空字串 → 預設(F8)
    if name in TEST_PROFILES:
        prof = dict(TEST_PROFILES[name])
    elif name != "csharp-xunit":
        print(f"⚠ 未知 test_profile '{name}'(有: {', '.join(TEST_PROFILES)}),用 csharp-xunit",
              file=sys.stderr)
    ov = cfg.get("test")
    if ov is not None and not isinstance(ov, dict):   # F1:test 非 dict → 忽略不 crash
        print(f"⚠ config.json 的 test 欄位應為物件,忽略(收到 {type(ov).__name__})", file=sys.stderr)
        ov = None
    if isinstance(ov, dict):
        if "exts" in ov:
            raw = ov["exts"]
            raw = [raw] if isinstance(raw, str) else raw   # F1:字串容錯為單元素
            if isinstance(raw, list):
                prof["exts"] = {e if e.startswith(".") else "." + e for e in raw}
            else:
                print("⚠ test.exts 應為陣列,忽略", file=sys.stderr)
        if isinstance(ov.get("scaffold_ext"), str):
            prof["scaffold_ext"] = ov["scaffold_ext"]
        if "method_regex" in ov:
            rx, err = _safe_user_regex(ov["method_regex"])   # F2:編譯 + ReDoS 探針
            if rx is not None:
                prof["method_re"] = rx
            else:
                print(f"⚠ test.method_regex 不採用({err}),沿用 profile 內建", file=sys.stderr)
    return prof


def load_platforms(repo_root):
    """讀 .lumos/config.json 的多根多 profile 設定(多平台合約測試綁定)。
    回 {multiplatform: bool, default_platform: str, platforms: {plat: {profile: dict, root: Path}}}。
    - 無 config / 無 `platforms` 鍵 → legacy:multiplatform False、單一條目(key=test_profile 或
      csharp-xunit、root=repo_root、profile 走 load_test_profile 含 inline 覆蓋)。此 multiplatform
      信號(而非「dict 是否為空」)決定 resolve_test_refs 要不要做前綴切分(審計 r4 + opus 辯方拍板)。
    - 有 `platforms` 鍵 → multiplatform True:每平台 profile 名 → profile dict、
      root=(repo_root/root_str).resolve()(不存在大聲警告、不擋);default_platform 依 D1 規則。
    設定錯誤(缺 default_platform 且平台 >1 / default 指向不存在鍵 / profile 名未知)→ raise ValueError。"""
    import json
    cfg_path = repo_root / ".lumos" / "config.json"
    cfg = {}
    if cfg_path.exists():
        try:
            cfg = json.loads(cfg_path.read_text(encoding="utf-8"))
        except Exception as e:
            print(f"⚠ .lumos/config.json 解析失敗,退回 legacy 單 profile: {e}", file=sys.stderr)
            cfg = {}
    plats = cfg.get("platforms")
    if not isinstance(plats, dict) or not plats:
        # legacy:單一條目(root=repo_root,profile 沿用 load_test_profile 的 inline 覆蓋支援)
        name = cfg.get("test_profile") or "csharp-xunit"
        if name not in TEST_PROFILES:
            name = "csharp-xunit"
        _tcfg = cfg.get("test") if isinstance(cfg.get("test"), dict) else {}
        return {"multiplatform": False, "default_platform": name,
                "platforms": {name: {"profile": load_test_profile(repo_root), "root": repo_root,
                                     "run_cmd": _tcfg.get("run_cmd")}}}
    out = {}
    for plat, spec in plats.items():
        if not isinstance(spec, dict):
            raise ValueError(f"platforms['{plat}'] 應為物件(收到 {type(spec).__name__})")
        pname = spec.get("profile")
        if pname not in TEST_PROFILES:
            raise ValueError(f"platforms['{plat}'].profile '{pname}' 未知(有: {', '.join(TEST_PROFILES)})")
        root_str = spec.get("root", ".")
        root = (repo_root / root_str).resolve()   # 明寫基底 repo_root(非 cwd),見 D1
        if not root.exists():
            print(f"⚠ 平台 '{plat}' 的 root 不存在: {root}(該平台 discover 將掃不到測試)", file=sys.stderr)
        out[plat] = {"profile": dict(TEST_PROFILES[pname]), "root": root,
                     "run_cmd": spec.get("run_cmd")}   # guard kill 用;缺=None
    default = cfg.get("default_platform")
    if default is None:
        if len(out) == 1:
            default = next(iter(out))
        else:
            raise ValueError(f"多平台 config 有 {len(out)} 個平台但未指定 default_platform"
                             f"(無前綴 [test:X] 不知歸屬);請加 default_platform")
    elif default not in out:
        raise ValueError(f"default_platform '{default}' 不在 platforms({', '.join(out)})")
    return {"multiplatform": True, "default_platform": default, "platforms": out}


def _safe_user_regex(pattern):
    """編譯使用者提供的 regex,並用【靜態】啟發式擋常見巢狀量詞 ReDoS。
    關鍵:**絕不執行**該 regex 來探測 — 在 CPython 裡 catastrophic regex 持有 GIL,
    用 thread/probe 探測反而會把整個 process 卡死(GIL 餓死主執行緒)。故只做模式檢查。
    非窮舉(擋不到 alternation 型),擋得到 (a+)+ / (a*)+ / (a+)* 這類經典款。
    回傳 (compiled, None) 或 (None, 原因)。"""
    if not isinstance(pattern, str):
        return None, "非字串"
    # 巢狀量詞:帶量詞的群組整體又被量詞修飾(經典 catastrophic backtracking)
    if re.search(r"\([^()]*[+*][^()]*\)\s*[+*?]", pattern) or \
       re.search(r"\([^()]*\)\s*[+*]\s*[+*]", pattern):
        return None, "疑似巢狀量詞 ReDoS(如 (a+)+);請改寫或用 profile 內建"
    try:
        return re.compile(pattern, re.S), None
    except re.error as e:
        return None, f"無效: {e}"


def invariant_test_refs(inv_text):
    """從 ★INVARIANT★ 文字抽 [test:A,B] 綁定的可執行測試名(可多個,逗號分隔)。無綁定回 []。
    回**原始字串**(含任何 平台: 前綴)——供 tag 重建/顯示;平台解析走 resolve_test_refs。"""
    out = []
    for m in TEST_REF_RE.findall(inv_text):
        out.extend(t.strip() for t in m.split(",") if t.strip())
    return out


def resolve_test_refs(inv_text, platforms, default_platform):
    """把 [test:...] 解析為 [(platform, method_name)]。沿用 invariant_test_refs 的逗號切分。
    - platforms 非空(多平台):每段含 ':' → 前綴須為已定義 platform 鍵(C#/Kotlin 名不含冒號,
      故含冒號即視為 平台:名;前綴未定義 → raise ValueError,不誤當方法名);無 ':' → 歸 default_platform。
    - platforms 空(legacy,由呼叫端在 multiplatform=False 時傳 {}):**不切分**,整串(含任何冒號)
      配 default_platform → 後續走單一 method set 比對(含冒號的假想 ref 走 dangling 而非報錯)。"""
    out = []
    for seg in invariant_test_refs(inv_text):
        if platforms and ":" in seg:
            plat, name = seg.split(":", 1)
            plat, name = plat.strip(), name.strip()
            if plat not in platforms:
                raise ValueError(
                    f"[test:{seg}] 的平台前綴 '{plat}' 未定義於 platforms"
                    f"({', '.join(platforms)});不 fallback 避免誤綁")
            out.append((plat, name))
        else:
            out.append((default_platform, seg))
    return out


def invariant_audit_refs(inv_text):
    """從 ★INVARIANT★ 文字抽 [audit:模型/日期] 留痕(通常一條)。無=回 []。"""
    return [m.strip() for m in AUDIT_REF_RE.findall(inv_text) if m.strip()]


def strip_test_refs(inv_text):
    """回傳 (去掉 [test:..]/[audit:..] 標記的乾淨宣稱文字, 綁定測試名 list)。"""
    return INV_TAG_RE.sub("", inv_text).strip(), invariant_test_refs(inv_text)


# ── 可逆性軸(獨立於 ★INVARIANT★ 合約軸;走平行函式,不碰 extract_contracts/INV_TAG_RE)──
CHECKPOINT_RE = re.compile(r"^KEY:\s*(?:\([^)]*\)\s*)?★CHECKPOINT★\s*(.*)")
IRREVERSIBLE_RE = re.compile(r"^KEY:\s*(?:\([^)]*\)\s*)?★IRREVERSIBLE★\s*(.*)")
ROLLBACK_REF_RE = re.compile(r"\[rollback:\s*([^\]]+)\]")
GUARD_REF_RE = re.compile(r"\[guard:\s*([^\]]+)\]")  # 可逆性軸,平行於 ROLLBACK_REF_RE

# ── regen 重生來源軸(M1 from-scratch 守衛;Check J,獨立於合約軸/可逆性軸)──
# 設計:Projects/from-scratch重生守衛_計劃(design-loop 3 輪,golden: governance/golden/fromscratch-m1)。
# [src:路徑(:行號)]=Tier A 現 code 可驗;[git:sha]=Tier B 變更事件;推測:/佚失: 前綴=Tier C/佚失。
SRC_REF_RE = re.compile(r"\[src:\s*([^\]]+?)(?::(\d+(?:-\d+)?))?\s*\]")
GIT_REF_RE = re.compile(r"\[git:\s*([0-9a-fA-F]{7,40})\s*\]")
# 疊放釘死:緊跟 summary 前綴(KEY:推測:/DECISION:佚失:);行中出現不算標記(防歧義)。只掃 summary。
REGEN_PREFIX_RE = re.compile(r"^(?:KEY|DECISION):\s*(推測|佚失):")


def reversibility_rollback_ref(text):
    m = ROLLBACK_REF_RE.search(text)
    return m.group(1).strip() if m else None


def reversibility_guard_ref(text):
    m = GUARD_REF_RE.search(text)
    return m.group(1).strip() if m else None


IRREVERSIBLE_HINT_PATTERNS = [
    re.compile(r"\bprod[._\-/]|production\b", re.I),
    re.compile(r"smtplib|sendmail|send_mail\b|\.send_message\b", re.I),
    re.compile(r"requests\.post\b|httpx\.post\b", re.I),
    re.compile(r"boto3\.(client|resource)\s*\(", re.I),
    re.compile(r"\bstripe\.\b|\btwilio\.\b|\bsendgrid\.\b", re.I),
    re.compile(r"\bDROP\s+TABLE\b|\bDELETE\s+FROM\b", re.I),
    re.compile(r"external_api\b|ext_api\b", re.I),
]


def _scan_diff_for_irreversible_hints(cwd):
    """掃 git diff --staged(優先)或 HEAD~1..HEAD,回傳疑似不可逆 +行摘要列表。
    非 git repo 或無 diff → 回傳 []。跳過測試檔與純注解行。
    cwd=str(env.vault) 即可:git diff 無 pathspec 時範圍為全 repo,cwd 子目錄不縮小範圍。"""
    import subprocess  # lazy import,與 L339/L2298 等先例一致
    _SKIP_EXT = {".md", ".txt", ".rst"}
    _TEST_PAT = re.compile(r"(test_|_test\.|\.spec\.|/tests?/)", re.I)

    for cmd in (["git", "diff", "--staged"], ["git", "diff", "HEAD~1..HEAD"]):
        try:
            r = subprocess.run(cmd, capture_output=True, text=True, cwd=cwd)
        except FileNotFoundError:
            return []
        if r.returncode != 0 or not r.stdout.strip():
            continue
        diff_text = r.stdout
        break
    else:
        return []

    cur_file = ""
    hits = []
    for line in diff_text.splitlines():
        if line.startswith("+++ b/"):
            cur_file = line[6:]
        if line.startswith("+++") or line.startswith("---"):
            continue
        if not line.startswith("+"):
            continue
        ext = Path(cur_file).suffix if cur_file else ""
        if ext in _SKIP_EXT:
            continue
        if cur_file and _TEST_PAT.search(cur_file):
            continue
        code_line = line[1:].strip()
        if code_line.startswith(("#", "//", "--", "/*", "*")):
            continue
        for pat in IRREVERSIBLE_HINT_PATTERNS:
            if pat.search(code_line):
                hits.append(f"{Path(cur_file).name}: {code_line[:80]}")
                break
    return hits[:8]


def extract_reversibility(note):
    """從 summary KEY 行抽 (marker, 去 [rollback:]/[guard:] 的乾淨文字, rollback_ref, guard_ref)。"""
    summ = note.fields.get("summary")
    out = []
    if isinstance(summ, str):
        for raw in summ.split("\n"):
            line = raw.strip()
            for marker, rx in (("★CHECKPOINT★", CHECKPOINT_RE), ("★IRREVERSIBLE★", IRREVERSIBLE_RE)):
                m = rx.match(line)
                if m:
                    body = m.group(1)
                    clean_body = ROLLBACK_REF_RE.sub("", GUARD_REF_RE.sub("", body)).strip()
                    out.append((marker, clean_body,
                                reversibility_rollback_ref(body), reversibility_guard_ref(body)))
    return out


def _rollback_resolved(note, ref):
    """[rollback:decisions] 視為已解析 ⟺ 本節點 decisions[] 有 ≥1 條非空 rollback。"""
    if not ref or ref.strip().lower() != "decisions":
        return False
    return any(str(d.get("rollback", "")).strip() for d in parse_decisions(note.fm_lines))


def _guard_resolved(note, ref):
    """[guard:decisions] 視為已解析 ⟺ 本節點 decisions[] 有 ≥1 條非空 guard。"""
    if not ref or ref.strip().lower() != "decisions":
        return False
    return any(str(d.get("guard", "")).strip() for d in parse_decisions(note.fm_lines))


def build_code_haystack(repo_root):
    """讀 repo 內所有 code 檔串成大字串,供 ★INVARIANT★ 綁定的測試名做存在性檢查。
    (閉環外接觸:doctor 不執行測試,只驗證『載重宣稱認領的證據真的存在於程式碼』)"""
    import os
    parts = []
    for dp, dirs, files in os.walk(repo_root):
        dirs[:] = [d for d in dirs if d not in CODE_SKIP_DIRS]
        for f in files:
            if Path(f).suffix.lower() in CODE_EXTS_T:
                try:
                    parts.append((Path(dp) / f).read_text(encoding="utf-8", errors="ignore"))
                except Exception:
                    pass
    return "\n".join(parts)


def discover_test_methods(repo_root, profile=None):
    """掃 repo 內測試檔,回傳「真實測試方法名」集合(被測試框架註解標註者)。
    測試棧 profile 決定掃哪些副檔名 + 用哪條方法 regex(預設 csharp-xunit;P5 語言可插拔)。
    Check T 用此集合驗證 ★INVARIANT★ 綁定的是『可執行證據』而非散文裡的字面巧合(B6 審計)。"""
    import os, fnmatch
    profile = profile or load_test_profile(repo_root)
    exts, mre = profile["exts"], profile["method_re"]
    must = profile.get("file_must_match")   # 選填:只認內容含此 marker 的檔(如 Maestro ^appId:)
    fname_globs = profile.get("file_name_match")   # 選填:basename fnmatch 檔名錨(python:test_*.py)
    strip = profile.get("comment_strip", "c-style")  # 預設 c-style 向後相容;python="none"
    methods = set()
    for dp, dirs, files in os.walk(repo_root):
        dirs[:] = [d for d in dirs if d not in CODE_SKIP_DIRS]
        for f in files:
            if Path(f).suffix.lower() in exts:
                # 檔名錨:ext 檢查後、讀檔前套(CheckT-Python-profile_計劃 std F4)
                if fname_globs and not any(fnmatch.fnmatch(f, g) for g in fname_globs):
                    continue
                try:
                    txt = (Path(dp) / f).read_text(encoding="utf-8", errors="ignore")
                except Exception:
                    continue
                # file_must_match:讀檔後、去註解前先過濾(如 .yaml 一堆,只認真 Maestro flow;
                # 濾掉 CI yaml 的 name: 被誤收)。現有 profile 無此鍵→.get() 回 None→不過濾。
                if must is not None and not must.search(txt):
                    continue
                # 去註解(語言感知,2026-07-25 根因修):c-style 剝 // 與 /*..*/(行尾註解會打斷
                # 「註解串→方法簽章」連續比對,真測試被誤判偽證據)。★python 走 "none" 不剝★——
                # Python 無 C 式註解,剝了反被中文註解/字串字面裡的 /*..*/ 配對誤吃大段內容
                # (實測 test_lumos.py 260→94);被註解的 # def 不在行首,PYTHON_TEST_RE 行首錨排除。
                if strip == "c-style":
                    txt = re.sub(r"//[^\n]*", "", txt)
                    txt = re.sub(r"/\*.*?\*/", "", txt, flags=re.S)
                for m in mre.finditer(txt):
                    methods.add(m.group(1).strip("`"))  # Kotlin 反引號測試名去引號
    return methods


def cmd_contracts(env, rel=None):
    """合約登記簿: ★INVARIANT★(改=breaking) / ★DEBT★(可改)。
    動某模組前先查它的硬合約 — Obsidian 做不到(子字串不在它的 graph 裡)。
    ★INVARIANT★ 顯示綁定的測試(可執行證據);未綁=⚠(doctor Check T 會擋)。"""
    targets = [rel] if rel else sorted(env.notes)
    n_inv = n_debt = 0
    for r in targets:
        inv, debt = extract_contracts(env.notes[r])
        if not inv and not debt:
            continue
        print(f"# {r}")
        for x in inv:
            clean, refs = strip_test_refs(x)
            print(f"  ★INVARIANT★ {clean}")
            print(f"      ↳ test: {', '.join(refs)}" if refs else "      ↳ ⚠ 未綁測試(無可執行證據)")
            n_inv += 1
        for x in debt:
            print(f"  ★DEBT★ {x}")
            n_debt += 1
    if n_inv == 0 and n_debt == 0:
        print("(無合約標記)" if rel else "(全 vault 無合約標記 — 用 ★INVARIANT★/★DEBT★ 前綴標 KEY 行)")
    else:
        print(f"\n合約 {n_inv} 條(改=breaking) | 技術債 {n_debt} 條(可改)")
    return 0


KNOWN_TYPES = {"system", "verification", "issue", "project", "moc"}
SYMBOL_NAMES = {"KEY", "FLOW", "DEP", "TEST", "AUTH", "FLAG", "DECISION", "VERIFY", "CORE"}
SYMBOLISH_RE = re.compile(r"^([A-Z]{2,}):")   # 像「符號宣告」的行(全大寫前綴)→ 抓 typo


def _git_commit_exists(repo_root, sha):
    """[git:sha] Tier B 驗證:git cat-file -e sha^{commit}。非 git repo/物件缺 → False。"""
    import subprocess
    try:
        r = subprocess.run(["git", "cat-file", "-e", f"{sha}^{{commit}}"], cwd=str(repo_root),
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return r.returncode == 0
    except OSError:
        return False


def _git_is_shallow(repo_root):
    import subprocess
    try:
        r = subprocess.run(["git", "rev-parse", "--is-shallow-repository"], cwd=str(repo_root),
                           capture_output=True, text=True)
        return r.returncode == 0 and r.stdout.strip() == "true"
    except OSError:
        return False


def check_regen_provenance(note, repo_root):
    """Check J(regen 重生來源守衛)共用檢查器——cmd_lint 與 run_doctor 同呼叫同一函式(防兩入口
    規則漂移)。只對 frontmatter 帶 regen 的節點生效;非 regen 節點回三空。只掃 summary 行。
    回 (errs, warns, gov_events),兩入口映射(spec 映射表,照抄不猜):
      errs → lint errs 計 rc1 / doctor warn(hard) 計 issues
      warns → lint 顯示不計 rc / doctor warn_soft(J-d 提醒與 shallow 降級兩入口皆非阻擋)
      gov_events → 僅 doctor --ci 落 _append_governance_log;lint 高頻一律不落帳(防治理帳灌水)
    註:本函式為 regen 節點對 lint「node-local 不掃 repo」原則的 opt-in 例外(檔案+git 存取)。
    設計:Projects/from-scratch重生守衛_計劃;golden: governance/golden/fromscratch-m1。"""
    errs, warns, gov = [], [], []
    regen = note.fields.get("regen")
    if not (isinstance(regen, str) and regen.strip()):
        return errs, warns, gov
    summ = note.fields.get("summary")
    summ = summ if isinstance(summ, str) else ""
    shallow = None  # 惰性判定(每節點至多一次 rev-parse)
    untagged_keys = 0
    has_git_ptr = "[git:" in summ  # presence-guard:整節點無 [git: 子串即不 spawn
    for raw in summ.split("\n"):
        line = raw.strip()
        if not line:
            continue
        has_src = SRC_REF_RE.search(line)
        has_git = GIT_REF_RE.search(line)
        prefix_m = REGEN_PREFIX_RE.match(line)
        # 不對稱接線:推測/佚失 不得承載合約/不可逆(raw 行獨立偵測——INVARIANT_RE 對此形態
        # 整行不 match,靠它=該行對 Check T/contracts 隱形,比擋下更毒;四組合皆觸發)
        if prefix_m and ("★INVARIANT★" in line or "★IRREVERSIBLE★" in line):
            errs.append(f"『{prefix_m.group(1)}:』行不得承載 ★INVARIANT★/★IRREVERSIBLE★"
                        f"(合約不能建在推測上;補 [src:]/[git:] 或走 signoff 升級):{line[:48]}")
            continue
        # J-a:regen ★INVARIANT★ 需 [src:]/[git:] 意圖證據(與 Check T 的 [test:] 疊加——
        # [test:] 只證行為現在成立,不證意圖是合約;拒絕發明合約)
        if INVARIANT_RE.match(line) and not (has_src or has_git):
            errs.append(f"regen 節點的 ★INVARIANT★ 缺 [src:]/[git:] 意圖證據"
                        f"(J-a 拒絕發明合約):{line[:48]}")
        # J-b:DECISION 行需證據指針或顯式標 推測:/佚失:(重建的 why 必須標來源或標推測)
        if line.startswith("DECISION:") and not (has_src or has_git or prefix_m):
            errs.append(f"regen 節點的 DECISION 行無證據指針且未標 推測:/佚失:(J-b):{line[:48]}")
        # J-d:無 tier 標記的 KEY 行計數(唯讀提醒,不寫回任何欄位)
        if line.startswith("KEY:") and not (has_src or has_git or prefix_m):
            untagged_keys += 1
        # J-c:[src:] substring gate(直走 _validate_repo_ref,不經 top_dirs 靜默過濾)
        for m in SRC_REF_RE.finditer(line):
            path, lno = m.group(1).strip(), (m.group(2) or "")
            status, _ = _validate_repo_ref(repo_root, path, lno)
            if status == "missing":
                errs.append(f"[src:{path}] 目標不存在(J-c dangling=幻覺證據)")
            elif status == "line_out_of_range":
                errs.append(f"[src:{path}:{lno}] 行號越界(J-c)")
        # J-c:[git:sha](presence-guard 後才 spawn;shallow 降級=顯性+僅 doctor --ci 留痕,不得靜默)
        if has_git_ptr:
            for m in GIT_REF_RE.finditer(line):
                sha = m.group(1)
                if _git_commit_exists(repo_root, sha):
                    continue
                if shallow is None:
                    shallow = _git_is_shallow(repo_root)
                if shallow:
                    warns.append(f"[git:{sha[:12]}] Tier B 驗證跳過(shallow clone,本地無該物件;"
                                 f"非擋——full clone 下會重驗)")
                    gov.append({"gate": "check-j", "kind": "shallow-skip", "hard": False,
                                "nodes": [note.stem]})
                else:
                    errs.append(f"[git:{sha[:12]}] commit 不存在(J-c dangling=幻覺證據)")
    if untagged_keys:
        warns.append(f"{untagged_keys} 條 KEY 行無 tier 標記([src:]/[git:]/推測:/佚失:)"
                     f"——J-d 提醒:prose 級誠實機械驗不了,建議補標或過對抗審")
    return errs, warns, gov


def cmd_drift_history(env, every=60, limit=0, as_json=False):
    """★讓每份架構圖自己量規律,而不是相信別人在別份架構圖上的結論★(Enzo 2026-08-12 裁定)。

    沿 git 歷史取樣重放 Check Y 的核心邏輯:每個取樣點用 `git grep` 對當時的 code
    比對當時架構圖提到的符號,輸出「幽靈符號」時間序列。不需 checkout、不動工作區。

    為什麼需要它:本工具的三道守衛(U/N/Y)有兩道靠形狀/詞表啟發式,★換一份架構圖或語言棧
    可能靜默失效★。與其宣稱通用,不如給每個專案一把尺自己量:
      - 曲線一直是 0 → 這個專案沒有這型 drift(或形狀規則沒對上 → 先調 symbol_profile)
      - 曲線長期非 0 且同一批符號反覆出現 → ★規律成立,值得開檢查★
    LandmarkMember 首跑實測:GetOrdersForRedeemAsync / ListAvailableAsync 兩條
    ★橫跨 77 天、11 個取樣點都在★,期間架構圖從 21 篇長到 30 篇也沒被修掉。

    ★方法論警示(踩過)★:首版取樣腳本因 git 對非 ASCII 檔名加引號跳脫,`.md` 尾綴比對
    把 25/30 個節點濾掉,結論從「2% 持續三個月」變成「0% 完全沒問題」。故本實作固定
    帶 `-c core.quotePath=off`——★表面形狀的假設沒說清楚,會錯得無聲無息★。"""
    import json as _json, subprocess as _sp, tempfile as _tf, os as _os
    repo_root = None
    for _p in env.vault.parents:      # 同 doctor Check C 的推導:docs/ 的上一層即 repo root
        if _p.name == "docs":
            repo_root = _p.parent
            break
    if repo_root is None:
        print("ERROR: 需要 <repo>/docs/<slug>-knowledge 佈局才能對照 code", file=sys.stderr)
        return 2
    prof, neg = load_symbol_profile(repo_root)
    sym_re = re.compile(prof["shape_re"])
    ext_re = re.compile(r"\.(aspx|html|cs|js|vue|sql|ps1|yml|json|md|kt|py)$", re.I)
    sufs, dot_ok = tuple(prof.get("suffixes") or ()), prof.get("dotted_ok", True)
    code_globs = ["*" + e for e in prof.get("code_exts", (".cs",))]

    def _shaped(s):
        if "/" in s or " " in s or ext_re.search(s):
            return False
        if any(c.isdigit() for c in s) or s.isupper():
            return False
        if not sym_re.match(s):
            return False
        if sufs and any(s.endswith(x) for x in sufs):
            return True
        return dot_ok and "." in s

    def _git(*a):
        return _sp.run(["git", "-c", "core.quotePath=off", *a], cwd=repo_root,
                       capture_output=True, text=True, errors="replace").stdout

    vault_rel = _os.path.relpath(env.vault, repo_root).replace(_os.sep, "/")
    sys_rel = f"{vault_rel}/Systems"
    # ★不可只取「動過架構圖的 commit」★(2026-08-12 被自己的測試打出來的設計缺陷):
    # drift 的誕生機制正是「只改 code、沒改架構圖」的 commit——若只在架構圖 commit 取樣,
    # 就系統性錯過 drift 出生的那一刻,只有等下一次剛好有人動架構圖才看得到。
    # 這個盲點跟它要量的問題是同一個形狀,測試翻紅才發現。故改成掃全部 commit,
    # 架構圖還不存在的取樣點由下方 ls-tree 空清單自然略過。
    log = _git("log", "--format=%H %ad", "--date=short", "--reverse").splitlines()
    if not log:
        print("(架構圖在 git 歷史中沒有紀錄,無法重放)")
        return 0
    picks = [l.split() for i, l in enumerate(log) if i % max(1, every) == 0]
    if limit:
        picks = picks[-limit:]
    rows = []
    for sha, date in picks:
        files = [f for f in _git("ls-tree", "-r", "--name-only", sha, sys_rel).splitlines()
                 if f.endswith(".md")]
        if not files:
            continue
        cands = set()
        for f in files:
            for ln in _git("show", f"{sha}:{f}").splitlines():
                if any(k in ln for k in neg):
                    continue
                for m in INLINE_CODE_RE.finditer(ln):
                    s = m.group(0).strip("`").strip()
                    if _shaped(s):
                        cands.add(s)
        ghosts = []
        if cands:
            tfh = _tf.NamedTemporaryFile("w", suffix=".txt", delete=False, encoding="utf-8")
            tfh.write("\n".join(sorted({c.split(".")[-1] for c in cands})) + "\n")
            tfh.close()
            out = _git("grep", "-F", "-h", "-f", tfh.name, sha, "--", *code_globs)
            _os.unlink(tfh.name)
            ghosts = sorted(c for c in cands if c.split(".")[-1] not in out)
        rows.append({"sha": sha[:9], "date": date, "notes": len(files),
                     "candidates": len(cands), "ghosts": ghosts})
    if as_json:
        print(_json.dumps(rows, ensure_ascii=False))
        return 0
    if not rows:
        print("(取樣點都沒有 Systems 節點)")
        return 0
    print(f"drift-history — {len(rows)} 個取樣點(每 {every} 個架構圖 commit 取 1)"
          f"｜symbol_profile 命中形狀={prof['shape_re']}")
    print(f"{'commit':10} {'date':11} {'節點':>4} {'候選':>5} {'幽靈':>5}  持續中的幽靈符號")
    for r in rows:
        print(f"{r['sha']:10} {r['date']:11} {r['notes']:4} {r['candidates']:5} "
              f"{len(r['ghosts']):5}  {', '.join(r['ghosts'][:4])}")
    persist = set(rows[0]["ghosts"])
    for r in rows[1:]:
        persist &= set(r["ghosts"])
    print()
    if persist:
        print(f"★橫跨全部 {len(rows)} 個取樣點都存在的幽靈符號:{', '.join(sorted(persist))}")
        print("  → 規律成立:這不是偶發,是穩態。這型 drift 值得開機械檢查(見 Check Y)。")
    elif any(r["ghosts"] for r in rows):
        print("幽靈符號有出現但非持續 → 有人在修,但沒有機制擋住它再發生。")
    else:
        print("所有取樣點都 0 幽靈 → 這個專案沒有這型 drift,"
              "★或 symbol_profile 沒對上你的語言棧(先確認候選數不是 0)★。")
    return 0


def cmd_lint(env, node):
    """單檔快檢:寫完一個節點立刻自驗標籤/格式(node-local,不掃 repo → 比 doctor 快;
    例外:regen 節點的 Check J 需檔案+git 存取,opt-in、量小)。
    抓「寫入當下」最常見的錯:type/summary 缺漏、★ 標記格式錯(漏被 contracts 抓)、
    裸合約 / 未審、symbol 行 typo、frontmatter 指紋(ghost trap…)。
    與 doctor 分工:doctor 是全圖權威(跨節點完整性 + [test:] 存在性),lint 只看這一篇、
    predicts pre-push 會不會擋(error 即 doctor --ci 會擋的同類)。"""
    rel = env.find(node)
    if rel is None:
        print(f"ERROR: 找不到節點 {node}", file=sys.stderr)
        return 2
    n = env.notes[rel]
    errs = list(n.lint)          # frontmatter 指紋(ghost trap / 重複鍵 / 日期引號…)= error
    warns = []

    t = n.fields.get("type")
    if not isinstance(t, str) or not t:
        errs.append("缺 type(frontmatter 必須有 type)")
    elif t not in KNOWN_TYPES:
        errs.append(f"未知 type『{t}』(應為 {'/'.join(sorted(KNOWN_TYPES))})")

    summ = n.fields.get("summary")
    summ = summ if isinstance(summ, str) else ""
    if t in ("system", "issue") and not summ.strip():
        errs.append(f"{t} 節點必須有 summary block(放 FLOW:/KEY:/DEP: 等符號行)")

    # aliases 宣告制(2026-08-05 Enzo 裁定,cutoff 起新 system/issue 逼「判過」不逼「有值」):
    # aliases 吃 3.5 檢索權重,湊數別名主動污染排序——故 `aliases: []`=明示判過,合法;
    # 缺鍵=沒判過,擋。舊節點不回溯(created < cutoff)。
    _ALIASES_CUTOFF = "2026-08-05"
    if t in ("system", "issue"):
        _created = str(n.fields.get("created") or "")
        if _created >= _ALIASES_CUTOFF and "aliases" not in n.fields:
            errs.append("缺 aliases 鍵(2026-08-05 起 system/issue 必須判過同義詞——"
                        "有就列(症狀語/縮寫/舊名),確定沒有寫 aliases: [];湊數別名比空更糟)")

    # 值域執法(2026-08-05 標籤結構優化,Enzo 裁;cutoff 制不回溯——Landmark 實測野化:
    # status 13 值同義混用、FLAG 50+ 自由文字淪為備註欄,可篩選性歸零)
    _ENUM_CUTOFF = "2026-08-06"
    _STATUS_ENUM = {
        "system": {"doing", "done", "planned", "deferred", "rejected", "superseded", "stale"},
        "project": {"todo", "doing", "done", "superseded"},
        "issue": {"open", "doing", "resolved", "done", "wontfix"},
        "verification": {"pass", "stale", "superseded"},
        "moc": {"doing", "done"},
    }
    _PRIORITY_ENUM = {"P0", "P1", "P2", "P3"}
    _RISK_ENUM = {"金流", "對外送出", "不可逆", "守衛面"}
    _FLAG_ENUM = {"TECHNICAL", "DECISION", "ORIGIN"}
    _created_e = str(n.fields.get("created") or n.fields.get("date") or "")
    if _created_e >= _ENUM_CUTOFF:
        _st = str(n.fields.get("status") or "")
        if t in _STATUS_ENUM and _st and _st not in _STATUS_ENUM[t]:
            errs.append(f"status『{_st}』不在 {t} 合法值集 {sorted(_STATUS_ENUM[t])}"
                        "(同義詞歸一:resolved/done 擇一慣例、verification 用 pass)")
        for tg in (n.fields.get("tags") or []):
            if not isinstance(tg, str):
                continue
            if tg.startswith("priority/") and tg.split("/", 1)[1] not in _PRIORITY_ENUM:
                errs.append(f"priority tag 只認 P0-P3,收到 {tg!r}")
            if tg.startswith("risk/") and tg.split("/", 1)[1] not in _RISK_ENUM:
                errs.append(f"risk tag 只認 {sorted(_RISK_ENUM)},收到 {tg!r}")
            if tg.startswith(("feature/", "area/")):
                warns.append(f"{tg!r}:feature/area 家族已凍結,新寫入請用 scope/(讀側仍認舊帳)")
        import re as _re_f
        _mflag = _re_f.search(r"^\s*FLAG:(\S+)", summ, _re_f.M)
        if _mflag and _mflag.group(1) not in _FLAG_ENUM:
            errs.append(f"FLAG:『{_mflag.group(1)}』不在三值集 {sorted(_FLAG_ENUM)}"
                        "(FLAG=語意類別非備註欄;敘述內容移 KEY: 行)")

    # decisions 結構守衛(2026-07-29 外審實錘:id 縮排吞進 content block,parser 靜默降級、
    # doctor 全綠——「綠燈≠schema 有效」的活例。以正牌 parse_decisions 驗:
    # 壞型一(sibling 被吞)→ content 空;壞型二(entry 非 `- key:` 形)→ 整條被靜默丟棄=條數對不上)
    try:
        _fm_lines, _ = split_frontmatter((env.vault / rel).read_text(encoding="utf-8"))
    except OSError:
        _fm_lines = None
    if _fm_lines and any(re.match(r"^decisions:\s*$", _l) for _l in _fm_lines):
        _parsed = parse_decisions(_fm_lines)
        _raw_items = 0
        _in = False
        for _l in _fm_lines:
            if re.match(r"^decisions:\s*$", _l):
                _in = True
                continue
            if _in and _l.strip() and not _l.startswith(" "):
                _in = False
            if _in and re.match(r"^  -\s", _l):
                # 只認 entry 縮排層(恰 2 空格):alternatives_considered 等巢狀清單(≥4 空格)
                # 不是決策條目——2026-08-05 Landmark 回填實戰:照 ADR 規範寫巢狀清單被誤報壞損
                _raw_items += 1
        if _raw_items != len(_parsed):
            errs.append(f"decisions 結構壞損:寫了 {_raw_items} 條、只解析出 {len(_parsed)} 條"
                        "(entry 須為 `- id:`/`- content:` 起頭的 dict;用 lumos decision-add 寫入)")
        for _di, _d in enumerate(_parsed):
            if not str(_d.get("content") or "").strip():
                errs.append(f"decisions[{_di}] content 為空(常見成因:sibling 鍵縮排錯位被吞進 block scalar)")

    # 狀態標籤漂移守衛:status 欄位 vs tags 的 status/*(反正規化的完整性檢查,
    # 兜住繞過 set status 同步的寫入路徑;見 Projects/狀態標籤同步守衛_計劃)
    _st = n.fields.get("status")
    if isinstance(_st, str) and _st.strip():
        for _tg in as_list(n.fields.get("tags")):
            if isinstance(_tg, str) and _tg.startswith("status/") and _tg != f"status/{_st.strip()}":
                errs.append(f"status 欄位({_st})與標籤({_tg})漂移(lumos set status 會自動同步;手改請對齊)")

    _regen_val = n.fields.get("regen")
    _lint_is_regen = isinstance(_regen_val, str) and bool(_regen_val.strip())

    for raw in summ.split("\n"):
        line = raw.strip()
        if not line:
            continue
        ms = SYMBOLISH_RE.match(line)
        if ms and ms.group(1) not in SYMBOL_NAMES:
            warns.append(f"非標準符號行『{ms.group(1)}:』(typo? 符號應為 {'/'.join(sorted(SYMBOL_NAMES))})")
        for mark, rx in (("★INVARIANT★", INVARIANT_RE), ("★DEBT★", DEBT_RE)):
            if mark in line and not rx.match(line):
                # 雙報消歧 predicate(Check J):regen 節點的 KEY:推測:★INVARIANT★ 由 J 專屬訊息
                # 接手,跳過 generic 位置錯誤(同一行恰一則;非 regen 節點 generic 保留=兜底)。
                # 既有迴圈只含 INVARIANT/DEBT、無 IRREVERSIBLE → 消歧只需此分支。
                if (_lint_is_regen and REGEN_PREFIX_RE.match(line)
                        and ("★INVARIANT★" in line or "★IRREVERSIBLE★" in line)):
                    continue
                errs.append(f"{mark} 必須是 KEY 行前綴(KEY:{mark} ...),否則 contracts/doctor 抓不到:{line[:48]}")

    invs, _ = extract_contracts(n)
    for inv in invs:
        clean, refs = strip_test_refs(inv)
        if not refs:
            errs.append(f"裸 ★INVARIANT★(沒綁 [test:],Check T 會擋):{first_line(clean, 48)}")
        elif not invariant_audit_refs(inv):
            errs.append(f"★INVARIANT★ 綁了測試但未獨立審計(缺 [audit:],pre-push 會擋):{first_line(clean, 48)}")

    # Check J 單檔版(regen 重生來源守衛):共用 check_regen_provenance,映射表——
    # errs→errs(rc1)/warns→warns(顯示不計 rc)/gov_events→lint 一律不落帳(高頻)。
    if _lint_is_regen:
        j_errs, j_warns, _j_gov = check_regen_provenance(n, _repo_root_from_env(env))
        errs.extend(j_errs)
        warns.extend(j_warns)

    # Check R 單檔版:可逆性回退綁定 + 標錯型別
    for marker, rclean, ref, guard_ref in extract_reversibility(n):
        if t != "system":
            errs.append(f"{marker} 只能在 Systems 節點(本節點 type={t!r}):{first_line(rclean, 40)}")
        elif marker == "★IRREVERSIBLE★":
            if not (_rollback_resolved(n, ref) or _guard_resolved(n, guard_ref)):
                errs.append(f"{marker} 缺實質回退(行尾加 [rollback:decisions] 或 [guard:decisions],decisions[] 要有非空 rollback/guard):{first_line(rclean, 40)}")
        elif not _rollback_resolved(n, ref):  # ★CHECKPOINT★;guard_ref 不讀
            warns.append(f"{marker} 建議補回退([rollback:decisions]):{first_line(rclean, 40)}")

    # ── Check U:全稱宣稱未綁測試(成因 G「過度概化」;2026-08-12 加) ──
    # 由來:2026-08-12 LandmarkMember 全 24 篇交叉審計(389 主張/59 不一致)歸因出一類最毒的 drift
    # ——★把單一模組的個別設計寫成系統通則★。實例:`背景排程總覽` 寫「服務 disabled 時也要寫心跳」
    # 像通則,實際只有一支服務這樣做,現役的 SecurityAnomalyMonitorService 直接 return 不寫;
    # 後人依樣畫葫蘆就會寫出不一致的新服務。
    # PRIOR-ART(真搜):世界對這類的成熟解是**架構適應度函數**(ArchUnit/Deptrac)——「與其把規則
    # 畫在沒人看的圖上,不如編成一違反就 fail build 的測試」。本檢查不取代那個做法,而是**提示該去做**:
    # 若真是通則,寫成適應度函數會當場告訴你有沒有例外;若寫不出來,那它本來就不是通則。
    # ★噪音實測(2026-08-12,LandmarkMember 30 篇 Systems / 261 條 KEY 行)★:
    #   單看量詞(一律/必須/所有…)→ 命中 17%,抽樣多為用詞規範/操作指示 = 會被無視的 warn;
    #   收緊成「分配式量詞 + 程式實體 + 義務語氣」三者同現 → 命中 1%(5 行),其中 3 條真陽性,
    #   含 CustTransfer/滿額贈 的「折疊守衛(通則)」(自稱通則、零 [test:],且節點自己記載
    #   2026-06-02 漏補一路到 07-21 才被使用者回報)。故採三訊號同現。
    _U_DIST = r'(所有|每個|每支|每一|各個|凡是|凡|一律)'
    _U_ENT = r'(Service|Repository|Controller|Job|服務|排程|查詢|端點|入口|呼叫點|實作|模組|節點|欄位)'
    _U_MOD = r'(必須|都要|都必須|皆須|應該|一律要|要寫|要帶|不可|禁止)'
    import re as _re_u
    for _ln in summ.splitlines():
        _s = _ln.strip()
        if not _s.startswith("KEY:"):
            continue
        if "[test:" in _s or "★DEBT★" in _s:
            continue          # 已綁證據 / 已自認技術債(不是在宣稱規則)→ 不吵
        if (_re_u.search(_U_DIST, _s) and _re_u.search(_U_ENT, _s)
                and _re_u.search(_U_MOD, _s)):
            warns.append(
                "疑似「通則」宣稱但未綁測試(Check U):" + first_line(_s[4:], 46) +
                " → 若真是通則,寫成一支列舉所有實例的測試(適應度函數)並 [test:] 綁上;"
                "若寫不出來,它八成只是某個模組的個別設計,★請改寫成限定範圍★"
                "(誤報可加 [test:] 或改寫語氣消音)")

    if not errs and not warns:
        print(f"✓ lint {rel} — 0 問題")
        return 0
    print(f"lint {rel}")
    for e in errs:
        print(f"  ✗ {e}")
    for w in warns:
        print(f"  ⚠ {w}")
    print(f"\n{len(errs)} error / {len(warns)} warning"
          + ("" if errs else "(warning 不阻擋,但建議補)"))
    return 1 if errs else 0


SPEC_CLAUSE_RE = re.compile(r"\[S(\d+)\]")


def cmd_spec_trace(env, node, as_json=False):
    """條款級追溯(RTM 輕量版):計劃 body 的 [SN] 條款 × 回指 Verification 的認領。
    rc:全認領=0;有未認領=1;計劃無 [SN] 標記=0(opt-in 未啟用)。唯讀。"""
    import json
    rel = env.find(node)
    if rel is None:
        print(f"ERROR: 找不到節點 {node}", file=sys.stderr)
        return 2
    plan_stem = env.notes[rel].stem
    try:
        text = (env.vault / rel).read_text(encoding="utf-8-sig")
    except OSError as ex:
        print(f"ERROR: {ex}", file=sys.stderr)
        return 2
    ids = sorted({int(m) for m in SPEC_CLAUSE_RE.findall(text)})
    if not ids:
        if as_json:
            print(json.dumps({"plan": rel, "clauses": {}, "unclaimed": [],
                              "opt_in": False}, ensure_ascii=False))
        else:
            print(f"(opt-in 未啟用) {rel} 無 [SN] 條款標記——要追溯就在規格 bullet 加 [S1]/[S2]…")
        return 0
    claims = {i: [] for i in ids}
    for vrel, n in env.notes.items():
        if not vrel.startswith("Verification/"):
            continue
        prs = n.fields.get("plan_refs")
        prs = prs if isinstance(prs, list) else ([prs] if prs else [])
        if not any(plan_stem in str(x) for x in prs):
            continue   # 沒回指本計劃的提及不算認領(防偶然文字)
        # 已知設計限制:多計劃 Verification 提及 [S1] 會同時記入兩計劃的 S1
        # (條款 ID 只有數字無計劃域)——一篇 Verification 盡量只回指一個計劃
        try:
            vtext = (env.vault / vrel).read_text(encoding="utf-8-sig")
        except OSError:
            continue
        for m in SPEC_CLAUSE_RE.findall(vtext):
            i = int(m)
            if i in claims:
                claims[i].append(vrel)
    unclaimed = [i for i in ids if not claims[i]]
    if as_json:
        print(json.dumps({"plan": rel, "clauses": {f"S{i}": claims[i] for i in ids},
                          "unclaimed": [f"S{i}" for i in unclaimed]}, ensure_ascii=False))
    else:
        for i in ids:
            mark = "✓" if claims[i] else "✗"
            who = ", ".join(Path(x).stem for x in claims[i]) or "(無人認領)"
            print(f"{mark} [S{i}] ← {who}")
        print(f"\n{len(ids)} 條款 / 未認領 {len(unclaimed)}")
    return 1 if unclaimed else 0


def cmd_signoff(env, node, note, by=None):
    """業務簽核留痕(validation 那半):人對業務正確性點頭 → ledger+frontmatter 戳記。
    工具只記留痕,不證明確認真的發生(同 audit/self-audit 的誠實前提)。"""
    import json
    import datetime
    import subprocess
    if not (note or "").strip():
        print("ERROR: --note 必填(確認了什麼,給未來的人看)", file=sys.stderr)
        return 2
    rel = env.find(node)
    if rel is None:
        print(f"ERROR: 找不到節點 {node}", file=sys.stderr)
        return 2
    today = datetime.date.today().isoformat()
    commit = ""
    try:
        commit = subprocess.run(["git", "-C", str(env.vault.parent), "rev-parse", "--short", "HEAD"],
                                capture_output=True, text=True).stdout.strip()
    except OSError:
        pass
    log = env.vault.parent / ".signoff-log.jsonl"
    try:
        with open(log, "a", encoding="utf-8") as fh:
            fh.write(json.dumps({"ts": datetime.datetime.now().isoformat(timespec="seconds"),
                                 "node": rel, "by": by or "", "note": note,
                                 "commit": commit}, ensure_ascii=False) + "\n")
    except OSError as ex:
        print(f"ERROR: signoff-log 寫入失敗: {ex}", file=sys.stderr)
        return 2
    rc = cmd_set(env, rel, "signed_off", today)
    if rc != 0:
        print("⚠ ledger 已記但 frontmatter 戳記失敗(見上)", file=sys.stderr)
        return rc
    print(f"✓ signoff {rel} — {today}{('(' + by + ')') if by else ''}: {note[:60]}")
    return 0


def cmd_gov(env, node=None, since_days=90, full=False):
    """唯讀彙整七帳(bypass/rot-queue/governance/canary/kill/signoff/ci)→ 治理事件時間軸。
    本機開發可見性工具(非合規物)。L2 無 node、L3 以 Verification 為鍵 → 對 Systems 為部分視圖。
    去噪(2026-07-25,呈現層——帳本身不動):同日同類 advisory(軟/warned/無 detail,如 Check S
    每次 doctor 全名單重喊)跨 commit 折疊 ×N、同群 >6 節點收單行摘要;--full 回完整逐筆。"""
    import json
    import datetime
    docs = env.vault.parent
    cutoff = (datetime.date.today() - datetime.timedelta(days=since_days)).isoformat()

    def stem(s):
        return Path(str(s)).stem.lower()

    rows = []

    def load(name, mapper):
        p = docs / name
        if not p.exists():
            return
        for line in p.read_text(encoding="utf-8").splitlines():
            line = line.strip()
            if not line:
                continue
            try:
                rows.append(mapper(json.loads(line)))
            except (ValueError, KeyError):
                continue

    load(".bypass-log.jsonl", lambda d: {"ts": d.get("ts", ""), "commit": d.get("commit", ""),
         "gate": "L2", "kind": "bypassed", "hard": False, "nodes": [], "detail": d.get("subject", "")})
    load(".rot-queue.jsonl", lambda d: {"ts": d.get("ts", ""), "commit": d.get("commit", ""),
         "gate": "L3", "kind": "warned", "hard": False, "nodes": [stem(d.get("verification", ""))],
         "detail": d.get("reason", "")})
    load(".governance-log.jsonl", lambda d: {"ts": d.get("ts", ""), "commit": d.get("commit", ""),
         "gate": d.get("gate", "?"), "kind": d.get("kind", "?"), "hard": bool(d.get("hard")),
         "nodes": [stem(x) for x in d.get("nodes", [])], "detail": d.get("note", "")})
    # 第 6 源:業務簽核留痕(validation:人對業務正確性點頭的日期/人/內容)。
    load(".signoff-log.jsonl", lambda d: {"ts": d.get("ts", ""), "commit": d.get("commit", ""),
         "gate": "signoff", "kind": "signed", "hard": False,
         "token": d.get("ts", ""), "nodes": [stem(d.get("node", ""))],
         "detail": (d.get("by", "") + " " + d.get("note", "")).strip()})
    # 第 5 源:kill 殺傷力驗證留痕(guard kill 的 verdict 史)。
    load(".kill-log.jsonl", lambda d: {"ts": d.get("ts", ""), "commit": d.get("commit", ""),
         "gate": "kill", "kind": d.get("verdict", "?"), "hard": False,
         "token": d.get("invariant", "") + d.get("ts", ""),   # 同節點多合約/多次不互吞(dedup 第5鑑別子)
         "nodes": [stem(d.get("node", ""))],
         "detail": f"{d.get('invariant','')[:28]} [{d.get('test','')}] {d.get('note','')}".strip()})
    # 第 4 源:canary 審計留痕(審計員可靠度史)。只此 mapper 輸出 token 鍵(供 dedup 鑑別)。
    load(".canary-log.jsonl", lambda d: {"ts": d.get("ts", ""), "commit": "",
         "gate": "canary", "kind": d.get("kind", "?"), "hard": False, "nodes": [],
         "token": d.get("token", ""), "auditor": d.get("auditor") or "?",
         "findings": d.get("findings"), "severity": d.get("severity", ""),
         # [S2] second 行的 verdict/ref 併進 detail(否則分歧訊號在治理帳全程隱形)
         "detail": ((f"verdict={d.get('verdict','?')} ref={d.get('ref','')} · "
                     if d.get("kind") == "second" else "")
                    + (f"loop={d['loop']} sev={d.get('severity', '?')} · " if d.get("loop") else "")
                    + (d.get("auditor", "") + " " + d.get("note", "")).strip())})

    # 第 7 源:CI 回流帳(總開關——未宣告 ci 區塊即完全不 load,否則移除宣告後歷史事件仍顯示)
    _ci_root = _anchor_repo_root(None)
    if _ci_root and _ci_config(_ci_root)[0]:
        load(CI_LOG_NAME, lambda d: {"ts": d.get("ts", ""), "commit": d.get("sha", ""),
             "gate": "ci", "kind": d.get("conclusion", "?"), "hard": False, "nodes": [],
             "token": d.get("dedup_key", ""),
             "detail": f"{d.get('workflow', '')} {d.get('title', '')} {d.get('failed_step', '')}".strip()})

    rows = [r for r in rows if (r["ts"][:10] or "9999") >= cutoff]
    seen, ded = set(), []
    for r in sorted(rows, key=lambda r: r["ts"]):
        # canary 每筆 token 唯一 → 加 token 當第 5 鑑別子(舊三源無此鍵,.get 回 "");必須用 .get 不可 r["token"]
        k = (r["commit"], frozenset(r["nodes"]), r["gate"], r["kind"], r.get("token", ""))
        if k in seen:
            continue
        seen.add(k)
        ded.append(r)
    if node:
        q = stem(node)
        ded = [r for r in ded if q in r["nodes"]]
    # ── 去噪(呈現層):advisory(軟/warned/無 token/無 detail)同(日,gate,kind,node)折 ×N;
    #    同(日,gate,kind)群 >6 節點再收單行摘要。canary/kill/signoff/L2 等有 detail/token 逐筆保留。
    def _is_advisory(r):
        return (not r["hard"]) and r["kind"] == "warned" and not r.get("token") and not r["detail"]
    lines = []
    if full:
        for r in ded:
            mark = "硬擋" if r["hard"] else "軟"
            lines.append(f"{r['ts'][:10]} [{r['gate']}/{r['kind']}/{mark}] {','.join(r['nodes']) or '-'}  {r['detail'][:50]}")
    else:
        agg = {}          # (date,gate,kind) -> {node: 次數}(保序靠 dict 插入序)
        for r in ded:
            if _is_advisory(r):
                g = agg.setdefault((r["ts"][:10], r["gate"], r["kind"]), {})
                nk = ",".join(r["nodes"]) or "-"
                g[nk] = g.get(nk, 0) + 1
                if g[nk] == 1:
                    r["_agg"] = (r["ts"][:10], r["gate"], r["kind"], nk)   # 首見佔位,維持時間軸位置
                else:
                    r["_drop"] = True
        for r in ded:
            if r.get("_drop"):
                continue
            mark = "硬擋" if r["hard"] else "軟"
            if r.get("_agg"):
                date, gate, kind, nk = r["_agg"]
                g = agg[(date, gate, kind)]
                if len(g) > 6:                      # 大群組:整群收一行(只在群內首筆時印)
                    if g.get("_printed"):
                        continue
                    g["_printed"] = True
                    names = [k for k in g if k != "_printed"]
                    xmax = max(v for k, v in g.items() if k != "_printed")
                    head = ",".join(names[:3])
                    print(f"{date} [{gate}/{kind}/{mark}] {len(names)} 節點({head}…) ×{xmax}")
                else:                               # 小群組:逐節點+×N 計次
                    n = g[nk]
                    print(f"{date} [{gate}/{kind}/{mark}] {nk}" + (f" ×{n}" if n > 1 else ""))
                continue
            print(f"{r['ts'][:10]} [{r['gate']}/{r['kind']}/{mark}] {','.join(r['nodes']) or '-'}  {r['detail'][:50]}")
    for ln in lines:
        print(ln)
    if node:
        print("\n(註:L2 繞過無 node、L3 以 Verification 為鍵;對 Systems 節點為部分視圖)")
    # canary missed 分帳(2026-07-10,borrow mutation 文獻:missed 類別要分類追蹤,
    # missed-rate 是一級指標非異常事件)。per-auditor 計數 + note 的 type=X best-effort 分佈。
    can = [r for r in ded if r["gate"] == "canary"]
    if can and not node:
        import re as _re
        by_aud = {}
        by_type = {}
        for r in can:
            aud = r.get("auditor", "?")  # record 原生欄位(終審 F2:解析 detail 字串在無 --auditor 時誤歸戶)
            st = by_aud.setdefault(aud, {"caught": 0, "missed": 0})
            st[r["kind"]] = st.get(r["kind"], 0) + 1
            m = _re.search(r"type=([\w-]+)", r["detail"])
            if m:
                tt = by_type.setdefault(m.group(1), {"caught": 0, "missed": 0})
                tt[r["kind"]] = tt.get(r["kind"], 0) + 1
        print("\ncanary 分帳(missed-rate 一級指標):")
        for aud, st in sorted(by_aud.items()):
            tot = st["caught"] + st["missed"]
            if tot:
                print(f"  {aud}: caught {st['caught']} / missed {st['missed']}"
                      f" (missed-rate {st['missed']/tot:.0%})")
        if by_type:
            print("  型別分佈: " + " | ".join(
                f"{k}:{v['caught']}c/{v['missed']}m" for k, v in sorted(by_type.items())))
        # [S2] 第二判者分帳(否則 overturn 分歧只在 detail 字串裡、看不到彙總)
        _sec = [r for r in can if r["kind"] == "second"]
        if _sec:
            _ag = sum(1 for r in _sec if "verdict=agree" in r.get("detail", ""))
            _ov = len(_sec) - _ag
            print(f"  第二判者覆核: {len(_sec)} 筆(agree {_ag} / overturn {_ov}"
                  + (f" ← 分歧率 {_ov/len(_sec):.0%},翻盤輪值得回看" if _ov else "") + ")")
        # 對抗層增量帳(2026-07-26,borrow arXiv 2605.25665 實戰報告欄):折入=caught 輪辯方裁決後
        # 存活折入的真缺陷數——測試綠後仍被對抗層(canary 護審/辯方/跨家族)抓到,天生就是「測試漏掉的」。
        # 長期趨零=整套機關裝飾品該砍;這是驗證層對自己的驗證。missed 輪判決不採信不計;
        # findings 欄 2026-07-21(M1)起才有,舊輪無欄誠實另計不混入。
        fold_total, fold_sev, fold_aud, legacy_rounds = 0, {}, {}, 0
        for r in can:
            # none=停用制無植入輪(2026-08-14 d5):折入 findings 語意不變,照計——
            # 只讀 caught 會使本帳(文檔標一級指標)自停用日起永凍 0(終審 F2)
            if r["kind"] not in ("caught", "none"):
                continue
            fnd = r.get("findings")
            if fnd is None:
                legacy_rounds += 1
                continue
            fold_total += fnd
            if fnd:
                sv = r.get("severity") or "?"
                fold_sev[sv] = fold_sev.get(sv, 0) + fnd
                aud = r.get("auditor", "?")
                fold_aud[aud] = fold_aud.get(aud, 0) + fnd
        sev_s = " ".join(f"{k} {v}" for k, v in sorted(fold_sev.items())) or "無"
        aud_s = " · ".join(f"{k} {v}" for k, v in sorted(fold_aud.items())) or "無"
        legacy_s = f"(另 {legacy_rounds} 舊輪無 findings 欄不計)" if legacy_rounds else ""
        print(f"  對抗層增量帳(折入=測試綠後仍被抓;長期趨零=機關裝飾該砍): "
              f"折入 {fold_total} 筆缺陷 [{sev_s}] | 依審計員: {aud_s} {legacy_s}".rstrip())
    print(f"\n{len(ded)} 筆(近 {since_days} 天)")
    return 0


CLUSTER_STATES = ("resolved", "accepted-minor", "disputed-major")


def _parse_clusters(raw):
    """M2 risk-cluster 寫側解析:--clusters '名=狀態,...' → (dict{名:狀態}, None) 或 (None, 錯誤訊息)。
    三態白名單;accepted-minor 需冒號內嵌理由(整筆單一 note 對多 accepted-minor 無法對應=模糊過帳);
    尾逗號空段靜默過濾,但過濾後空列表=rc2(帶旗標即須有效內容,無「空字串=未帶」特例);
    設計:Projects/design-loop提效_計劃 M2(golden: governance/golden/dloop-m2-cluster)。"""
    parts = [p.strip() for p in str(raw).split(",") if p.strip()]
    if not parts:
        return None, "帶了 --clusters 但無有效內容(空字串/全逗號)"
    out = {}
    for p in parts:
        if "=" not in p:
            return None, f"段缺 '='(格式 名=狀態): {p!r}"
        name, state = p.split("=", 1)
        name, state = name.strip(), state.strip()
        if not re.fullmatch(r"[a-z0-9][a-z0-9_-]{0,63}", name):
            return None, f"cluster 名非法(kebab 短 slug:小寫英數起頭+[-_],≤64): {name!r}"
        base = state.split(":", 1)[0]
        if base not in CLUSTER_STATES:
            return None, f"狀態 {base!r} 不在白名單 {'/'.join(CLUSTER_STATES)}"
        if base == "accepted-minor":
            if ":" not in state or not state.split(":", 1)[1].strip():
                return None, f"accepted-minor 需逐 cluster 內嵌理由(accepted-minor:理由): {p!r}"
        elif state != base:
            # resolved/disputed-major 必須精確相等——夾帶冒號後綴=未定義第四態(帳面破三態白名單)
            return None, f"狀態 {state!r} 夾帶後綴(僅 accepted-minor 可帶冒號理由)"
        if name in out:
            return None, f"同輪同名 cluster 重複: {name!r}"
        out[name] = state
    return out, None


LOOP_TIERS = ("light", "standard", "high")


def _sha256_file(path):
    """檔案 sha256(M1包 #3);OSError 交呼叫端兜(目錄/無權限/不存在統一 rc2,沿 G1 慣例)。"""
    import hashlib
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()


def _vault_repo_root(env):
    """disposal 留痕路徑的落帳/解析根(r2 終審修,寫讀兩側★必須同用這一份★):
    從 vault 向上找 .git(docs/<slug>-knowledge 布局下 vault.parent=docs/ 非 repo root);
    找不到退 vault.parent(測試假 vault 行為不變)。"""
    p = env.vault.resolve()
    for cand in (p, *p.parents):
        if (cand / ".git").exists():
            return cand
    return env.vault.parent.resolve()


def cmd_canary(env, kind, auditor=None, token=None, note=None, loop=None, severity=None, findings=None, round_id=None, capture_counts=None, clusters=None, spec=None, reviewed=None, tokens=None, wallclock_min=None, tier=None, scope_lines=None, report=None, snapshot=None, findings_set=None, folded_set=None, accepted_set=None, accept_reasons=None, canary_type=None, probe=None):
    """記一筆審計輪留痕。kind=caught|missed 是 canary 植入判定(★協議 2026-08-14 停用,
    僅歷史帳;見 Systems/canary-audit d5★);kind=none = 無植入輪的純處置帳載體——
    停用後每輪照記(severity/findings/disposal 欄位是 loop status --disposal 的讀取源)。
    record-only、本機;漏抓(missed)= 該輪審計員放水的訊號,經 lumos gov 可查詢。
    --loop/--severity:把這輪歸進某設計 loop(供 lumos loop status 算收斂)。
    --clusters(M2):該輪 risk-cluster 三態帳(每輪至多一筆帶;讀側 loop status --panel 消費)。
    天花板:這只證明「審計員有沒有醒著讀」,不證明它抓到所有真問題(見設計 doc)。"""
    import json
    import datetime
    import secrets
    if not token:
        token = "CANARY-" + secrets.token_hex(4)   # 隨機,非時間戳(同秒不撞)
    rec = {"ts": datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
           "kind": kind, "auditor": auditor or "", "token": token, "note": note or ""}
    if loop:
        rec["loop"] = loop
    # D 前置(2026-08-05):植入型別/探針結果結構化——原散文 note 不可重算;
    # 不給不寫鍵(T1 相容慣例)。D 本體開工條件=帶型別記錄攢滿 15 筆(canary-stats 可數)。
    if canary_type:
        rec["canary_type"] = canary_type
    if probe:
        rec["probe"] = probe
    if round_id:
        if round_id.startswith("__"):
            # r3 終審修(3 席重疊):__ 為讀側內部鍵保留字首(round-less 逐筆 __seqN)——
            # 使用者 round-id 撞鍵可讓新輪併入舊輪、舊 carrier 冒充最新處置帳偽 PASS
            print(f"ERROR: --round 不得以 __ 開頭(內部保留字首): {round_id!r}", file=sys.stderr)
            return 2
        rec["round"] = round_id   # panel 一輪 W 筆共享 round-id(loop status --panel 分組)
    if capture_counts:
        try:
            rec["capture_counts"] = [int(x) for x in str(capture_counts).split(",") if x.strip()]
        except ValueError:
            print(f"ERROR: --capture-counts 需逗號分隔整數,收到 {capture_counts!r}", file=sys.stderr)
            return 2
    if severity:
        rec["severity"] = severity
    if findings is not None:
        rec["findings"] = findings
    if clusters is not None:   # 空字串也進解析器 → rc2(帶旗標即須有效內容,勿被 falsy 吞)
        parsed, err = _parse_clusters(clusters)
        if err:
            print(f"ERROR: --clusters {err}", file=sys.stderr)
            return 2
        rec["clusters"] = parsed   # dict{名:狀態},同 capture_counts 寫側轉型慣例
    # ── M1包 #3 雙 hash 鏈(loop機械脊椎M1包_計劃):--spec/--reviewed 必須同現 ──
    if (spec is None) != (reviewed is None):
        print("ERROR: hash 雙欄必須成對(--spec 與 --reviewed 同現;reviewed=派工當下真檔 sha256)",
              file=sys.stderr)
        return 2
    if spec is not None:
        try:
            rec["result_sha256"] = _sha256_file(spec)   # record 於 fold 後執行=post-fold hash
        except OSError as e:
            print(f"ERROR: 讀不到 --spec {spec}: {e}", file=sys.stderr)
            return 2
        if not re.fullmatch(r"[0-9a-f]{64}", str(reviewed)):
            print(f"ERROR: --reviewed 需 64 位 sha256 hex,收到 {reviewed!r}", file=sys.stderr)
            return 2
        rec["reviewed_sha256"] = reviewed
    # ── M1包 #4 成本選配欄:非負整數,不給不寫鍵(同 --findings 慣例) ──
    # ★scope_lines(2026-08-02)★:這輪「被審材料有多少行」。
    # 為什麼要記——canary 抓到只證審查員醒著,但★東西越多越抓不到★是外部實測裡
    # 最主導的因素(arXiv 2606.15689:合成缺陷抓得到不可靠地預測真實缺陷抓得到,
    # 且 diff 大小是主導混淆變數)。本專案十輪 code-loop 的 diff 從 332 到 2770 行,
    # ★在帳上長得一模一樣★——等於無法回答「小 diff 上的 caught 是不是灌水」。
    # 這一欄不改任何判定、不進任何 gate,★純粹是把缺的變數記下來★,好讓
    # 「caught 率 vs 規模」這個問題日後答得出來(三種結果都有用:有關係→大 diff
    # 要切開或加席;沒關係→這個擔心在本情境不成立、寫下來別再擔心;反過來→查)。
    # ★不能回溯★:既有記錄沒有這個數字,時鐘從加上去那天才開始走。
    for _name, _val in (("tokens", tokens), ("wallclock_min", wallclock_min),
                        ("scope_lines", scope_lines)):
        if _val is not None:
            if _val < 0:
                print(f"ERROR: --{_name.replace('_', '-')} 需非負整數,收到 {_val}", file=sys.stderr)
                return 2
            rec[_name] = _val
    if scope_lines is not None and scope_lines > _CANARY_SCOPE_SOFT_CAP_LINES:
        rec["scope_oversize"] = True
        print(f"⚠ 本輪被審材料 {scope_lines} 行,超過軟上限 {_CANARY_SCOPE_SOFT_CAP_LINES} 行"
              f"(≈30K token,context rot 的已發表退化起點是 32K)。", file=sys.stderr)
        print("  已在帳上標記 scope_oversize。★這一輪的 caught 是弱證據★——"
              "審查員可能是「看不完」而不是「沒問題」;收斂宣稱請講小,下一輪拆開審。", file=sys.stderr)
    # ── M1包 #1 tier 定錨欄(選配;loop next/gate 讀首個帶 tier 記錄定錨) ──
    if tier is not None:
        if tier not in LOOP_TIERS:
            print(f"ERROR: --tier 需 {'/'.join(LOOP_TIERS)},收到 {tier!r}", file=sys.stderr)
            return 2
        rec["tier"] = tier
    # ── T1 相容雙讀(design-loop重設計 實作計畫):處置帳六選配欄——★全部不給=行為與今日相同★ ──
    # 集合核對而非總數核對(r1 Codex:只核總數可被重複計數/虛構項配平);
    # 「不給不寫鍵」同 --findings 慣例;違反一律 rc2(寫側就擋,不留到 gate)。
    def _ids(raw):   # None=未給;""=明示空集合(兩者語意不同)
        return None if raw is None else [x.strip() for x in raw.split(",") if x.strip()]
    f_set, fo_set, ac_set = _ids(findings_set), _ids(folded_set), _ids(accepted_set)
    if any(x is not None for x in (fo_set, ac_set, accept_reasons)) and f_set is None:
        print("ERROR: --folded-set/--accepted-set/--accept-reason 須與 --findings-set 同現", file=sys.stderr)
        return 2
    if f_set is not None:
        if not f_set:
            print("ERROR: --findings-set 不得為空(沒 findings 就別帶處置欄)", file=sys.stderr)
            return 2
        if len(set(f_set)) != len(f_set):
            print(f"ERROR: --findings-set 含重複 id: {f_set}", file=sys.stderr)
            return 2
        fo, ac = fo_set or [], ac_set or []
        F, FO, AC = set(f_set), set(fo), set(ac)
        if not FO <= F or not AC <= F:
            print("ERROR: folded/accepted 含 findings-set 以外的 id", file=sys.stderr)
            return 2
        if FO & AC:
            print(f"ERROR: folded 與 accepted 互斥,交集非空: {sorted(FO & AC)}", file=sys.stderr)
            return 2
        if FO | AC != F:
            print(f"ERROR: 未處置的 finding: {sorted(F - FO - AC)}(folded∪accepted 必須=findings-set;"
                  "每一條都要有去向)", file=sys.stderr)
            return 2
        reasons = {}
        for item in (accept_reasons or []):
            if "=" not in item:
                print(f"ERROR: --accept-reason 格式須 id=理由,收到 {item!r}", file=sys.stderr)
                return 2
            k, _, v = item.partition("=")
            reasons[k.strip()] = v.strip()
        if set(reasons) != AC or any(not v for v in reasons.values()):
            print(f"ERROR: accept_reasons 鍵集合須=accepted-set 且理由非空(accepted={sorted(AC)},"
                  f" 有理由={sorted(reasons)})", file=sys.stderr)
            return 2
        if severity == "blocker" and AC:
            print("ERROR: blocker 輪 accepted 必須為空——blocker 只能折不能放行(重設計 d1)", file=sys.stderr)
            return 2
        rec["findings_set"], rec["folded_set"], rec["accepted_set"] = f_set, fo, ac
        if reasons:
            rec["accept_reasons"] = reasons
    for _flag, _p in (("--report", report), ("--snapshot", snapshot)):
        if _p is None:
            continue
        try:
            _h = _sha256_file(_p)
        except OSError as e:
            print(f"ERROR: {_flag} 讀不到: {e}", file=sys.stderr)
            return 2
        import os as _os
        if _os.path.getsize(_p) == 0:
            print(f"ERROR: {_flag} 是空檔——留痕的最低要求是非空({_p})", file=sys.stderr)
            return 2
        _k = "report" if _flag == "--report" else "snapshot"
        # [r1 終審修+r2 修] 落帳路徑正規化:repo root 底下存相對路徑、之外存絕對——
        # 原樣存呼叫者字串=相對 cwd,換目錄跑 gate 留痕假失蹤(合法 loop 永久 FAIL)。
        # root 判定=_vault_repo_root(向上找 .git;r2 否決席:vault.parent 在 docs/ 兩層
        # 布局=docs/ 非 repo root,governance/ 留痕永遠落絕對路徑,可攜性假賣點)。
        _pr = Path(_p).resolve()
        try:
            _stored = str(_pr.relative_to(_vault_repo_root(env)))
        except ValueError:
            _stored = str(_pr)
        rec[_k + "_path"], rec[_k + "_sha256"] = _stored, _h
    path = env.vault.parent / ".canary-log.jsonl"
    # ── T6 收緊(design-loop重設計 實作計畫):disposal 定錨後留痕轉強制 ──
    # 定錨=該 loop 帳面已有任一筆帶 findings_set(同 M2 cluster「首個有效輪定錨」前例)。
    # 定錨後每筆 record 必帶 report+snapshot;未定錨/舊 loop 完全不受影響(相容鐵則)。
    if loop and path.exists() and not (report and snapshot):
        _anchored = False
        try:
            import json as _json6
            # [r1 終審修] 逐行容錯:壞行只跳該行——原整包 try 被 any() 短路順序玩死
            # (壞行排在定錨行前→先炸→整包 fail-open,T6 強制被繞過;4 席重疊 finding)。
            # 殘餘天花板:定錨行★自己★損毀仍偵測不到(讀側 disposal 閘壞行 rc2 兜底)。
            for _l in path.read_text(encoding="utf-8").splitlines():
                if not _l.strip():
                    continue
                try:
                    _d6 = _json6.loads(_l)
                except ValueError:
                    continue
                if _d6.get("loop") == loop and "findings_set" in _d6:
                    _anchored = True
                    break
        except OSError:
            _anchored = False   # 整檔讀不到=環境層問題,寫側不因此誤擋
        if _anchored:
            print(f"ERROR: loop {loop!r} 已定錨為 disposal loop(帳面有 findings_set 記錄)——"
                  "後續 record 必帶 --report 與 --snapshot(留痕強制;T6)", file=sys.stderr)
            return 2
    rc = _jsonl_append_verified(path, rec, "token", token)
    if rc != 0:
        return rc
    print(f"✓ canary {kind} 留痕: {token}" + (f" (auditor={auditor})" if auditor else "")
          + f" → {path.resolve()}")
    return 0


def _jsonl_append_verified(path, rec, key_field, key_value):
    """[S1 oracle品質包] append 一行 JSONL + 讀回自驗(成功宣稱與證據綁死)。
    caller 給唯一鍵欄名與值——不寫死欄名(record 用 token、second 用自身 token)。
    寫入 OSError → rc2(既有訊息);寫成功但重開檔讀不回該鍵 → rc2「落盤自驗失敗」。
    出身:2026-07-28 record 回報成功未落盤事故([[Issues/canary-record未落盤事件]])。"""
    import json
    try:
        with open(path, "a", encoding="utf-8") as f:
            f.write(json.dumps(rec, ensure_ascii=False) + "\n")
    except OSError as e:
        print(f"ERROR: 寫入 {path} 失敗: {e}", file=sys.stderr)
        return 2
    try:
        with open(path, encoding="utf-8", errors="replace") as f:   # 獨立重開檔(非同 fd)
            for line in f:
                if not line.strip():
                    continue
                try:
                    d = json.loads(line)
                except ValueError:
                    continue
                if isinstance(d, dict) and d.get(key_field) == key_value:
                    return 0
    except (OSError, ValueError) as e:
        print(f"canary record: 落盤自驗失敗({path.resolve()}): 讀回失敗 {e}", file=sys.stderr)
        return 2
    print(f"canary record: 落盤自驗失敗({path.resolve()}): 寫入回報成功但讀不回該筆",
          file=sys.stderr)
    return 2


def cmd_canary_second(env, ref_id=None, verdict=None, auditor=None, note=None):
    """[S2 oracle品質包] canary 判定的第二判者留痕(抽樣分權,telemetry-only)。
    走 [S1] 同一自驗 helper(唯一鍵=自身新 token);loop status 天然忽略(second 行無 loop 欄)。
    天花板:第二判者仍是 LLM,只壓「植入者=唯一判定者」的單點,不證判定為真。"""
    import json
    import datetime
    import secrets
    if not ref_id or not verdict:
        print("ERROR: canary second 需 --id 與 --verdict", file=sys.stderr)
        return 2
    if verdict not in ("agree", "overturn"):
        print(f"ERROR: --verdict 僅收 agree/overturn,收到 {verdict!r}", file=sys.stderr)
        return 2
    if not auditor:
        print("ERROR: canary second 需 --auditor(分權紀錄無名則失義)", file=sys.stderr)
        return 2
    path = env.vault.parent / ".canary-log.jsonl"
    found = False
    orig_auditor = ""
    try:
        with open(path, encoding="utf-8", errors="replace") as f:   # 半截多位元組行不炸(替代字元)
            for line in f:
                if not line.strip():
                    continue
                try:
                    d = json.loads(line)
                except ValueError:
                    continue
                if isinstance(d, dict) and d.get("token") == ref_id and d.get("kind") != "second":
                    found = True
                    orig_auditor = (d.get("auditor") or "").strip()
                    break
    except OSError as e:
        print(f"ERROR: 讀不到 canary log {path}: {e}", file=sys.stderr)
        return 2
    if not found:
        print(f"ERROR: --id {ref_id} 不在 canary log(無原判可覆核)", file=sys.stderr)
        return 2
    if orig_auditor and orig_auditor.strip().lower() == auditor.strip().lower():
        # 分權的核心:同一判者自覆核=沒有第二個人,字面擊穿 S2(2026-07-29 終審 Codex)
        print(f"ERROR: --auditor 與原判者相同({orig_auditor})——第二判者須為不同判者(分權)",
              file=sys.stderr)
        return 2
    token = "CANARY-" + secrets.token_hex(4)
    rec = {"ts": datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
           "kind": "second", "token": token, "ref": ref_id, "verdict": verdict,
           "auditor": auditor, "note": note or ""}
    rc = _jsonl_append_verified(path, rec, "token", token)
    if rc != 0:
        return rc
    print(f"✓ canary second 留痕: {token} (ref={ref_id} verdict={verdict} auditor={auditor})"
          f" → {path.resolve()}")
    return 0


def _capture_counts_from_finders(finders):
    """異質 panel 接線(code-loop 三輪壓縮):把多個 finder 各自找到的 finding-key
    彙成 capture-recapture 輸入。code-loop 的 finder 是**異質**的——LLM reviewer、
    `.lumos/lint.json` SARIF linter、測試失敗、mutation 存活——各是一組 finding-key;
    確定性工具的錯誤剖面與 LLM 正交=真獨立票(直擊「9 judge 2 票」相關性天花板)。

    參數:finders = [[key,...], [key,...], ...],每個子 list = 一個 finder 找到的 key。
    回傳:各 distinct key「被幾個 finder 找到」的次數列表(降序,決定性)——
    直接餵 _estimate_remaining_defects 算殘餘。
    正規化:key strip+casefold(容忍大小寫/前後空白差異);同一 finder 內去重(重複只算一次)。"""
    from collections import Counter
    counter = Counter()
    for finder in finders:
        seen = set()
        for k in finder:
            nk = str(k).strip().casefold()
            if nk and nk not in seen:
                seen.add(nk)
                counter[nk] += 1
    return sorted(counter.values(), reverse=True)


def _cc_ints(cc):
    """capture_counts 型別守衛(2026-08-14 code-loop r1 s2 席):回純 int list,壞型回 None。
    非 list/元素非 int/bool 混入(bool 是 int 子類,isinstance 擋不住)一律判壞型——
    這些餵進 _estimate_remaining_defects 不炸、靜默算出假 0.0(最強假收斂訊號),
    所以所有讀側呼叫點統一過這裡,壞型明示、不得靜默算。"""
    if not isinstance(cc, list):
        return None
    if any(not isinstance(x, int) or isinstance(x, bool) for x in cc):
        return None
    return cc


def _estimate_remaining_defects(capture_counts):
    """capture-recapture 殘餘缺陷估計(Chao1 偏差修正版)。

    平行 panel 的收斂結構信號(loop 三輪壓縮):W 個獨立審計員讀同稿,
    `capture_counts` = 各 distinct 缺陷「被幾個審計員找到」的次數列表。
    從「只被 1 人找到(f1)」與「恰被 2 人找到(f2)」的比例估未找到的殘餘缺陷:
        remaining ≈ f1*(f1-1) / (2*(f2+1))   # 偏差修正,f2=0 不 div0
    高重疊(f1 小)→ 母體枯竭 → 殘餘≈0 → 收斂;低重疊(f1 大)→ 殘餘大 → 續跑。
    誠實天花板:小樣本估計會出極端值,當一個收斂信號、非 oracle(見設計節點)。"""
    if not capture_counts:
        return 0.0
    f1 = sum(1 for c in capture_counts if c == 1)
    f2 = sum(1 for c in capture_counts if c == 2)
    return f1 * (f1 - 1) / (2 * (f2 + 1))


def _round_valid_m2(recs):
    """M2 統一單位謂詞(有效輪):(caught+none)≥2 ∧ missed=0 ∧ 全部 kind ∈ 白名單。
    gate/fold/定錨/ledger/W 歸屬五處共用——嚴禁記錄級判定(2caught+1missed 輪的
    clusters 掛 caught 記錄上也不得採納);未知 kind 使輪無效(既有 2303 謂詞對此是盲的)。
    kind=none(2026-08-14 協議停用,Systems/canary-audit d5)=無植入輪,計入席數。"""
    kinds = [r.get("kind") for r in recs]
    if any(k not in ("caught", "missed", "none") for k in kinds):
        return False
    return (kinds.count("caught") + kinds.count("none")) >= 2 and kinds.count("missed") == 0


def _panel_extra_checks(latest, min_seats, spec):
    """M1包 判定輪加驗(code-loop 補審 r1 折入:cluster 與無-cluster 兩路皆須過,不得繞):
    min-seats 數相異非空 auditor(同席灌筆/空席不計)+ G3 hash(帶 --spec=聲明要驗)。回 fails 片段。"""
    fails = []
    if min_seats:
        seats = len({a for r in latest if (a := r.get("auditor"))})
        if seats < min_seats:
            print(f"[panel] min-seats: ✗ — 席數不足({min_seats} 席制僅 {seats} 相異席;同席重複/空席不計)")
            fails.append("席數不足")
        else:
            print(f"[panel] min-seats: ✓ — {seats} 相異席 ≥ {min_seats}")
    if spec is not None:
        err, info = _hash_chain_check([latest], spec)   # OSError 上拋至 cmd_loop_status 統一 rc2
        if err:
            print(f"[panel] G3 hash: ✗ — {err}")
            fails.append("G3")
        elif info == "unbound":
            print("[panel] G3 hash: ✗ — 判定輪未綁 spec hash(帶 --spec 即要求驗證)")
            fails.append("G3")
        else:
            print(f"[panel] G3 hash: ✓ — {info}(同輪雙欄一致∧末 result=當前檔)")
    return fails


def _panel_k2_active(rounds):
    """[A案 2026-08-05] K=2 適用判定:loop 首筆 ts 日期 ≥ cutoff(預設 2026-08-06)→新制。
    舊帳不回溯(spec 落地面5,借 T6 定錨慣例);env LUMOS_PANEL_K2_CUTOFF 供測試/緊急覆寫。"""
    import os
    cutoff = os.environ.get("LUMOS_PANEL_K2_CUTOFF", "2026-08-06")
    ts = str((rounds[0] if rounds else {}).get("ts") or "")
    return ts[:10] >= cutoff


def _panel_round_conjuncts(recs, quiet=False):
    """單輪兩條合取(輪有效∧存活≤minor;capture-recapture 殘餘=advisory 觀測,2026-08-14 降級)——A案 K=2 抽出共用,
    ★單一實作★:判定輪(quiet=False,輸出逐字同改動前)與 K=2 前一輪(quiet=True)同函式。
    回 fails list。"""
    order = {"clean": 0, "minor": 1, "major": 2, "blocker": 3}
    fails = []
    caught_recs = [r for r in recs if r.get("kind") == "caught"]
    # 2026-08-14 canary 協議停用(Systems/canary-audit d5):kind=none=無植入輪的純處置帳載體。
    # none 制輪有效=記帳席數≥2 且零 missed(醒著證明改由 skill 層 quote-check 引句錨定機械把關);
    # 舊 caught 分支原樣保留(歷史帳/混用輪回放不變)。
    none_recs = [r for r in recs if r.get("kind") == "none"]
    caught = len(caught_recs)
    missed = sum(1 for r in recs if r.get("kind") == "missed")
    if none_recs and missed == 0 and (caught + len(none_recs)) >= 2:
        if not quiet:
            print(f"[panel] 輪有效(no-canary 制,記帳席 {caught + len(none_recs)}): ✓")
    elif caught >= 2 and missed == 0:
        if not quiet:
            print(f"[panel] 輪有效(canary caught {caught}/{caught},near-perfect): ✓")
    elif missed > 0:
        if not quiet:
            print(f"[panel] 輪有效: ✗ — {missed} missed(near-perfect 要求全 caught;中段分數弱訊號不背書收斂)")
        fails.append("輪無效")
    else:
        if not quiet:
            print(f"[panel] 輪有效: ✗ — 記帳席不足(caught {caught}+none {len(none_recs)} <2,輪無效)")
        fails.append("輪無效")
    # 嚴重度合取讀 caught+none(none 輪不讀會盲掉存活 findings——停用制下全輪都是 none)
    maxsev = max((order.get(r.get("severity", "clean"), 1) for r in caught_recs + none_recs), default=0)
    if maxsev >= 2:
        if not quiet:
            print(f"[panel] falsification+ODC(存活 max≤minor): ✗ — 存活 {'blocker' if maxsev==3 else 'major'}")
        fails.append("存活≥major")
    else:
        if not quiet:
            print("[panel] falsification+ODC(存活 max≤minor): ✓")
    # capture-recapture 殘餘:★2026-08-14 降 advisory,不進合取★(Projects/收斂閘殘餘估計降級_計劃 S1/S2)
    # 理由=鑑別力≈0(殘餘<1 組下輪 major+ 67% vs ≥1 對照組 79%,p≈0.25)+f1≤1 公式退化+席獨立前提被自家
    # 重疊分布(64-71% 單席獨佔)否定;舊「殘餘超門檻」「無capture_counts」兩條 fails 撤除。
    cc = next((r["capture_counts"] for r in recs if r.get("capture_counts")), None)
    if cc is None:
        if not quiet:
            print("[panel] capture-recapture 殘餘(advisory,不進合取): 無 capture_counts,殘餘觀測缺席")
    else:
        ccl = _cc_ints(cc)   # r1 s2:三個讀側呼叫點統一過型別守衛,壞型不得靜默算假 0.0
        if ccl is None:
            if not quiet:
                print("[panel] capture-recapture 殘餘(advisory,不進合取): 壞型(counts 非 int list),不算")
        else:
            remaining = _estimate_remaining_defects(ccl)
            if not quiet:
                note = "⚠ 低殘餘讀數無鑑別力(自帳對照 67% vs 79%,2026-08-14)" if remaining < 1.0 else ""
                print(f"[panel] capture-recapture 殘餘(advisory,不進合取): 估計 {remaining:.2f} {note}".rstrip())
    return fails


def _panel_probe_verdict(loop_id, rid, recs):
    """[A案 e'] 決定性抽查判定:sha256(loop_id+判定輪 rid+該輪 token 排序串)%2==0 → 應抽。
    輸入全部來自 append-only 帳(token=record 時 secrets 自動鑄造)——任何人可事後重算
    「該不該抽」,不依賴編排者誠實(r1 折入:原「編排者擲 p」嚇阻不成立)。"""
    import hashlib
    toks = ",".join(sorted(str(r.get("token") or "") for r in recs))
    h = int(hashlib.sha256(f"{loop_id}:{rid}:{toks}".encode("utf-8")).hexdigest(), 16)
    return h % 2 == 0


def _loop_status_panel(rounds, loop_id, min_seats=None, spec=None):
    """平行 panel 收斂謂詞(loop 三輪壓縮)。無-cluster 帳:兩條合取(輪有效∧存活max≤minor;殘餘=advisory
    ∧capture-recapture 殘餘,fail-closed)。cluster 帳(M2,設計 Projects/design-loop提效_計劃;
    golden: governance/golden/dloop-m2-cluster):首個有效輪帶 clusters 定錨 → 兩條合取
    (輪有效∧fold 後無 disputed-major),新生 cluster/capture-recapture 降 advisory,
    無效輪 clusters 忽略+警告區列帳(不蒸發)。讀側 rc2 類:round-id 非連續/型別損壞/
    有效輪 W 歸屬衝突/有效輪級混用。"""
    from collections import OrderedDict
    groups = OrderedDict()
    for r in rounds:
        rid_ = r.get("round")
        if rid_ in groups and next(reversed(groups)) != rid_:
            # M2:round-id 被其他 round 隔開後重現=帳本次序損壞(append-only 不容跳寫)
            print(f"ERROR: round-id {rid_!r} 非連續重現(被其他輪隔開;append-only 帳次序損壞)",
                  file=sys.stderr)
            return 2
        groups.setdefault(rid_, []).append(r)
    if not groups:
        print(f"⏳ 無 panel 輪記錄 ({loop_id})")
        return 1
    # ── M2 讀側型別防禦:clusters 欄必須是 dict[str,str](寫側轉型慣例;手改/損壞 → rc2 非 traceback)
    for r in rounds:
        if "clusters" in r:
            c = r["clusters"]
            if (not isinstance(c, dict)
                    or any(not isinstance(k, str) or not isinstance(v, str) for k, v in c.items())):
                print(f"ERROR: 記錄 clusters 欄非 dict{{名:狀態}} 結構(損壞/手改 JSONL?): {c!r}",
                      file=sys.stderr)
                return 2
    valid_of = {rid_: _round_valid_m2(recs) for rid_, recs in groups.items()}
    # ── M2 W 歸屬:有效輪同輪 >1 筆帶 clusters → rc2(無效輪多筆帶=豁免,列警告區)
    for rid_, recs in groups.items():
        if valid_of[rid_] and sum(1 for r in recs if "clusters" in r) > 1:
            print(f"ERROR: 輪 {rid_} 有 {sum(1 for r in recs if 'clusters' in r)} 筆記錄帶 clusters"
                  f"(每輪至多一筆;衝突不靜默取第一筆)", file=sys.stderr)
            return 2
    # ── M2 定錨:第一個有效輪定模式(無效輪不定錨——首輪全 missed 的新 loop 不得鎖死)
    anchor_rid, anchor_cluster = None, False
    for rid_, recs in groups.items():
        if valid_of[rid_]:
            anchor_rid = rid_
            anchor_cluster = any("clusters" in r for r in recs)
            break
    if anchor_rid is not None:
        # 有效輪級混用守衛(無效輪豁免:帶或不帶皆不觸發)
        for rid_, recs in groups.items():
            if not valid_of[rid_]:
                continue
            has_c = any("clusters" in r for r in recs)
            if anchor_cluster and not has_c:
                print(f"ERROR: 本 loop 已定錨 cluster 帳(定錨輪 {anchor_rid}),有效輪 {rid_} 未帶"
                      f" clusters(半帶);補該輪 cluster 記錄或開新 loop id", file=sys.stderr)
                return 2
            if not anchor_cluster and has_c:
                print(f"ERROR: 本 loop 已定錨無-cluster 模式(定錨輪 {anchor_rid}),有效輪 {rid_} 帶了"
                      f" clusters;要用 cluster 帳請開新 loop id(不升級既有 loop)", file=sys.stderr)
                return 2
    if anchor_rid is not None and anchor_cluster:
        return _loop_status_panel_clusters(groups, valid_of, loop_id,
                                           min_seats=min_seats, spec=spec, all_rounds=rounds)
    # ── 無-cluster 舊帳(或零有效輪=未定錨):既有三條合取,fail-closed 不變 ──
    # cluster-intent 但未定錨(零有效輪):條 1 改用 M2 嚴格謂詞(unknown-kind 盲區補;
    # 純無-cluster loop 不受影響——舊行為迴歸保證只對真 legacy 帳)
    _cluster_intent = any("clusters" in r for r in rounds)
    rid, latest = next(reversed(groups.items()))
    if _cluster_intent and not valid_of[rid]:
        print(f"[panel] 輪有效: ✗ — cluster-intent loop 判定輪 {rid} 無效(M2 謂詞:caught≥2∧missed=0∧kind 白名單)")
        for i, r in enumerate(latest, 1):
            print(f"  {rid}.{i}\t{r.get('kind','?')}\t{r.get('severity','-')}\t{r.get('auditor','')}")
        print(f"⛔ PANEL GATE FAIL ({loop_id} 輪 {rid}: 輪無效[未定錨 cluster-intent])")
        return 1
    fails = _panel_round_conjuncts(latest)   # A案:三條合取抽出共用(輸出逐字同改動前)
    # [A案 2026-08-05] K=2:cutoff 起的新 loop,收斂需最後★兩★輪各自過三條合取
    # (AEGIS 非單調序列+relmainnet 既遂實例;design-loop r1+r2 收斂裁定)。舊帳不回溯。
    k2 = _panel_k2_active(rounds)
    if k2 and not fails:
        rids = list(groups)
        if len(rids) < 2:
            print("[panel] K=2 前一輪: ✗ — 僅一輪(K=2 需連續兩個乾淨輪;第二輪材料全量)")
            fails.append("K=2需第二輪")
        else:
            prev_rid = rids[-2]
            prev_fails = _panel_round_conjuncts(groups[prev_rid], quiet=True)
            if prev_fails:
                print(f"[panel] K=2 前一輪({prev_rid}): ✗ — {'/'.join(prev_fails)}")
                fails.append("K=2前一輪未乾淨")
            else:
                # 前一輪殘餘觀測行內附值(S2:quiet 路徑不重印整段,但 K=2 為新 loop 預設,
                # 不附值則前一輪殘餘觀測在常態下整段消音——r1 邊界席 P8)
                pcc = next((r["capture_counts"] for r in groups[prev_rid] if r.get("capture_counts")), None)
                pccl = _cc_ints(pcc) if pcc is not None else None
                if pcc is None:
                    obs = "殘餘 obs 缺席"
                elif pccl is None:
                    obs = "殘餘 obs 壞型(counts 非 int list)"   # r1 s2:同守衛,壞型不印假值
                else:
                    obs = f"殘餘 obs {_estimate_remaining_defects(pccl):.2f}"
                print(f"[panel] K=2 前一輪({prev_rid}): ✓ ({obs})")
    fails += _panel_extra_checks(latest, min_seats, spec)
    for i, r in enumerate(latest, 1):
        print(f"  {rid}.{i}\t{r.get('kind','?')}\t{r.get('severity','-')}\t{r.get('capture_counts','-')}\t{r.get('auditor','')}")
    for line in _cost_summary(rounds):
        print(line)
    if fails:
        print(f"⛔ PANEL GATE FAIL ({loop_id} 輪 {rid}: {'/'.join(fails)})")
        return 1
    if k2:
        probe = _panel_probe_verdict(loop_id, rid, latest)
        print(f"✅ PANEL GATE PASS ({loop_id} 輪 {rid}: K=2 ∧ 輪有效 ∧ 存活≤minor)")
        print(f"[panel] 抽查判定(e',決定性可重算): {'★應抽查★——加開 probe-* 輪(不計 cap;冒 major 即自動撤銷收斂)' if probe else '免抽'}")
    else:
        print(f"✅ PANEL GATE PASS ({loop_id} 輪 {rid}: 輪有效 ∧ 存活≤minor)")
    return 0


def _loop_status_panel_clusters(groups, valid_of, loop_id, min_seats=None, spec=None, all_rounds=None):
    """M2 cluster 帳 gate:兩條合取(判定輪有效 ∧ fold 後無 disputed-major)。
    fold 只採有效輪(last-wins,同名跨輪最後狀態勝);無效輪 clusters 警告區列帳不蒸發;
    新生 cluster 與 capture-recapture 皆 advisory 不進合取。"""
    order = {"clean": 0, "minor": 1, "major": 2, "blocker": 3}
    rid, latest = next(reversed(groups.items()))
    fails = []
    # 條 1:判定輪(latest)有效——同一謂詞
    caught_recs = [r for r in latest if r.get("kind") == "caught"]
    n_caught, n_missed = len(caught_recs), sum(1 for r in latest if r.get("kind") == "missed")
    n_none = sum(1 for r in latest if r.get("kind") == "none")   # 停用制輪(d5)
    if valid_of[rid]:
        # 顯示與謂詞同步(終審 F4:原字面只印 caught,none 制輪印出「caught 0≥2 ✓」自相矛盾)
        if n_none:
            print(f"[panel/cluster] 條1 輪有效(no-canary 制,記帳席 {n_caught + n_none}≥2,0 missed): ✓")
        else:
            print(f"[panel/cluster] 條1 輪有效(caught {n_caught}≥2,0 missed): ✓")
    else:
        print(f"[panel/cluster] 條1 輪有效: ✗ — caught {n_caught}/none {n_none}/missed {n_missed}"
              f"(謂詞:記帳席[caught+none]≥2∧missed=0∧kind 全白名單)")
        fails.append("輪無效")
    # fold(僅有效輪,append 序 last-wins)+ ledger(首現/末更輪僅計有效輪,與 advisory 同源)
    from collections import OrderedDict as _OD
    ledger = _OD()
    for rid_, recs in groups.items():
        if not valid_of[rid_]:
            continue
        for r in recs:
            for name, state in (r.get("clusters") or {}).items():
                if name not in ledger:
                    ledger[name] = {"state": state, "first": rid_, "last": rid_}
                else:
                    ledger[name]["state"] = state
                    ledger[name]["last"] = rid_
    disputed = [n for n, e in ledger.items() if e["state"].split(":", 1)[0] == "disputed-major"]
    if disputed:
        print(f"[panel/cluster] 條2 fold 後無 disputed-major: ✗ — {len(disputed)} 個: {','.join(disputed)}")
        fails.append("存在disputed-major")
    else:
        print("[panel/cluster] 條2 fold 後無 disputed-major: ✓")
    # advisory:新生 cluster(僅基於有效輪;判定輪無效 → 不適用)
    if valid_of[rid]:
        born = [n for n, e in ledger.items() if e["first"] == rid]
        print(f"[panel/cluster] (advisory) 新生 cluster: {len(born)} 個"
              + (f": {','.join(born)}" if born else ""))
    else:
        print("[panel/cluster] (advisory) 新生 cluster: 判定輪無效,新生統計不適用")
    # advisory:capture-recapture(照算照印,不進合取;無 counts 不 fail-closed——cluster 帳接手守門)
    cc = next((r["capture_counts"] for r in latest if r.get("capture_counts")), None)
    ccl = _cc_ints(cc) if cc is not None else None   # r1 s2/s3:讀側統一型別守衛
    if cc is not None and ccl is None:
        print("[panel/cluster] (advisory) capture-recapture: 壞型(counts 非 int list),不算")
    elif ccl is not None:
        remaining = _estimate_remaining_defects(ccl)
        print(f"[panel/cluster] (advisory) capture-recapture 殘餘估計: {remaining:.2f}(不進合取)")
    else:
        print("[panel/cluster] (advisory) capture-recapture: 無 counts(advisory,不擋)")
    # 警告區:無效輪攜帶的 clusters(已忽略;資料本在 canary-log,顯示即留痕——status 唯讀)
    for rid_, recs in groups.items():
        if valid_of[rid_]:
            continue
        carried = []   # 全列:同名多筆逐條保留(dict.update 會靜默覆蓋掩掉爭議狀態)
        for r in recs:
            carried.extend((n, s) for n, s in (r.get("clusters") or {}).items())
        if carried:
            print(f"  ⚠ {rid_}(無效輪) clusters 已忽略: "
                  + ",".join(f"{n}={s}" for n, s in carried))
    # ledger 表
    if ledger:
        print("  ── cluster ledger(僅計有效輪)──")
        for n, e in ledger.items():
            print(f"  {n}\t{e['state']}\t首現 {e['first']}\t末更 {e['last']}")
    # [A案 2026-08-05] K=2(cluster 路同窗):fold 帳是累積的,故第二條件=前一輪也是有效輪
    _k2c = _panel_k2_active(all_rounds or [])
    if _k2c and not fails:
        rids_ = list(groups)
        prev_valid = len(rids_) >= 2 and valid_of.get(rids_[-2], False)
        if not prev_valid:
            print("[panel/cluster] K=2 前一輪: ✗ — " + ("僅一輪" if len(rids_) < 2 else f"前一輪 {rids_[-2]} 無效")
                  + "(K=2 需連續兩個有效輪)")
            fails.append("K=2前一輪未乾淨")
        else:
            print(f"[panel/cluster] K=2 前一輪({rids_[-2]}): ✓")
    fails += _panel_extra_checks(latest, min_seats, spec)   # M1包:cluster 路不得繞過(code-loop r1)
    for i, r in enumerate(latest, 1):
        print(f"  {rid}.{i}\t{r.get('kind','?')}\t{r.get('severity','-')}\t{r.get('auditor','')}")
    for line in _cost_summary(all_rounds or []):
        print(line)
    if fails:
        print(f"⛔ PANEL GATE FAIL ({loop_id} 輪 {rid}: {'/'.join(fails)})")
        return 1
    if _k2c:
        probe = _panel_probe_verdict(loop_id, rid, latest)
        print(f"✅ PANEL GATE PASS ({loop_id} 輪 {rid}: K=2 ∧ 輪有效 ∧ fold 後無 disputed-major"
              f"[cluster 帳,{len(ledger)} 個 cluster])")
        print(f"[panel] 抽查判定(e',決定性可重算): {'★應抽查★——加開 probe-* 輪(不計 cap;冒 major 即自動撤銷收斂)' if probe else '免抽'}")
    else:
        print(f"✅ PANEL GATE PASS ({loop_id} 輪 {rid}: 輪有效 ∧ fold 後無 disputed-major"
              f"[cluster 帳,{len(ledger)} 個 cluster])")
    return 0


def cmd_loop_capture_counts(env, finders, from_pitfalls=None, repo=None):
    """異質 panel 接線的機械生產者(code-loop 三輪壓縮):把各 finder 的 finding-key
    彙成 capture_counts + 算殘餘估計,吐出可直接餵 `canary record --capture-counts` 的逗號串。

    為什麼要機械算:重疊計數(哪個洞被幾個 finder 找到)是 capture-recapture 的核心輸入,
    人手數易錯——正是該機械化的。異質 finder 一律先正規化 key 再跨 finder 數重疊:
    LLM reviewer 的 finding、`pitfalls --diff` 的 SARIF linter 命中、測試失敗、mutation 存活,
    每個 finder 給一個 --finder(逗號分隔它找到的 key,如 file:line 或 section:nature)。
    確定性工具與 LLM 錯誤剖面正交 → 真獨立票,重疊(同洞多 finder 中)= 更強收斂信號。

    --from-pitfalls <range>:自動收割 `pitfalls --diff` 的命中成確定性 finder(免手貼)——
    按 source 分組(每個 linter driver / pitfalls 內建各自一個 finder,錯誤剖面互不相同),
    每個 finder = 該 source 命中的 `file:line` 集合,併進手動 --finder 一起算重疊。
    這關掉「手動把 linter 命中貼成 --finder」那半破口。

    finders = [comma_str, ...](每個 --finder 一項)。空/全空 → 印 0 缺陷、殘餘 0.0。"""
    parsed = [[k for k in str(fs).split(",") if k.strip()] for fs in (finders or [])]
    harvested = []
    if from_pitfalls:
        repo_root = _anchor_repo_root(repo)
        if repo_root is None:
            return 2
        data = _pitfall_diff_collect(from_pitfalls, repo_root, no_lint=False)
        if data is None:
            return 2                              # git 錯誤(壞 range 等),collect 已印
        from collections import OrderedDict
        by_source = OrderedDict()
        for c in data.get("claims", []):
            src = c.get("source") or "pitfalls-builtin"
            by_source.setdefault(src, []).append(f"{c['file']}:{c['line']}")
        for src, keys in by_source.items():
            harvested.append((src, keys))
            parsed.append(keys)
        for src, keys in harvested:
            print(f"收割 from-pitfalls finder [{src}]: {len(keys)} 命中")
    cc = _capture_counts_from_finders(parsed)
    remaining = _estimate_remaining_defects(cc)
    n_finders = len(parsed)
    n_distinct = len(cc)
    print(f"finders={n_finders} distinct-findings={n_distinct} "
          f"capture_counts={','.join(str(c) for c in cc) if cc else '(空)'}")
    print(f"remaining-estimate={remaining:.2f}  "
          "(advisory 觀測;2026-08-14 起不進收斂合取——鑑別力≈0,勿當收斂/續跑訊號)")
    if cc:
        print(f"→ canary record ... --capture-counts {','.join(str(c) for c in cc)}")
    return 0


def _hash_chain_check(rounds_list, spec_path):
    """M1包 #3 雙 hash 鏈收斂窗驗證(loop機械脊椎M1包_計劃)。
    rounds_list=[[rec,...],...] 窗內按序的「輪」列表(legacy=每筆一輪;panel=判定輪一組)。
    回 (fail_msg or None, info):fail=None 且 info='unbound' 表窗內全無 hash(呼叫端裁 FAIL/advisory)。
    驗四件:窗級 all-or-nothing(帶=雙欄俱全)/同輪雙欄各自一致/鏈續性 reviewed[k+1]==result[k]/
    窗末 result==sha256(當前檔)。窗首 reviewed 無窗內錨=已知逃逸不硬驗。"""
    def has_hash(r):
        return "reviewed_sha256" in r and "result_sha256" in r
    def half(r):
        return ("reviewed_sha256" in r) != ("result_sha256" in r)
    all_recs = [r for grp in rounds_list for r in grp]
    if any(half(r) for r in all_recs):
        return "收斂窗 hash 半帶(記錄僅有 reviewed/result 其一——雙欄必須成對)", ""
    banded = [has_hash(r) for r in all_recs]
    if not any(banded):
        return None, "unbound"
    if not all(banded):
        return "收斂窗 hash 半帶——收斂憑證無法互證(窗內任一筆帶即全體必須帶)", ""
    per_round = []   # [(reviewed, result), ...] 每輪一組
    for grp in rounds_list:
        revs = {r["reviewed_sha256"] for r in grp}
        ress = {r["result_sha256"] for r in grp}
        if len(revs) > 1 or len(ress) > 1:
            return ("同輪 hash 分裂——各席 reviewed 或 result 不一致(同輪宣稱多個版本)", "")
        per_round.append((next(iter(revs)), next(iter(ress))))
    for k in range(len(per_round) - 1):
        if per_round[k + 1][0] != per_round[k][1]:
            return (f"鏈續性斷裂——第 {k + 2} 輪 reviewed ≠ 第 {k + 1} 輪 result"
                    "(折入版本與下輪受審版本不接)", "")
    cur = _sha256_file(spec_path)   # OSError 上拋——呼叫端統一 rc2(code-loop r2:panel/light 原轉字串成 rc1,與 G1 不對稱)
    if per_round[-1][1] != cur:
        return "spec 於審計後被改動(窗末 result ≠ 當前檔),需再過一輪", ""
    return None, f"{len(per_round)} 輪鏈驗訖"


def _cost_summary(rounds):
    """M1包 #4:任一筆有成本欄時回摘要行 list,否則空(零噪音)。"""
    rows = [(i, r) for i, r in enumerate(rounds, 1)
            if "tokens" in r or "wallclock_min" in r]
    if not rows:
        return []
    out = ["成本(自報,GIGO 同 anchors):"]
    tt = tm = 0
    for i, r in rows:
        tk, mn = r.get("tokens"), r.get("wallclock_min")
        tt += tk or 0
        tm += mn or 0
        out.append(f"  #{i}: tokens={tk if tk is not None else '-'} 分鐘={mn if mn is not None else '-'}")
    out.append(f"  總計: tokens={tt} 分鐘={tm}")
    return out


_COMPRESS_PIN_RE = re.compile(
    r"★INVARIANT★|★IRREVERSIBLE★|★CHECKPOINT★|停在放行點|anchor\s*驗證|anchor\s*verify|\[PIN\]", re.I)
_COMPRESS_EVID_RE = re.compile(r"VERIFY:|✅|\[test:|^\s*TEST:", re.I)
_COMPRESS_OPEN_RE = re.compile(r"-\s*\[\s\]|TODO|BLOCKER|⏳|未結", re.I)


def cmd_loop_compress(file, as_json=False):
    """[S2] 結構化壓縮(結清式收斂_計劃,2026-07-28):長跑上下文不交通用摘要——規則式三欄:
    壓不掉白名單(★合約/停在放行點/anchor 驗證/[PIN] 口頭約定)/已驗證證據(VERIFY:/✅/[test:)/
    未結約束(checkbox/TODO/BLOCKER)。白名單行在輸出**必存在**(治 governance decay 殘餘面:
    對話中途口頭約定寫成 [PIN] 行即壓不掉);無標記散文可丟。零模型、純規則,輸出走 stdout
    (落檔權在消費者——orchestrator 自行重導)。rc0 成功/rc2 檔不可讀。"""
    import json
    try:
        lines = Path(file).read_text(encoding="utf-8-sig").splitlines()
    except OSError as e:
        print(f"ERROR: 讀不到 {file}: {e}", file=sys.stderr)
        return 2
    pinned, evidence, open_items = [], [], []
    for ln in lines:
        s = ln.strip()
        if not s:
            continue
        if _COMPRESS_PIN_RE.search(s):
            pinned.append(s)
        elif _COMPRESS_EVID_RE.search(s):
            evidence.append(s)
        elif _COMPRESS_OPEN_RE.search(s):
            open_items.append(s)
    if as_json:
        print(json.dumps({"pinned": pinned, "evidence": evidence, "open": open_items,
                          "input_lines": len(lines)}, ensure_ascii=False, indent=1))
        return 0
    print("# 壓縮狀態(規則式;白名單壓不掉)")
    for title, bucket in (("壓不掉白名單", pinned), ("已驗證證據", evidence), ("未結約束", open_items)):
        print(f"## {title}")
        for s in bucket:
            print(f"- {s}")
    print(f"[compress] 輸入 {len(lines)} 行 → 保留 {len(pinned) + len(evidence) + len(open_items)} 行"
          f"(白名單 {len(pinned)}/證據 {len(evidence)}/未結 {len(open_items)})")
    return 0


def cmd_loop_canary_stats(env, loop_id=None):
    """[d4 承諾的讀取面,2026-08-05] 跨輪 canary 累積帳彙總——寫入面(record note/caught/missed)
    T1-T7 落地後一直只能人翻 JSONL,正是「機制蓋好在等一個記得用它的人」病(全流程體檢命名)。
    席位×caught/missed×尾端連續 missed streak;streak≥2 印升級提示(「連 2 missed 升 opus」
    規則的機械眼——原靠編排者記得)。純唯讀觀測恆 rc0;壞行跳過並註記(不進任何 gate)。"""
    import json
    from collections import OrderedDict
    path = env.vault.parent / ".canary-log.jsonl"
    if not path.exists():
        print("⏳ 無 canary 帳")
        return 0
    per_loop = OrderedDict()   # loop -> OrderedDict(auditor -> {"caught":n,"missed":n,"streak":n})
    none_per_loop = {}         # loop -> n(kind=none 輪;停用制計數,不入 caught/missed 統計)
    overlap = {}               # loop -> {"counts":[int...合併], "badtype":n}(S3 重疊分布;讀全部 kind 含 none)
    n_bad = 0

    def _harvest_overlap(lp, d):
        # S3(2026-08-14,收斂閘殘餘估計降級 S3):跨輪分布合併(各輪母體獨立,彙總為分布統計非去重)。
        # 型別防禦(r1 邊界席 P7 實跑實證):非 list(如字串 "3,2,1")靜默進 _estimate 會算出假 0.0,
        # 必須計壞型明示跳過,不得靜默算。
        cc = d.get("capture_counts")
        if cc is None or not lp:
            return
        o = overlap.setdefault(lp, {"counts": [], "badtype": 0})
        ccl = _cc_ints(cc)   # r1 s2 F1:bool 是 int 子類,守衛統一在 _cc_ints 排除
        if ccl is not None:
            o["counts"].extend(ccl)
        else:
            o["badtype"] += 1
    try:
        for line in path.read_text(encoding="utf-8").splitlines():
            line = line.strip()
            if not line:
                continue
            try:
                d = json.loads(line)
            except ValueError:
                n_bad += 1
                continue
            lp = d.get("loop")
            kind = d.get("kind")
            _harvest_overlap(lp, d)
            # 協議停用(2026-08-14 d5):kind=none 不入 caught/missed 統計(無植入無此語意),
            # 但要計數——否則停用制 loop 在這裡回報「無記錄」,誤讀成什麼都沒發生
            # (2026-08-14 終審 F1:本報表是文檔點名的「升級提示機械眼」,不可靜默瞎掉)。
            if kind == "none" and lp:
                none_per_loop[lp] = none_per_loop.get(lp, 0) + 1
                continue
            if not lp or kind not in ("caught", "missed"):
                continue
            aud = d.get("auditor") or "(無席名)"
            seats = per_loop.setdefault(lp, OrderedDict())
            st = seats.setdefault(aud, {"caught": 0, "missed": 0, "streak": 0})
            st[kind] += 1
            st["streak"] = st["streak"] + 1 if kind == "missed" else 0   # 尾端連續 missed(append 序)
    except OSError as e:
        print(f"ERROR: 讀 {path} 失敗: {e}", file=sys.stderr)
        return 2
    def _print_overlap(lp):
        # S3 席位重疊分布(跨輪分布合併;席名=auditor 欄原文、鏡頭層不在帳內——誠實界線)
        o = overlap.get(lp)
        bad = f";壞型 {o['badtype']} 筆(counts 非 int list,已跳過不計)" if o and o["badtype"] else ""
        if not o or not o["counts"]:
            reason = "全為壞型,無可計數據" if (o and o["badtype"]) else "該 loop 記錄不帶 capture_counts"
            print(f"  重疊分布: 無重疊數據({reason}){bad}")
            return
        cs = o["counts"]
        f1 = sum(1 for c in cs if c == 1)
        print(f"  重疊分布(跨輪分布合併,非同一母體去重): 相異缺陷 {len(cs)} | 僅單席抓到 "
              f"{f1}/{len(cs)}({round(100 * f1 / len(cs))}%){bad}")

    targets = [loop_id] if loop_id else list(per_loop)
    if loop_id and loop_id not in per_loop:
        if none_per_loop.get(loop_id):
            print(f"ℹ [{loop_id}] 停用制 loop:{none_per_loop[loop_id]} 輪 kind=none(無植入;"
                  "canary-stats 僅回放歷史 caught/missed 帳,升級訊號改看 quote-check——d5)")
            _print_overlap(loop_id)   # r1 整合席 P5:重疊段不得被 none-only 提前返回吃掉
        else:
            print(f"⏳ 無記錄 ({loop_id})")
        return 0
    for lp in targets:
        seats = per_loop[lp]
        tc = sum(v["caught"] for v in seats.values())
        tm = sum(v["missed"] for v in seats.values())
        rate = f"{tc}/{tc+tm}" if (tc + tm) else "0/0"
        nn = none_per_loop.get(lp, 0)
        print(f"[{lp}] caught {rate}(missed {tm})"
              + (f"  +{nn} 輪 none(停用制,不入統計)" if nn else ""))
        if loop_id:
            for aud, v in seats.items():
                tail = f"  尾端連續missed={v['streak']}" if v["streak"] else ""
                esc = "  ⚠ 連 2 missed → 升級模型(升 opus)" if v["streak"] >= 2 else ""
                print(f"  {aud}\tcaught {v['caught']}\tmissed {v['missed']}{tail}{esc}")
            _print_overlap(lp)   # S3:指定 loop 查詢時附重疊分布
    # D 前置:型別×探針×caught 表(帶 canary_type 的記錄才入列;attr 攢滿 15 筆=D 本體開工條件)
    # S2 回溯層(2026-08-06,plan:驗證層自證三件):型別來源如實分層——attr(結構化欄位)/
    # note(散文 type=X regex fallback,慣例寫法覆蓋率有限)/unknown(無任何線索,不硬猜)。
    # 覆蓋率即時計算(該 plan r2 折入:寫死數字會被自己的新記錄打臉);D 案 15 筆條件只認 attr。
    import re as _re
    typed = {}
    n_attr = n_note = n_unknown = 0
    try:
        for line in path.read_text(encoding="utf-8").splitlines():
            try:
                d = json.loads(line)
            except ValueError:
                continue
            if d.get("kind") not in ("caught", "missed"):
                continue
            if loop_id and d.get("loop") != loop_id:
                continue
            ct = d.get("canary_type")
            if ct:
                n_attr += 1
                key = (ct, d.get("probe") or "-", "attr")
            else:
                m = _re.search(r"type=([a-d])\b", d.get("note") or "")
                if m:
                    n_note += 1
                    key = (m.group(1), "-", "note")
                else:
                    n_unknown += 1
                    continue
            t = typed.setdefault(key, {"caught": 0, "missed": 0})
            t[d["kind"]] += 1
    except OSError:
        pass
    if typed or n_unknown:
        total = n_attr + n_note + n_unknown
        print(f"  ── 型別×探針×caught(attr {n_attr} / note {n_note} / unknown {n_unknown} / 總 {total};"
              f"attr 攢滿 15 筆=D 案開工條件)──")
        for (ct, pb, src), v in sorted(typed.items()):
            print(f"  {ct}\tprobe={pb}\tsrc={src}\tcaught {v['caught']}\tmissed {v['missed']}")
        if n_unknown:
            print(f"  (unknown {n_unknown} 筆無型別線索,不併入任何型別——如實分層,不硬猜)")
    if n_bad:
        print(f"  (帳面 {n_bad} 行不可解析,已跳過——壞行只影響觀測完整性,不進 gate)")
    print("  ★觀測非閘:caught 只證席位醒著,不證審得夠廣(caught≠覆蓋);missed 席 findings 不作廢(d4)★")
    return 0


def cmd_loop_verify_progress(env, loop_id, settle=None, as_json=False):
    """[S3] 獨立進度驗證器(結清式收斂_計劃,2026-07-28):看不到被審材料的覆核原語——
    直讀 .canary-log.jsonl(+選配 settle 清單檔),**只吃結構欄位**(kind/severity/findings/
    auditor 存在性/hash 存在性),note/--clusters 理由字串一律丟棄(LoopTrap 散文注入面隔離)。
    fail-closed:壞行/kind 缺失=rc2。誠實天花板:結構欄位≠客觀真值(findings/severity 源頭仍是
    LLM 裁決、帳由被驗方寫)——隔離的是散文注入,不是帳本自報。輸出=結構 JSON/純事實行,
    供編排者對照自己的收斂認知,非 oracle。"""
    import json
    path = env.vault.parent / ".canary-log.jsonl"
    rounds = []
    try:
        if path.exists():
            for line in path.read_text(encoding="utf-8").splitlines():
                line = line.strip()
                if not line:
                    continue
                try:
                    d = json.loads(line)
                except ValueError:
                    print("ERROR: canary-log 含不可解析行——驗證器 fail-closed(結構完整性破損,"
                          "輪序不可信)", file=sys.stderr)
                    return 2
                if d.get("loop") == loop_id:
                    rounds.append(d)
    except OSError as e:
        print(f"ERROR: 讀 {path} 失敗: {e}", file=sys.stderr)
        return 2
    for i, r in enumerate(rounds, 1):
        if not isinstance(r.get("kind"), str):
            print(f"ERROR: 第 {i} 筆 record 缺 kind——結構欄位缺失 fail-closed", file=sys.stderr)
            return 2
    def caught_ok(r):
        # none=協議停用制無植入輪(2026-08-14 d5),與 caught 同計合格輪
        return r.get("kind") in ("caught", "none") and bool(r.get("auditor"))
    streak = 0
    for r in reversed(rounds):
        if caught_ok(r) and r.get("severity") in ("clean", "minor"):
            streak += 1
        else:
            break
    out = {
        "loop": loop_id,
        "rounds": len(rounds),
        "kinds": [r.get("kind") for r in rounds],
        "clean_streak": streak,
        "findings_trend": [r.get("findings") for r in rounds],
        "last": ({"kind": rounds[-1].get("kind"), "severity": rounds[-1].get("severity"),
                  "has_result_hash": "result_sha256" in rounds[-1]} if rounds else None),
    }
    if settle is not None:
        try:
            data = json.loads(Path(settle).read_text(encoding="utf-8-sig"))
            entries = data["entries"]
            assert isinstance(entries, list) and entries
        except (OSError, ValueError, KeyError, AssertionError) as e:
            print(f"ERROR: settle 清單檔不可讀/格式非法: {e}", file=sys.stderr)
            return 2
        def is_caught_round(n):
            return isinstance(n, int) and 1 <= n <= len(rounds) and caught_ok(rounds[n - 1])
        unsettled = 0
        for e in entries:
            status = e.get("status")
            if status == "llm-ok" and not is_caught_round(e.get("verified_in_round")):
                status = "unverified"
            if status == "unverified" or (e.get("kind") == "semantic" and status != "llm-ok"):
                unsettled += 1
        out["settle"] = {"total": len(entries), "unsettled": unsettled,
                         "settled": len(entries) - unsettled}
    if as_json:
        print(json.dumps(out, ensure_ascii=False, indent=1, sort_keys=True))
    else:
        print(f"[verify-progress] loop={loop_id} rounds={out['rounds']} clean_streak={out['clean_streak']}")
        print(f"  kinds={out['kinds']} findings={out['findings_trend']}")
        if out["last"]:
            print(f"  last={out['last']}")
        if "settle" in out:
            print(f"  settle={out['settle']}")
    return 0


def _loop_status_settle(rounds, n_badlines, loop_id, settle_path, spec, repo):
    """settle 收斂閘([S1] 結清式收斂_計劃,2026-07-28):清單全結清 ∧ G1 refcheck ∧ G3(末筆 result=現檔)。
    K-streak/G2 由「逐條存在證明」取代(G2 印 advisory 不進合取)。
    caught 輪定義收緊:kind=caught ∧ auditor 非空;否則視同 missed(貶值 llm-ok)。
    fail-closed 族:log 壞行=rc2(及於整個共用檔——壞行無法歸屬 loop);清單檔不可讀/格式非法/
    零條目/llm-ok 缺 verified_in_round=rc2;懸空輪/非 caught 輪的 llm-ok=貶值視同未結清。
    清單檔=JSON {"entries":[{id,kind:mech|semantic,claim,status,verified_in_round?,spec_sha}]}
    (零依賴家規:JSON 非 YAML——stdlib 可解)。"""
    import json
    if n_badlines:
        print(f"ERROR: canary-log 含 {n_badlines} 行不可解析——settle 輪鍵=append 序,壞行使序號位移,"
              "fail-closed 及於整個共用檔(修復或歸檔壞行後重跑)", file=sys.stderr)
        return 2
    try:
        data = json.loads(Path(settle_path).read_text(encoding="utf-8-sig"))
    except OSError as e:
        print(f"ERROR: 讀不到 --settle 清單檔 {settle_path}: {e}", file=sys.stderr)
        return 2
    except ValueError as e:
        print(f"ERROR: --settle 清單檔非合法 JSON: {e}", file=sys.stderr)
        return 2
    entries = data.get("entries") if isinstance(data, dict) else None
    if not isinstance(entries, list) or not entries:
        print("ERROR: 清單需 {\"entries\":[...]} 且至少 1 條——零條目全結清恆真=零證明,拒收",
              file=sys.stderr)
        return 2
    for i, e in enumerate(entries, 1):
        if not isinstance(e, dict) or not all(k in e for k in ("id", "kind", "status", "spec_sha")):
            print(f"ERROR: 條目 #{i} 缺必要欄(id/kind/status/spec_sha)", file=sys.stderr)
            return 2
        if e["kind"] not in ("mech", "semantic") or e["status"] not in ("unverified", "mech-ok", "llm-ok"):
            print(f"ERROR: 條目 {e.get('id')} kind/status 非法(kind=mech|semantic,"
                  "status=unverified|mech-ok|llm-ok)", file=sys.stderr)
            return 2
        if e["status"] == "llm-ok" and not isinstance(e.get("verified_in_round"), int):
            print(f"ERROR: 條目 {e.get('id')} llm-ok 缺 verified_in_round(int)——空席背書洞,schema 強制",
                  file=sys.stderr)
            return 2
    repo_root = _anchor_repo_root(repo)
    if repo_root is None:
        return 2
    try:
        cur_sha = _sha256_file(spec)
        text = Path(spec).read_text(encoding="utf-8-sig")
    except OSError as e:
        print(f"ERROR: 讀不到 --spec {spec}: {e}", file=sys.stderr)
        return 2
    fails = []
    # caught 輪(收緊定義):kind=caught|none ∧ auditor 非空;輪鍵=append 序(1-based)
    # (none=協議停用制無植入輪,2026-08-14 d5)
    def is_caught_round(n):
        if not (1 <= n <= len(rounds)):
            return False   # 懸空輪 fail-closed
        r = rounds[n - 1]
        return r.get("kind") in ("caught", "none") and bool(r.get("auditor"))
    unsettled = []
    for e in entries:
        status = e["status"]
        why = None
        if status == "llm-ok" and not is_caught_round(e["verified_in_round"]):
            status, why = "unverified", f"貶值(第 {e['verified_in_round']} 輪非 caught/懸空/空席)"
        if e["spec_sha"] != cur_sha:
            why = "spec_sha 過期(spec 已改版,重拆或確認重蓋)"
        elif status == "unverified" or (e["kind"] == "semantic" and status != "llm-ok"):
            why = why or ("語意條停 " + status + "(須 llm-ok 才結清)" if status != "unverified" else "未查證")
        if why:
            unsettled.append((e["id"], why))
    if unsettled:
        print(f"[settle] 清單全結清: ✗ — {len(unsettled)}/{len(entries)} 條未結清")
        for eid, why in unsettled:
            print(f"    {eid}: {why}")
        fails.append("清單未結清")
    else:
        print(f"[settle] 清單全結清: ✓ — {len(entries)} 條(mech-ok/llm-ok 依 kind 各就終態)")
    claims, n_missing, n_oor, _n_ok = _refcheck_scan(text, repo_root)
    bad = [c for c in claims if c["status"] in ("missing", "line_out_of_range")]
    if bad:
        print(f"[settle] G1 refcheck: ✗ — {len(bad)} 條壞宣稱")
        fails.append("G1")
    else:
        print(f"[settle] G1 refcheck: ✓ — {len(claims)} 條宣稱全 ok")
    last = rounds[-1] if rounds else None
    if last is None:
        print("[settle] G3 末筆對齊: ✗ — settle 帳零 record(fail-closed)")
        fails.append("G3")
    elif last.get("result_sha256") != cur_sha:
        print("[settle] G3 末筆對齊: ✗ — 末筆 result hash≠當前 spec(缺欄同 ✗;off-fold 改版後請重審一輪)")
        fails.append("G3")
    else:
        print("[settle] G3 末筆對齊: ✓")
    fs = [r.get("findings") for r in rounds[-3:]]
    print(f"[settle] G2(advisory,不進合取): findings 近況={fs}")
    for i, r in enumerate(rounds, 1):
        print(f"{i}\t{r.get('kind', '?')}\t{r.get('severity', '-')}\t{r.get('ts', '')}\t{r.get('note', '')}")
    if fails:
        print(f"⛔ SETTLE GATE FAIL ({loop_id}: {'/'.join(fails)})")
        return 1
    print(f"✅ SETTLE GATE PASS ({loop_id}: 清單全結清 ∧ G1 ∧ G3)")
    return 0


def cmd_loop_status(env, loop_id, need=None, gate=False, spec=None, repo=None, panel=False, light=False, min_seats=None, settle=None, disposal=False, roster=False):
    """算某設計 loop 的收斂(收斂留痕):連 K 輪『canary caught 且 severity∈{clean,minor}』。
    --gate:升級為證據閘(K-streak 為必要條件,合取 G1 refcheck 引用座標 + G2 發現枯竭);
    findings 數的源頭仍是 LLM 裁決——gate 機械化的是算術,不是數字的正確性(見設計 doc)。
    讀 .canary-log.jsonl 的 **append 序**(不 ts-sort:ts 只到秒、同秒會並列),篩 loop==id。
    tail-K 滑動窗:前面髒輪不影響、只看最後 K 筆;missed/缺 severity 視同未收斂。
    exit 0=CONVERGED / 1=未收斂(含無記錄=還沒開始)/ 2=真錯誤。
    天花板:收斂=連 K 輪醒著的審計員沒找到 blocker/major,非完整正確;severity 自報(見設計 doc)。"""
    import json
    if light and panel:
        print("ERROR: --light 與 --panel 互斥(light=單席 legacy 格式;三模式各自一條路)", file=sys.stderr)
        return 2
    explicit_need = need is not None
    if need is None:
        need = 2
    if disposal:
        # [T4 處置閘] 獨立路徑(design-loop重設計 d2/B5):與所有既有模式互斥,舊閘一行不動
        if panel or light or settle is not None or explicit_need or min_seats is not None:
            print("ERROR: --disposal 與 --panel/--light/--settle/--need/--min-seats 互斥(獨立閘路徑)",
                  file=sys.stderr)
            return 2
        if spec is None:
            print("ERROR: --disposal 需 --spec(fail-closed;G3 與留痕重驗無對象不可判)", file=sys.stderr)
            return 2
    if settle is not None:
        # [S1] rc2 互斥/前置群(fail-closed;結清式收斂_計劃 2026-07-28)
        if panel or light:
            print("ERROR: --settle 與 --panel/--light 互斥(v1 只接 legacy 路徑)", file=sys.stderr)
            return 2
        if explicit_need:
            print("ERROR: --settle 不數輪,顯式 --need 無意義(靜默忽略會誤導)——拿掉 --need", file=sys.stderr)
            return 2
        if min_seats is not None:
            print("ERROR: --settle 與 --min-seats 併用 rc2(該檢查定義在 need 窗上,settle 拔窗後無定義域;"
                  "auditor 非空職能由 caught 定義收緊承接)", file=sys.stderr)
            return 2
        if not gate:
            print("ERROR: --settle 需 --gate(fail-closed)", file=sys.stderr)
            return 2
        if spec is None:
            print("ERROR: --settle 需 --spec(條目 spec_sha 與 G3 皆比對現檔,無對象不可判)", file=sys.stderr)
            return 2
    if min_seats is not None and min_seats < 1:
        print(f"ERROR: --min-seats 需正整數,收到 {min_seats}(負/零=門檻失義;code-loop r2 折入)", file=sys.stderr)
        return 2
    need = max(1, need)
    path = env.vault.parent / ".canary-log.jsonl"
    rounds = []
    n_badlines = 0
    bad_linenos = []   # disposal rc2 訊息用:壞行可一分鐘定位修復(r2 三席異議的降噪配套)
    try:
        if path.exists():
            for _ln, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
                line = line.strip()
                if not line:
                    continue
                try:
                    d = json.loads(line)
                except ValueError:
                    n_badlines += 1   # settle fail-closed 用;legacy/panel 維持容忍(行為不變)
                    bad_linenos.append(_ln)
                    continue
                if d.get("loop") == loop_id:
                    rounds.append(d)
    except OSError as e:
        print(f"ERROR: 讀 {path} 失敗: {e}", file=sys.stderr)
        return 2

    if roster:
        # [派工編制資料化] advisory 觀測——恆在各模式分支 early-return 之前印,rc 完全不動
        try:
            _roster_observe(env, loop_id, rounds, repo)
        except Exception as e:   # 觀測絕不擋閘:任何意外只降級為警告
            print(f"[roster] ⚠ 觀測失敗(advisory,不影響判定): {e}")

    # 混用守衛(R2-F1 footgun):panel 記錄(有 round 欄)與 legacy 模式不可混用。
    # 用 all/any 而非單向 any:partial-mix(部分有 round、部分沒)也擋——否則 round-less
    # 記錄在 panel 模式會形成 None phantom 組、可能成「最新輪」偽過(review I1)。
    n_round = sum(1 for r in rounds if "round" in r)
    if panel and rounds and n_round != len(rounds):
        print("ERROR: --panel 要求本 loop 記錄全帶 round 欄(混用/legacy 記錄拒讀,防 None phantom 輪)",
              file=sys.stderr)
        return 2
    if disposal:
        # 留痕解析根:預設=寫側同源的 _vault_repo_root(對稱);顯式 --repo 覆蓋
        # (r3 s2 席:git-less 部署副本裡 .git 不在,向上找會落錯根——給使用者一條明路)
        _dsp_root = Path(repo).resolve() if repo else _vault_repo_root(env)
        return _loop_status_disposal(rounds, loop_id, spec, n_badlines, _dsp_root,
                                     bad_linenos=bad_linenos)
    if not panel and n_round > 0:
        print("ERROR: canary-log 含 round 欄(panel 記錄)卻未加 --panel——拒絕靜默把一輪 W 筆當 W 輪",
              file=sys.stderr)
        return 2
    if settle is not None:
        return _loop_status_settle(rounds, n_badlines, loop_id, settle, spec, repo)
    if panel:
        try:
            return _loop_status_panel(rounds, loop_id, min_seats=min_seats, spec=spec)
        except OSError as e:   # G3 --spec 不可讀:與 legacy G1 對稱 rc2(code-loop r2 折入)
            print(f"ERROR: 讀不到 --spec {spec}: {e}", file=sys.stderr)
            return 2

    # ── M1包 #2:light K=1 謂詞(loop機械脊椎M1包_計劃;hash 強制 fail-closed) ──
    if light:
        if spec is None:
            print("ERROR: --light 需 --spec(light hash 強制 fail-closed,無驗證對象不可判)", file=sys.stderr)
            return 2
        # ratchet 最先:任一 caught/none 筆 severity≥major → 永久 FAIL(missed 筆不觸發;
        # none=協議停用制的無植入輪——不納會使停用後 major 輪失去永久升級,閘變寬鬆)
        if any(r.get("kind") in ("caught", "none") and r.get("severity") in ("major", "blocker") for r in rounds):
            print(f"⛔ LIGHT GATE FAIL ({loop_id}: ratchet——已有 caught 輪 severity≥major,永久升 standard;"
                  "開新 panel loop id(原 id+-std 後綴)承接,乾淨輪不洗回)")
            return 1
        if not rounds:
            print(f"⏳ 無記錄 ({loop_id})")
            return 1
        last = rounds[-1]
        fails = []
        if last.get("kind") not in ("caught", "none"):
            fails.append("retryable——末輪 missed(判決不採信;light cap=2 內可重試)")
        if last.get("severity") not in ("clean", "minor"):
            fails.append(f"severity={last.get('severity')} 不在 {{clean,minor}}")
        sev, f = last.get("severity"), last.get("findings")
        if f is None or (sev == "clean" and f != 0) or (sev == "minor" and f < 1):
            fails.append(f"欄位互證矛盾:severity={sev} 與 findings={f} 不相容")
        try:
            err, info = _hash_chain_check([[last]], spec)
        except OSError as e:   # 與 legacy G1 對稱 rc2(code-loop r2 折入)
            print(f"ERROR: 讀不到 --spec {spec}: {e}", file=sys.stderr)
            return 2
        if err:
            fails.append(err)
        elif info == "unbound":
            fails.append("hash 未綁(light 強制 fail-closed:record 須帶 --spec/--reviewed)")
        if min_seats and len({a for r in [last] if (a := r.get("auditor"))}) < min_seats:
            fails.append(f"席數不足(min-seats={min_seats};空 auditor 不計席——code-loop r1 折入)")
        for line in _cost_summary(rounds):
            print(line)
        if fails:
            print(f"⛔ LIGHT GATE FAIL ({loop_id}): " + "；".join(fails))
            return 1
        print(f"✅ LIGHT GATE PASS ({loop_id}: 單席 caught∧max≤minor∧互證∧hash 鏈驗訖 K=1)")
        return 0

    def good(r):
        return r.get("kind") in ("caught", "none") and r.get("severity") in ("clean", "minor")

    converged = len(rounds) >= need and all(good(r) for r in rounds[-need:])
    streak = 0                                  # 從尾往回的連續合格數(算「還需 N」)
    for r in reversed(rounds):
        if good(r):
            streak += 1
        else:
            break
    if not gate:
        if converged:
            print(f"✅ CONVERGED ({loop_id}, 連 {need} 輪 caught+乾淨;共 {len(rounds)} 輪)")
            rc = 0
        else:
            print(f"⏳ 還需 {need - streak} 輪乾淨 ({loop_id}, 已 {len(rounds)} 輪)")
            rc = 1
        for i, r in enumerate(rounds, 1):       # 留痕:每輪一行 tab 分隔
            print(f"{i}\t{r.get('kind', '?')}\t{r.get('severity', '-')}\t{r.get('ts', '')}\t{r.get('note', '')}")
        for line in _cost_summary(rounds):
            print(line)
        return rc

    # ── 證據閘(--gate):K-streak(必要)∧ G1 refcheck(--spec 可選)∧ G2 發現枯竭 ──
    repo_root = _anchor_repo_root(repo)
    if repo_root is None:
        return 2
    fails = []
    if converged:
        print(f"[gate] K-streak(--need {need}): ✓")
    else:
        print(f"[gate] K-streak(--need {need}): ✗ — 還需 {need - streak} 輪 caught+乾淨(已 {len(rounds)} 輪)")
        fails.append("K-streak")
    if spec is None:
        print("[gate] G1 refcheck(引用座標): skipped(無 spec 對象,code-loop 情境)")
    else:
        try:
            text = Path(spec).read_text(encoding="utf-8-sig")
        except OSError as e:
            print(f"ERROR: 讀不到 --spec {spec}: {e}", file=sys.stderr)
            return 2
        claims, n_missing, n_oor, _n_ok = _refcheck_scan(text, repo_root)
        bad = [c for c in claims if c["status"] in ("missing", "line_out_of_range")]
        if bad:
            print(f"[gate] G1 refcheck(引用座標): ✗ — {len(bad)} 條壞宣稱")
            for c in bad:
                loc = f"{c['token']}:{c['line']}" if c["line"] else c["token"]
                print(f"    {loc}({c['status']})")
            fails.append("G1")
        else:
            print(f"[gate] G1 refcheck(引用座標): ✓ — {len(claims)} 條宣稱全 ok")
    tail = rounds[-need:]
    fs = [r.get("findings") for r in tail]
    g2_fail = ""
    if len(tail) < need:
        g2_fail = f"紀錄不足 {need} 輪"
    elif any(f is None for f in fs):
        g2_fail = "tail-K 有輪缺 findings 欄位(fail-closed:用 canary record --findings N 記錄)"
    else:
        for r in tail:
            sev, f = r.get("severity"), r.get("findings")
            if (sev == "clean" and f != 0) or (sev == "minor" and f < 1):
                g2_fail = f"欄位互證矛盾:severity={sev} 與 findings={f} 不相容"
                break
        if not g2_fail:
            if need == 1:
                drained = fs[-1] == 0
            else:
                mono = all(fs[i] >= fs[i + 1] for i in range(len(fs) - 1))
                drained = mono and fs[-1] <= 1 and (fs[-1] == 0 or fs[-1] < fs[-2])
            if not drained:
                g2_fail = f"findings={fs} 未枯竭(需單調不增、末輪 ≤1 且末輪=0 或末步嚴格下降)"
    if g2_fail:
        print(f"[gate] G2 發現枯竭: ✗ — {g2_fail}")
        fails.append("G2")
    else:
        print(f"[gate] G2 發現枯竭: ✓ — findings={fs}")
    if min_seats:   # legacy gate 消費;**逐輪**驗非空(code-loop r2 Codex:整窗聯集會讓「一有一空」過關)
        bad = [i for i, r in enumerate(tail, 1)
               if len({a for a in [r.get("auditor")] if a}) < min_seats]
        if bad:
            print(f"[gate] min-seats: ✗ — 窗內第 {','.join(map(str, bad))} 輪席數不足"
                  f"({min_seats} 席制;逐輪驗非空,空席不計)")
            fails.append("席數不足")
        else:
            print(f"[gate] min-seats: ✓ — 窗內 {len(tail)} 輪逐輪 ≥ {min_seats}")
    # ── M1包 #3 G3 雙 hash 鏈(帶 --spec=聲明要驗;收斂窗=tail need 筆) ──
    if spec is not None:
        try:
            err, info = _hash_chain_check([[r] for r in tail], spec)
        except OSError as e:   # 對稱 G1 rc2(code-loop r2 折入;G1 讀 text 過≠hash 讀 bytes 必過,race 窗)
            print(f"ERROR: 讀不到 --spec {spec}: {e}", file=sys.stderr)
            return 2
        if err:
            print(f"[gate] G3 hash 鏈: ✗ — {err}")
            fails.append("G3")
        elif info == "unbound":
            print("[gate] G3 hash 鏈: ✗ — 收斂窗未綁 spec hash(帶 --spec 即要求驗證;"
                  "請重審一輪並於 record 帶 --spec/--reviewed)")
            fails.append("G3")
        else:
            print(f"[gate] G3 hash 鏈: ✓ — {info}")
    for i, r in enumerate(rounds, 1):
        print(f"{i}\t{r.get('kind', '?')}\t{r.get('severity', '-')}\t{r.get('findings', '-')}\t{r.get('ts', '')}\t{r.get('note', '')}")
    for line in _cost_summary(rounds):
        print(line)
    if fails:
        print(f"⛔ GATE FAIL ({loop_id}: {'/'.join(fails)})")
        return 1
    print(f"✅ GATE PASS ({loop_id}: K-streak ∧ G1 ∧ G2 ∧ G3)")
    return 0


_TIER_PARAMS = {"light": (1, 2), "standard": (3, 3), "high": (5, 3), "legacy": (1, 6)}  # tier→(width, cap)
# ★一輪能丟多少給審查員的軟上限★(2026-08-02)
# 為什麼有這條:審查員的任務是「在 N 行裡找出那個植入的錯」,而 context rot(脈絡越長、
# 注意力越差)是已發表的實測現象——有效脈絡長度約標稱值的 60-70%,★退化在 32K token 就
# 量得到★(不必塞爆),報告的退化幅度 13.9%-85%。
# ★這條門檻★純粹★借自外部文獻,本專案自己的資料不支持它★(2026-08-02 更正,
# 原註解在此宣稱「本專案資料落在線的兩邊、方向是反的」——★那個宣稱是錯的,已撤★):
#   ① 原始觀察(code-slim-python r1/r2 大 payload 零 findings、r3-r6 小 payload 有 findings)
#      經查證★兩組審的根本不是同一份碼★(前者 bash→Python 移植,後者後來才寫的 manifest 步驟),
#      拿來比就是拿蘋果比橘子,不構成任何證據。
#   ② 之後跑了★兩次刻意設計的對照實驗★(見架構圖 [[Projects/審查規模對照實驗]] 與
#      [[Projects/審查規模對照實驗二_Landmark真缺陷]]),★都不支持「量大→漏看」★:
#      命中率沒掉。實驗二甚至 7/7 全中,撞到天花板。
#   ③ 反而浮出另一個假說:量大影響的可能不是「有沒有看到」而是★判斷的自信度★——
#      大 payload 的席位會★有把握地宣稱有缺陷的地方沒問題★(見 [[Projects/規模影響判斷力假說]],
#      3/3 大 payload 席位講反、1/1 小 payload 席位找到)。★該假說 n=4、觀察性、
#      編碼者=提出者,尚未閉合 maker≠checker,★不得據以動 gate★。
# 門檻取 1800 行 ≈ 30K token,是★借用已發表的 32K 起點取略保守整數★,不是本專案量出來的。
# 這是軟上限:超過不擋(輪已經跑完才記帳,擋也來不及),但★記進帳並要求收斂宣稱講小★。
_CANARY_SCOPE_SOFT_CAP_LINES = 1800

_CANARY_TYPES = ("a", "b", "c", "d")   # 壞交叉引用/未定義旗標/未定義欄位常數/未定義產物裸檔名


# ── 派工編制資料化(Projects/派工編制資料化_計劃):編制宣告表+對帳原語 ──
# 編制數字單源=本表(skill 散文降解說);數值逐條抄自 lumos-design-loop/lumos-code-loop SKILL 現值。
# code/standard(循序)於 2026-08-18 循序codeloop-tier錨定案補列(v1 曾因 tier↔格式守衛誤擋而不入表,守衛已修)。
_ROSTER_EXTERNAL_KEYS = ("codex", "gemini", "qwen", "gpt")
_ROSTER_CLAUDE_KEYS = ("sonnet", "opus", "haiku", "claude")


def _rseat(slot, family, occ, req, note=None):
    d = {"slot": slot, "family": family, "occupies_w": occ, "requirement": req}
    if note:
        d["note"] = note
    return d


_TIER_ROSTER = {
    ("design", "light"): {"mode": "single", "seats": [
        _rseat("通才", "claude", True, "required")]},
    ("design", "standard"): {"mode": "panel", "seats": [
        _rseat("鏡頭1", "claude", True, "required", "r1 其中一席通才(slot 命名慣例,非 lens 值域)"),
        _rseat("鏡頭2", "claude", True, "required"),
        _rseat("鏡頭3", "claude", True, "required"),
        _rseat("外家否決", "external", False, "note-if-absent")]},
    ("design", "high"): {"mode": "panel", "seats": [
        _rseat("鏡頭1", "claude", True, "required"),
        _rseat("鏡頭2", "claude", True, "required"),
        _rseat("鏡頭3", "claude", True, "required"),
        _rseat("鏡頭4", "claude", True, "required"),
        _rseat("鏡頭5", "claude", True, "required"),
        _rseat("外家否決", "external", False, "note-if-absent")]},
    ("code", "standard"): {"mode": "sequential", "seats": [
        _rseat("單reviewer", "claude", True, "required"),
        _rseat("外家否決", "external", False, "note-if-absent", "standard 退同門+留痕")]},
    ("code", "high"): {"mode": "panel", "seats": [
        _rseat("鏡頭1", "claude", True, "required"),
        _rseat("鏡頭2", "claude", True, "required"),
        _rseat("鏡頭3", "claude", True, "required"),
        _rseat("鏡頭4", "claude", True, "required"),
        _rseat("外家finder", "external", True, "required-fail-closed"),
        _rseat("外家否決", "external", False, "required-fail-closed"),
        _rseat("spec-conformance", "claude", False, "conditional", "有收斂 spec 才應派")]},
}


def _roster_kind(loop_id):
    """loop id 前綴三值判:code-(含連字號)=code;code 開頭無連字號=None(indeterminate,
    歷史帳實有 code側刪除傳播守衛/codestage);其餘=design。"""
    if loop_id.startswith("code-"):
        return "code"
    if loop_id.startswith("code"):
        return None
    return "design"


def _roster_family(auditor):
    """auditor 字串→(family, dual_hit)。lower() 子串比對;判序寫死 external 先比、先命中先贏。"""
    s = (auditor or "").lower()
    ext = any(k in s for k in _ROSTER_EXTERNAL_KEYS)
    cla = any(k in s for k in _ROSTER_CLAUDE_KEYS)
    if ext:
        return ("external", cla)
    if cla:
        return ("claude", False)
    return ("unknown", False)


def _roster_dispatch_entries(loop_dir, rid):
    """解析一輪的 rN-dispatch*.json → (auditor 串列, 跳過檔數)。三種真實形狀:
    ①dict 頂層 auditor ②dict 帶 seats 陣列 ③頂層 list;壞損 JSON 與不符形狀同一處置=跳過不計。"""
    import json as _json
    auditors, skipped = [], 0
    for f in sorted(loop_dir.glob(f"{rid}-dispatch*.json")):
        try:
            obj = _json.loads(f.read_text(encoding="utf-8"))
        except (OSError, UnicodeDecodeError, ValueError):
            print(f"[roster] ⚠ {f.name} 壞損/不符形狀,跳過不計")
            skipped += 1
            continue
        if isinstance(obj, dict) and "auditor" in obj:
            elems = [obj]
        elif isinstance(obj, dict) and isinstance(obj.get("seats"), list):
            elems = obj["seats"]
        elif isinstance(obj, list):
            elems = obj
        else:
            print(f"[roster] ⚠ {f.name} 壞損/不符形狀,跳過不計")
            skipped += 1
            continue
        for e in elems:
            a = e.get("auditor") if isinstance(e, dict) else None
            auditors.append(a if isinstance(a, str) else None)   # 非字串(數字/巢狀物)=無名席→unknown 桶,不炸整段觀測
    return auditors, skipped


def _roster_observe(env, loop_id, rounds, repo):
    """loop status --roster 觀測段(advisory 恆不影響 rc):應派(_TIER_ROSTER)vs 實派(dispatch 快照)
    逐輪分桶對帳。落點=cmd_loop_status 入口、各模式分支 early-return 之前(四模式皆吃得到)。"""
    kind = _roster_kind(loop_id)
    if kind is None:
        print(f"[roster] {loop_id}: kind 無法判定(code 開頭但非 code- 慣例),跳過對帳")
        return
    tier = next((r.get("tier") for r in rounds if r.get("tier")), None)
    print(f"[roster] {loop_id}: kind={kind}(依前綴推定) tier={tier or '無定錨'}")
    if tier is None:
        print("[roster] tier 無定錨(legacy/零記錄帳),無編制可對")
        return
    entry = _TIER_ROSTER.get((kind, tier))
    if entry is None:
        print(f"[roster] 無編制宣告(組合 {kind}/{tier} 未定義),跳過對帳")
        return
    root = Path(repo).resolve() if repo else _vault_repo_root(env)
    loop_dir = root / "governance" / "review-reports" / loop_id
    rids = []
    for r in rounds:
        rid = r.get("round")
        if rid and rid not in rids:
            rids.append(rid)
    if loop_dir.is_dir():
        import re as _re
        for f in sorted(loop_dir.glob("*-dispatch*.json")):
            m = _re.match(r"^(r\d+)-dispatch", f.name)
            if m and m.group(1) not in rids:
                rids.append(m.group(1))
    if not rids:
        print("[roster] 無輪記錄與派工快照,無可對帳")
        return
    seats = entry["seats"]
    req_c = [s for s in seats if s["requirement"] in ("required", "required-fail-closed") and s["family"] == "claude"]
    req_e = [s for s in seats if s["requirement"] in ("required", "required-fail-closed") and s["family"] == "external"]
    nia = [s for s in seats if s["requirement"] == "note-if-absent"]
    for rid in rids:
        auditors, _skipped = _roster_dispatch_entries(loop_dir, rid) if loop_dir.is_dir() else ([], 0)
        if not auditors:
            print(f"[roster] {rid}: 無派工快照可對帳(舊帳/未落)")
            continue
        fams = [(a, *_roster_family(a)) for a in auditors]
        n_c = sum(1 for _, f, _d in fams if f == "claude")
        exts = [a for a, f, _d in fams if f == "external"]
        unks = [a for a, f, _d in fams if f == "unknown"]
        duals = [a for a, _f, d in fams if d]
        hedge = f"可能缺(另有 {len(unks)} 席家族無法辨識)" if unks else "缺"
        print(f"[roster] {rid}: 實派 {len(auditors)} 席(claude {n_c}/external {len(exts)}/unknown {len(unks)})"
              f";應派 required claude {len(req_c)}+external {len(req_e)}")
        if len(exts) < len(req_e):
            fc = any(s["requirement"] == "required-fail-closed" for s in req_e)
            msg = f"[roster] {rid}: external_missing——外家桶{hedge}(實 {len(exts)}/應 {len(req_e)})"
            if fc:
                msg += ";fail-closed 紀律未滿足(轉述,不阻斷)"
            print(msg)
        if n_c < len(req_c):
            print(f"[roster] {rid}: seat_shortfall——claude 桶{hedge}(實 {n_c}/應 {len(req_c)})")
        if len(req_e) >= 2:
            from collections import Counter as _Counter
            for name, cnt in _Counter(exts).items():
                if cnt >= 2:
                    print(f"[roster] {rid}: ⚠ 外家疑似兼任({cnt} 席同名:{name})")
        if nia and not exts:
            print(f"[roster] {rid}: 單家族,收斂宣稱要講小(note-if-absent 席缺,不算 shortfall)")
        for s in seats:
            if s["requirement"] == "conditional":
                print(f"[roster] {rid}: 條件席 {s['slot']}——條件:{s.get('note', '?')}——應派與否編排者自對")
        for a in unks:
            print(f"[roster] {rid}: unknown 席列出不判定:{a}")
        for a in duals:
            print(f"[roster] {rid}: ⚠ 雙家族關鍵字命中:{a}(判序 external 先贏)")


def _roster_next_payload(loop_id, eff_tier):
    """loop next 的應派 roster:(dict|None, note|None)。legacy=單席通才慣例;
    indeterminate 與查表 miss=None+對應 note(per-command 訊息:next 無對帳可跳,不印「跳過對帳」)。"""
    kind = _roster_kind(loop_id)
    if kind is None:
        return None, "kind 無法判定(code 開頭但非 code- 慣例)"
    if eff_tier == "legacy":
        return {"mode": "single", "seats": [_rseat("通才", "claude", True, "required")]}, None
    entry = _TIER_ROSTER.get((kind, eff_tier))
    if entry is None:
        return None, f"無編制宣告(組合 {kind}/{eff_tier} 未定義)"
    return entry, None



def cmd_loop_next(env, loop_id, tier=None, as_json=False, need=2, spec=None, repo=None):
    """M1包 #1(loop機械脊椎M1包_計劃):帳本吐唯一下一動作。唯讀指針——lumos 不 spawn agent,
    編排仍是 Claude(Systems/design-loop 分工)。phase 五值:escalate/gate-pending/converged/
    cap-reached/plant-canary;判定優先序=escalate→gate-pending(資訊不足,先於 cap)→converged
    (僅 full-basis)→cap-reached→plant-canary。converged=rc0/其餘 phase=rc1/錯誤=rc2。
    tier 定錨優先:帳面首個帶 tier 記錄定錨;僅無定錨舊帳按格式推導;零記錄 rc2 要 --tier。"""
    import json as _json
    import io
    import contextlib
    path = env.vault.parent / ".canary-log.jsonl"
    rounds = []
    try:
        if path.exists():
            for line in path.read_text(encoding="utf-8").splitlines():
                line = line.strip()
                if not line:
                    continue
                try:
                    d = _json.loads(line)
                except ValueError:
                    continue
                if d.get("loop") == loop_id:
                    rounds.append(d)
    except OSError as e:
        print(f"ERROR: 讀 {path} 失敗: {e}", file=sys.stderr)
        return 2
    n_round = sum(1 for r in rounds if "round" in r)
    if rounds and n_round not in (0, len(rounds)):
        print("ERROR: canary-log round 欄混用(partial-mix)——帳損壞,同 status 拒讀", file=sys.stderr)
        return 2
    panel_fmt = n_round > 0
    if panel_fmt:   # 讀側損壞守衛不得因缺 --spec 提前 return 而繞過(code-loop r2 折入)
        seen, cur_rid = set(), None
        for r in rounds:
            rid = r["round"]
            if rid != cur_rid:
                if rid in seen:
                    print(f"ERROR: round-id {rid!r} 非連續重現(append-only 帳次序損壞)——同 status 拒讀",
                          file=sys.stderr)
                    return 2
                seen.add(rid)
                cur_rid = rid
    # ── tier 解析:定錨優先(v8);僅無定錨舊帳按格式推導;零記錄 rc2 ──
    anchor = next((r["tier"] for r in rounds if r.get("tier")), None)
    if tier and anchor and tier != anchor:
        print(f"ERROR: --tier {tier} 與帳面定錨 {anchor} 衝突(定錨優先;要換 tier 開新 loop id)", file=sys.stderr)
        return 2
    eff_tier = anchor or tier
    if eff_tier is None:
        if not rounds:
            print("ERROR: 零記錄 loop 需明示 --tier(不猜——猜錯模式撞混用守衛)", file=sys.stderr)
            return 2
        eff_tier = "standard" if panel_fmt else "legacy"   # 無定錨舊帳 fallback
    width, cap = _TIER_PARAMS[eff_tier]
    light = eff_tier == "light"
    # seq=循序 code loop(skill 設計行為:code 的 standard 走單 reviewer 循序;
    # 2026-08-18 循序codeloop-tier錨定案——not panel_fmt 是硬規格,code+standard 的 panel 帳照 panel 樣式走)
    seq = (eff_tier == "standard" and _roster_kind(loop_id) == "code" and not panel_fmt)
    if seq:
        width = 1   # 單 reviewer;cap 沿 _TIER_PARAMS["standard"][1]=3(分量本就正確,不另覆寫)
    # ── tier↔格式一致性(code-loop r1 折入:格式推導可被繞——high 漏帶 --round 會走鬆的 legacy 閘;
    #    2026-08-18 放寬單一象限:code∧standard∧無round=循序設計行為,不再誤擋——歷史三個循序 loop
    #    因此被迫落 legacy cap6,見 Issues/loop-next吐不可宣告的tier) ──
    if rounds:
        if eff_tier in ("standard", "high") and not panel_fmt and not seq:
            print(f"ERROR: tier={eff_tier} 要求 panel 格式(記錄帶 --round),帳面為 legacy 格式——"
                  "格式衝突(補 record 帶 --round,或 tier 錯誤則開新 loop id)", file=sys.stderr)
            return 2
        if light and panel_fmt:
            print("ERROR: tier=light 為單席 legacy 格式,帳面卻帶 --round(panel 格式)——格式衝突", file=sys.stderr)
            return 2
    rounds_count = len({r["round"] for r in rounds}) if panel_fmt else len(rounds)
    n_next = rounds_count + 1

    def emit(phase, extra=None):
        out = {"phase": phase, "tier": eff_tier, "round": n_next, "width": width,
               "min_seats": width, "cap": cap, "advisory": "tier 由編排者宣告後定錨;lumos 只做映射與定錨讀取"}
        _roster, _rnote = _roster_next_payload(loop_id, eff_tier)
        out["roster"] = _roster
        if _rnote:
            out["roster_note"] = _rnote
        if phase == "plant-canary":
            # 型別派工當下隨機抽(2026-08-06 S2 同場補,plan:驗證層自證三件):固定輪替
            # =可猜=答案印在考卷背面(該 plan r1 審計語);同輪 slot 間仍不重複(width≤4 時
            # 全 distinct;width>4 以重洗批次延續,重複最少化)——冗餘 canary 不算獨立注意力票。
            import random
            if light or eff_tier == "legacy" or seq:
                out["canary_type"] = random.choice(_CANARY_TYPES)
            else:
                pool = []
                while len(pool) < width:
                    pool.extend(random.sample(_CANARY_TYPES, len(_CANARY_TYPES)))
                out["canary_type"] = {f"slot{i}": pool[i - 1] for i in range(1, width + 1)}
            rmode = "" if (light or eff_tier == "legacy" or seq) else f" --round r{n_next}"
            # ★`legacy` 不是可宣告值,不得吐進 record_cmd★(2026-08-04):`--tier` 的 choices
            # 只有 light/standard/high(LOOP_TIERS),legacy 純粹是「無定錨舊帳 + legacy 格式」
            # 的推導結果。原本這裡無條件吐 `--tier {eff_tier}`,legacy 下等於★發一條 argparse
            # 當場擋掉的指令★;而使用者最自然的修復是「把 --tier 拿掉再跑一次」——拿掉就記不上
            # 定錨,下一輪 next 又推成 legacy、又吐一條跑不動的指令。
            # ★這個 bug 自己維持自己★:2026-08 三個走循序的 loop(code-slim-python /
            # code-teardown-windows / code-slim-handoff)全數 tier=None,即此循環的產物;
            # 其中 code-slim-python 吃到 legacy 的 cap 6(standard 是 3)才被逼停。
            _tier_flag = f" --tier {eff_tier}" if eff_tier in LOOP_TIERS else ""
            out["record_cmd"] = (f"lumos canary record caught|missed --loop {loop_id}{rmode}"
                                 f" --auditor <席> --severity <s> --findings <M>"
                                 f" --spec <計劃節點.md> --reviewed <sha256>{_tier_flag}"
                                 f" --scope-lines <這輪審了幾行>")
            # [T5 design-loop重設計] 處置閘模板(選用;record_cmd 原樣保留給 code-loop/舊流程)
            if not light and eff_tier != "legacy":
                out["disposal_cmd"] = (
                    f"lumos canary record caught|missed --loop {loop_id}{rmode}"
                    f" --auditor <席> --severity <s>"
                    f" --findings-set <id串> --folded-set <id串> --accepted-set <id串>"
                    f" --accept-reason <id=理由>"
                    f" --report <席報告.md> --snapshot <凍結快照.md>"
                    f" --spec <計劃節點.md> --reviewed <sha256>{_tier_flag}")
                out["disposal_gate"] = f"lumos loop status {loop_id} --disposal --spec <計劃節點.md> --repo <root>"
            if eff_tier == "legacy":
                if _roster_kind(loop_id) == "code":
                    # 循序codeloop-tier錨定案:standard 對 code 循序已格式相容,但補標=cap 陷阱——警告式,不邀請
                    out["tier_hint"] = (
                        "★本 loop 無 tier 定錨,正在吃 legacy 判準(單席、cap 6——比 standard 的 cap 3 鬆)★。"
                        "legacy 不是可宣告值。補 --tier high 會被格式一致性當場擋掉(rc2);"
                        "--tier standard 格式相容(code 循序=設計行為,2026-08-18 守衛修正)——"
                        "但★既有輪數會整批計入 cap=3★,已跑 ≥3 筆的 loop 一補標下一步即 cap-reached。"
                        "要走分級判準請★開新 loop id,並在第一筆 record 就帶 --tier★。")
                else:
                    out["tier_hint"] = (
                        "★本 loop 無 tier 定錨,正在吃 legacy 判準(單席、cap 6——比 standard 的 cap 3 鬆)★。"
                        "legacy 不是可宣告值,★這個 loop 補標不了★:帳面已是 legacy 格式(記錄不帶 --round),"
                        "補 --tier standard|high 會被格式一致性當場擋掉(rc2)。"
                        "(--tier light 格式相容,但 cap=2 且帶 ratchet 語意,對已跑數輪的 loop 通常當場 cap-reached。)"
                        "要走分級判準請★開新 loop id,並在第一筆 record 就帶 --tier★。")
            # ★預防端:警告必須在派工「之前」★——記帳時才喊已經來不及(輪跑完了)。
            # loop next 是每輪第一步,所以量尺放這裡。
            out["scope_cap"] = (
                f"★派工前先量★ `wc -l <工作副本/patch>`:超過 {_CANARY_SCOPE_SOFT_CAP_LINES} 行"
                f"(≈30K token)就★拆開審★——切成多輪,或拆給多席各審一段。"
                "理由:審查員的任務是『在 N 行裡找出那個植入的錯』,而脈絡越長注意力越差是"
                "已發表的實測(退化在 32K token 就量得到)。"
                "★這條門檻純粹借自外部文獻——本專案自己跑過三次對照實驗都測不出規模效應,"
                "不得引用自家資料當佐證★(原本這裡寫「本專案資料落在線兩邊」,該宣稱已撤:"
                "兩組審的根本不是同一份碼;之後兩次刻意設計的實驗一次撞天花板 7/7、一次撞"
                "地板 0/6,見 Projects/規模影響判斷力假說)。"
                "超標不擋,但會在帳上標 scope_oversize、該輪 caught 視為弱證據。")
        # ★cluster 帳的選擇只有第一輪能做★(2026-08-02):模式由「第一個有效輪」定錨,之後
        # 要換只能開新 loop id。而 M2 落地至今 316 筆 canary 記錄裡★只有 1 筆帶 clusters★,
        # 且那一筆是開發它的 code-m2cluster 自己——34 個 panel loop 中有 33 個靜默落回
        # 無-cluster 舊帳。根因不是機制不好,是★沒有任何地方在該選的時候提起它★。
        # 只在 N=1 提(那是選擇真正還開著的唯一時刻),避免對已定錨的 loop 噴無效噪音。
        if phase == "plant-canary" and not light and eff_tier != "legacy" and not seq and n_next == 1:
            out["cluster_hint"] = (
                "★本 loop 第一輪——cluster 帳只有現在能選(模式由第一個有效輪定錨,之後要換只能開新 loop id)★:"
                "若預期 findings 會散成★性質不同★的風險群(例:「規格縮水」與「邊界 bug」),"
                "改用 `--clusters '名=resolved|accepted-minor:理由|disputed-major'` 逐群追蹤,"
                "gate 改判「無 disputed-major」——不把不同性質的問題壓成單一 max severity(一軸會遮蔽另一軸)。"
                "單一主題、findings 同性質的 loop 用預設(無-cluster)即可。")
        if extra:
            out.update(extra)
        if as_json:
            print(_json.dumps(out, ensure_ascii=False))
        else:
            print(f"[next] {loop_id}: phase={phase} tier={eff_tier} 下一輪 N={n_next}"
                  f" width={width} cap={cap}")
            if out.get("roster"):
                for s in out["roster"]["seats"]:
                    print(f"  應派: {s['slot']} family={s['family']}"
                          f" 佔W={'是' if s['occupies_w'] else '否'} requirement={s['requirement']}"
                          + (f" note={s['note']}" if s.get("note") else ""))
            elif out.get("roster_note"):
                print(f"  應派: —({out['roster_note']})")
            for k in ("canary_type", "record_cmd", "scope_cap", "cluster_hint", "note"):
                if k in out:
                    print(f"  {k}: {out[k]}")
        return 0 if phase == "converged" else 1

    # ⓪ escalate:light ratchet 永久態最先短路
    if light and any(r.get("kind") in ("caught", "none") and r.get("severity") in ("major", "blocker")
                     for r in rounds):
        return emit("escalate", {"note": "light ratchet 已觸發——停止本 loop,開新 panel loop id(原 id+-std 後綴)承接"})
    if not rounds:
        return emit("plant-canary")
    # ① gate-pending:判 converged 需 gate 結果,資訊不足絕不背書(先於 cap)
    if spec is None:
        return emit("gate-pending", {"note": "缺 --spec,gate 判定資訊不足——跑 loop status --gate 附完整參數自判"})
    # ② full-basis gate 委派(靜默跑既有謂詞,零新判定邏輯)
    buf = io.StringIO()
    with contextlib.redirect_stdout(buf), contextlib.redirect_stderr(buf):
        rc = cmd_loop_status(env, loop_id, need=(1 if light else need), gate=True,
                             spec=spec, repo=repo, panel=(panel_fmt and not light),
                             light=light, min_seats=width)   # 恆傳(light/legacy=1;code-loop r1 折入)
    if rc == 2:
        sys.stderr.write(buf.getvalue())
        return 2
    if rc == 0:
        return emit("converged", {"gate_basis": "full(G 合取+hash 委派既有謂詞全過)"})
    # ③ cap(資訊充分且未 PASS)
    if rounds_count >= cap:
        return emit("cap-reached", {"note": f"cap={cap} 到頂未收斂——停,攤給人裁(別無限燒)"})
    # ④ plant-canary
    return emit("plant-canary")


# ───────────── guard: 合約守衛 scaffold(對談驅動)─────────────
# lumos 只做機械活:① 列出 ★INVARIANT★ 綁定狀態 ② 套範本產 stub(預設紅燈) ③ 把 [test:] 綁回 KEY 行(自驗)。
# 「斷言本體」由 Claude 經對談向人確認意圖後填 — claim 的真來自人確認,不來自 code 反推
# (反推=套套邏輯=Check T 在打的偽證據)。範本是技術棧專屬、放專案 .lumos/guard-templates/<type>.tmpl,
# lumos 本體維持語言無關。
GUARD_TYPES = ("pure", "behavioral", "state")
GUARD_ICON = {"real": "✅ 已綁真方法", "dangling": "❌ 懸空(找不到方法)",
              "fake": "⚠ 偽證據(非測試方法)", "naked": "❌ 裸合約(未綁)"}


def _repo_root_from_env(env):
    for p in env.vault.parents:
        if p.name == "docs":
            return p.parent
    return env.vault.parent  # standalone vault root


def _platform_test_index(repo_root):
    """依 .lumos/config 建「平台 → (method set, code haystack)」的惰性索引 + 解析參數。
    多平台 discover 呼叫點(Check T / classify_invariants / cmd_archive)共用,避免各自重寫平台迴圈。
    回 (split, default, methods_for, hay_for):
    - split = multiplatform 時的 platforms dict、legacy 時 {}(→ resolve_test_refs 不切分);
    - default = default_platform;
    - methods_for(plat)/hay_for(plat) = 惰性(一次 CLI 內快取)取該平台 root+profile 的測試方法集/haystack
      (haystack 也跨 repo,修 r4:fake vs dangling 訊息品質)。"""
    pdata = load_platforms(repo_root)
    split = pdata["platforms"] if pdata["multiplatform"] else {}
    default = pdata["default_platform"]
    mcache, hcache = {}, {}

    def methods_for(plat):
        if plat not in mcache:
            p = pdata["platforms"].get(plat)
            mcache[plat] = discover_test_methods(p["root"], p["profile"]) if p else set()
        return mcache[plat]

    def hay_for(plat):
        if plat not in hcache:
            p = pdata["platforms"].get(plat)
            hcache[plat] = build_code_haystack(p["root"]) if p else ""
        return hcache[plat]

    return pdata, split, default, methods_for, hay_for


def _classify_one(x, split, default, methods_for, hay_for):
    """單條 ★INVARIANT★ 的綁定狀態:naked/real/fake/dangling(多平台:每 ref 對其平台判、取最壞)。
    未定義平台前綴(resolve 報 ValueError)→ dangling(guard list 不 crash;doctor Check T 另明確報)。"""
    _, refs = strip_test_refs(x)
    if not refs:
        return "naked"
    try:
        resolved = resolve_test_refs(x, split, default)
    except ValueError:
        return "dangling"
    sts = []
    for plat, name in resolved:
        if name in methods_for(plat):
            sts.append("real")
        elif name in hay_for(plat):
            sts.append("fake")
        else:
            sts.append("dangling")
    return "dangling" if "dangling" in sts else ("fake" if "fake" in sts else "real")


def classify_invariants(env):
    """每條 ★INVARIANT★ 的綁定狀態:real / dangling / fake / naked(多平台感知)。"""
    repo_root = _repo_root_from_env(env)
    _, split, default, methods_for, hay_for = _platform_test_index(repo_root)
    rows = []
    for rel in sorted(env.notes):
        inv, _ = extract_contracts(env.notes[rel])
        for x in inv:
            clean, refs = strip_test_refs(x)
            status = _classify_one(x, split, default, methods_for, hay_for)
            rows.append({"node": rel, "text": clean, "refs": refs, "status": status,
                         "audited": bool(invariant_audit_refs(x)),
                         "audit": invariant_audit_refs(x),
                         "has_kill": bool(KILL_REF_RE.search(x))})   # 從原始行判(clean 已剝)
    return rows


def cmd_guard_list(env, unbound_only=False):
    rows = classify_invariants(env)
    shown = 0
    for r in rows:
        if unbound_only and r["status"] == "real":
            continue
        shown += 1
        print(f"{GUARD_ICON[r['status']]}  {r['node']}")
        print(f"    {r['text'][:96]}")
        tag = f"[test:{','.join(r['refs'])}]" if r["refs"] else "(未綁)"
        tag += f"  [audit:{','.join(r['audit'])}]" if r["audited"] else ("  ⚠ 未審" if r["refs"] else "")
        if r.get("has_kill"):
            tag += "  [kill✓]"
        print(f"    {tag}")
    from collections import Counter
    c = Counter(r["status"] for r in rows)
    unaudited = sum(1 for r in rows if r["refs"] and not r["audited"])
    print(f"\n合約 {len(rows)} 條 — 真綁 {c['real']} / 懸空 {c['dangling']} / "
          f"偽證據 {c['fake']} / 裸 {c['naked']} / 未審 {unaudited}")
    if unbound_only and shown == 0:
        print("✓ 沒有未綁合約(全綁真方法)")
    return 0


IDENT_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")


def _detect_test_dir(repo_root, gtype, profile=None):
    """偵測測試專案目錄。由 profile 決定:
    suffix 模式(C#)= 頂層目錄 endswith(pure 排除 IntegrationTests);
    rglob 模式(Kotlin/Android)= 遞迴找目錄名(巢狀 src/test、多 module)。
    多候選印警告取第一個(避免靜默寫錯)。找不到回 None → scaffold 要求 --out。"""
    profile = profile or load_test_profile(repo_root)
    inc, exc = profile["dirs"].get(gtype, ([], []))
    if profile["dir_mode"] == "suffix":
        hit = [d for d in sorted(repo_root.iterdir())
               if d.is_dir() and any(d.name.endswith(p) for p in inc)
               and not any(d.name.endswith(e) for e in exc)]
    else:  # rglob:遞迴找目錄名(取第一個 include pattern 有命中者)
        under = profile.get("rglob_under")
        hit = []
        for p in inc:
            found = sorted(d for d in repo_root.rglob(p)
                           if d.is_dir() and not (set(d.parts) & CODE_SKIP_DIRS)
                           and (under is None or under in d.parts))  # F6:限 src/ 下
            if found:
                hit = found
                break
    if not hit:
        return None
    if len(hit) > 1:
        names = [str(d.relative_to(repo_root)) for d in hit]
        print(f"⚠ 偵測到多個測試目錄 {names},取 {names[0]};要寫別處用 --out 指定",
              file=sys.stderr)
    return hit[0]


def _tautology_warn(claim, clean):
    """claim 高度重述 invariant = 套套邏輯嫌疑(防帶風向)。字元三連袋 Jaccard,中英都適用。"""
    def trigrams(s):
        s = re.sub(r"\s+", "", s)
        return {s[i:i+3] for i in range(max(0, len(s) - 2))}
    a, b = trigrams(claim), trigrams(clean)
    if not a or not b:
        return
    jac = len(a & b) / len(a | b)
    norm_claim = re.sub(r"\s+", "", claim)
    norm_clean = re.sub(r"\s+", "", clean)
    if norm_claim and (norm_claim in norm_clean or norm_clean in norm_claim or jac >= 0.85):
        print("⚠ claim 與 invariant 文字高度雷同(套套邏輯嫌疑)。claim 應是『向人確認過、"
              "可驗的具體斷言』,不是重述合約本身——確認它來自意圖而非 code/合約 reword。",
              file=sys.stderr)


def cmd_guard_scaffold(env, node, invariant_substr, method, gtype, claim,
                       out_dir=None, template=None, klass=None, platform=None):
    if gtype not in GUARD_TYPES:
        print(f"ERROR: --type 須為 {'|'.join(GUARD_TYPES)}(收到 {gtype})", file=sys.stderr)
        return 2
    if not IDENT_RE.match(method):
        print(f"ERROR: --method『{method}』非合法識別字(只允許字母/數字/底線,不可數字開頭)。"
              f"\n  (Kotlin 反引號測試名含空白 → CLI 不支援,請手動編輯 .md 的 [test:] 與測試檔)",
              file=sys.stderr)
        return 2
    if klass is not None and not IDENT_RE.match(klass):
        print(f"ERROR: --class『{klass}』非合法識別字", file=sys.stderr)
        return 2
    rel = env.find(node)
    if rel is None:
        print(f"ERROR: 找不到節點 {node}", file=sys.stderr)
        return 2
    inv, _ = extract_contracts(env.notes[rel])
    # 比對 invariant 語義本體(去掉 [test:..] 後綴),避免子字串誤命中既有測試名
    matched = [x for x in inv if invariant_substr in strip_test_refs(x)[0]]
    if not matched:
        print(f"ERROR: {rel} 沒有含『{invariant_substr}』的 ★INVARIANT★(已排除 [test:] 後綴)",
              file=sys.stderr)
        return 2
    if len(matched) > 1:
        print(f"ERROR: 『{invariant_substr}』命中 {len(matched)} 條,請給更精確子字串", file=sys.stderr)
        return 2
    clean, _ = strip_test_refs(matched[0])
    _tautology_warn(claim, clean)
    repo_root = _repo_root_from_env(env)
    # 多平台:依 --platform 選 root+profile(範本落點/scaffold_ext/測試目錄偵測都跟平台走)。
    try:
        pdata = load_platforms(repo_root)
    except ValueError as ex:
        print(f"ERROR: config platforms 設定錯誤: {ex}", file=sys.stderr)
        return 2
    if platform is None:
        if len(pdata["platforms"]) == 1:
            platform = next(iter(pdata["platforms"]))
        else:
            print(f"ERROR: 多平台 config 有 {len(pdata['platforms'])} 個平台,scaffold 請用 --platform 指定"
                  f"(可選: {', '.join(pdata['platforms'])})", file=sys.stderr)
            return 2
    elif platform not in pdata["platforms"]:
        print(f"ERROR: --platform '{platform}' 不在 config platforms({', '.join(pdata['platforms'])})",
              file=sys.stderr)
        return 2
    pentry = pdata["platforms"][platform]
    platform_root, profile = pentry["root"], pentry["profile"]
    tpl_path = Path(template) if template else \
        (platform_root / ".lumos" / "guard-templates" / f"{gtype}.tmpl")   # 範本走該平台 root(審計 r4)
    if not tpl_path.exists():
        print(f"ERROR: 找不到範本 {tpl_path}\n  範本是技術棧專屬、放專案 "
              f".lumos/guard-templates/<type>.tmpl;lumos 語言無關不內建。先建範本再 scaffold。",
              file=sys.stderr)
        return 2
    klass = klass or (method + "Tests")  # 不複用 method 當類名(避免 class==method 同名)
    prefix = "TEST" + re.sub(r"[^A-Za-z]", "", method).upper()[:7]
    text = tpl_path.read_text(encoding="utf-8")
    for k, v in {"CLASS": klass, "METHOD": method, "NODE": rel,
                 "INVARIANT": clean, "CLAIM": claim, "PREFIX": prefix}.items():
        text = text.replace("{{" + k + "}}", v)
    leftover = sorted(set(re.findall(r"\{\{[^}]+\}\}", text)))
    if leftover:
        print(f"⚠ 範本有未取代的 placeholder {leftover}(範本 typo?)— 仍寫出,請檢查產出檔",
              file=sys.stderr)
    out = Path(out_dir) if out_dir else _detect_test_dir(platform_root, gtype, profile)
    if out is None:
        print("ERROR: 偵測不到測試專案目錄,請給 --out", file=sys.stderr)
        return 2
    if not out.is_dir():
        print(f"ERROR: 輸出目錄不存在: {out}(打錯路徑?先 mkdir 或修正 --out)", file=sys.stderr)
        return 2
    # scaffold_name 模板(python="test_{m}"→test_X.py 命中該 profile 檔名錨;無模板走 klass 慣例。
    # std F2:預設 XTests.py 會被 python 檔名錨排除,scaffold 產物必須自己能被 Check T 掃到)
    _tpl = profile.get("scaffold_name")
    _base = _tpl.format(m=method) if _tpl else klass
    target = out / f"{_base}{profile['scaffold_ext']}"
    if target.exists():
        print(f"ERROR: {target} 已存在,不覆寫(避免蓋掉既有守衛)", file=sys.stderr)
        return 2
    _write_lf(target, text)
    print(f"✓ 已產 stub: {target}")
    print(f"  類型: {gtype}  |  方法: {method}  |  守衛: {clean[:70]}")
    print("\n下一步(Claude/人):")
    print(f"  1. 開 {target.name},把 // TODO 換成『已向人確認的斷言』"
          f"(預設 {profile['fail_hint']} → 必須填到綠)")
    _pflag = f" --platform {platform}" if pdata["multiplatform"] else ""
    print(f"  2. 綁回架構圖:  lumos guard bind {rel} \"{invariant_substr}\" {method}{_pflag}")
    print(f"  3. lumos doctor 確認 Check T 通過")
    return 0


def cmd_guard_bind(env, node, invariant_substr, method, platform=None):
    if not IDENT_RE.match(method):
        print(f"ERROR: method『{method}』非合法識別字", file=sys.stderr)
        return 2
    # 多平台:平台另帶(method 維持識別字、不含冒號),寫成 [test:平台:方法]。IDENT_RE 不放寬。
    ref = f"{platform}:{method}" if platform else method
    rel = env.find(node)
    if rel is None:
        print(f"ERROR: 找不到節點 {node}", file=sys.stderr)
        return 2
    path = env.vault / rel
    try:
        lines, _, e = load_raw_for_edit(path)
    except (ValueError, RuntimeError) as ex:
        print(f"ERROR: {ex}", file=sys.stderr)
        return 2
    target_idx = None
    for i in range(1, e):
        # 比對去掉 [test:..] 後的行(子字串不誤命中既有測試名)
        if INVARIANT_RE.match(lines[i].strip()) and invariant_substr in TEST_REF_RE.sub("", lines[i]):
            if target_idx is not None:
                print(f"ERROR: 『{invariant_substr}』命中多條 KEY 行,請給更精確子字串", file=sys.stderr)
                return 2
            target_idx = i
    if target_idx is None:
        print(f"ERROR: {rel} 找不到含『{invariant_substr}』的 ★INVARIANT★ KEY 行", file=sys.stderr)
        return 2
    line = lines[target_idx]
    m = TEST_REF_RE.search(line)
    if m:
        refs = [t.strip() for t in m.group(1).split(",") if t.strip()]
        if ref in refs:   # 去重比完整 ref(platform:method),否則多平台漏判(審計 r3)
            print(f"已綁 [test:{ref}],無需重綁")
            return 0
        refs.append(ref)
        newline = line[:m.start()] + f"[test:{','.join(refs)}]" + line[m.end():]
    else:
        newline = line.rstrip() + f" [test:{ref}]"
    new_lines = lines[:target_idx] + [newline] + lines[target_idx + 1:]

    def check(fields):
        summ = fields.get("summary")
        if not isinstance(summ, str):
            return False
        for l in summ.split("\n"):
            mi = INVARIANT_RE.match(l.strip())
            if mi and invariant_substr in l:
                return ref in invariant_test_refs(mi.group(1))   # verify closure 也比完整 ref
        return False

    try:
        atomic_write_verify(path, new_lines, f"[test:{ref}]", check)
    except (ValueError, RuntimeError) as ex:
        print(f"ERROR: {ex}", file=sys.stderr)
        return 2
    print(f"✓ 綁定 [test:{ref}] → {rel} 的 ★INVARIANT★")
    print("  下一步: lumos doctor — 方法須已存在於 code,否則 Check T 顯示懸空")
    return 0


# ── guard kill:殺傷力驗證(宣告式壞法→隔離 worktree→綁定測試必須翻紅) ──
# 設計 spec:docs/lumos-toolchain-knowledge/Projects/guard殺傷力驗證_計劃.md(3 輪 panel 收斂)
# borrow-design:pytest-mutagen(宣告式)+cargo-mutants(baseline/timeout)+Stryker command-runner

_KILL_METHOD_OK_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$|^[\w .]+$")  # IDENT 或 Kotlin 反引號拆殼後白名單


def _kill_read_recipes(path):
    """讀節點的 kill_recipes frontmatter(block scalar 單行 compact JSON array)。回 (list, err)。"""
    import json
    try:
        lines, _, e = load_raw_for_edit(path)
        fields, _bk, _lint = parse_frontmatter(lines[1:e])
    except Exception as ex:
        return None, f"frontmatter 解析失敗: {ex}"
    raw = fields.get("kill_recipes")
    if raw is None:
        return [], None
    try:
        data = json.loads(raw if isinstance(raw, str) else str(raw))
        if not isinstance(data, list):
            return None, "kill_recipes 必須是 JSON array"
        return data, None
    except ValueError as ex:
        return None, f"kill_recipes JSON 解析失敗: {ex}"


def cmd_guard_kill_add(env, node, invariant_substr, file, old, new, test=None,
                       platform=None, note=""):
    """宣告一條壞法配方進 kill_recipes + KEY 行補 [kill:recipes](同檔一次 atomic 寫)。"""
    import json
    if old == new:
        print("ERROR: old 與 new 相同,配方無語意", file=sys.stderr)
        return 2
    rel = env.find(node)
    if rel is None:
        print(f"ERROR: 找不到節點 {node}", file=sys.stderr)
        return 2
    path = env.vault / rel
    try:
        lines, _, e = load_raw_for_edit(path)
    except (ValueError, RuntimeError) as ex:
        print(f"ERROR: {ex}", file=sys.stderr)
        return 2
    # 定位 KEY 行(去標記後比對,避免子字串誤中標記文字)
    target_idx = None
    for i in range(1, e):
        if INVARIANT_RE.match(lines[i].strip()) and invariant_substr in INV_TAG_RE.sub("", lines[i]):
            if target_idx is not None:
                print(f"ERROR: 『{invariant_substr}』命中多條 KEY 行,請給更精確子字串", file=sys.stderr)
                return 2
            target_idx = i
    if target_idx is None:
        print(f"ERROR: {rel} 找不到含『{invariant_substr}』的 ★INVARIANT★ KEY 行", file=sys.stderr)
        return 2
    # 解析綁定測試:--test 或 KEY 行唯一 [test:] ref;0 個 → 硬報(kill 驗的就是綁定)
    line = lines[target_idx]
    refs = invariant_test_refs(line)
    if test is None:
        if len(refs) == 0:
            print("ERROR: 該合約無 [test:] 綁定(naked)——kill 驗的是綁定測試,先 guard bind", file=sys.stderr)
            return 2
        if len(refs) > 1:
            print(f"ERROR: 該合約綁多個測試({', '.join(refs)}),--test 指明哪一個", file=sys.stderr)
            return 2
        test = refs[0]
    recipe = {"invariant": invariant_substr, "test": test, "file": file,
              "old": old, "new": new, "note": note or ""}
    if platform:
        recipe["platform"] = platform
    recipes, err = _kill_read_recipes(path)
    if recipes is None:
        print(f"ERROR: {err}", file=sys.stderr)
        return 2
    for r in recipes:
        if r.get("invariant") == invariant_substr and r.get("file") == file and r.get("old") == old:
            print("ERROR: 重複配方(同 invariant 同 file/old),先手動移除舊條", file=sys.stderr)
            return 2
    recipes.append(recipe)
    blob = json.dumps(recipes, ensure_ascii=False)
    # 重寫 frontmatter:替換或插入 kill_recipes block(單行 compact) + KEY 行補標記
    newline = line if KILL_REF_RE.search(line) else line.rstrip() + " [kill:recipes]"
    out, i, replaced = [], 0, False
    while i < e:
        l = lines[i]
        if i == target_idx:
            out.append(newline); i += 1; continue
        if l.startswith("kill_recipes:"):
            out.append("kill_recipes: |-")
            out.append("  " + blob)
            i += 1
            while i < e and (lines[i].startswith("  ") or not lines[i].strip()):
                i += 1
            replaced = True
            continue
        out.append(l); i += 1
    if not replaced:
        out.append("kill_recipes: |-")
        out.append("  " + blob)
    new_lines = out + lines[e:]
    # 若 KEY 行在 summary block 內(常態),target_idx < e 已處理;標記寫後自驗

    def check(fields):
        raw = fields.get("kill_recipes")
        if not isinstance(raw, str):
            return False
        try:
            data = json.loads(raw)
        except ValueError:
            return False
        if not any(r.get("invariant") == invariant_substr and r.get("old") == old for r in data):
            return False
        summ = fields.get("summary")
        if isinstance(summ, str):
            for sl in summ.split("\n"):
                mi = INVARIANT_RE.match(sl.strip())
                if mi and invariant_substr in INV_TAG_RE.sub("", sl):
                    return bool(KILL_REF_RE.search(sl))
        return False

    try:
        atomic_write_verify(path, new_lines, "[kill:recipes]", check)
    except (ValueError, RuntimeError) as ex:
        print(f"ERROR: {ex}", file=sys.stderr)
        return 2
    print(f"✓ kill 配方寫入 {rel}(invariant『{invariant_substr[:24]}…』, test={test})")
    print("  下一步: lumos guard kill 跑殺傷力驗證(worktree 隔離,弄壞→測試必須翻紅)")
    return 0


def _kill_run(cmd, cwd, timeout):
    """跑 run_cmd(shell,killpg 沿 lint 先例)。回 (rc, tail200, elapsed, timed_out)。"""
    import os
    import signal
    import subprocess
    import tempfile
    import time
    t0 = time.time()
    with tempfile.TemporaryFile(mode="w+", encoding="utf-8", errors="replace") as buf:
        proc = subprocess.Popen(cmd, shell=True, cwd=str(cwd), start_new_session=True,
                                stdout=buf, stderr=subprocess.STDOUT)
        try:
            proc.communicate(timeout=timeout)
        except subprocess.TimeoutExpired:
            try:
                os.killpg(os.getpgid(proc.pid), signal.SIGKILL)
            except (ProcessLookupError, OSError, AttributeError):
                # AttributeError=Windows 無 killpg/SIGKILL → 退回殺直接子程序
                try:
                    proc.kill()
                except OSError:
                    pass
            proc.wait()
            buf.seek(0)
            txt = buf.read()
            return (None, _kill_cap(txt), time.time() - t0, True)
        buf.seek(0)
        txt = buf.read()
    return (proc.returncode, _kill_cap(txt), time.time() - t0, False)


_KILL_OUT_CAP = 256 * 1024


def _kill_cap(txt):
    """[S3 oracle品質包] 保留完整輸出供歸因(上限 256KB;超限取頭尾各半、對齊換行邊界
    並插 marker——裸位元組砍半會把兩條真實行拼成假行汙染行窗掃描)。"""
    if len(txt) <= _KILL_OUT_CAP:
        return txt
    half = _KILL_OUT_CAP // 2
    head, tail = txt[:half], txt[-half:]
    head = head[:head.rfind("\n") + 1] if "\n" in head else head
    tail = tail[tail.find("\n") + 1:] if "\n" in tail else tail
    dropped = len(txt) - len(head) - len(tail)
    return head + f"...[truncated {dropped} bytes]...\n" + tail


_KILL_FAIL_MARKS = ("FAIL", "FAILED", "✗", "AssertionError")
# 窗內另一個測試名(常見命名:test_x / TestX / xxxTest)——見到即停掃,防「隔壁測試失敗」被算到綁定測試頭上
_KILL_OTHER_TEST_RE = re.compile(r"\b([Tt]est[_A-Za-z0-9]\w*|\w+Tests?)\b")


def _kill_attribute(out, method):
    """[S3] 歸因:綁定測試名的任一出現處,其行起(含同行)5 行窗內有失敗標記,
    且標記命中位置不得落在測試名字串自身範圍內(防 test_fail_closed 這類名字偽造強殺)。
    回 (attributed: bool, excerpt: str)——excerpt 取跨距最短的命中處、名行到標記行整段、截 200 字。"""
    if not out or not method:
        return False, ""
    lines = out.splitlines()
    best = None
    for i, line in enumerate(lines):
        col = line.find(method)
        if col < 0:
            continue
        for j in range(i, min(i + 5, len(lines))):
            probe = lines[j]
            # 遮蔽測試名字串本身再找標記(名字自帶 FAIL/AssertionError 不算證據)
            masked = probe.replace(method, " " * len(method))
            if j > i and _KILL_OTHER_TEST_RE.search(masked):
                break   # 窗內出現另一個測試名 → 後續標記屬別支,停掃(防鄰近他測誤歸因)
            up = masked.upper()
            if any(m.upper() in up for m in _KILL_FAIL_MARKS):
                span = j - i
                if best is None or span < best[0]:
                    best = (span, i, j)
                break
    if best is None:
        return False, ""
    _, i, j = best
    return True, "\n".join(lines[i:j + 1])[:200]


def cmd_guard_kill(env, node, invariant_substr=None, platform_override=None,
                   as_json=False, keep_worktree=False):
    """跑節點的 kill 配方:worktree 隔離→baseline 綠→套壞法→綁定測試必須翻紅。
    rc:全 killed(含 timed_out)=0;任一 survived=1;有 drifted/abort/error 而無 survived=2;
    零配方/缺 run_cmd/config 壞=2。"""
    import json
    import os
    import shlex
    import shutil
    import subprocess
    import tempfile
    import datetime
    rel = env.find(node)
    if rel is None:
        print(f"ERROR: 找不到節點 {node}", file=sys.stderr)
        return 2
    path = env.vault / rel
    recipes, err = _kill_read_recipes(path)
    if recipes is None:
        print(f"ERROR: {err}", file=sys.stderr)
        return 2
    if invariant_substr:
        recipes = [r for r in recipes if invariant_substr in r.get("invariant", "")]
    if not recipes:
        print("ERROR: 無配方可跑(kill-add 先宣告;或子字串不匹配)", file=sys.stderr)
        return 2
    repo_root = _repo_root_from_env(env)
    try:
        pdata = load_platforms(repo_root)
    except ValueError as ex:
        print(f"ERROR: config 壞: {ex}", file=sys.stderr)
        return 2
    plats = pdata["platforms"]
    default_plat = pdata["default_platform"]
    if pdata.get("multiplatform") and (Path(repo_root) / ".lumos" / "config.json").exists():
        # platforms 在則 test.run_cmd 不生效(load_platforms 二分慣例)→ 有宣告時告警
        try:
            _cfg = json.loads((Path(repo_root) / ".lumos" / "config.json").read_text(encoding="utf-8"))
            if isinstance(_cfg.get("test"), dict) and _cfg["test"].get("run_cmd"):
                print("⚠ config 同時有 platforms 與 test.run_cmd——多平台模式下 test.run_cmd 不生效",
                      file=(sys.stderr if as_json else sys.stdout))   # [S3] --json 純度
        except Exception:
            pass
    floor = 20.0
    try:
        floor = float(os.environ.get("LUMOS_KILL_TIMEOUT_FLOOR", "20"))
    except ValueError:
        pass
    results = []
    commit = ""   # 迴圈外留痕用;多平台時記最後一組的 HEAD(各 row 的 platform 欄可辨)
    ts = datetime.datetime.now().isoformat(timespec="seconds")
    # 依 platform 分組(每平台一個 worktree + baseline per test)
    groups = {}
    for r in recipes:
        groups.setdefault(r.get("platform") or platform_override or default_plat, []).append(r)
    for plat, plist in groups.items():
        pentry = plats.get(plat)
        if pentry is None:
            for r in plist:
                results.append({**r, "platform": plat, "verdict": "error",
                                "detail": f"平台 '{plat}' 不在 config"})
            continue
        run_cmd = pentry.get("run_cmd")
        if not run_cmd:
            print(f"ERROR: 平台 '{plat}' 未宣告 run_cmd(多平台=platforms.{plat}.run_cmd;"
                  f"legacy=test.run_cmd)——kill 不可用", file=sys.stderr)
            return 2
        proot = Path(pentry["root"])
        commit = ""
        try:
            commit = subprocess.run(["git", "-C", str(proot), "rev-parse", "--short", "HEAD"],
                                    capture_output=True, text=True).stdout.strip()
        except Exception:
            pass
        try:
            dirty = subprocess.run(["git", "-C", str(proot), "status", "--porcelain"],
                                   capture_output=True, text=True).stdout.strip()
        except OSError:
            dirty = ""
        if dirty:
            print(f"⚠ {plat} repo 有未提交變更——不會進沙盒(kill 以 HEAD 為基準),配方/測試需先 commit",
                  file=(sys.stderr if as_json else sys.stdout))   # [S3] --json 純度:診斷一律 stderr
        flaky = pentry["profile"].get("scaffold_ext") in (".yaml", ".yml") or plat in ("maestro", "playwright")
        # per (test) baseline 快取:同測試多配方只跑一次 baseline
        tmp_parent = tempfile.mkdtemp(prefix="lumos-kill-")
        wt = os.path.join(tmp_parent, "wt")
        wt_ok = False
        try:
            r_add = subprocess.run(["git", "-C", str(proot), "worktree", "add", "--detach", wt],
                                   capture_output=True, text=True)
            if r_add.returncode != 0:
                for r in plist:
                    results.append({**r, "platform": plat, "verdict": "error",
                                    "detail": f"worktree add 失敗: {r_add.stderr.strip()[:120]}"})
                continue
            wt_ok = True
            wt_real = os.path.realpath(wt)
            baselines = {}
            for r in plist:
                method_full = r.get("test", "")
                method = method_full.split(":", 1)[1] if (":" in method_full and pdata.get("multiplatform")) else method_full
                method = method.strip("`")   # Kotlin 反引號名拆殼後進白名單
                if not _KILL_METHOD_OK_RE.fullmatch(method or ""):
                    results.append({**r, "platform": plat, "verdict": "error",
                                    "detail": f"test 名不合法(拒注入): {method!r}"})
                    continue
                cmd = run_cmd.replace("{method}", shlex.quote(method)) if "{method}" in run_cmd else run_cmd
                note_ws = "" if "{method}" in run_cmd else " whole-suite"
                if cmd not in baselines:
                    b_rc, b_tail, b_elapsed, b_to = _kill_run(cmd, wt, max(600.0, floor))
                    baselines[cmd] = (b_rc, b_tail, b_elapsed, b_to)
                b_rc, b_tail, b_elapsed, b_to = baselines[cmd]
                if b_to or b_rc != 0:
                    results.append({**r, "platform": plat, "verdict": "abort",
                                    "detail": f"baseline 非綠(rc={b_rc}){note_ws}", "tail": b_tail[-200:]})
                    continue
                # 套配方(路徑圍欄:雙邊 realpath)
                target = os.path.realpath(os.path.join(wt, r.get("file", "")))
                if not target.startswith(wt_real + os.sep):
                    results.append({**r, "platform": plat, "verdict": "error",
                                    "detail": "file 路徑逃逸 worktree(圍欄擋下)"})
                    continue
                try:
                    with open(target, encoding="utf-8") as _tf:
                        src = _tf.read()
                except OSError as ex:
                    results.append({**r, "platform": plat, "verdict": "drifted",
                                    "detail": f"file 開不了: {ex}"})
                    continue
                cnt = src.count(r.get("old", ""))
                if cnt != 1:
                    results.append({**r, "platform": plat, "verdict": "drifted",
                                    "detail": f"old 命中 {cnt} 次(需恰 1——配方漂移,重寫)"})
                    continue
                with open(target, "w", encoding="utf-8") as _tf:
                    _tf.write(src.replace(r["old"], r["new"], 1))
                m_timeout = max(b_elapsed * 5, floor)
                m_rc, m_tail, _me, m_to = _kill_run(cmd, wt, m_timeout)
                rv = subprocess.run(["git", "-C", wt, "checkout", "--", r.get("file", "")],
                                    capture_output=True)
                if rv.returncode != 0:
                    results.append({**r, "platform": plat, "verdict": "error",
                                    "detail": "revert 失敗——後續同組配方作廢防污染"})
                    break   # 樹已髒,本組終止(worktree 在 finally 清)
                attr_excerpt = ""
                if m_to:
                    # [S3] timeout 降弱證據(不再計 killed):掛掉可能是環境非變異
                    verdict = "timed_out_weak"
                elif m_rc != 0:
                    ok_attr, attr_excerpt = _kill_attribute(m_tail, method)
                    verdict = "killed" if ok_attr else "killed_unattributed"
                else:
                    verdict = "survived"
                res = {**r, "platform": plat, "verdict": verdict}
                if attr_excerpt:
                    res["attr_excerpt"] = attr_excerpt
                if verdict == "killed_unattributed":
                    res["detail"] = (res.get("detail", "")
                                     + "弱證據:紅燈未歸因到綁定測試(建議 run_cmd 加 filter 鎖定該測試)")
                if verdict == "survived":
                    res["tail"] = b_tail[-200:]   # 展示裁回(_kill_run 現保留全文供歸因)
                if flaky:
                    res["flaky_risk"] = True
                if note_ws:
                    res["detail"] = (res.get("detail", "") + note_ws +
                                     ("(弱證據:紅燈可能來自無關測試)" if verdict in ("killed", "killed_unattributed", "timed_out_weak") else ""))
                results.append(res)
        finally:
            if keep_worktree:
                print(f"(--keep-worktree) 現場保留: {wt}",
                      file=(sys.stderr if as_json else sys.stdout))
            else:
                if wt_ok:
                    subprocess.run(["git", "-C", str(proot), "worktree", "remove", "--force", wt],
                                   capture_output=True)
                shutil.rmtree(tmp_parent, ignore_errors=True)   # add 失敗也清(無條件)
                if wt_ok:
                    subprocess.run(["git", "-C", str(proot), "worktree", "prune"],
                                   capture_output=True)          # prune 放 rmtree 後(dir 已消才修行政記錄)
    # 留痕(docs/.kill-log.jsonl,gov 第 5 支 load 撈)——迴圈外:add 失敗 continue 的 error 也要進帳
    if True:
        log = env.vault.parent / ".kill-log.jsonl"
        try:
            _fh_ok = True
            fh_cm = open(log, "a", encoding="utf-8")
        except OSError as ex:
            _fh_ok = False
            print(f"⚠ kill-log 寫入失敗(結果只印不留痕): {ex}", file=sys.stderr)
        if _fh_ok:
          with fh_cm as fh:
            for res in results:
                if res.get("_logged"):
                    continue
                res["_logged"] = True
                fh.write(json.dumps({"ts": ts, "node": rel, "commit": commit,
                                     "invariant": res.get("invariant", ""), "test": res.get("test", ""),
                                     "platform": res.get("platform", ""),
                                     "verdict": res["verdict"], "note": res.get("note", ""),
                                     "flaky_risk": res.get("flaky_risk", False),
                                     "tail": res.get("tail", "")}, ensure_ascii=False) + "\n")
    verdicts = [r["verdict"] for r in results]
    if as_json:
        print(json.dumps({"results": [{k: v for k, v in r.items() if k != "_logged"}
                                      for r in results]}, ensure_ascii=False))
    else:
        # 七態(舊 timed_out 鍵已於 2026-07-29 移除:那是六態時代的殘留死鍵,
        # 且掛 ✓ 會讓人誤以為逾時算接住——現在逾時是 timed_out_weak ⚠)
        icon = {"killed": "✓", "killed_unattributed": "⚠",
                "timed_out_weak": "⚠", "survived": "✗",
                "drifted": "⚠", "abort": "⚠", "error": "⚠"}
        for r in results:
            print(f"{icon.get(r['verdict'],'?')} {r['verdict']:<9} {r.get('invariant','')[:30]}"
                  f" [{r.get('test','')}] {r.get('detail','')}")
    if "survived" in verdicts:
        print("✗ 有配方 SURVIVED——綁定測試接不住宣告的壞法(稻草人證據),補強測試", file=sys.stderr)
        return 1
    if any(v in ("drifted", "abort", "error") for v in verdicts):
        return 2
    # 弱證據 fail-open 修補(2026-07-29 終審 Codex):全部弱證據=沒有任何一條配方被歸因到綁定測試
    # → rc1(同 survived 級「證據不足」),不得以 rc0 讓 hook/CI 誤判通過。混有強殺則 rc0。
    if verdicts and "killed" not in verdicts and all(
            v in ("killed_unattributed", "timed_out_weak") for v in verdicts):
        print("✗ 全部弱證據(未歸因/逾時)——無任一配方證實被綁定測試咬住,補 filter 或強化斷言",
              file=sys.stderr)
        return 1
    if not as_json:
        # [S3] 措辭收斂:「咬得住」只配全強殺;混弱證據分列(unattributed+timeout 同桶)
        _strong = verdicts.count("killed")
        _weak = verdicts.count("killed_unattributed") + verdicts.count("timed_out_weak")
        if _weak:
            print(f"強殺 {_strong} / 弱證據 {_weak}"
                  f"(unattributed {verdicts.count('killed_unattributed')}"
                  f" + timeout {verdicts.count('timed_out_weak')})——弱證據未歸因到綁定測試")
        else:
            print(f"✓ 全部 killed({len(verdicts)} 配方)——綁定測試咬得住")
    return 0


def cmd_guard_audit(env, node, invariant_substr, model="sonnet", date=None):
    """把 [audit:模型/日期] 留痕寫回 ★INVARIANT★ KEY 行(寫後自驗)。
    語意:這條鐵則的「合法性」(是不是真鐵則 / 綁的測試夠不夠格)已由一個
    *無對話脈絡的獨立 agent* 判過並通過。工具只記留痕,不證明審計真的乾淨——
    那靠 skill 的 maker/checker 誠實鐵則(別餵結論給審計者、提出者不得自評)。"""
    import datetime
    if date is None:
        date = datetime.date.today().isoformat()
    stamp = f"{model}/{date}"
    rel = env.find(node)
    if rel is None:
        print(f"ERROR: 找不到節點 {node}", file=sys.stderr)
        return 2
    path = env.vault / rel
    try:
        lines, _, e = load_raw_for_edit(path)
    except (ValueError, RuntimeError) as ex:
        print(f"ERROR: {ex}", file=sys.stderr)
        return 2
    target_idx = None
    for i in range(1, e):
        # 比對去掉 [test:]/[audit:] 後的行(子字串不誤命中既有標記內容)
        if INVARIANT_RE.match(lines[i].strip()) and invariant_substr in INV_TAG_RE.sub("", lines[i]):
            if target_idx is not None:
                print(f"ERROR: 『{invariant_substr}』命中多條 KEY 行,請給更精確子字串", file=sys.stderr)
                return 2
            target_idx = i
    if target_idx is None:
        print(f"ERROR: {rel} 找不到含『{invariant_substr}』的 ★INVARIANT★ KEY 行", file=sys.stderr)
        return 2
    line = lines[target_idx]
    m = AUDIT_REF_RE.search(line)
    if m:
        newline = line[:m.start()] + f"[audit:{stamp}]" + line[m.end():]   # 重審 → 覆蓋舊留痕(新日期生效)
    else:
        newline = line.rstrip() + f" [audit:{stamp}]"
    new_lines = lines[:target_idx] + [newline] + lines[target_idx + 1:]

    def check(fields):
        summ = fields.get("summary")
        if not isinstance(summ, str):
            return False
        for l in summ.split("\n"):
            mi = INVARIANT_RE.match(l.strip())
            if mi and invariant_substr in INV_TAG_RE.sub("", l):
                return stamp in invariant_audit_refs(mi.group(1))
        return False

    try:
        atomic_write_verify(path, new_lines, f"[audit:{stamp}]", check)
    except (ValueError, RuntimeError) as ex:
        print(f"ERROR: {ex}", file=sys.stderr)
        return 2
    print(f"✓ 留痕 [audit:{stamp}] → {rel} 的 ★INVARIANT★")
    print("  前提:這條合法性已由無脈絡的獨立 agent 判過(maker≠checker)。doctor Check T 不再報『未審』。")
    return 0


def cmd_guard_trace(env, node=None):
    """合約 → 守衛測試 → Verification 證據 的鏈(reverse lookup)。
    用途:改某模組前,看它的 ★INVARIANT★ 各綁哪個測試、哪篇 Verification 背書 →
    breaking change 的爆炸半徑可查(grep 輸出某測試名即反查)。"""
    rel = None
    if node:
        rel = env.find(node)
        if rel is None:
            print(f"ERROR: 找不到節點 {node}", file=sys.stderr)
            return 2
    # 預掃所有 Verification 全文 → 之後查「哪篇提到某測試方法名」。
    # 剝 fenced/inline code(對齊 load_vault 的 body 連結抽取慣例 — code block 內宣告不算證據)。
    verif_text = {}
    for r in env.notes:
        if r.startswith("Verification/"):
            try:
                raw = (env.vault / r).read_text(encoding="utf-8-sig")
                # ★同上:未閉合圍欄裡的測試名會被當成真佐證,污染合約證據鏈★
                verif_text[r] = _strip_code_text(raw)
            except Exception:
                verif_text[r] = ""
    # 多平台:refs 帶 平台: 前綴(如 android:X),但 Verification 文字寫的是裸方法名 X →
    # 搜尋前先剝前綴(顯示仍用完整 ref)。config 壞則當 legacy(不剝)。
    try:
        _pd = load_platforms(_repo_root_from_env(env))
        _split = _pd["platforms"] if _pd["multiplatform"] else {}
    except ValueError:
        _split = {}

    def _bare(mth):
        if _split and ":" in mth:
            p, n = mth.split(":", 1)
            if p.strip() in _split:
                return n.strip()
        return mth

    targets = [rel] if rel else sorted(env.notes)
    nodes_with_inv = 0
    short_names = set()
    for r in targets:
        inv, _ = extract_contracts(env.notes[r])
        if not inv:
            continue
        nodes_with_inv += 1
        print(f"# {r}")
        for x in inv:
            clean, refs = strip_test_refs(x)
            print(f"  ★INVARIANT★ {clean[:78]}")
            if not refs:
                print("      ↳ ⚠ 未綁測試")
                continue
            for mth in refs:
                bare = _bare(mth)   # 剝平台前綴後才是 Verification 文字裡的方法名
                if len(bare) < 10:
                    short_names.add(bare)
                # re.ASCII:方法名 ASCII;否則中文緊貼方法名(無空格)時 \b 失效漏命中
                pat = re.compile(r"\b" + re.escape(bare) + r"\b", re.ASCII)
                vs = sorted(env.notes[vr].stem for vr, t in verif_text.items() if pat.search(t))
                tail = ", ".join(vs) if vs else "(無 Verification 提到此守衛)"
                print(f"      ↳ [test:{mth}]  →  {tail}")
    if nodes_with_inv == 0:
        print("(無 ★INVARIANT★ 合約)" if rel else "(全 vault 無合約)")
        return 0
    print("\n※ 「→」是 Verification 全文【字串命中】(非結構化背書):不分正/否定句,"
          "也抓不到「有驗但沒寫方法名」的篇。當證據鏈線索用,別當鐵證。")
    if short_names:
        print(f"⚠ 短方法名 {sorted(short_names)} 易誤命中(全文裡剛好出現該字),建議用長、領域專屬名。")
    return 0


def cmd_sync_verified_by(env, apply=False):
    """補 doctor Check 3 抓到的 verified_by 漏寫(Verification 連到 Systems、但 Systems.verified_by 沒列)。
    只動這一個『零判斷』項 — orphan 補掛 / plan_refs 需語意判斷,不在此自動修。
    dry-run 預設;--apply 才寫(T1 atomic append,自帶 dedup)。"""
    from collections import defaultdict
    notes, resolve = env.notes, env.resolve
    expected = defaultdict(set)
    for r, n in notes.items():
        if not r.startswith("Verification/"):
            continue
        # 對齊 Check 3 skip 集(stale/fail 2026-07-15;superseded 真遺忘第二刀 2026-07-26):
        # 失效/作廢驗證不構成雙向義務,sync 不得反向補回(否則 E1 掛回又報死背書、search 藏了又被撿)。
        if status_of(env, r).strip() in ("stale", "fail", "superseded"):
            continue
        for t in n.targets:
            dest = resolve(t)
            if dest and dest.startswith("Systems/"):
                expected[dest].add(r)
    planned = []
    for sys_rel, verif_rels in sorted(expected.items()):
        actual = {resolve(link_target(a))
                  for a in as_list(notes[sys_rel].fields.get("verified_by"))}
        actual.discard(None)
        for v in sorted(verif_rels):
            if v not in actual:
                vl = v[:-3] if v.endswith(".md") else v
                planned.append((sys_rel, f"[[{vl}]]"))
    if not planned:
        print("✓ verified_by 已全同步,無漏寫")
        return 0
    for sys_rel, vl in planned:
        print(f"  {'+' if apply else '·'} {sys_rel}  ← {vl}")
    if not apply:
        print(f"\n{len(planned)} 筆待補(dry-run)。加 --apply 真寫入。")
        print("※ 判準同 doctor Check 3:Verification 連到某 Systems 即視為驗證它。"
              "若連結是『描述性提及』(如「取代 [[Systems/舊]]」)會誤補 → 先審這份 dry-run 再 --apply。")
        return 0
    print()
    n_ok = 0
    for sys_rel, vl in planned:
        try:
            if cmd_append(env, sys_rel, "verified_by", vl) == 0:
                n_ok += 1
        except (ValueError, RuntimeError) as ex:
            print(f"  ✗ {sys_rel} {vl}: {ex}", file=sys.stderr)
    print(f"\n✓ 補了 {n_ok}/{len(planned)} 筆 verified_by")
    return 0


def _node_age_days(n):
    """節點日齡(天):Verification 用 date:、System 用 updated:。
    取不到或格式異常 → None(不參與日齡判斷)。90 天紅標的共用來源(cmd_context + doctor Check V)。"""
    import datetime
    date_str = n.fields.get("date") or n.fields.get("updated") or ""
    if not date_str:
        return None
    try:
        return (datetime.date.today() - datetime.date.fromisoformat(str(date_str))).days
    except ValueError:
        return None


# ── 相關節點推薦(BFS-decay+共引+Jaccard × BM25F 融合;spec:檢索優化_計劃 §2) ──

def _reco_adj(env):
    """無向鄰接表(全部邊型:body wikilink+frontmatter list)。"""
    adj = {}
    for rel, n in env.notes.items():
        for tgt in n.targets:
            dst = env.resolve(tgt)
            if dst and dst != rel:
                adj.setdefault(rel, set()).add(dst)
                adj.setdefault(dst, set()).add(rel)
    return adj


def _reco_scores(env, seed, depth=2):
    """回 {rel: {"hop","B","C","J","G"}}(不含 seed)。
    B=min(1, 2/2^k);C=max 共引飽和(同行×2/同節點×1,每引用者一次);J=鄰域 Jaccard。"""
    adj = _reco_adj(env)
    # BFS 最短距(每節點一次)
    hops, frontier, seen = {}, {seed}, {seed}
    for k in range(1, depth + 1):
        nxt = set()
        for u in frontier:
            for v_ in adj.get(u, ()):
                if v_ not in seen:
                    seen.add(v_)
                    hops[v_] = k
                    nxt.add(v_)
        frontier = nxt
    # 共引:掃引用 seed 的節點 u,同行/同節點的其他 wikilink
    craw = {}
    seed_stem = env.notes[seed].stem
    for u, n in env.notes.items():
        if u == seed:
            continue
        try:
            text = (env.vault / u).read_text(encoding="utf-8-sig")
        except Exception:
            continue
        if f"[[{seed_stem}" not in text and f"[[Systems/{seed_stem}" not in text \
           and not any(env.resolve(tg) == seed for tg in n.targets):
            continue
        contrib = {}
        for line in text.split("\n"):
            links = [env.resolve(m.group(1).split("|")[0].split("#")[0])
                     for m in re.finditer(r"\[\[([^\]]+)\]\]", line)]
            links = [x for x in links if x]
            if seed in links:
                for other in links:
                    if other not in (seed, u):
                        contrib[other] = max(contrib.get(other, 0), 2)   # 同行=2
        for tg in n.targets:
            dst = env.resolve(tg)
            if dst and dst not in (seed, u) and dst not in contrib \
               and any(env.resolve(t2) == seed for t2 in n.targets):
                contrib[dst] = 1   # 同節點=1
        for other, w in contrib.items():
            craw[other] = craw.get(other, 0) + w
    gs = env.notes and adj.get(seed, set())
    out = {}
    for rel, k in hops.items():
        B = min(1.0, 2.0 / (2 ** k))
        cr = craw.get(rel, 0)
        C = cr / (cr + 2.0)
        gv = adj.get(rel, set())
        inter = len(gs & gv) if gs else 0
        union = len(gs | gv) if (gs or gv) else 1
        J = inter / union if union else 0.0
        out[rel] = {"hop": k, "B": B, "C": round(C, 4), "J": round(J, 4),
                    "G": round(0.60 * B + 0.25 * C + 0.15 * J, 4)}
    # 共引但不在 BFS 深度內的節點也納入(hop 記為 depth,B 用共引者路徑近似 2 hop)
    for rel, cr in craw.items():
        if rel not in out and rel != seed and rel in env.notes:
            C = cr / (cr + 2.0)
            out[rel] = {"hop": 2, "B": 0.5, "C": round(C, 4), "J": 0.0,
                        "G": round(0.60 * 0.5 + 0.25 * C, 4)}
    return out


def _reco_fused(env, seed, top=8, min_score=0.20, depth=2):
    """G × BM25F 融合(query=seed 的 title+summary+tags)。R=0.6L+0.4G;
    hop1 只受靜態底線;hop≥2 需 L>0。回 list[dict] 依 R 降冪。"""
    gscores = _reco_scores(env, seed, depth=depth)
    if not gscores:
        return []
    sf = _rank_fields(env, seed)
    query = " ".join([sf["title"], sf["summary"], sf["tags"]])
    # 結構前綴停用(KEY:/FLOW:…是 summary 模板詞,人人都有——不算詞彙訊號)
    _STOP = {"key", "flow", "dep", "test", "verify", "auth", "decision", "flag",
             "core", "type", "status", "system", "systems"}
    q_toks = [tok for tok in _rank_tokenize(query) if tok not in _STOP]
    scored = {rel: s for rel, s, _h in _rank_score_candidates(env, " ".join(q_toks), list(gscores))}
    mx = max(scored.values()) if scored else 0.0
    out = []
    for rel, g in gscores.items():
        L = (scored.get(rel, 0.0) / mx) if mx > 0 else 0.0
        if g["hop"] >= 2 and L <= 0:
            continue   # 遠端需詞彙背書(spec §2 r1)
        R = round(0.60 * L + 0.40 * g["G"], 4)
        if R < min_score:
            continue
        out.append({"node": rel, "score": R, "L": round(L, 4), **g})
    out.sort(key=lambda x: (-x["score"], x["node"]))
    return out[:max(int(top), 1)]


def _usage_log(env, rel, cmd):
    """A2 事件帳種子(節點靜態先驗_調研):記「節點真的被查閱採用」的 append 帳。
    先累語料不進分數;未來 frecency=查詢時現算(Firefox 教訓:不存時變分數)。best-effort 靜默。"""
    try:
        import datetime as _dt
        p = env.vault.parent / ".usage-log.jsonl"
        with open(p, "a", encoding="utf-8") as fh:
            fh.write(json.dumps({"ts": _dt.datetime.now().isoformat(timespec="seconds"),
                                 "node": rel, "cmd": cmd}, ensure_ascii=False) + "\n")
    except Exception:
        pass


def cmd_show(env, rel, body_only=False):
    """節點檔完整內容(frontmatter+body)——context 是壓縮導航,show 是完整真相讀取
    (Projects/lumos-show讀取入口_計劃)。不改架構圖節點檔;usage-log 事件帳同 context 慣例。"""
    _usage_log(env, rel, "show")
    p = env.vault / rel
    try:
        text = p.read_text(encoding="utf-8-sig")  # -sig: 同 load_vault 慣例,BOM 不外洩進輸出
    except Exception as e:
        # load_vault 容忍讀檔失敗節點(壞 symlink/權限/race 刪檔)照進索引 → 重開檔須自防
        print(f"ERROR: 讀檔失敗: {rel}: {e}", file=sys.stderr)
        return 2
    if body_only:
        _, text = split_frontmatter(text)  # 無 frontmatter → (None, 原文) → 印整檔
    sys.stdout.write(text if text.endswith("\n") or not text else text + "\n")
    return 0


def cmd_context(env, rel, brief=False, recommend=False, top=8, min_score=0.20, as_json=False):
    """節點 + 鄰居 summary 壓縮索引 — MemPalace closet 具象化
    brief=True: 只給 meta + summary 首兩行 + 鄰居名單(壓 token 用)"""
    n = env.notes[rel]
    _usage_log(env, rel, "context")
    out_e, in_e = env.edges
    meta = " | ".join(f"{k}:{n.fields[k]}" for k in ("type", "status", "created", "updated")
                      if isinstance(n.fields.get(k), str) and n.fields.get(k))
    # 額外 tag 家族上頭部(2026-08-05,Enzo:「是給你(AI)看的」)——priority/scope/flag 等
    # 寫給 AI 的分類資訊原本在進場主讀路徑(context 頭部)上隱形,實測 gap
    _extra = [t for t in (n.fields.get("tags") or [])
              if isinstance(t, str) and "/" in t
              and not t.startswith(("type/", "status/"))]
    if _extra:
        meta += " | " + " | ".join(t.replace("/", ":", 1) for t in _extra)
    print(f"# {rel}")
    if meta:
        print(meta)
    vu = _conds(n.fields.get("valid_under"))
    if vu:
        age = _node_age_days(n)
        flag = f"[⚠ 節點已 {age} 天未更新,前提條件可能失效]" if (age is not None and age > 90) else ""
        print(f"⚠ 使用前驗證(valid_under){flag}:")
        for c in vu:
            print(f"  {c}")
    inv, debt = extract_contracts(n)
    if inv or debt:
        print("⚠ 合約(動前必讀):")
        for x in inv:
            print(f"  ★INVARIANT★ {x}")
        for x in debt:
            print(f"  ★DEBT★ {x}")
    summ = n.fields.get("summary")
    if isinstance(summ, str) and summ:
        lines = summ.split("\n")
        if brief:
            lines = lines[:2]
        print("summary:")
        for l in lines:
            print(f"  {first_line(l, 100) if brief else l}")
    for key in ("verified_by", "plan_refs", "core_refs"):
        vals = as_list(n.fields.get(key))
        if vals:
            print(f"{key}: {', '.join(vals)}")
    for label, rows in (("→ 連出", sorted(set(out_e.get(rel, [])))),
                        ("← 連入", sorted(set(in_e.get(rel, []))))):
        print(f"{label} ({len(rows)}):")
        for d in rows:
            if brief:
                print(f"  • {d} [{status_of(env, d)}]")
                continue
            nb = env.notes[d]
            s = nb.fields.get("summary")
            hint = first_line(s if isinstance(s, str) else "")
            print(f"  • {d} [{status_of(env, d)}]" + (f" — {hint}" if hint else ""))
    if recommend:
        recos = _reco_fused(env, rel, top=top, min_score=min_score)
        if as_json:
            import json as _json
            print(_json.dumps({"node": rel, "recommend": recos}, ensure_ascii=False))
        else:
            print("\n相關節點推薦(圖分×詞彙融合 top-%d):" % top)
            shown = {}
            for x in recos:
                key = re.sub(r"_[^_]+$", "", Path(x["node"]).stem)
                if key in shown:
                    shown[key] += 1
                    continue
                shown[key] = 0
                print(f"  {x['score']:5.2f}  {x['node']}  (hop{x['hop']} L={x['L']})")
            sisters = sum(v for v in shown.values() if v)
            if sisters:
                print(f"  (+姐妹 {sisters};--json 全量)")
    return 0
def parse_decisions(fm_lines):
    """從 frontmatter 原始行解析 decisions 陣列(content/decided/valid/superseded_by/ended)"""
    items = []
    i, n = 0, len(fm_lines)
    while i < n and not re.match(r"^decisions:\s*$", fm_lines[i]):
        i += 1
    if i >= n:
        return items
    i += 1
    cur = None

    def indent(s):
        return len(s) - len(s.lstrip(" "))

    while i < n:
        line = fm_lines[i]
        if line.strip() and not line.startswith(" "):
            break  # 下一個 top-level key
        m_item = re.match(r"^(\s*)-\s+([\w-]+):\s*(.*)$", line)
        m_kv = re.match(r"^(\s+)([\w-]+):\s*(.*)$", line)
        if m_item:
            cur = {}
            items.append(cur)
            key, val = m_item.group(2), m_item.group(3).strip()
            base = indent(line)
            key_col = base + 2          # dash line: key 在「- 」之後,有效欄位 = base+2
        elif m_kv and cur is not None:
            key, val = m_kv.group(2), m_kv.group(3).strip()
            base = indent(line)
            key_col = base              # 子欄位: key 欄位 = base
        else:
            i += 1
            continue
        if val in ("|", "|-", ">", ">-"):
            # block scalar 終止 = 首個縮排 <= key_col 的非空行(否則會把兄弟欄位吸進 content,Bug1)
            block = []
            i += 1
            while i < n and (not fm_lines[i].strip() or indent(fm_lines[i]) > key_col):
                if fm_lines[i].strip():
                    block.append(fm_lines[i].strip())
                i += 1
            cur[key] = "\n".join(block)
            continue
        if val == "":
            lst = []
            i += 1
            while i < n and fm_lines[i].strip() and indent(fm_lines[i]) > base \
                    and re.match(r"^\s+-\s+", fm_lines[i]):
                lst.append(strip_quotes(re.match(r"^\s+-\s+(.*)$", fm_lines[i]).group(1).strip()))
                i += 1
            cur[key] = lst
            continue
        cur[key] = strip_quotes(val)
        i += 1
    return items


def fmt_decision(d):
    mark = "✅" if str(d.get("valid", "true")).lower() != "false" else "❌"
    line = f"{mark} [{d.get('decided', '?')}] {first_line(d.get('content', ''), 100)}"
    if d.get("superseded_by"):
        line += f" → {d['superseded_by']}"
    return line


def cmd_decisions(env, rel=None, superseded=False):
    if superseded:
        found = []
        for r, n in sorted(env.notes.items()):
            for d in parse_decisions(n.fm_lines):
                if str(d.get("valid", "true")).lower() == "false":
                    found.append(f"{n.stem}: {first_line(d.get('content', ''), 80)}"
                                 f" → {d.get('superseded_by', '?')}")
        print("\n".join(found) if found else "無被推翻的決策")
        return 0
    ds = parse_decisions(env.notes[rel].fm_lines)
    if not ds:
        print(f"{rel}: 無 decisions")
        return 0
    for d in ds:
        print(fmt_decision(d))
    return 0


def _conds(val):
    """frontmatter list / 字串 / block scalar → 逐條件展開(去空行)。
    block scalar 存成含 \\n 的單一字串,split 開以免後續行被 first_line 截掉。"""
    out = []
    for c in as_list(val):
        out += [ln.strip() for ln in str(c).split("\n") if ln.strip()]
    return out


def _graph_pagerank(env, personalization=None, damping=0.85, tol=1e-6, max_iter=50):
    """[S1] 中心性/PPR helper(中心性重驗排程_計劃+檢索PPR邊權_計劃,2026-07-28):
    節點集=vault 全節點排 type=moc;邊=env.edges(ghost 建邊已丟);L1 收斂 1e-6/50 迭代。
    personalization=None(③ 語意):有向、均勻 teleport、dangling 均攤——行為恆定不變。
    personalization={rel:w}(② 語意):傳播圖**對稱化**(vault 連結大宗=新筆記→舊節點,有向會漏
    in-link-only 真相關)、teleport 與 dangling 質量皆回種子向量;域外種子(moc/不存在)由本
    helper 濾除後重歸一(合約 owner=helper),全濾/空集=回空 dict(呼叫端視為 P 缺席)。
    誠實:本圖幾百節點下近似平滑 in-degree(A3 消融紀錄在案;PPR 檢索分量 2026-07-28
    edit 卷消融同敗——personalization 保留為 ③ 之參數位與通用原語,檢索用途勿復活)。"""
    out_e, _in_e = env.edges
    nodes = [rel for rel, n in env.notes.items() if str(n.fields.get("type") or "") != "moc"]
    node_set = set(nodes)
    N = len(nodes)
    if N == 0:
        return {}
    outs = {r: [d for d in out_e.get(r, []) if d in node_set] for r in nodes}
    seeds = None
    if personalization is not None:
        seeds = {r: w for r, w in personalization.items() if r in node_set and w > 0}
        if not seeds:
            return {}
        tot = sum(seeds.values())
        seeds = {r: w / tot for r, w in seeds.items()}
        sym = {r: set(outs[r]) for r in nodes}
        for r in nodes:
            for d in outs[r]:
                sym[d].add(r)
        outs = {r: sorted(sym[r]) for r in nodes}

    def _tp(r):
        return seeds.get(r, 0.0) if seeds is not None else 1.0 / N

    pr = {r: _tp(r) for r in nodes} if seeds is not None else {r: 1.0 / N for r in nodes}
    for _ in range(max_iter):
        dangling = sum(pr[r] for r in nodes if not outs[r])
        new = {r: (1 - damping) * _tp(r) + damping * dangling * _tp(r) for r in nodes}
        for r in nodes:
            o = outs[r]
            if o:
                share = damping * pr[r] / len(o)
                for d in o:
                    new[d] += share
        delta = sum(abs(new[r] - pr[r]) for r in nodes)   # L1 norm
        pr = new
        if delta < tol:
            break
    return pr


def _hazen_percentile(pr):
    """Hazen 百分位 (rank−0.5)/N,同分 average-rank——開區間永不 0/1(防最低分歸零沉底)。"""
    import bisect
    vals = sorted(pr.values())
    N = len(vals)
    if N == 0:
        return {}
    out = {}
    for r, v in pr.items():
        lo = bisect.bisect_left(vals, v)
        hi = bisect.bisect_right(vals, v)
        avg_rank = (lo + 1 + hi) / 2.0        # 1-based average rank
        out[r] = (avg_rank - 0.5) / N
    return out


_STALE_DATE_RE = re.compile(r"^(\d{4}-\d{2}-\d{2})")


def _stale_days(n, today):
    """陳舊天數:date 欄→檔名日期前綴→created→None(三層全缺,呼叫端剔除+警示)。"""
    import datetime
    for src in (str(n.fields.get("date") or "").strip(), n.stem,
                str(n.fields.get("created") or "").strip()):
        m = _STALE_DATE_RE.match(src)
        if m:
            try:
                d = datetime.date.fromisoformat(m.group(1))
                return max(0, (today - d).days)
            except ValueError:
                continue
    return None


def cmd_stale(env, match=None, candidate=False, legacy=False):
    if match is not None and not match.strip():          # NEW-1:空 --match 會 "" in c 恆真=全掃
        print("ERROR: --match 不可為空字串", file=sys.stderr)
        return 2
    if candidate and not match:                          # Finding 6:bare --candidate ≈ 列全部=噪音
        print("ERROR: --candidate 必須配 --match <關鍵字>(例: stale --candidate --match DispatchLog)。\n"
              "  語意=『改某流程時,哪些活躍 Verification 的 revalidate_when 提到該關鍵字 → 該重驗』;\n"
              "  本架構圖每篇 Verification 都有 revalidate_when,不帶 --match = 列全部,無篩選意義。",
              file=sys.stderr)
        return 2
    if candidate:
        # 聚焦查詢:活躍(非 Archive)+ revalidate_when 提到關鍵字 = 「改 X 時該重驗的那幾篇」。
        # 與純 --match 的差別:只掃 revalidate_when(未來重驗條件,不含 valid_under 快照條件)、排 Archive。
        rows, n_hit = [], 0
        for rel, n in sorted(env.notes.items()):
            if not rel.startswith("Verification/") or "/Archive/" in rel:
                continue
            rw = [c for c in _conds(n.fields.get("revalidate_when")) if match in c]
            if not rw:
                continue
            n_hit += 1
            rows.append(f"{rel} [{status_of(env, rel) or 'no-status'}]")
            rows += [f"    ↳ {first_line(c, 90)}" for c in rw]
        if not rows:
            print(f"無 revalidate_when 提到『{match}』的活躍 Verification")
            return 0
        print("\n".join(rows))
        print(f"\n{n_hit} 篇 revalidate_when 提到『{match}』→ 逐一判斷是否需重驗"
              f"(`lumos set <篇> status stale`)。")
        return 0
    if match:
        rows = []
        for rel, n in sorted(env.notes.items()):
            if not rel.startswith("Verification/"):
                continue
            arch = " [archived]" if "/Archive/" in rel else ""
            hit = [c for c in (_conds(n.fields.get("valid_under"))
                               + _conds(n.fields.get("revalidate_when"))) if match in c]
            if hit:
                rows.append(f"{rel} [{status_of(env, rel) or 'no-status'}]{arch}")
                rows += [f"    ↳ {first_line(h, 90)}" for h in hit]
        print("\n".join(rows) if rows else "無命中")
        return 0
    # bare 模式:風險加權排序([S2][S3] 中心性重驗排程_計劃;--legacy 保字母序=舊行為)
    import datetime
    import math
    cands = [(rel, n) for rel, n in sorted(env.notes.items())
             if rel.startswith("Verification/") and status_of(env, rel) == "stale"]
    if not cands:
        print("無 status:stale 的驗證")
        return 0
    if legacy:
        for rel, _n in cands:
            arch = " [archived]" if "/Archive/" in rel else ""
            print(f"{rel} [stale]{arch}")
        return 0
    pct = _hazen_percentile(_graph_pagerank(env))
    idx = build_typed_index(env)
    today = datetime.date.today()
    linked, unlinked = [], []
    for rel, n in cands:
        days = _stale_days(n, today)
        if days is None:
            print(f"⚠ {rel}: date/檔名前綴/created 三層皆缺,無法算陳舊天數——已剔除(fail-visible),請補 date 欄",
                  file=sys.stderr)
            continue
        objs = [s for s, et in idx["rev"].get(rel, []) if et == "verified_by" and s in pct]
        if objs:
            p_ = max(pct[s] for s in objs)
            risk = p_ * (1 + math.log1p(days))
            band = "高" if p_ >= 2 / 3 else ("中" if p_ >= 1 / 3 else "低")
            linked.append((-risk, -days, rel, p_, band, days))
        else:
            unlinked.append((-days, rel, days))
    linked.sort()
    unlinked.sort()
    for negr, _nd, rel, p_, band, days in linked:
        arch = " [archived]" if "/Archive/" in rel else ""
        print(f"{rel} [stale]{arch}  risk={-negr:.2f} band={band} 天數={days}")
    for _nd, rel, days in unlinked:
        arch = " [archived]" if "/Archive/" in rel else ""
        print(f"{rel} [stale]{arch}  無鏈組 天數={days}")
    return 0


# query 收案態(--active 排除集):與各 type 的 status enum 對齊(2026-08-16 架構圖結構化查詢)
QUERY_CLOSED_STATUSES = {"done", "pass", "superseded", "resolved", "wontfix"}


def cmd_query(env, tags=None, no_tags=None, active=False, contract=False,
              linked=None, include_superseded=False, as_json=False):
    """結構化查詢:WHERE over 標籤家族(旗標一律 AND 疊加,不發明查詢語言)。
    [[Projects/架構圖結構化查詢_計劃]] borrow-design 自 zk list 旗標語意。"""
    tags = tags or []
    no_tags = no_tags or []
    if not (tags or no_tags or active or contract or linked):
        print("ERROR: query 至少要帶一個條件(--tag/--no-tag/--active/--contract/--linked),"
              "不帶條件=列全庫,無篩選意義(例: query --tag risk/金流 --active)。",
              file=sys.stderr)
        return 2
    scope = None
    if linked:
        anchor = env.find(linked)
        if anchor is None:
            print(f"ERROR: 找不到筆記: {linked}", file=sys.stderr)
            return 2
        out_e, in_e = env.edges
        scope = (set(out_e.get(anchor, ())) | set(in_e.get(anchor, ()))) - {anchor}
    hits, hidden = [], 0
    for rel in sorted(env.notes):
        if scope is not None and rel not in scope:
            continue
        n = env.notes[rel]
        ntags = set(as_list(n.fields.get("tags")))
        if any(t not in ntags for t in tags):
            continue
        if any(t in ntags for t in no_tags):
            continue
        st = status_of(env, rel)
        if active and st in QUERY_CLOSED_STATUSES:
            continue
        if contract and not extract_contracts(n)[0]:
            continue
        if st == "superseded" and not include_superseded:
            hidden += 1
            continue
        hits.append((rel, st, sorted(t for t in ntags if not t.startswith(("type/", "status/")))))
    if hidden:
        print(f"（已隱藏 {hidden} 筆作廢結果，--include-superseded 顯示）", file=sys.stderr)
    if as_json:
        print(json.dumps({"results": [{"node": rel, "status": st, "tags": ts}
                                      for rel, st, ts in hits],
                          "hidden_superseded": hidden}, ensure_ascii=False, indent=2))
        return 0
    if not hits:
        print("無節點符合條件")
        return 0
    for rel, st, ts in hits:
        extra = f"  {','.join(ts)}" if ts else ""
        print(f"{rel} [{st or 'no-status'}]{extra}")
    print(f"\n{len(hits)} 節點命中")
    return 0


def cmd_recent(env, days):
    cutoff = time.time() - days * 86400
    rows = sorted(((n.mtime, rel) for rel, n in env.notes.items() if n.mtime >= cutoff),
                  reverse=True)
    for mt, rel in rows:
        print(f"{time.strftime('%Y-%m-%d %H:%M', time.localtime(mt))}  {rel}")
    print(f"({len(rows)} 篇 / 最近 {days} 天)")
    return 0


def cmd_stats(env):
    folders = defaultdict(int)
    for rel in env.notes:
        folders[rel.split("/")[0] if "/" in rel else "(root)"] += 1
    width = max(len(k) for k in folders)
    for k in sorted(folders):
        print(f"{k:<{width}}  {folders[k]}")
    print(f"{'total':<{width}}  {len(env.notes)}")
    return 0


def cmd_export(env, fmt, folders):
    out_e, _ = env.edges
    include = [rel for rel in env.notes
               if rel.split("/")[0] in folders]
    ids = {rel: f"n{i}" for i, rel in enumerate(sorted(include))}
    if fmt == "dot":
        print("digraph G {")
        for rel, nid in ids.items():
            label = env.notes[rel].stem.replace("\\", "\\\\").replace('"', '\\"')
            print(f'  {nid} [label="{label}"];')
        for rel, nid in ids.items():
            for d in out_e.get(rel, []):
                if d in ids:
                    print(f"  {nid} -> {ids[d]};")
        print("}")
        return 0
    print("flowchart LR")
    for rel, nid in ids.items():
        label = env.notes[rel].stem.replace('"', "&quot;")  # mermaid quoted label 逸出
        print(f'    {nid}["{label}"]')
    for rel, nid in ids.items():
        for d in sorted(set(out_e.get(rel, []))):
            if d in ids:
                print(f"    {nid} --> {ids[d]}")
    return 0


