def _html_model(env):
    """蒐集語意模型給 HTML 視圖:nodes(含 type/status/合約/stale/raw)+ typed edges。"""
    out_e, in_e = env.edges
    nodes, edges, seen = [], [], set()
    for rel, n in env.notes.items():
        inv, debt = extract_contracts(n)
        summ = n.fields.get("summary")
        summ = summ if isinstance(summ, str) else ""
        status = status_of(env, rel)
        ntype = n.fields.get("type")
        ntype = ntype if isinstance(ntype, str) and ntype else rel.split("/")[0].lower()
        try:
            raw = (env.vault / rel).read_text(encoding="utf-8-sig")
        except Exception:
            raw = ""
        _dt = n.fields.get("date") or n.fields.get("created")
        nodes.append({
            "id": rel, "label": n.stem, "rel": rel, "type": ntype, "status": status,
            "folder": rel.split("/")[0], "inv": inv, "debt": debt,
            "date": str(_dt) if _dt else "",
            "indeg": len(set(in_e.get(rel, []))),
            "summary": [l.strip() for l in summ.split("\n") if l.strip()][:6],
            "raw": raw,
        })
    # typed edges: plan_refs / verified_by / link
    for rel, n in env.notes.items():
        plan = {env.resolve(link_target(x)) for x in as_list(n.fields.get("plan_refs"))}
        verify = {env.resolve(link_target(x)) for x in as_list(n.fields.get("verified_by"))}
        plan.discard(None); verify.discard(None)
        for d in set(out_e.get(rel, [])):
            kind = "plan" if d in plan else "verify" if d in verify else "link"
            key = (rel, d, kind)
            if key not in seen:
                seen.add(key)
                edges.append({"source": rel, "target": d, "kind": kind})
    return {"nodes": nodes, "edges": edges}


_VIZ_LIBS = {
    "3d-force-graph": ("https://cdn.jsdelivr.net/npm/3d-force-graph",
                       '<script src="https://cdn.jsdelivr.net/npm/3d-force-graph"></script>'),
    "marked": ("https://cdn.jsdelivr.net/npm/marked@12.0.2/marked.min.js",
               '<script src="https://cdn.jsdelivr.net/npm/marked@12.0.2/marked.min.js"></script>'),
}
_FONT_LINKS = ('<link rel="preconnect" href="https://fonts.googleapis.com">\n'
               '<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>\n'
               '<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">')


def _fetch_text(url, cache):
    """下載文字資源並快取(scripts/vendor/)。離線重複 export 不再抓。
    用 curl(走系統憑證;macOS python urllib 常無 cert store 致 SSL verify 失敗)。"""
    import subprocess
    if cache.exists():
        return cache.read_text(encoding="utf-8")
    cache.parent.mkdir(parents=True, exist_ok=True)
    txt = subprocess.run(["curl", "-fsSL", url], capture_output=True, text=True,
                         timeout=60, check=True).stdout
    if not txt:
        raise RuntimeError("空回應")
    cache.write_text(txt, encoding="utf-8")
    return txt


def cmd_export_html(env, out_path, standalone=False):
    import json
    import datetime
    model = _html_model(env)
    # </script> 在嵌入 JSON 裡會提早關閉 <script> 標籤破壞整頁 → 轉義 </(標準作法)
    data = json.dumps(model, ensure_ascii=False).replace("</", "<\\/")
    stamp = datetime.date.today().isoformat()
    html = _HTML_TEMPLATE.replace("__DATA__", data).replace("__STAMP__", stamp) \
                         .replace("__VAULT__", env.vault.name) \
                         .replace("__NC__", str(len(model["nodes"]))) \
                         .replace("__EC__", str(len(model["edges"])))
    if standalone:
        # inline cytoscape/marked(去 CDN,防火牆/離線可開);字體退化系統字(移除 google link)
        vendor = Path(__file__).resolve().parent / "vendor"
        for name, (url, tag) in _VIZ_LIBS.items():
            try:
                src = _fetch_text(url, vendor / f"{name}.min.js").replace("</script", "<\\/script")
            except Exception as e:
                print(f"ERROR: --standalone 需抓 {name}(此機需一次網路): {e}", file=sys.stderr)
                return 2
            html = html.replace(tag, f"<script>{src}</script>")
        html = html.replace(_FONT_LINKS, "<!-- standalone: 字體退化系統字(無外部 CDN) -->")
    Path(out_path).write_text(html, encoding="utf-8")
    mode = "standalone(自包含/離線可開)" if standalone else "CDN"
    print(f"✓ export html [{mode}]: {out_path}  ({len(model['nodes'])} 節點 / {len(model['edges'])} 邊)")
    return 0


# ═══════════════════════ 階段三: 寫側 T1(行級手術) ═══════════════════════

SCALAR_KEYS = {"status", "updated", "created", "type", "self_audit", "signed_off", "regen", "pitfall_ask", "pitfall_source"}  # pitfall_* 2026-08-09 已知坑策展庫
LIST_KEYS = {"verified_by", "plan_refs", "related", "tags", "aliases", "pitfall_when", "core_refs"}   # aliases 2026-08-05;pitfall_when 2026-08-09(已知坑策展庫,content-trigger);core_refs 2026-08-11(升格加指針/降格拆指針,兩向都要 T1;值是純路徑非 wikilink——lumos-core-knowledge skill 明令禁跨 vault wikilink)
LINK_KEYS = ("verified_by", "plan_refs", "related", "core_refs")  # S2「純連結欄位」子集(≠LIST_KEYS:那是 append 白名單,pitfall_when=content-trigger 不算連結);spec=Projects/code側刪除傳播守衛_計劃
DATE_KEYS = {"updated", "created", "date", "decided", "ended"}
DATE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")


def fm_structure(fm_lines):
    """回傳 ordered [(key, start, end, kind)]，kind ∈ scalar/list/block。
    end = 該 key 區塊最後一行的 index(含)。"""
    out = []
    i, n = 0, len(fm_lines)
    while i < n:
        m = TOP_KEY_RE.match(fm_lines[i])
        if not m:
            i += 1
            continue
        key, val = m.group(1), m.group(2).strip()
        start = i
        if val in ("|", "|-", ">", ">-"):
            i += 1
            while i < n and (fm_lines[i].startswith("  ") or not fm_lines[i].strip()):
                i += 1
            out.append((key, start, i - 1, "block"))
        elif val == "":
            # 消費所有縮排行(含 list item 的 sub-mapping,如 decisions 的 content/decided),
            # 與 parse_frontmatter 一致 → fm_structure 算出的 end 涵蓋整個區塊(BUG-5 對齊)
            i += 1
            while i < n and (fm_lines[i].startswith(" ") or not fm_lines[i].strip()):
                i += 1
            out.append((key, start, i - 1, "list"))
        else:
            out.append((key, start, start, "scalar"))
            i += 1
    return out


def fmt_scalar(key, value):
    """純量值格式化。日期 bare(不加引號避污染指紋);含 ': ' 或特殊字元才引號。"""
    v = value.strip()
    if key in DATE_KEYS:
        if not DATE_RE.match(v):
            raise ValueError(f"{key} 需 YYYY-MM-DD,得到: {v}")
        return v  # bare,絕不加引號
    # YAML 型別劫持守衛: true/false/null/yes/no/~ 與純數字當 status 會被解析成 bool/num/null
    if v.lower() in ("true", "false", "null", "yes", "no", "on", "off", "~") or \
       re.fullmatch(r"-?\d+(\.\d+)?", v):
        return '"' + v + '"'
    if re.search(r":\s|^[\[\{>|*&!#@`]|^\s|\s$", v) or v == "":
        return '"' + v.replace('"', '\\"') + '"'
    return v


def fmt_list_item(value):
    """list 項格式化。wikilink / 含特殊字元 → 引號(鐵則1 安全:一項一行)。"""
    v = value.strip()
    if v.startswith("[[") or re.search(r":\s|^[\[\{]", v):
        return '"' + v.replace('"', '\\"') + '"'
    return v


def edit_fm_scalar(fm_lines, key, value):
    fm = list(fm_lines)
    formatted = fmt_scalar(key, value)
    struct = {k: (s, e, kind) for k, s, e, kind in fm_structure(fm)}
    if key in struct:
        s, e, kind = struct[key]
        if kind != "scalar":
            raise ValueError(f"{key} 是 {kind} 型,set 只改純量(list 用 append,巢狀用 T3)")
        fm[s] = f"{key}: {formatted}"
    else:
        # 插在開頭純量區之後(第一個 list/block key 之前,否則末尾)
        ins = len(fm)
        for k, s, e, kind in fm_structure(fm):
            if kind in ("list", "block"):
                ins = s
                break
        fm.insert(ins, f"{key}: {formatted}")
    return fm


def edit_fm_sync_status_tag(fm_lines, status):
    """set status 的反正規化同步:tags 內既有 status/* 項就地改寫為 status/<新值>。
    無 tags/無 status/* 標籤則不動(純同步不發明;繞過本路徑的寫入由 lint/doctor
    漂移守衛兜底)。回傳 (new_fm, tags 內有無 status/* 標籤)。"""
    fm = list(fm_lines)
    struct = {k: (s, e, kind) for k, s, e, kind in fm_structure(fm)}
    if "tags" not in struct or struct["tags"][2] != "list":
        return fm, False
    s, e, _kind = struct["tags"]
    found = False
    for i in range(s + 1, e + 1):
        m = re.match(r"^(\s*-\s*)status/\S+\s*$", fm[i])
        if m:
            fm[i] = f"{m.group(1)}status/{status}"
            found = True
    return fm, found


def edit_fm_append(fm_lines, key, value):
    fm = list(fm_lines)
    item = fmt_list_item(value)
    tgt = link_target(value)
    struct = {k: (s, e, kind) for k, s, e, kind in fm_structure(fm)}
    if key in struct:
        s, e, kind = struct[key]
        if kind != "list":
            raise ValueError(f"{key} 是 {kind} 型,append 只加 list 項")
        # dedup: 精確 full-target 比對(保留路徑;非子字串、非 basename-only)
        for j in range(s + 1, e + 1):
            existing = fm[j].strip()
            if existing.startswith("-") and link_target(existing[1:]) == tgt:
                return fm  # 已存在,no-op
        # 偵測現有項縮排,否則預設 2 空格
        indent = "  "
        for j in range(s + 1, e + 1):
            if fm[j].lstrip().startswith("-"):
                indent = fm[j][:len(fm[j]) - len(fm[j].lstrip())]
                break
        # 插在最後一個非空行之後(避開區塊尾部空行,免在 list 中插出空行)
        last = e
        while last > s and not fm[last].strip():
            last -= 1
        fm.insert(last + 1, f"{indent}- {item}")
    else:
        ins = len(fm)
        fm.insert(ins, key + ":")
        fm.insert(ins + 1, f"  - {item}")
    return fm


def edit_fm_remove(fm_lines, key, value):
    """T1 list 項移除(append 的逆操作,同一套 link_target 精確比對)。

    回傳 (new_fm, removed_count)。removed_count==0 代表沒命中(呼叫端該報錯,
    不可靜默 no-op——打錯字卻回成功是本函式最該防的失敗)。
    命中多筆(歷史重複項)一次清乾淨。清完若 list 空了,連 key 行一起移除
    (留 `key:` 裸鍵會被 YAML 解成 null,doctor/lint 對「有鍵無值」的判讀比沒鍵更糟)。
    比對用 link_target():`[[A]]` / `[[Folder/A|alias]]` / 純路徑 `x/y.md` 一致處理,
    保留路徑不做 basename-only(同 append dedup,避免 Systems/X 誤刪 Verification/X)。"""
    fm = list(fm_lines)
    tgt = link_target(value)
    struct = {k: (s, e, kind) for k, s, e, kind in fm_structure(fm)}
    if key not in struct:
        raise ValueError(f"此筆記無 {key}")
    s, e, kind = struct[key]
    if kind != "list":
        raise ValueError(f"{key} 是 {kind} 型,remove 只移除 list 項")
    hits = []
    for j in range(s + 1, e + 1):
        existing = fm[j].strip()
        if existing.startswith("-") and link_target(existing[1:]) == tgt:
            hits.append(j)
    if not hits:
        return fm, 0
    for j in reversed(hits):
        del fm[j]
    # 清完是否還有存活項?沒有就把 key 行也拿掉(空 list 不留裸鍵)
    struct2 = {k: (a, b, c) for k, a, b, c in fm_structure(fm)}
    if key in struct2:
        s2, e2, _ = struct2[key]
        if not any(fm[j].strip().startswith("-") for j in range(s2 + 1, e2 + 1)):
            del fm[s2:e2 + 1]
    return fm, len(hits)


def decisions_items(fm_lines):
    """surgical 定位 decisions[] 的每個項目行範圍(不重序列化,延伸 T1 到巢狀)。
    回傳 (block_start, block_end, [(item_start, item_end)], item_indent, sub_indent)
    或 None(無 decisions)。item_end 含,已去尾部空行。處理項目內含 nested 子清單。"""
    block = None
    for k, s, e, kind in fm_structure(fm_lines):
        if k == "decisions" and kind == "list":
            block = (s, e)
            break
    if block is None:
        return None
    s, e = block
    item_indent = None
    starts = []
    for i in range(s + 1, e + 1):
        ln = fm_lines[i]
        if not ln.strip():
            continue
        m = re.match(r"^(\s*)-\s", ln)
        if m:
            ind = len(m.group(1))
            if item_indent is None:
                item_indent = ind
            if ind == item_indent:  # 只認最淺層 dash(子清單的 dash 更深,不算項目)
                starts.append(i)
    items = []
    for idx, st in enumerate(starts):
        en = (starts[idx + 1] - 1) if idx + 1 < len(starts) else e
        while en > st and not fm_lines[en].strip():
            en -= 1
        items.append((st, en))
    sub_indent = (item_indent + 2) if item_indent is not None else 4
    return s, e, items, (item_indent or 2), sub_indent


def load_raw_for_edit(path: Path):
    """讀 raw,拒 BOM/CRLF(本 vault 慣例 LF/no-BOM,異常不靜默正規化)。
    回傳 (all_lines, fm_start, fm_end_exclusive)。fm = all_lines[1:fm_end]。"""
    raw = path.read_bytes()
    if raw.startswith(b"\xef\xbb\xbf"):
        raise ValueError("T1 不寫 BOM 檔(慣例外),請用 obsidian CLI / 先正規化")
    if b"\r\n" in raw:
        raise ValueError("此檔是 CRLF(慣例要求 LF)。Windows 常見=git autocrlf;"
                         "修:確認 .gitattributes 已套用(vault 標 eol=lf)+ `git add --renormalize .`,"
                         "或單檔 `dos2unix`。lumos 不靜默改行尾。")
    lines = raw.decode("utf-8").split("\n")
    if not lines or lines[0].strip() != "---":
        raise ValueError("無 frontmatter,T1 不處理")
    fm_end = None
    for i in range(1, len(lines)):
        if lines[i].strip() == "---":
            fm_end = i
            break
    if fm_end is None:
        raise ValueError("frontmatter 未閉合")
    return lines, 1, fm_end


def _write_lf(path: Path, text: str):
    """寫 UTF-8 / LF / no-BOM,平台無關(不靠 text mode)。vault 唯一寫入原語。
    用 write_bytes:write_text(newline=) 要 Python 3.10,違反本專案 ≥3.8。
    [2026-08-05 單席快審 F2] tmp→os.replace 原子替換:防半寫毀檔(CLAUDE.md reinject 等
    整檔覆寫消費者)。read-modify-write 的併發 last-write-wins 窗仍在(單機 CLI,不上鎖,accepted)。"""
    import os as _os
    tmp = path.with_name(path.name + ".tmp-wlf")
    tmp.write_bytes(text.encode("utf-8"))
    _os.replace(tmp, path)


def atomic_write_verify(path: Path, new_lines, key, expected_check):
    """寫 tmp → re-parse 自驗 + lint 無新指紋 → atomic rename。任一步敗:tmp 丟棄,原檔不動。"""
    orig_fm = load_raw_for_edit(path)
    orig_lint = set(parse_frontmatter(orig_fm[0][1:orig_fm[2]])[2])
    text = "\n".join(new_lines)
    new_fm_lines = new_lines[1:]
    for i in range(1, len(new_lines)):
        if new_lines[i].strip() == "---":
            new_fm_lines = new_lines[1:i]
            break
    fields, _, new_lint = parse_frontmatter(new_fm_lines)
    if not expected_check(fields):
        raise RuntimeError(f"自驗失敗:{key} 寫入後值不符預期")
    introduced = set(new_lint) - orig_lint
    if introduced:
        raise RuntimeError("自驗失敗:引入新 frontmatter 指紋:" + "; ".join(sorted(introduced)))
    import os
    tmp = path.with_suffix(path.suffix + ".lumos-tmp")
    try:
        _write_lf(tmp, text)
        os.replace(tmp, path)
    finally:
        if tmp.exists():
            tmp.unlink()


def cmd_set(env, rel, key, value):
    if key not in SCALAR_KEYS:
        print(f"ERROR: set 白名單={sorted(SCALAR_KEYS)};{key} 不在內"
              f"(list 用 append;decisions 翻盤/新增用 decision-supersede / decision-add)", file=sys.stderr)
        return 2
    path = env.vault / rel
    lines, s, e = load_raw_for_edit(path)
    new_fm = edit_fm_scalar(lines[1:e], key, value)
    exp = fmt_scalar(key, value)
    exp_val = strip_quotes(exp)
    tag_synced = False
    if key == "status":
        new_fm, tag_synced = edit_fm_sync_status_tag(new_fm, exp_val)
    new_lines = lines[:1] + new_fm + lines[e:]

    def _check(f):
        if str(f.get(key, "")) != exp_val:
            return False
        if tag_synced:
            want = f"status/{exp_val}"
            tags = [t for t in as_list(f.get("tags")) if isinstance(t, str)]
            return want in tags and all(t == want for t in tags if t.startswith("status/"))
        return True

    atomic_write_verify(path, new_lines, key, _check)
    print(f"✓ set {rel}: {key} = {exp}" + (";tags 的 status/* 已同步" if tag_synced else ""))
    return 0


def cmd_self_audit(env, rel, model="sonnet", date=None):
    """L4 自足性審計留痕:寫 self_audit: <model>/<date> 到節點 frontmatter。
    語意:這整篇節點的「自足性」(無主對話脈絡的乾淨 agent 只讀架構圖能不能還原
    專案現況)已由一個獨立 agent 審過並通過。對應 guard audit 的角色(乾淨 agent
    審後蓋戳),但程式路徑獨立——這是節點級戳記,guard audit 是行級 [audit:]。
    工具只記留痕,不證明審計真乾淨——派 agent 的乾淨脈絡/中立 prompt 靠主對話誠實。"""
    import datetime
    if date is None:
        date = datetime.date.today().isoformat()
    else:
        try:
            datetime.date.fromisoformat(date)
        except ValueError:
            print(f"ERROR: --date 須為 YYYY-MM-DD:{date!r}", file=sys.stderr)
            return 2
    return cmd_set(env, rel, "self_audit", f"{model}/{date}")


def cmd_append(env, rel, key, value):
    if key not in LIST_KEYS:
        print(f"ERROR: append 白名單={sorted(LIST_KEYS)};{key} 不在內", file=sys.stderr)
        return 2
    path = env.vault / rel
    lines, s, e = load_raw_for_edit(path)
    new_fm = edit_fm_append(lines[1:e], key, value)
    new_lines = lines[:1] + new_fm + lines[e:]
    tgt = link_target(value)
    atomic_write_verify(path, new_lines, key,
                        lambda f: any(link_target(x) == tgt for x in as_list(f.get(key))))
    print(f"✓ append {rel}: {key} += {value}")
    return 0


def cmd_remove(env, rel, key, value):
    """T1 list 項移除(append 逆操作)。補的是 2026-08-11 實戰撞到的缺口:
    死背書(verified_by 指向已 superseded 的驗證)、降格後殘留的 core_refs 指針,
    都只能靠移除 list 項來收,但 set 只收純量、append 只能加,唯一合法退路
    (obsidian processFrontMatter)還要 Obsidian 開著 → 實務上等於無路可走。

    ★不命中一律 rc=2★:打錯字卻回成功,會讓呼叫端以為清乾淨了(死背書照舊掛著),
    比報錯危險得多。"""
    if key not in LIST_KEYS:
        print(f"ERROR: remove 白名單={sorted(LIST_KEYS)};{key} 不在內", file=sys.stderr)
        return 2
    path = env.vault / rel
    lines, s, e = load_raw_for_edit(path)
    new_fm, n = edit_fm_remove(lines[1:e], key, value)
    if n == 0:
        cur = [str(x) for x in as_list(parse_frontmatter(lines[1:e])[0].get(key))]
        print(f"ERROR: {rel} 的 {key} 找不到 {value}(比對 target={link_target(value)});"
              f"現有 {len(cur)} 項:{cur[:8]}{' …' if len(cur) > 8 else ''}", file=sys.stderr)
        return 2
    new_lines = lines[:1] + new_fm + lines[e:]
    tgt = link_target(value)
    atomic_write_verify(path, new_lines, key,
                        lambda f: not any(link_target(x) == tgt for x in as_list(f.get(key))))
    print(f"✓ remove {rel}: {key} -= {value}" + (f"(命中 {n} 項)" if n > 1 else ""))
    return 0


def _fm_of(all_lines):
    """從完整檔行抽 frontmatter 行(供 decision 自驗用 parse_decisions 重解)。"""
    for i in range(1, len(all_lines)):
        if all_lines[i].strip() == "---":
            return all_lines[1:i]
    return all_lines[1:]


def _fmt_decision_value(v):
    """decision 子欄位值格式化(含 ': ' 或特殊字元 → 引號,避鐵則 3)。"""
    v = v.strip()
    if re.search(r":\s|^[\[\{>|*&!#@`\"']|^\s|\s$", v) or v == "":
        return '"' + v.replace('"', '\\"') + '"'
    return v


def _decision_block(content, new_id, decided, item_indent, sub,
                    context=None, alternatives=None, why=None, trade_offs=None):
    """組裝一條 ADR 決策的 frontmatter 行。

    ★單一組裝源★——cmd_decision_add 有兩條路徑(無 decisions 時新建 / append 到既有),
    原本各自組裝一次 block。欄位一多,「只改一邊」就會讓首篇決策與後續決策欄位分歧
    (本專案 2026-08-01 才因同型的分支簿記漏一條被代碼審抓到)。抽成單一源後,新增
    欄位天生對兩條路徑同時成立,不靠人記得改兩處。

    欄位順序對齊 lumos-project-notes reference.md 的 ADR 完整版範例:
    content / id / context / alternatives_considered / why_chosen / trade_offs /
    decided / valid。巢狀清單項縮排 = sub + 2。
    """
    ip, sp = " " * item_indent, " " * sub
    block = [f"{ip}- content: {_fmt_decision_value(content)}", f"{sp}id: {new_id}"]
    if context:
        block.append(f"{sp}context: {_fmt_decision_value(context)}")
    if alternatives:
        block.append(f"{sp}alternatives_considered:")
        block += [f"{sp}  - {_fmt_decision_value(a)}" for a in alternatives]
    if why:
        block.append(f"{sp}why_chosen: {_fmt_decision_value(why)}")
    if trade_offs:
        block.append(f"{sp}trade_offs: {_fmt_decision_value(trade_offs)}")
    block += [f"{sp}decided: {decided}", f"{sp}valid: true"]
    return block


def cmd_decision_supersede(env, rel, match, by, ended=None):
    """T3 巢狀手術:把 decisions[] 中 content 含 match 的決策標 valid:false + 補
    superseded_by/ended。surgical line-based(不重序列化,最小 diff;優於 ruamel reflow)。
    [P1]:ended 缺則自動補今日 + 同步 bump 頂層 updated(單次 atomic,供 E2 時序法)。"""
    import datetime
    if ended and not DATE_RE.match(ended):
        raise ValueError(f"--ended 需 YYYY-MM-DD,得到: {ended}")
    path = env.vault / rel
    lines, s_fm, e_fm = load_raw_for_edit(path)
    fm = lines[1:e_fm]
    loc = decisions_items(fm)
    if loc is None:
        raise ValueError("此筆記無 decisions")
    if not loc[2]:  # block 存在但解析不到項目(Bug2:0-indent / 非標準縮排)
        raise ValueError("decisions 區塊解析不到項目(本工具要求 2-space 縮排,不支援 0-indent/tab)")
    _, _, items, _, sub = loc
    pad = " " * sub
    needle = nfc(match)
    id_mode = re.fullmatch(r"#d\d+", match.strip())
    if id_mode:
        # [M1/R12] #dN 精確定址:比對項內 id 行
        want = match.strip()[1:]
        hits = [(st, en) for (st, en) in items
                if any(re.match(rf"^{pad}id:\s*{re.escape(want)}\s*$", fm[i])
                       for i in range(st, en + 1))]
        if not hits:
            raise ValueError(f"以 {match} 定址查無決策——該節點決策可能尚無 id,先跑 lumos decision-reindex {rel}")
    else:
        hits = [(st, en) for (st, en) in items
                if needle in nfc("\n".join(fm[st:en + 1]))]
        if not hits:
            raise ValueError(f"找不到 content 含「{match}」的決策")
        if len(hits) > 1:
            # [M1/R12] 選擇端唯一命中:first-match 會「先改錯項、再用錯項 id 精確驗證它改成功」
            cands = "; ".join(first_line(fm[st].split("content:", 1)[-1].strip(), 40)
                              for (st, _) in hits[:5])
            raise ValueError(f"「{match}」命中 {len(hits)} 條決策,拒絕 first-match(防改錯項)。"
                             f"候選: {cands} …改用更長子字串或 --match \"#dN\" 精確定址")
    st, en = hits[0]
    valid_line = None
    for i in range(st, en + 1):
        if re.match(rf"^{pad}valid:\s", fm[i]):   # 只認精確 sub_indent(Bug5:移除過寬 fallback,免誤命中子清單)
            valid_line = i
            break
    if valid_line is None:
        raise ValueError("該決策無 valid 欄位(或縮排非標準 2-space),T3 不自動 supersede(請手動 / 確認結構)")
    # Bug3: 已 superseded 不重插(免重複鍵)。同 sub_indent 已有 superseded_by → 拒
    for i in range(st, en + 1):
        if re.match(rf"^{pad}superseded_by:\s", fm[i]):
            raise ValueError("該決策已有 superseded_by(已翻盤過),不重複 supersede;要改取代者請手動編輯")
    fm[valid_line] = f"{pad}valid: false"
    # [P1] ended 選填 → 缺則自動補今日(E2 時序法要 ended 才判得了「鄰居晚於翻案沒?」)
    if not ended:
        ended = datetime.date.today().isoformat()
    ins = [f"{pad}superseded_by: {_fmt_decision_value(by)}", f"{pad}ended: {ended}"]
    fm[valid_line + 1:valid_line + 1] = ins
    # [P1] supersede = 對本節點的實質編輯 → 同步 bump 頂層 updated(單次 atomic,同一份 fm;
    #   不串第二個寫命令避免半完成)。有則就地換、無則插在 decisions: 前(不動決策區索引)。
    today = datetime.date.today().isoformat()
    upd_i = next((k for k, ln in enumerate(fm) if re.match(r"^updated:\s", ln)), None)
    if upd_i is not None:
        fm[upd_i] = f"updated: {today}"
    else:
        dec_i = next((k for k, ln in enumerate(fm) if re.match(r"^decisions:\s*$", ln)), len(fm))
        fm[dec_i:dec_i] = [f"updated: {today}"]
    new_lines = lines[:1] + fm + lines[e_fm:]
    # [M1/P2] 讀 target 的 id → 組全域格式 <rel>#d<N> 回傳(下游 header/CASCADE/--from 同格式,無裸碼流出)
    did = None
    for i in range(st, en + 1):
        m = re.match(rf"^{pad}id:\s*(d\d+)\s*$", fm[i])
        if m:
            did = m.group(1)
            break
    gid = f"{rel}#{did}" if did else None

    def _check(_fields):
        for d in parse_decisions(_fm_of(new_lines)):
            # [M1] 有 id → ID 精確驗證(content 子字串重疊會驗錯項);無 id(未 reindex 舊節點)→ 退回 content 驗證
            hit = (str(d.get("id", "")).strip() == did) if did \
                else (needle in nfc(str(d.get("content", ""))))
            if hit:
                return str(d.get("valid", "")).lower() == "false" and "superseded_by" in d
        return False
    atomic_write_verify(path, new_lines, "decisions", _check)
    _tag = f" [{gid}]" if gid else ""
    print(f"✓ supersede {rel}: 決策「{match[:30]}」→ valid:false + superseded_by + ended={ended} (updated bump {today}){_tag}")
    return 0, gid


def _max_decision_id(fm_lines):
    """[M1/P2] 掃 decisions[] 既有 id: d<N>,回最大 N(無則 0)。新號=max+1(不重排既有、
    不回收缺號——ID 穩定性合約:翻案後永不重用)。"""
    mx = 0
    for d in parse_decisions(fm_lines):
        m = re.fullmatch(r"d(\d+)", str(d.get("id", "")).strip())
        if m:
            mx = max(mx, int(m.group(1)))
    return mx


def cmd_decision_add(env, rel, content, decided, context=None, why=None,
                     alternatives=None, trade_offs=None):
    """T3 巢狀手術:append 一條新 ADR 決策到 decisions[](無則建)。surgical line-based。
    [M1/P2]:指派穩定 id d<max+1> 並回傳 (rc, 全域決策id <rel>#d<N>);dispatcher 解包後
    CLI 對外仍只回整數 rc。
    [2026-08-26] ADR 四欄位補齊:alternatives_considered(巢狀清單)+ trade_offs。
    先前只支援 context/why_chosen,規範要求的四欄位寫不進 frontmatter,重大決策的
    「為什麼不選 B」與「代價是什麼」只能塞本文——而那正是 ADR 的價值所在。"""
    if not DATE_RE.match(decided):
        raise ValueError(f"--decided 需 YYYY-MM-DD,得到: {decided}")
    path = env.vault / rel
    lines, s_fm, e_fm = load_raw_for_edit(path)
    fm = lines[1:e_fm]
    loc = decisions_items(fm)
    new_id = f"d{_max_decision_id(fm) + 1}"
    if loc is None:
        # 無 decisions key → 在 fm 末尾建
        block = _decision_block(content, new_id, decided, 2, 4, context=context,
                                alternatives=alternatives, why=why, trade_offs=trade_offs)
        fm = fm + ["decisions:"] + block
    else:
        _, e_block, items, item_indent, sub = loc
        block = _decision_block(content, new_id, decided, item_indent, sub, context=context,
                                alternatives=alternatives, why=why, trade_offs=trade_offs)
        last = items[-1][1] if items else e_block
        fm[last + 1:last + 1] = block
    new_lines = lines[:1] + fm + lines[e_fm:]
    needle = nfc(content)

    def _check(_fields):
        # [M1] ID 精確驗證:新 id 那條存在且 content 相符(取代純 content 子字串——重疊時驗錯項)
        for d in parse_decisions(_fm_of(new_lines)):
            if str(d.get("id", "")).strip() != new_id:
                continue
            if needle not in nfc(str(d.get("content", ""))):
                return False
            # [2026-08-26] 四欄位寫後自驗:★寫了就要讀得回來★。只驗 id+content 的話,
            # 巢狀清單縮排寫錯會靜默通過(YAML 解成別的東西或吞進上一鍵),呼叫端拿到
            # rc=0 卻沒有 alternatives——同 remove「不命中回成功」那類最危險的假成功。
            if alternatives:
                got = d.get("alternatives_considered")
                if not isinstance(got, list) or \
                        [nfc(str(x)) for x in got] != [nfc(a.strip()) for a in alternatives]:
                    return False
            if trade_offs and nfc(str(d.get("trade_offs", ""))).strip() != nfc(trade_offs.strip()):
                return False
            return True
        return False
    atomic_write_verify(path, new_lines, "decisions", _check)
    print(f"✓ decision-add {rel}: 「{content[:30]}」(id={new_id}, valid:true)")
    return 0, f"{rel}#{new_id}"


def cmd_decision_reindex(env, rel=None, all_mode=False):
    """[M1/P2] 回填遷移:對既有無 id 決策依文件順序、從既有最大 id+1 接續編號(不重排既有、
    不回收缺號——混合狀態絕不撞既有 id);冪等(已有 id 跳過)。單節點一次一篇;--all 批次套用
    到所有有 decisions 的節點(decision_refs 自動養成前置 P;顯式指令、非隱式改)。
    解析不到的決策項明確拒絕(同 supersede 0-indent/tab 語意),不靜默跳過造成缺洞。"""
    if all_mode:
        targets = sorted(r for r, n in env.notes.items() if decisions_items(n.fm_lines) is not None)
        done = errs = 0
        for r in targets:
            try:
                cmd_decision_reindex(env, r)
                done += 1
            except (ValueError, RuntimeError, OSError) as e:   # [code-loop r1 A] 補 OSError:寫檔面(磁碟滿/權限)
                print(f"  ✗ {r}: {e}", file=sys.stderr)
                errs += 1
        print(f"✓ reindex --all: 掃 {len(targets)} 個決策節點,{done} 處理 / {errs} 拒絕(格式不合)")
        return 2 if errs else 0
    path = env.vault / rel
    lines, s_fm, e_fm = load_raw_for_edit(path)
    fm = lines[1:e_fm]
    loc = decisions_items(fm)
    if loc is None:
        raise ValueError("此筆記無 decisions")
    if not loc[2]:
        raise ValueError("decisions 區塊解析不到項目(本工具要求 2-space 縮排,不支援 0-indent/tab)")
    _, _, items, _, sub = loc
    pad = " " * sub
    nxt = _max_decision_id(fm) + 1
    # 先依文件順序算好指派,再由下而上插入(插入不位移未處理的上方索引)
    plan = []
    for (st, en) in items:
        if not any(re.match(rf"^{pad}id:\s*d\d+\s*$", fm[i]) for i in range(st, en + 1)):
            plan.append((st, f"d{nxt}"))
            nxt += 1
    if not plan:
        print(f"✓ reindex {rel}: 全部決策已有 id,無需回填(冪等)")
        return 0
    pre_ids = {str(d.get("id", "")).strip() for d in parse_decisions(fm) if d.get("id")}
    for st, did in reversed(plan):
        fm[st + 1:st + 1] = [f"{pad}id: {did}"]   # 插在 dash(content)行之後
    new_lines = lines[:1] + fm + lines[e_fm:]

    def _check(_fields):
        ds = parse_decisions(_fm_of(new_lines))
        ids = [str(d.get("id", "")).strip() for d in ds]
        return (all(re.fullmatch(r"d\d+", i) for i in ids)          # 全數有 id
                and len(ids) == len(set(ids))                        # 唯一
                and pre_ids <= set(ids))                             # 既有 id 未被動
    atomic_write_verify(path, new_lines, "decisions", _check)
    print(f"✓ reindex {rel}: 回填 {len(plan)} 條 id({plan[0][1]}..{plan[-1][1]});既有 {len(pre_ids)} 條跳過")
    return 0


# ── [M3/S5b] rel-cascade ledger:連鎖判定的 append-only 帳本 ──
# 設計/合約見 Projects/關係層主網_實作計畫 M3(3 輪 design-loop 釘死):
# 每 cascade 一檔 governance/rel-cascade/<cascade-id>.jsonl;行帶 event 判別欄
# (header|transition);重放折疊=只折 transition、同粒度鍵取檔內物理序最後一筆(沿
# canary-log 慣例:讀 append 序、不 ts-sort);torn 行(壞 JSON)=未提交,跳過。

CASCADE_ID_RE = re.compile(r"^[A-Za-z0-9._-]+$")
REL_CASCADE_EDGES = ("verified_by", "plan_refs")   # 方向語意明確的邊(related 弱,v1 恆不展)


def _rel_cascade_dir(env):
    """帳本目錄=<repo root>/governance/rel-cascade(可追蹤逐 cascade 檔,非 vault-parent 隱藏帳慣例——
    刻意設計)。repo root:docs/<slug>-knowledge 型= docs 的上層;standalone vault=vault 自身
    (絕不往系統 temp 等共用父層爬;.jsonl 非 .md,load_vault 不掃、無污染)。"""
    root = env.vault.parent.parent if env.vault.parent.name == "docs" else env.vault
    return root / "governance" / "rel-cascade"


def _utc_ts():
    import datetime
    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")


def _ledger_append(path, obj):
    """[M3 並行合約] O_APPEND fd + 單次 os.write() 整行 bytes(≤4KB 寫前拒,不截斷)。
    POSIX regular file 實務原子;Windows/跨平台 best-effort、預期單寫者(誠實降級,r1 D10)。
    無 O_CREAT——confirm/prune 永不建檔(建檔只屬觸發端 rel_cascade_create,r2 R4)。
    [code-loop r1] O_NOFOLLOW 拒 symlink 終點(字元白名單擋不住,CX1);os.write 回傳驗滿寫
    (ENOSPC 短寫會留中段殘行且 rc=0 假成功,B1)——短寫即 RuntimeError,呼叫端 rc=2。"""
    import json
    data = (json.dumps(obj, ensure_ascii=False) + "\n").encode("utf-8")
    if len(data) > 4096:
        raise ValueError(f"事件行 {len(data)}B 超過 4KB 上限,寫前拒絕(不截斷、不靜默破壞原子假設)")
    fd = os.open(str(path), os.O_WRONLY | os.O_APPEND | getattr(os, "O_NOFOLLOW", 0))
    try:
        written = os.write(fd, data)
        if written != len(data):
            raise RuntimeError(f"帳本短寫({written}/{len(data)}B,疑磁碟滿)——本筆事件未完整落盤,重試前先查空間")
    finally:
        os.close(fd)


def rel_cascade_create(env, root_gid, node_rel):
    """[M3 定址合約] 觸發端唯一鑄造者:mint cascade-id=c-<UTC秒ts>-<sha1(root全域id)[:8]>(-<n>)?
    + O_CREAT|O_EXCL 建檔寫 header。同秒撞名遞增序號(不等下秒;上限 99 防異常迴圈)。
    純生成、不含節點名——中文 rel 無淨化問題(r1 D5 消解)。回 cascade_id。"""
    import datetime, hashlib, json
    d = _rel_cascade_dir(env)
    d.mkdir(parents=True, exist_ok=True)
    ts = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%d%H%M%S")
    base = f"c-{ts}-{hashlib.sha1(root_gid.encode('utf-8')).hexdigest()[:8]}"
    for suffix in [""] + [f"-{i}" for i in range(1, 100)]:
        cid = base + suffix
        p = d / (cid + ".jsonl")
        try:
            fd = os.open(str(p), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
        except FileExistsError:
            continue
        try:
            hdr = json.dumps({"event": "header", "ts": _utc_ts(),
                              "root_decision_id": root_gid, "node": node_rel},
                             ensure_ascii=False) + "\n"
            os.write(fd, hdr.encode("utf-8"))
        finally:
            os.close(fd)
        return cid
    raise RuntimeError("cascade-id 同名重試逾上限(99)——目錄異常?")


def _ledger_read(path):
    """重放讀取:append 序逐行 parse;壞 JSON 行跳過(torn=未提交事件,丟棄正確)。
    header=首行且 event:header 才算(torn header → None,root 不可恢復)。回 (header|None, transitions)。"""
    import json
    try:
        raw = path.read_text(encoding="utf-8")
    except (FileNotFoundError, OSError):
        return None, []
    header, trans = None, []
    for i, line in enumerate(raw.splitlines()):
        try:
            o = json.loads(line)
        except ValueError:
            continue
        if i == 0 and o.get("event") == "header" \
                and str(o.get("root_decision_id", "")).strip() and str(o.get("node", "")).strip():
            # [code-loop r1 CX2] 必要欄位齊才算合法 header——空殼 {"event":"header"} 會讓
            #   resume 拿空 root 靜默 rc=0 裝成功,而非走「不可恢復 rc=1」救援語意
            header = o
        elif o.get("event") == "transition":
            trans.append(o)
    return header, trans


def _ledger_fold(transitions):
    """狀態折疊:同 (neighbor×edge_type×from_decision_id) 取物理序最後一筆。"""
    state = {}
    for t in transitions:
        k = (t.get("neighbor"), t.get("edge_type"), t.get("from_decision_id"))
        if all(k):
            state[k] = t
    return state


def _validate_cascade_id(cid):
    # [code-loop r1 A3] fullmatch 非 match——match+$ 會放過尾端換行(re 的 $ 容忍結尾 \n)
    if not CASCADE_ID_RE.fullmatch(cid) or ".." in cid:
        raise ValueError(f"cascade-id 含非法字元(限 [A-Za-z0-9._-],擋 ../): {cid}")


def _validate_from_gid(from_id):
    if re.fullmatch(r"d\d+", from_id.strip()):
        raise ValueError(f"--from 需全域格式 <節點rel>#d<N>,裸 {from_id} 拒收(裸格式會讓折疊鍵跨節點誤合)")
    if not re.fullmatch(r".+#d\d+", from_id.strip()):
        raise ValueError(f"--from 格式非 <節點rel>#d<N>: {from_id}")


def _append_decision_ref(env, rel, field, ref):
    """[decision_refs 自動養成 T1] 把精確 decision_ref(<rel>#dN)append 到 field
    (decision_refs=human/cascade-confirmed | decision_refs_ai=AI 填)。**exact-string dedup**
    ——不用 link_target(它 split('#') 會把 #dN 剝掉,導致同節點不同決策誤 dedup 成一條)。
    值一律引號化(含 #// 安全)。走 atomic_write_verify。回 True=新增 / False=已存在。"""
    ref = ref.strip()
    # [code-loop r1 CX3/B + delta] 顯式拒 " / \ / 任何 C0 控制字元(<0x20,含裸 \r/\n/\t)——
    #   strip_quotes 不反跳脫、CRLF 檔案守衛只認 \r\n 序列認不出裸 CR;合法 <rel>#dN 永不含這些。
    #   「凡控制字元一律拒」比枚舉個案完整(delta reviewer:漏 \r)。
    if '"' in ref or '\\' in ref or any(ord(c) < 0x20 for c in ref):
        raise ValueError(f"decision_ref 含不可序列化字元(\"/\\/控制字元): {ref!r}")
    path = env.vault / rel
    lines, s_fm, e_fm = load_raw_for_edit(path)
    fm = lines[1:e_fm]
    struct = {k: (s, e, kind) for k, s, e, kind in fm_structure(fm)}
    quoted = '"' + ref + '"'   # ref 已排除 "/\ → 純引號包裹即安全 round-trip(含 #// 無虞)
    if field in struct:
        s, e, kind = struct[field]
        if kind != "list":
            raise ValueError(f"{field} 是 {kind} 型,不可 append decision_ref")
        for j in range(s + 1, e + 1):
            if fm[j].lstrip().startswith("-") and strip_quotes(fm[j].lstrip()[1:].strip()) == ref:
                return False   # exact 已存在
        indent = "  "
        for j in range(s + 1, e + 1):
            if fm[j].lstrip().startswith("-"):
                indent = fm[j][:len(fm[j]) - len(fm[j].lstrip())]
                break
        last = e
        while last > s and not fm[last].strip():
            last -= 1
        fm.insert(last + 1, f"{indent}- {quoted}")
    else:
        fm.append(field + ":")
        fm.append(f"  - {quoted}")
    new_lines = lines[:1] + fm + lines[e_fm:]
    atomic_write_verify(path, new_lines, field,
                        lambda f: any(str(x).strip() == ref for x in as_list(f.get(field))))
    return True


def cmd_rel_cascade_write(env, verb, neighbor, cascade_id, from_id, edge, by):
    """[M3] confirm|prune:append 一筆 transition。寫前驗證(R4):檔存在(不存在→拒,建檔只屬觸發端)、
    header 合法(torn→拒,與 resume rc=1 救援語意按指令類別分流)、--from==header root(全鏈同源)。"""
    _validate_cascade_id(cascade_id)
    _validate_from_gid(from_id)
    nrel = env.find(neighbor)
    if nrel is None:
        raise ValueError(f"找不到鄰居節點: {neighbor}")
    p = _rel_cascade_dir(env) / (cascade_id + ".jsonl")
    if not p.exists():
        raise ValueError(f"cascade 檔不存在: {cascade_id}——帳本由 decision-supersede 觸發端建立,confirm/prune 永不建檔")
    header, _ = _ledger_read(p)
    if header is None:
        raise ValueError("header 損毀/不合法,寫前驗證拒(該 cascade 交 resume 標不可恢復+補網 E2 兜底)")
    if header.get("root_decision_id") != from_id.strip():
        raise ValueError(f"--from 不屬本 cascade(header root={header.get('root_decision_id')});v1 全鏈同源")
    state = "confirmed" if verb == "confirm" else "pruned"
    _ledger_append(p, {"event": "transition", "ts": _utc_ts(), "neighbor": nrel,
                       "edge_type": edge, "from_decision_id": from_id.strip(),
                       "state": state, "by": by})
    print(f"✓ rel-cascade {verb} {nrel} --edge {edge} ({cascade_id}, by={by})")
    # [decision_refs 自動養成 T1] confirm = 地面真相「鄰居依賴這條決策」→ 回寫 decision_ref。
    #   provenance 雙欄不對稱信任:by ai → decision_refs_ai(E3 firing 生效、E2 抑制碰不到);
    #   by human → decision_refs(可抑制 E2)。prune 不回寫(判無關=不記依賴)。
    #   回寫失敗=軟警告不回滾(帳本才是地面真相,decision_refs 是衍生、可從帳本重建)。
    if verb == "confirm":
        # [code-loop r1 C-medium] fail-**safe**:只有明確 by==human 才落可信正欄;非 ai/human
        #   (None/打錯/未來新值)一律落不可信 ai 欄——安全守門不靠上游 argparse 撐(誤落正欄=可抑制 E2)
        field = "decision_refs" if by == "human" else "decision_refs_ai"
        try:
            if _append_decision_ref(env, nrel, field, from_id.strip()):
                print(f"  ↳ decision_refs 養成: {nrel}.{field} += {from_id.strip()}")
        except Exception as _e:
            # [code-loop r1 CX2] 不過度承諾:reconcile 命令尚未實作(列 future),此處僅記帳本已提交
            print(f"  ⚠ decision_ref 回寫失敗(帳本已記為地面真相;節點欄位本次未同步): {_e}", file=sys.stderr)
    return 0


def cmd_rel_cascade_list(env, stale_days=None):
    """[M3] 以活動齡列 cascade(--stale N=最後事件 ts 早於 N 天;不判開放/完成精確分類——
    活動齡才是可算的 crash/失敗偵測器)。stdout、查無 rc=0 空輸出。"""
    import datetime
    d = _rel_cascade_dir(env)
    if not d.exists():
        return 0
    now = datetime.datetime.now(datetime.timezone.utc)
    for p in sorted(d.glob("*.jsonl")):
        header, trans = _ledger_read(p)
        cid = p.stem
        root = header.get("root_decision_id") if header else "(header 損毀,root 不可恢復)"
        all_ts = [o.get("ts", "") for o in ([header] if header else []) + trans if o.get("ts")]
        last = max(all_ts) if all_ts else ""
        if stale_days is not None and last:
            try:
                age = (now - datetime.datetime.fromisoformat(last)).days
            except ValueError:
                age = None
            if age is not None and age < stale_days:
                continue
        folded = _ledger_fold(trans)
        n_c = sum(1 for t in folded.values() if t.get("state") == "confirmed")
        n_p = sum(1 for t in folded.values() if t.get("state") == "pruned")
        print(f"{cid}  root={root}  last={last or '?'}  confirmed={n_c} pruned={n_p}")
    return 0


def _typed_hop1(env, node_rel, idx=None):
    """[M4/S2] typed hop-1 原語:在 [P0] typed 索引上列「誰以方向語意明確的邊指向 node」單層鄰居。
    多跳/visited 交 [S4] 編排(resume/判斷閘)。回 (neighbors=[(src,etype,invariant數)], ambigs=[(字面,候選數)])。"""
    if idx is None:
        idx = build_typed_index(env)
    neighbors, ambigs = [], []
    for (src, etype) in idx["rev"].get(node_rel, []):
        if etype not in REL_CASCADE_EDGES:
            continue
        inv_n = len(extract_contracts(env.notes[src])[0]) if src in env.notes else 0
        neighbors.append((src, etype, inv_n))
    for (asrc, lit, aetype, cands) in idx["ambiguous"]:
        if node_rel in cands and aetype in REL_CASCADE_EDGES:
            ambigs.append((lit, len(cands)))
    return neighbors, ambigs


def cascade_surface(env, node_rel, root_decision_id, stream=None):
    """[M4/S1] surfacing 印行器:對 ledger 唯讀、不叫 AI(判斷閘=外部 agent 步驟)。
    NEIGHBOR 行由本函式印(dispatcher 印 CASCADE 行——它持有 mint 的 id 與 root id,T2 職責切分)。
    行式 schema=交接通道(編排者從此組 confirm/prune 參數)。回攤出的鄰居數。"""
    out = stream if stream is not None else sys.stderr
    neighbors, ambigs = _typed_hop1(env, node_rel)
    for (src, etype, inv_n) in neighbors:
        tag = f" INVARIANT_COUNT {inv_n}" if inv_n else ""
        print(f"NEIGHBOR {src} EDGE {etype}{tag}", file=out)
    for (lit, n) in ambigs:
        print(f"NEIGHBOR-AMBIG {lit} CANDIDATES {n}", file=out)
    return len(neighbors) + len(ambigs)


def cmd_impact_node(node_arg, repo=None, as_json=False):
    """[M4/S2] impact 第三模式 CLI 皮(供人手動查;自動迴圈走進程內原語不 shell-out):
    typed hop-1 列「誰依賴我」。與 --file/--diff 互斥、與 --depth 互斥(單層列舉無深度語意)。"""
    import json
    start = Path(repo).resolve() if repo else Path.cwd()
    vault = find_vault(start)
    if vault is None:
        print("ERROR: 找不到 vault(docs/*-knowledge)", file=sys.stderr)
        return 2
    env = Env(vault)
    rel = env.find(node_arg)
    if rel is None:
        print(f"ERROR: 找不到節點: {node_arg}", file=sys.stderr)
        return 2
    neighbors, ambigs = _typed_hop1(env, rel)
    if as_json:
        print(json.dumps({"node": rel,
                          "neighbors": [{"rel": s, "edge": e, "invariant_count": n}
                                        for (s, e, n) in neighbors],
                          "ambiguous": [{"literal": l, "candidates": n} for (l, n) in ambigs]},
                         ensure_ascii=False))
        return 0
    print(f"NODE {rel}  typed-hop1 連入(verified_by/plan_refs;related 弱恆不展):")
    for (src, etype, inv_n) in neighbors:
        tag = f" INVARIANT_COUNT {inv_n}" if inv_n else ""
        print(f"  NEIGHBOR {src} EDGE {etype}{tag}")
    for (lit, n) in ambigs:
        print(f"  NEIGHBOR-AMBIG {lit} CANDIDATES {n}")
    if not neighbors and not ambigs:
        print("  (無 typed 連入鄰居)")
    return 0


def cmd_rel_cascade_resume(env, cascade_id):
    """[M3] 「續」的交付項(D16):重放折疊→取 header root→重展 root+最終態 confirmed 鄰居
    (先 confirm 後 prune 不重展)→對粒度鍵差集→列剩餘待判。decision_id=root 全鏈攜帶(R3)。
    輸出:首行 CASCADE 行(編排者跨 session 拿 --from 不需讀檔)+NEIGHBOR 行 schema。
    中斷接續/escalate 待人項/誤 prune 翻案補跑下游 三場景共用。torn header → rc=1。"""
    _validate_cascade_id(cascade_id)
    p = _rel_cascade_dir(env) / (cascade_id + ".jsonl")
    if not p.exists():
        raise ValueError(f"cascade 檔不存在: {cascade_id}")
    header, trans = _ledger_read(p)
    if header is None:
        print(f"✗ {cascade_id}: header 損毀,root 不可恢復——本 cascade 放棄,交補網 E2 兜底", file=sys.stderr)
        return 1
    root_gid = header.get("root_decision_id", "")
    node = header.get("node", "")
    state = _ledger_fold(trans)
    confirmed = sorted({k[0] for k, t in state.items() if t.get("state") == "confirmed"})
    seeds = [node] + [c for c in confirmed if c != node]
    idx = build_typed_index(env)
    print(f"CASCADE {cascade_id} ROOT {root_gid}")
    pending = []
    seen = set()
    expanded = set()
    for s in seeds:   # visited=root∪最終態 confirmed;粒度鍵冪等,重複展開無害只多列
        if s in expanded:   # 菱形:同節點經兩路抵達 → 不再展,stderr 留痕(反靜默紀律)
            print(f"CASCADE-SKIP 已展過不重展: {s}", file=sys.stderr)
            continue
        expanded.add(s)
        neighbors, ambigs = _typed_hop1(env, s, idx=idx)
        for (src, etype, inv_n) in neighbors:
            k = (src, etype, root_gid)
            if k in state or k in seen:
                continue
            seen.add(k)
            tag = f" INVARIANT_COUNT {inv_n}" if inv_n else ""
            pending.append(f"NEIGHBOR {src} EDGE {etype}{tag}")
        for (lit, n) in ambigs:
            if (s, lit) not in seen:
                seen.add((s, lit))
                pending.append(f"NEIGHBOR-AMBIG {lit} CANDIDATES {n}")
    for line in pending:
        print(line)
    return 0


TEMPLATES = {
    "system": ("Systems", "type: system\nstatus: doing\ncreated: {today}\nupdated: {today}\n"
               "aliases: []\n"
               "tags:\n  - type/system\n  - status/doing\nsummary: |-\n  FLOW:\n  KEY:\n  DEP:\n  TEST:"),
    "verification": ("Verification", "type: verification\nstatus: pass\ndate: {today}\n"
                     "valid_under:\nrevalidate_when:\ntags:\n  - type/verification\n  - status/pass"),
    "issue": ("Issues", "type: issue\nstatus: open\ncreated: {today}\nupdated: {today}\n"
              "aliases: []\n"
              "tags:\n  - type/issue\n  - status/open\nsummary: |-\n  FLAG:\n  DECISION:\n  KEY:"),
    "project": ("Projects", "type: project\nstatus: doing\ncreated: {today}\nupdated: {today}\n"
                "tags:\n  - type/project\n  - status/doing"),
}

# new 後印出的「寫入當下教學」:符號行怎麼填 + 合約鏈,讓正確格式在執行 CLI 的此刻就在 context。
NEW_HINT = {
    "system": [
        "填 summary 符號行: FLOW:<流程 a→b→c>  KEY:<關鍵概念/欄位>  DEP:[[依賴模組]]  TEST:<測試狀態>",
        "合約用 KEY 行前綴: ★INVARIANT★=業務合約(改=breaking),必綁 [test:測試名] 再經獨立 [audit:];★DEBT★=偶然可改",
        "  └ 綁定別手寫: lumos guard bind <node> \"<KEY子字串>\" <測試名> / guard audit <node> \"<KEY子字串>\"",
        "可逆性: 不可逆動作(prod遷移/上架)標 ★IRREVERSIBLE★ + [rollback:decisions];改了難救標 ★CHECKPOINT★;外部不可逆(信已送/下游已消費)改用 [guard:decisions] 記冪等鍵/核可閘([guard:] 僅對 ★IRREVERSIBLE★ 生效;屬可逆性軸,與 lumos guard bind 的合約軸正交)",
        "組合覆蓋: 最重的鐵則(金額/權限/不可逆)在 ★INVARIANT★ 之後標 ★COMBO★ → doctor Check K 軟提醒補組合測試(別只測 happy-path)",
        "aliases: 同義詞/縮寫/跨域說法(進 BM25F 權重 3.5)——來源限真實出現過的說法;沒有就留 [](湊數別名污染檢索)",
    ],
    "issue": [
        "填 summary 符號行: FLAG:<TECHNICAL/DECISION/ORIGIN>  DECISION:<決策簡述>  KEY:<關鍵發現>",
        "aliases: 症狀語(人怎麼描述這問題)/縮寫/舊名——來源限真實出現過的說法;沒有就留 [](湊數別名污染檢索)",
    ],
    "verification": [
        "填 valid_under:<此驗證在什麼前提下成立>  revalidate_when:<改到什麼時該重驗>",
        "從對應 Systems 用 verified_by 回掛本篇(或 lumos sync-verified-by 補);summary 可選 TEST:/VERIFY:",
    ],
    "project": [
        "計劃節點: 落地的 Verification 用 plan_refs 回指本節點(意圖鏈,doctor Check 4 把關)",
    ],
}


def cmd_new(env, ntype, name, today, plan=None, systems=None):
    if ntype not in TEMPLATES:
        print(f"ERROR: type 須為 {sorted(TEMPLATES)}", file=sys.stderr)
        return 2
    if "/" in name or "\\" in name or ".." in name or name.startswith("."):
        print(f"ERROR: name 不得含路徑分隔符 / .. / 開頭點(防路徑逃脫): {name}", file=sys.stderr)
        return 2
    # 一鍵雙向(2026-08-05 收尾優化):verification 建檔當下填 plan_refs+對面 verified_by——
    # 把「事後 sync-verified-by 撿漏」變「寫入時就對」。僅 verification 收這兩旗標。
    if (plan or systems) and ntype != "verification":
        print("ERROR: --plan/--systems 僅 verification 型別適用", file=sys.stderr)
        return 2
    def _norm_rel(x):
        x = x.strip().removesuffix(".md")
        return x + ".md"
    sys_rels = [_norm_rel(x) for x in (systems.split(",") if systems else []) if x.strip()]
    plan_rels = [_norm_rel(x) for x in (plan.split(",") if plan else []) if x.strip()]
    for rel in sys_rels + plan_rels:
        if not (env.vault / rel).exists():
            print(f"ERROR: --plan/--systems 指到不存在節點: {rel}(先建對象再連,不留半套雙向)", file=sys.stderr)
            return 2
    folder, tmpl = TEMPLATES[ntype]
    path = env.vault / folder / f"{name}.md"
    if path.exists():
        print(f"ERROR: 已存在: {path}", file=sys.stderr)
        return 2
    path.parent.mkdir(parents=True, exist_ok=True)
    fm = tmpl.format(today=today)
    _write_lf(path, f"---\n{fm}\n---\n# {name}\n")
    self_rel = f"{folder}/{name}.md"
    # 非跨檔交易(2026-08-05 單席快審 F1,誠實化):逐檔各自原子,中途失敗會留部分連結——
    # 前置存在檢查擋掉最常見失敗;殘餘(磁碟滿/權限)接住例外、指路 sync-verified-by 撿漏
    rc_side = 0
    for rel in plan_rels:
        try:
            rc_side |= cmd_append(env, self_rel, "plan_refs", f"[[{rel.removesuffix('.md')}]]")
        except OSError as e:
            print(f"⚠ plan_refs 寫入失敗({rel}): {e}", file=sys.stderr)
            rc_side = 2
    for rel in sys_rels:
        try:
            rc_side |= cmd_append(env, rel, "verified_by", f"[[{folder}/{name}]]")
        except OSError as e:
            print(f"⚠ verified_by 寫入失敗({rel}): {e}", file=sys.stderr)
            rc_side = 2
    if rc_side:
        print("⚠ 雙向連結部分失敗(檔案已建,非跨檔交易)——補救:lumos sync-verified-by --apply"
              " + 手補 plan_refs;doctor 會抓殘缺", file=sys.stderr)
        return 2
    print(f"✓ new {ntype}: {path.relative_to(env.vault)}")
    for line in NEW_HINT.get(ntype, []):
        print(f"  {line}")
    print(f"  寫完跑 lumos lint {name}(單檔快檢標籤/格式)→ 全圖再 lumos doctor;完整規範見 lumos-project-notes skill")
    return 0


# ═══════════════════════ 階段三: archive(lumos 自做,單遍) ═══════════════════════

ARCHIVABLE = {"pass", "done", "superseded"}


def cmd_archive(env, days, apply, today):
    import os
    import datetime
    cutoff = (datetime.date.fromisoformat(today) - datetime.timedelta(days=days)).isoformat()

    # 「活守衛護欄」:一份 Verification 若還在提到某條 ★INVARIANT★ 綁定、且該測試仍存在於 code 的守衛,
    # 它的有效性是 CI 每次真機跑出來證明的、不是日曆決定的 → 不按年齡歸檔(否則把還在跑綠的守衛證據
    # 降級進 Archive,等於歸檔規則[天數]凌駕有效性規則[CI 綠燈])。守衛若被刪(測試不在 code)則照舊可歸檔。
    repo_root = None
    for p in env.vault.parents:
        if p.name == "docs":
            repo_root = p.parent
            break
    live_guard_tests = set()
    guard_re = None
    if repo_root is not None:
        # 多平台感知:每 invariant 依平台前綴解析,對其平台 root+profile 的 method set 判存活。
        # 收「存活的裸方法名」(非帶前綴的 ref)——guard_re 要在 Verification 文字裡搜方法名。
        _, split, default, methods_for, _hay = _platform_test_index(repo_root)
        for _n in env.notes.values():
            invs, _ = extract_contracts(_n)
            for inv in invs:
                try:
                    for plat, name in resolve_test_refs(inv, split, default):
                        if name in methods_for(plat):
                            live_guard_tests.add(name)
                except ValueError:
                    continue   # 未定義平台前綴:非有效綁定,不護
        if live_guard_tests:
            # 精確度對齊 Check T:用【詞界】比對方法名,不是 raw 子字串。
            # 否則短/前綴名(live `Pay` 命中散文 "Payment"、`Foo` 命中 `FooBar`)會
            # 假性護住無關 Verification → 它們永遠不歸檔(歸檔靜默失效)。
            # re.ASCII:方法名是 ASCII 識別字;否則 Python \b 視 CJK 為 \w,
            # 「守衛Pay跑」(中文緊貼方法名無空格)→ \b 不成立 → 漏護(under-protection,更危險)。
            guard_re = re.compile(r"\b(?:" + "|".join(map(re.escape, live_guard_tests)) + r")\b",
                                  re.ASCII)
    guards_all_dead = repo_root is not None and not live_guard_tests and any(
        invariant_test_refs(inv)
        for _n in env.notes.values() for inv in extract_contracts(_n)[0])

    cands = []       # (rel, stem, ym)
    protected = []   # (rel, [backs...]):早於 cutoff 但仍背書存活守衛
    for rel, n in sorted(env.notes.items()):
        if not rel.startswith("Verification/") or "/Archive/" in rel:
            continue
        if str(n.fields.get("status", "")) not in ARCHIVABLE:
            continue
        datestr = str(n.fields.get("created") or n.fields.get("date") or "")[:10]
        if not DATE_RE.match(datestr) or datestr > cutoff:
            continue
        # 活守衛護欄:這篇是否【詞界】提到任一條「測試仍存在」的綁定名 → 是則保留不歸檔
        if guard_re is not None:
            try:
                raw = (env.vault / rel).read_text(encoding="utf-8-sig")
            except Exception:
                raw = ""
            backs = sorted(set(guard_re.findall(raw)))
            if backs:
                protected.append((rel, backs))
                continue
        cands.append((rel, n.stem, datestr[:7]))

    print(f"lumos archive — vault: {env.vault}")
    print(f"  cutoff: {cutoff} (--days {days})  mode: {'APPLY' if apply else 'DRY-RUN(--apply 真執行)'}")
    if repo_root is None:
        print("  ⚠ 無法定位 repo root → 活守衛護欄停用(本次純按年齡歸檔)")
    if guards_all_dead:
        print("  ⚠ ★INVARIANT★ 綁定的測試都不在 code(守衛已刪/裸合約)→ 活守衛護欄本次停用"
              "(0 受護 ≠ 全部都能放心歸檔)")
    if protected:
        print(f"  活守衛護欄:{len(protected)} 篇早於 cutoff 但仍背書存活守衛(綁定測試還在 code)→ 保留不歸檔")
        for rel, backs in protected:
            print(f"      • {rel}  (backs: {', '.join(backs)})")
    print()
    if not cands:
        print("  無符合條件的 Verification(status∈{pass,done,superseded} 且早於 cutoff;已扣除活守衛護欄保留者)")
        return 0

    moved_stems = {stem for _, stem, _ in cands}
    # 計算每個被移檔的 path 式入連結(body + frontmatter 字串一起,raw text 掃)
    rewrite_plan = defaultdict(list)  # rel → [stem,...] 該檔內要正規化的 path 式連結
    for rel, n in env.notes.items():
        try:
            text = (env.vault / rel).read_text(encoding="utf-8-sig")
        except Exception:
            continue
        for stem in moved_stems:
            if re.search(r"\[\[Verification/" + re.escape(stem) + r"(?=[\]|#])", text):
                rewrite_plan[rel].append(stem)

    print(f"  將歸檔 {len(cands)} 篇:")
    for rel, stem, ym in cands:
        print(f"    • {rel} → Verification/Archive/{ym}/{stem}.md")
    n_links = sum(len(v) for v in rewrite_plan.values())
    print(f"\n  path 式入連結正規化(→ basename): {n_links} 處,分佈 {len(rewrite_plan)} 檔")
    for rel, stems in sorted(rewrite_plan.items()):
        print(f"    • {rel}: {', '.join(stems)}")
    if not apply:
        print("\n  (DRY-RUN,未動檔。basename 式入連結不受影響=移檔不斷)")
        return 0

    # 1) 先正規化連結(檔案還在原位)。順序=先 rewrite 後移檔:若中途失敗,
    #    已 rewrite 未移檔的檔其 basename 連結仍解析得到(檔還在 Verification/),狀態良性;
    #    且 re-run archive 會跳過已正規化的(無 path 式可改)只補移檔 → 可重入恢復。
    rewritten = 0  # 實際改寫處數(非計畫數;CRLF 跳過時不灌水,GAP-4)
    for rel, stems in sorted(rewrite_plan.items()):
        p = env.vault / rel
        raw = p.read_bytes()
        if raw.startswith(b"\xef\xbb\xbf") or b"\r\n" in raw:
            print(f"  ⚠ 跳過 rewrite(BOM/CRLF 慣例外,不靜默正規化): {rel}", file=sys.stderr)
            continue
        text = raw.decode("utf-8")
        for stem in stems:
            text, n_sub = re.subn(r"\[\[Verification/" + re.escape(stem) + r"(?=[\]|#])",
                                  "[[" + stem, text)
            rewritten += n_sub
        tmp = p.with_suffix(p.suffix + ".lumos-tmp")
        try:
            _write_lf(tmp, text)
            os.replace(tmp, p)
        finally:
            if tmp.exists():
                tmp.unlink()
    # 2) 移檔
    moved = 0
    for rel, stem, ym in cands:
        src = env.vault / rel
        dst_dir = env.vault / "Verification" / "Archive" / ym
        dst_dir.mkdir(parents=True, exist_ok=True)
        dst = dst_dir / f"{stem}.md"
        if dst.exists():
            print(f"  ⚠ 跳過(目標已存在): {dst}", file=sys.stderr)
            continue
        os.replace(src, dst)
        moved += 1
    print(f"\n  ✓ 歸檔 {moved} 篇,正規化 {rewritten} 處連結(計畫 {n_links})")
    return 0


# ═══════════════════════ main ═══════════════════════

def cmd_install(force=False):
    """全域 lumos + user-scope skills(機器層一鍵)。Unix=symlink、Win=.cmd shim。"""
    import os
    src = Path(__file__).resolve()
    bindir = Path.home() / ".local" / "bin"
    bindir.mkdir(parents=True, exist_ok=True)
    if _IS_WIN:
        shim = bindir / "lumos.cmd"
        shim.write_text(f'@echo off\r\npython "{src}" %*\r\n', encoding="utf-8")
        print(f"✓ 安裝: {shim} → python {src}")
    else:
        dst = bindir / "lumos"
        if dst.is_symlink() and dst.resolve() == src:
            print(f"✓ 已安裝(symlink 正確): {dst} → {src}")
        elif dst.exists() or dst.is_symlink():
            if not force:
                cur = str(dst.resolve()) if dst.is_symlink() else "(一般檔案)"
                print(f"⚠ {dst} 已存在(→ {cur}),加 --force 覆寫", file=sys.stderr)
                return 2
            dst.unlink(); dst.symlink_to(src); print(f"✓ 覆寫安裝: {dst} → {src}")
        else:
            dst.symlink_to(src); print(f"✓ 安裝: {dst} → {src}")
    # 連帶裝 skills(r2-F1:機器層一鍵)
    print("裝 user-scope skills…")
    _install_skills()
    # 全域 ~/.claude hooks/settings 同步(install全域hook同步_計劃:全域機器自癒——
    # copy 現役 hooks + 刪已撤除 hook 殘留 + prune 懸空註冊;來源=來源 repo 自身)
    _sync_global_claude(Path(__file__).resolve().parent.parent)
    print("  ✓ 全域 Claude hooks/settings 已同步(含清撤除的舊 Stop 註冊)")
    # PATH 檢查(r1-F7:用 os.pathsep,Windows 是 ;)
    if str(bindir) not in os.environ.get("PATH", "").split(os.pathsep):
        hint = (f'  Windows:把 {bindir} 加進使用者 PATH(系統環境變數)'
                if _IS_WIN else f'  export PATH="$HOME/.local/bin:$PATH"')
        print(f"⚠ {bindir} 不在當前 PATH —\n{hint}", file=sys.stderr)
    else:
        print(f"  {bindir} 已在 PATH — 任何專案打 `lumos doctor` 即可")
    return 0


def cmd_uninstall():
    """對稱移除 cmd_install 裝的東西:全域指令(Unix symlink / Win lumos.cmd)+ user-scope skills。"""
    import os, shutil
    removed = []
    bindir = Path.home() / ".local" / "bin"
    for name in ("lumos.cmd", "lumos"):          # Win shim + Unix symlink
        g = bindir / name
        if g.is_symlink():
            removed.append(f"{g}(symlink → {g.resolve()})"); g.unlink()
        elif g.exists():
            # 守衛(std F10,teardown一鍵拆機_計劃):同名一般檔不刪(可能是使用者別的工具);
            # 只有 symlink 才是我方 install 產物。避免 uninstall/teardown 誤刪非我方檔。
            print(f"  ⚠ {g} 是一般檔(非 symlink),保留不動——非 lumos 安裝物", file=sys.stderr)
    sk = Path.home() / ".claude" / "skills"      # 對稱 _install_skills:junction/symlink/複製夾都清
    for s in _SKILLS:
        d = sk / s
        if d.is_symlink():
            d.unlink(); removed.append(str(d))
        elif d.is_dir():
            try:
                os.rmdir(d)                       # junction/空夾:只移連結本身,不跟進 target(同 W4)
            except OSError:
                shutil.rmtree(d, ignore_errors=True)
            removed.append(str(d))
    if removed:
        print("✓ 移除:\n  " + "\n  ".join(removed))
    else:
        print("✓ 未安裝(無全域 lumos / skills)")
    return 0


def _selfdelete_risk(root: Path) -> bool:
    """Windows 專屬:正在跑的這份 lumos 就是 root 底下那份 vendored copy 嗎?

    `_deinit_remove_vendored` 最後會刪 `scripts/lumos`——POSIX 上刪掉執行中的檔案
    無妨(所以刻意排最後),★但 Windows 不准刪執行中的檔案★,會拋 PermissionError,
    而那句 `p.unlink()` 沒有 try/except。後果不是「少刪一個檔」而是★半做★:走
    teardown 的話,①全域 hook 已清、②CLAUDE.md 已剝、閘已拆,才在這裡炸 traceback,
    ③uninstall 根本沒機會跑。使用者拿到一個拆一半又看不懂的狀態。

    這條路很容易走到:Windows 裝完要重開 session 才吃得到 PATH,拿不到 `lumos`
    這個指令的人自然會打 `python scripts\\lumos teardown`。

    ★只在 Windows 回 True★——POSIX 上這條路是合法且刻意支援的,不能一起擋掉。
    `LUMOS_SIMULATE_WINDOWS` 只是測試接縫(本機沒有 Windows 可驗)。
    """
    if not (_IS_WIN or os.environ.get("LUMOS_SIMULATE_WINDOWS") == "1"):
        return False
    try:
        me, r = Path(__file__).resolve().parts, root.resolve().parts
    except OSError:
        return False       # 路徑解不開(權限/壞連結)就不擋(never block on unknown)
    # ★不用 `Path.is_relative_to()`★——那是 Python 3.9+,本專案宣告 ≥3.8
    # (同檔 `_write_lf` 為了同一個理由避開 3.10 才有的 write_text(newline=))。
    # ★也不要把 except 放寬成 `except Exception`★:這道守衛的失敗模式是「回 False」,
    # 一旦把自己的程式錯誤(如 AttributeError)也吞掉,守衛就★靜默地等於不存在★
    # ——2026-08-02 代碼審 r2 抓到的正是這個組合。
    return len(me) > len(r) and me[:len(r)] == r


def cmd_teardown(yes=False, source=None):
    """一鍵拆機:當前 repo 專案層 + 機器全域(CLI/skills/hooks),★永遠保留架構圖文件★。
    範圍(std F11)=當前 repo + 機器全域,非全機所有 repo(別 repo 的注入/hooks、來源 clone 都留)。
    三步順序(std F5,全域先——趁 deinit 還沒刪掉 vendored merge):
      ①_teardown_global_claude ②cmd_deinit(keep_graph=True) ③cmd_uninstall。
    設計/審計:Projects/teardown一鍵拆機_計劃。"""
    import subprocess
    try:                                       # repo root(對稱 deinit,非 git 中止)
        root = Path(subprocess.check_output(
            ["git", "rev-parse", "--show-toplevel"], text=True,
            stderr=subprocess.DEVNULL).strip())
    except Exception:
        print("ERROR: 非 git 目錄,teardown 需可靠 repo root(不 fallback cwd)", file=sys.stderr)
        return 2
    src = _lumos_src(source)
    if root.resolve() == src.resolve():
        print("ERROR: 當前就是 Lumos 來源本身,teardown 拒絕執行", file=sys.stderr)
        return 2
    if _selfdelete_risk(root):   # Windows 自刪(見 _selfdelete_risk)——在任何 mutation 之前擋
        print("ERROR: Windows 上不能用專案自帶的那份 lumos 拆自己"
              f"({Path(__file__).resolve()})——最後刪 vendored 時會刪到執行中的檔案,"
              "留下拆一半的狀態。", file=sys.stderr)
        print("  改用全域指令重跑:  lumos teardown", file=sys.stderr)
        print("  (若 PATH 還沒吃到,先重開一個終端;或直接用來源那份:"
              f"  python {src / 'scripts' / 'lumos'} teardown)", file=sys.stderr)
        return 2
    # 確認——★拒絕/取消前零 mutation★(std F13)
    if not yes:
        if not sys.stdin.isatty():
            print("ERROR: 非互動環境且未加 --yes,拒絕 teardown。加 --yes 確認。", file=sys.stderr)
            return 2
        print("teardown 將拆【當前 repo 專案層】(pre-commit/pre-push 閘、CLAUDE.md 注入、vendored 工具)")
        print("  +【機器全域】(~/.local/bin/lumos、user-scope skills、~/.claude 全域 hooks)。")
        print("  架構圖文件保留;scripts/hooks|templates 只刪 lumos 檔、你的自有檔保留(F9)。")
        print("  ⚠ 仍在的破壞性:剝 CLAUDE.md 注入會正規化 sentinel 外空白/換行;移除全部 lumos 家族")
        print("     skills(含 csharp/kotlin/vue-idioms,你名字不同的 skill 不碰)。")
        print("  (只拆當前 repo——別的 repo 與 bootstrap 來源 clone 不動。)")
        try:
            ans = input("確定? [y/N] ").strip().lower()
        except EOFError:
            # isatty() 在某些終端/Windows 回 True 但 stdin 其實 EOF → 讀不到確認。
            # 對齊 cmd_deinit 與 _confirm_tty 的既有硬化(同一現場,Windows 真機踩過):
            # 破壞性操作安全預設=拒絕(rc2,同上面非互動分支),不是往下做。
            # ★不要拿 --yes 當解法★——那等於跳過確認直接執行破壞性操作。
            print("ERROR: 讀不到確認輸入(stdin EOF),拒絕 teardown。"
                  "確定要拆再加 --yes。", file=sys.stderr)
            return 2
        if ans not in ("y", "yes"):
            print("已取消(未改動)。")
            return 0
    # 三步(全域先)
    print("① 全域 hook 清理…")
    _teardown_global_claude(Path(__file__).resolve().parent.parent)
    print("② 拆專案層(deinit,保留架構圖)…")
    rc_deinit = cmd_deinit(keep_graph=True, yes=True, source=source)
    print("③ 拆機器 CLI/skills(uninstall)…")
    rc_uninstall = cmd_uninstall()
    print(f"✓ teardown 完成(deinit rc={rc_deinit} / uninstall rc={rc_uninstall};架構圖保留)。"
          "  重裝:bootstrap 或 install + init。")
    return 0


def cmd_deinit(keep_graph=False, dry_run=False, yes=False, source=None):
    """專案層反安裝(對稱 cmd_init):拆本 repo 的 pre-commit 閘 / vendored 工具組 /
    CLAUDE.md 注入區塊 /(預設)架構圖 vault。不碰機器共用項(~/.claude)。不自動 commit。"""
    import subprocess
    # root 走 git toplevel;非 git 目錄中止(不 fallback cwd——deinit 會刪檔)
    try:
        root = Path(subprocess.check_output(
            ["git", "rev-parse", "--show-toplevel"], text=True,
            stderr=subprocess.DEVNULL).strip())
    except Exception:
        print("ERROR: 非 git 目錄,deinit 需可靠 repo root(不 fallback cwd)", file=sys.stderr)
        return 2
    # pre-flight 守衛①:來源 repo 自我保護(對齊 cmd_update 的 root==src → return 2)
    src = _lumos_src(source)
    if root.resolve() == src.resolve():
        print("ERROR: 當前就是 Lumos 來源本身,deinit 拒絕執行", file=sys.stderr)
        return 2
    # ★dry-run 例外(2026-08-02 代碼審 r2)★:純預覽、零 mutation,不會走到刪自己那一步,
    # 擋它只是誤傷合法的唯讀操作(而且使用者正想用它看看會動到什麼)。
    if not dry_run and _selfdelete_risk(root):   # Windows 自刪——mutation 之前擋
        print("ERROR: Windows 上不能用專案自帶的那份 lumos 拆自己"
              f"({Path(__file__).resolve()})——最後刪 vendored 時會刪到執行中的檔案,"
              "留下拆一半的狀態。", file=sys.stderr)
        print("  改用全域指令重跑:  lumos deinit", file=sys.stderr)
        print("  (若 PATH 還沒吃到,先重開一個終端;或直接用來源那份:"
              f"  python {src / 'scripts' / 'lumos'} deinit)", file=sys.stderr)
        return 2
    vault = _vault_in(root)
    # pre-flight 守衛②:vault == root 鐵閘(防 rmtree 整個 repo)
    if vault is not None and vault.resolve() == root.resolve() and not keep_graph:
        keep_graph = True
        print("⚠ 偵測到 standalone vault(架構圖=repo 根):強制保留架構圖,只拆其餘專案層。",
              file=sys.stderr)
    will_delete_vault = (vault is not None) and (not keep_graph)
    installed = _deinit_detect_installed(root)
    has_claude = _claude_block_present(root)
    if not installed and not will_delete_vault and not has_claude:
        print("✓ 未安裝(此 repo 無 Lumos 專案層)")
        return 0
    if dry_run:
        print("lumos deinit --dry-run(僅預演,不改動):")
        print(f"  root: {root}")
        print("  拆閘: git config --unset core.hooksPath" if installed
              else "  拆閘: (core.hooksPath 未設,略)")
        if has_claude:
            print("  剝 CLAUDE.md graph-discipline 區塊")
        if will_delete_vault:
            n = len([f for f in vault.rglob("*") if f.is_file()])
            print(f"  刪架構圖 vault: {vault}({n} 檔)")
        elif vault is not None:
            print(f"  保留架構圖 vault: {vault}")
        print("  移除 vendored 工具組(白名單:5 檔 + hooks/templates 兩夾)")
        return 0
    if will_delete_vault and not yes:
        if not sys.stdin.isatty():
            print("ERROR: 非互動環境(stdin 非 tty)且未加 --yes,拒絕刪架構圖。加 --yes 確認。",
                  file=sys.stderr)
            return 2
        files = [f for f in vault.rglob("*") if f.is_file()]
        dirty = subprocess.run(["git", "-C", str(root), "status", "--porcelain", str(vault)],
                               capture_output=True, text=True).stdout
        n_dirty = len([ln for ln in dirty.splitlines() if ln.strip()])
        print(f"將刪除架構圖 vault: {vault}({len(files)} 檔)")
        if n_dirty:
            print(f"  ⚠ 其中 {n_dirty} 個未 commit — 刪了 git 救不回!")
        try:
            ans = input("確定刪除?輸入 y 繼續、其他取消: ").strip().lower()
        except EOFError:
            # isatty() 在某些終端/Windows 回 True 但 stdin 其實 EOF → 讀不到確認。
            # 破壞性操作安全預設:拒刪(對齊上面非互動 rc2)。
            print("ERROR: 讀不到確認輸入(stdin EOF),拒絕刪架構圖。加 --yes 確認。", file=sys.stderr)
            return 2
        if ans != "y":
            print("已取消。")
            return 1
    # ── 固定順序執行(pre-flight 已過)──
    _deinit_unbar_gate(root)                 # step 1 先拆閘
    _deinit_strip_claude(root)               # step 2 剝 CLAUDE.md 區塊
    if will_delete_vault:                    # step 3 刪架構圖(pre-flight + 安全網已過)
        import shutil
        shutil.rmtree(vault)
    _deinit_remove_vendored(root, src)       # step 4 最後移 vendored(可能含自己);src 供逐檔白名單(F9)
    print("✓ deinit 完成(專案層已移除)。檢視 `git diff` 後自行 commit。")
    return 0


def _deinit_unbar_gate(root: Path) -> int:
    """拆 pre-commit 閘:git -C root config --unset core.hooksPath。
    rc 0(已 unset)/ rc 5(key 本不存在)皆成功;其他 rc 印 warning 但不中止
    (真正保險是 step 4 會刪掉 scripts/hooks/ 的 lumos hook 檔,缺 hook 檔 git 自會放行)。
    守衛(std F8,teardown一鍵拆機_計劃):只在 core.hooksPath 指向本 repo scripts/hooks 時才 unset;
    指向使用者自設(如 .githooks)則保留不動——別誤殺使用者的 git hooks(deinit/teardown 共用此安全)。"""
    import subprocess
    cur = subprocess.run(["git", "-C", str(root), "config", "--get", "core.hooksPath"],
                         capture_output=True, text=True)
    val = cur.stdout.strip()
    if val:
        vp = Path(val) if Path(val).is_absolute() else (root / val)
        ours = (root / "scripts" / "hooks")
        try:
            same = vp.resolve() == ours.resolve()
        except Exception:
            same = str(vp) == str(ours)
        if not same:
            print(f"  ⚠ core.hooksPath={val} 非指向 lumos(scripts/hooks),保留不動(可能是你自設的)",
                  file=sys.stderr)
            return 0
    r = subprocess.run(["git", "-C", str(root), "config", "--unset", "core.hooksPath"],
                       capture_output=True, text=True)
    if r.returncode not in (0, 5):
        print(f"  ⚠ git config --unset core.hooksPath rc={r.returncode}(續行)", file=sys.stderr)
    return r.returncode


def _extract_claude_block_span(text: str):
    """定位 CLAUDE.md 中的 LUMOS:GRAPH-DISCIPLINE sentinel 區塊,回傳三態。

    回傳 (state, span):
      "found"  → span 是 BlockSpan(body, body_start, body_end);
                 body = START 行結尾 \\n 之後、END 行開頭之前的子字串,strip 首尾空行;
                 保證 text[body_start:body_end] == body。
      "absent" → (START 前綴出現 0 次 且 END 出現 0 次) → ("absent", None)
                 乾淨「沒這塊」,T2 可安全附加。
      "broken" → 只 START 沒 END / 只 END 沒 START / END 在 START 前 /
                 START 前綴出現 > 1 次 → ("broken", None)
                 有殘跡但壞了,不可盲改。
    """
    start_count = 0
    idx = 0
    si = -1
    # 計算 START 前綴出現次數,同時記第一次位置
    while True:
        pos = text.find(_CLAUDE_START_PREFIX, idx)
        if pos == -1:
            break
        start_count += 1
        if start_count == 1:
            si = pos
        idx = pos + 1

    ei = text.find(_CLAUDE_END)

    has_start = start_count > 0
    has_end = ei != -1

    # absent: 兩者皆無
    if not has_start and not has_end:
        return ("absent", None)

    # broken: 只有其中一個 / 重複 START / END 在 START 前
    if start_count > 1:
        return ("broken", None)
    if has_start and not has_end:
        return ("broken", None)
    if has_end and not has_start:
        return ("broken", None)
    if ei < si:
        return ("broken", None)

    # found: si = START 行首字元;找該行結尾(含 \n)
    nl_after_start = text.find("\n", si)
    if nl_after_start == -1:
        # START 行是檔案最後一行,無換行 → 無 body
        body_raw_start = len(text)
    else:
        body_raw_start = nl_after_start + 1  # body 從 START 行下一字元開始

    # body 結束 = END 行開頭字元
    body_raw_end = ei  # text[body_raw_start:body_raw_end] 是未 strip 的 body

    raw_body = text[body_raw_start:body_raw_end]

    # strip 首尾空白行(只去掉 \n,保留內部縮排)
    stripped = raw_body.strip("\n")

    if stripped:
        # 在 raw_body 中找 stripped 的真實位移
        inner_start = raw_body.find(stripped)
        body_start = body_raw_start + inner_start
        body_end = body_start + len(stripped)
    else:
        # body 全是空白行:body 設為空字串,位移指向 body_raw_start
        body_start = body_raw_start
        body_end = body_raw_start
        stripped = ""

    return ("found", BlockSpan(body=stripped, body_start=body_start, body_end=body_end))


# Task 2 ─────────────────────────────────────────────────────────────────────
# START 行(本 task 無版本戳;T5 會在此字串中插入版本號——形式保留易替換)


def _expected_claude_body(root: Path, slug: str) -> "str | None":
    """讀 scripts/templates/graph-discipline.md,{{KG}} 替換後 strip 首尾空行 → 預期 body 字串。
    範本不存在 → None(呼叫端 skip Check D)。
    strip 用 `.strip("\\n")`(只去首尾空行、保留內縮排),與 _extract_claude_block_span 的 body
    取法一致——reinject 寫入、extract 讀回、Check D 比對三處同一算法,版本差不觸發(版本在 body 外)。"""
    tpl_path = root / "scripts" / "templates" / "graph-discipline.md"
    if not tpl_path.exists():
        return None
    return tpl_path.read_text(encoding="utf-8").replace("{{KG}}", f"docs/{slug}-knowledge/").strip("\n")



def _reinject_claude_block(root: Path, slug: str) -> "ReInjectResult":
    """讀 vendored 範本 → {{KG}} 替換 → 組 sentinel block → 依三態更新 CLAUDE.md。

    status ∈ created|updated|unchanged|appended|sentinel_broken|no_template。
    diff:僅 updated 帶 difflib.unified_diff 字串,其餘 None。
    讀入時正規化 CRLF→LF 並去 BOM;寫入一律 _write_lf(強制 LF / 無 BOM)。
    """
    import difflib

    # 1. 範本 + body(共用 _expected_claude_body 確保 Check D 比對算法一致)
    body = _expected_claude_body(root, slug)
    if body is None:
        return ReInjectResult("no_template", None)

    # 3. 組 block(START 行帶當前版本戳,機械插值——版本在 body 外,不影響 Check D 比對)
    start_line = _START_TEMPLATE.format(version=LUMOS_VERSION)
    block = start_line + "\n" + body + "\n" + _CLAUDE_END

    # 4. 讀 CLAUDE.md(去 BOM + CRLF 正規化)
    cm = root / "CLAUDE.md"
    if cm.exists():
        raw = cm.read_bytes()
        # 去 UTF-8 BOM
        if raw.startswith(b"\xef\xbb\xbf"):
            raw = raw[3:]
        claude_text = raw.decode("utf-8").replace("\r\n", "\n").replace("\r", "\n")
    else:
        claude_text = None

    # 5. 三態分派
    if claude_text is None:
        # CLAUDE.md 不存在 → created
        _write_lf(cm, "# CLAUDE.md\n\n" + block + "\n")
        return ReInjectResult("created", None)

    state, span = _extract_claude_block_span(claude_text)

    if state == "broken":
        return ReInjectResult("sentinel_broken", None)

    if state == "absent":
        # 有 CLAUDE.md 但無 sentinel → appended
        new_text = claude_text.rstrip() + "\n\n" + block + "\n"
        _write_lf(cm, new_text)
        return ReInjectResult("appended", None)

    # state == "found": splice body + 同步刷新 START 行(版本戳落在存量戶的唯一路徑——
    # 只換 body 會讓 updated 路徑永遠拿不到版本戳,標籤機制對存量安裝戶形同虛設。
    # START 行在管理區塊「內」,★INVARIANT★ 只保護 sentinel 之外,刷新它不違約)。
    old_body = span.body
    new_body = body
    si = claude_text.find(_CLAUDE_START_PREFIX)
    sl_begin = claude_text.rfind("\n", 0, si) + 1
    sl_end = claude_text.find("\n", si)
    old_start_line = claude_text[sl_begin:sl_end] if sl_end != -1 else claude_text[sl_begin:]

    if old_body == new_body and old_start_line == start_line:
        return ReInjectResult("unchanged", None)

    # 有差 → 先換 body(高位移),再換 START 行(低位移,原始位移仍有效);兩 splice 之間
    # 的原始空白行區逐字保留。
    new_text = claude_text[:span.body_start] + new_body + claude_text[span.body_end:]
    if sl_end != -1 and old_start_line != start_line:
        new_text = new_text[:sl_begin] + start_line + new_text[sl_end:]
    _write_lf(cm, new_text)

    diff = "".join(difflib.unified_diff(
        (old_start_line + "\n" + old_body).splitlines(keepends=True),
        (start_line + "\n" + new_body).splitlines(keepends=True),
        fromfile="old block",
        tofile="new block",
    ))
    return ReInjectResult("updated", diff)


def _deinit_strip_claude(root: Path) -> bool:
    """剝 CLAUDE.md 的 LUMOS:GRAPH-DISCIPLINE 區塊;其餘內容/整個檔都留。
    無檔或無 START 標記 → no-op 回 False(對稱注入端 scripts/lumos:3175 的存在性 gating)。"""
    cm = root / "CLAUDE.md"
    if not cm.exists():
        return False
    text = cm.read_text(encoding="utf-8")
    start_marker = "<!-- LUMOS:GRAPH-DISCIPLINE:START"
    end_marker = "LUMOS:GRAPH-DISCIPLINE:END -->"
    si = text.find(start_marker)
    ei = text.find(end_marker)
    if si == -1 or ei == -1 or ei < si:
        return False
    ei += len(end_marker)
    new = (text[:si].rstrip() + "\n" + text[ei:].lstrip()).strip()
    _write_lf(cm, (new + "\n") if new else "")
    return True


def _deinit_remove_vendored(root: Path, src=None) -> list:
    """白名單移除 vendored 工具組:① _VENDORED_TOOLKIT 固定 5 檔;
    ② scripts/hooks/、scripts/templates/ ★依 src 列舉逐檔刪★(對稱 _vendor_toolchain 的 rglob 安裝)。
    F9 修(2026-07-24,Issues/deinit整夾刪使用者檔):不再整夾 rmtree——只刪 src 有的 lumos 檔、
    保留使用者放這兩夾的自有檔,夾空了才移。fallback(a):src 缺(None 或來源夾不存在)→ 保守留夾
    +warn、不刪(never delete unknown)。scripts/ 底下使用者自有檔不碰;scripts/ 空了才 rmdir。
    回傳已移除相對路徑列表。"""
    removed = []
    for rel in _VENDORED_TOOLKIT:
        p = root / rel
        if p.exists():
            # ★刪不掉不該炸穿整個流程★(2026-08-01):這裡以前是裸 unlink()。
            # 走 teardown 時,①全域 hook 已清、②CLAUDE.md 已剝、閘已拆,
            # 若在這裡拋 PermissionError(Windows 刪執行中的檔、防毒鎖檔),
            # ③uninstall 根本沒機會跑 → 使用者拿到拆一半又只看到 traceback 的
            # 狀態。改成印清楚哪一個檔沒刪掉、繼續往下走完;★不靜默★——沒刪掉
            # 的檔不會被記進 removed,呼叫端印出來的清單仍然誠實。
            # (Windows 自刪這條主要路徑另有 _selfdelete_risk 在 mutation 前擋。)
            try:
                p.unlink(); removed.append(rel)
            except OSError as e:
                print(f"  ⚠ 移除 {p} 失敗,跳過(其餘步驟照跑): {e}", file=sys.stderr)
    for d in ("scripts/hooks", "scripts/templates"):
        tgt = root / d
        if not tgt.is_dir():
            continue
        src_d = (src / d) if src is not None else None
        if src_d is None or not src_d.is_dir():   # fallback(a):列舉不出 → 保守留夾
            print(f"  ⚠ 無法從來源列舉 {d} 的 lumos 檔清單,保留整夾避免誤刪你的檔"
                  "(手動清理,或 deinit/teardown 加 --source 指向 Lumos 來源)", file=sys.stderr)
            continue
        for f in src_d.rglob("*"):                # 對稱安裝:src_d 下的檔即 lumos-owned,逐檔刪
            if f.is_file():
                rel_f = f.relative_to(src_d)
                t = tgt / rel_f
                if t.exists():
                    t.unlink(); removed.append(f"{d}/{rel_f}")
        for sub in sorted((p for p in tgt.rglob("*") if p.is_dir()),   # 由深到淺移空子目錄
                          key=lambda x: len(x.parts), reverse=True):
            if not any(sub.iterdir()):
                sub.rmdir()
        if any(tgt.iterdir()):                    # 夾內尚有使用者檔 → 留+warn
            leftover = sorted(p.name for p in tgt.iterdir())
            print(f"  ⚠ {d} 保留(內有非 lumos 檔:{', '.join(leftover[:5])})", file=sys.stderr)
        else:
            tgt.rmdir(); removed.append(d + "/")
    sc = root / "scripts"
    if sc.is_dir() and not any(sc.iterdir()):
        sc.rmdir(); removed.append("scripts/")
    return removed


def _deinit_detect_installed(root: Path) -> bool:
    """target repo root 是否有專案層安裝痕跡:core.hooksPath 有值 或 scripts/hooks/ 存在。
    不靠 scripts/lumos 自身存在(執行檔與'此 repo 是否裝過'無關)。"""
    import subprocess
    hp = subprocess.run(["git", "-C", str(root), "config", "core.hooksPath"],
                        capture_output=True, text=True)
    if hp.returncode == 0 and hp.stdout.strip():
        return True
    return (root / "scripts" / "hooks").is_dir()


def _claude_block_present(root: Path) -> bool:
    cm = root / "CLAUDE.md"
    return cm.exists() and "LUMOS:GRAPH-DISCIPLINE:START" in cm.read_text(encoding="utf-8")


def _lumos_src(source=None):
    """解析 Lumos 唯一源 repo 路徑:--source > $LUMOS_HOME > ~/harness/lumos-toolchain。"""
    import os
    return Path(source or os.environ.get("LUMOS_HOME")
                or (Path.home() / "harness" / "lumos-toolchain")).expanduser()


# ── Task 5: 版本 parse + nudge ───────────────────────────────────────────────

def _parse_sentinel_version(claude_text: str) -> "str | None":
    """從 CLAUDE.md 文字中找 START sentinel 行,空格切分取形如 vX.Y 的欄位。
    取不到(無 START / START 行無版本欄位) → None;不 crash。"""
    _ver_re = re.compile(r"\bv\d+\.\d+\b")
    for line in claude_text.splitlines():
        if _CLAUDE_START_PREFIX in line:
            # START 行存在,掃各 token 找 vX.Y
            for token in line.split():
                if _ver_re.fullmatch(token):
                    return token
            # START 行存在但無版本欄位 → None
            return None
    return None


def _version_nudge(root: Path) -> "str | None":
    """比對本專案 CLAUDE.md sentinel 版本 vs 來源 clone 的 LUMOS_VERSION。

    - 來源 clone 不存在/不可達 → None(靜默 skip;CI 無來源 clone 不誤報)。
    - CLAUDE 版本 < 來源版本(字串不等且 CLAUDE 較舊) → 軟提示字串。
    - 相等 / CLAUDE 較新 / 任一取不到 → None。
    """
    # 1. 讀 CLAUDE.md sentinel 版本
    cm = root / "CLAUDE.md"
    if not cm.exists():
        return None
    try:
        claude_text = cm.read_bytes()
        if claude_text.startswith(b"\xef\xbb\xbf"):
            claude_text = claude_text[3:]
        claude_text = claude_text.decode("utf-8").replace("\r\n", "\n").replace("\r", "\n")
    except OSError:
        return None
    claude_ver = _parse_sentinel_version(claude_text)
    if claude_ver is None:
        return None

    # 2. 讀來源 clone 的 LUMOS_VERSION(文字 grep,不 import 避免副作用)
    src = _lumos_src()
    src_lumos = src / "scripts" / "lumos"
    if not src_lumos.exists():
        return None  # 來源不可達 → 靜默 skip
    try:
        _ver_pat = re.compile(r'^LUMOS_VERSION\s*=\s*"(v\d+\.\d+)"', re.MULTILINE)
        src_text = src_lumos.read_text(encoding="utf-8", errors="replace")
        m = _ver_pat.search(src_text)
        if not m:
            return None
        src_ver = m.group(1)
    except OSError:
        return None

    # 3. 比對:CLAUDE 版本 < 來源版本 → nudge(簡單字串不等判準;版本是 advisory)
    if claude_ver == src_ver:
        return None
    # 嘗試 tuple 比對(vMAJOR.MINOR → (MAJOR, MINOR));取不到就用字串不等
    def _ver_tuple(s):
        try:
            parts = s.lstrip("v").split(".")
            return tuple(int(x) for x in parts)
        except (ValueError, AttributeError):
            return None
    ct = _ver_tuple(claude_ver)
    st = _ver_tuple(src_ver)
    if ct is not None and st is not None and ct >= st:
        return None  # CLAUDE 版本 ≥ 來源,不 nudge
    # CLAUDE 落後(或無法比較)→ 提示
    return (
        f"本專案紀律區塊版本 {claude_ver} 落後來源 {src_ver},"
        f" 可跑 lumos update 刷新"
    )


# vendored 工具組白名單(固定 5 檔,scripts/ 前綴;hooks/templates 兩夾另走整夾刪)。
# _vendor_toolchain 安裝端與 cmd_deinit 移除端共用,避免漂移。
_VENDORED_TOOLKIT = ("scripts/lumos", "scripts/test_lumos.py",
                     "scripts/merge-claude-settings.py", "scripts/graph-rename.sh",
                     "scripts/fetch-notesmd.sh")


def _pull_source_or_abort(src, allow_stale=False):
    """更新來源 clone;拉不到就中止。回傳 0=可繼續、None=中止(呼叫端不得再寫任何檔)。

    ★為什麼 fail-closed★:原本 pull 失敗只印一行警告就繼續 vendor,來源落後或有本機
    分歧時會靜默拿舊版蓋掉專案裡較新的檔——消費端實戰咬過兩次,那行警告混在一堆輸出裡
    根本看不到。「拿不到最新」與「確定這是最新」是兩種狀態,不該用同一條路走完。

    ★但無 remote 不算失敗★:手動複製 / slim 安裝出來的來源本就沒有 remote,那是合法的
    離線情境,擋它等於把離線使用者鎖在門外。只有「有 remote 卻拉不到」才中止。
    _vendor_toolchain(專案層) 與 cmd_bootstrap(機器層) 共用本函式,避免兩處政策漂移。
    """
    import subprocess
    if not (src / ".git").is_dir():
        print("  (來源非 git repo,跳過 pull)")
        return 0
    has_remote = subprocess.run(["git", "-C", str(src), "remote"],
                                capture_output=True, text=True).stdout.strip()
    if not has_remote:
        print("  (來源無 remote:離線 clone,跳過 pull)")
        return 0
    print("  git pull 來源(取最新工具組)…")
    if subprocess.run(["git", "-C", str(src), "pull", "--ff-only"]).returncode == 0:
        return 0
    if allow_stale:
        print("  ⚠ --allow-stale:pull 失敗,明示沿用現有來源繼續", file=sys.stderr)
        return 0
    print(f"ERROR: 來源 {src} 拉不到最新(非 ff / 網路不通 / 工作區擋住),已中止——\n"
          f"  不拿可能過期的來源覆蓋你的專案(靜默降版是本專案咬過兩次的坑)。\n"
          f"  先處理來源:cd {src} && git status && git pull --ff-only\n"
          f"  確定要用現有來源:重跑並加 --allow-stale", file=sys.stderr)
    return None


def _vendor_toolchain(src, root, slug, no_pull=False, allow_stale=False):
    """從 Lumos 來源 src vendor 工具組到專案 root(python 單一源 scaffold + hooks + 結尾自癒)。
    回傳 0;來源無效回傳 None。架構圖資料受 _scaffold_project 的 skip 保護不被動。
    cmd_update / cmd_init(--with-hooks) 共用。"""
    import subprocess, shutil, filecmp
    installer = src / "scripts" / "install-graph-toolchain.sh"  # 仍作來源有效性探針(薄殼亦在)
    if not installer.exists():
        print(f"ERROR: 找不到 Lumos 來源 {src}（無 scripts/install-graph-toolchain.sh）\n"
              f"  用 --source <path> 指定、設 $LUMOS_HOME、或 clone 到 ~/harness/lumos-toolchain",
              file=sys.stderr)
        return None
    if not no_pull:
        rc_p = _pull_source_or_abort(src, allow_stale)
        if rc_p is None:
            return None                      # fail-closed:一個檔都還沒動就退場
    # 安裝邏輯收進 python 單一源(scaffold + hooks);bash 安裝器僅留薄殼。
    _scaffold_project(root, slug)
    _install_hooks_py(root)
    rc = 0
    # 結尾 diff 自癒:python 端逐檔比對 src↔target,差異即補(可安全覆寫)。
    toolkit = list(_VENDORED_TOOLKIT)
    for sub in ("scripts/hooks", "scripts/templates"):
        base = src / sub
        if base.is_dir():
            toolkit += [str(p.relative_to(src)) for p in base.rglob("*") if p.is_file()]
    healed = []
    for rel in toolkit:
        s, t = src / rel, root / rel
        if not s.exists():
            continue
        if (not t.exists()) or not filecmp.cmp(s, t, shallow=False):
            t.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(s, t)
            if s.stat().st_mode & 0o111:
                t.chmod(t.stat().st_mode | 0o111)
            healed.append(rel)
    if healed:
        print(f"  結尾自癒:補齊 installer 漏的 {len(healed)} 檔 → {', '.join(healed)}")
    else:
        print("  ✓ 結尾自癒檢查:工具組完全對齊(無漏)")
    # 範本已是最新(copy2 迴圈完成) → reinject CLAUDE.md 紀律區塊
    ri = _reinject_claude_block(root, slug)
    if ri.status == "updated":
        print("  CLAUDE.md 紀律區塊已更新")
        if ri.diff:
            for line in ri.diff.splitlines()[:20]:  # 最多印 20 行 diff 摘要
                print(f"    {line}")
    elif ri.status in ("created", "appended"):
        print(f"  CLAUDE.md 紀律區塊已注入({ri.status})")
    elif ri.status == "sentinel_broken":
        print("  ⚠ CLAUDE.md sentinel 半壞,未自動覆蓋,請檢查", file=sys.stderr)
    # unchanged / no_template → 靜默
    return rc


def cmd_update(source=None, no_pull=False, allow_stale=False):
    """從 Lumos 唯一源 repo 更新「本專案」vendored 的工具組。
    = (git pull Lumos) + install-graph-toolchain --target <本專案> --slug <自動偵測>。
    架構圖資料受 install-graph-toolchain 的 scaffold-skip 保護,不會被動。"""
    src = _lumos_src(source)
    vault = find_vault(Path.cwd())
    if vault is None:
        print("ERROR: 當前目錄找不到 docs/*-knowledge 專案 vault", file=sys.stderr)
        return 2
    root = vault.parent.parent  # docs/<slug>-knowledge → docs → 專案 root
    slug = vault.name[:-len("-knowledge")] if vault.name.endswith("-knowledge") else vault.name
    if root.resolve() == src.resolve():
        # 來源 repo 自身:範本本地即最新,無 pull/vendor 之需——reinject-only
        # (2026-08-05 實戰缺口修:改完範本後來源 repo 自己的 CLAUDE.md 原本無路可刷)
        ri = _reinject_claude_block(root, slug)
        print(f"lumos update — 來源 repo 自身:只刷新 CLAUDE.md 紀律區塊({ri.status})")
        return 0 if ri.status in ("updated", "unchanged", "created", "appended") else 2
    print(f"lumos update — 來源 {src} → 本專案 {root}（slug={slug}）")
    rc = _vendor_toolchain(src, root, slug, no_pull=no_pull, allow_stale=allow_stale)
    return 2 if rc is None else rc


def _skills_list():
    """user-scope skills=repo skills/ 下所有含 SKILL.md 的目錄(掃目錄防清單漂移——
    舊硬編碼 tuple 曾漏 code-loop 等;同步修 install.sh 同款漂移)。"""
    repo = Path(__file__).resolve().parent.parent
    d = repo / "skills"
    if not d.is_dir():
        return ()
    return tuple(sorted(p.name for p in d.iterdir() if (p / "SKILL.md").is_file()))


_SKILLS = _skills_list()


def _link_or_copy(src: Path, dst: Path):
    """src→dst:Unix symlink、Win 目錄 junction、失敗 fallback 複製。src 須為目錄。"""
    import os, shutil, subprocess
    # W4:Windows junction 不被 is_symlink() 認出。舊碼 rmtree(dst) 會「跟進」junction 刪掉
    # 來源 target;且重跑時 junction 殘留 → mklink 報已存在 → 不冪等。改:junction/空夾用
    # os.rmdir(只移連結本身、不碰 target),真實非空夾才 rmtree。
    if dst.is_symlink():
        dst.unlink()                                  # Unix symlink
    elif dst.is_dir():
        try:
            os.rmdir(dst)                             # junction 或空夾:只移連結/夾,不跟進 target
        except OSError:
            shutil.rmtree(dst, ignore_errors=True)    # 真實非空夾(上次 fallback 複製過)
    elif dst.exists():
        dst.unlink()
    dst.parent.mkdir(parents=True, exist_ok=True)
    try:
        if _IS_WIN:
            # W2:mklink 輸出走 OEM 碼頁(繁中=cp950),text=True 預設 UTF-8 解碼會在
            # reader thread 炸 UnicodeDecodeError。errors="replace" 防炸,returncode 仍可靠。
            r = subprocess.run(["cmd", "/c", "mklink", "/J", str(dst), str(src)],
                               capture_output=True, text=True, encoding="utf-8", errors="replace")
            if r.returncode != 0:
                raise OSError(r.stderr)
        else:
            dst.symlink_to(src)
    except OSError:
        shutil.copytree(src, dst, dirs_exist_ok=True)  # Python ≥ 3.8
        print(f"  ⚠ 連結失敗,改複製(失去 git pull 即更新): {dst}")


def _install_skills():
    repo = Path(__file__).resolve().parent.parent
    dest = Path.home() / ".claude" / "skills"
    for s in _SKILLS:
        src = repo / "skills" / s
        if src.is_dir():
            _link_or_copy(src, dest / s)
            print(f"  ✓ skill {s}")


_INIT_SUBDIRS_FULL = ("Systems", "Verification", "Projects", "Issues", "Sessions", "MOC")


def _scaffold_project(root: Path, slug: str):
    kg = root / "docs" / f"{slug}-knowledge"
    if kg.exists():
        print(f"  ✓ vault 已存在,跳過 scaffold(保護資料): {kg}")
        return
    for d in _INIT_SUBDIRS_FULL:
        (kg / d).mkdir(parents=True, exist_ok=True)
    _write_lf(kg / "MOC" / "index.md",
              f"---\ntype: moc\nstatus: doing\n---\n# {slug} 知識架構圖總索引\n")
    _write_lf(kg / ".gitignore",
              ".bypass-log.jsonl\n.rot-queue.jsonl\n.governance-log.jsonl\n.canary-log.jsonl\n.kill-log.jsonl\n.signoff-log.jsonl\n")
    print(f"  ✓ scaffold {kg}")


_GLOBAL_CLAUDE_HOOKS = ("check-graph-sync.py", "verification-rot-check.py", "impact-hook.py", "ci-status-hook.py")
# 已撤除的全域 hook：install/update 主動刪其殘留真檔(否則 _prune_dangling 因「非懸空」不剪、nag 不停)。
# code-loop-guard.py:2026-07-06 ADR 撤除 Stop nag(見 Projects/code-loop必用守衛_計劃)。撤別的 hook 在此補。
_RETIRED_CLAUDE_HOOKS = ("code-loop-guard.py",)


def _sync_global_claude(src_repo: Path):
    """全域 ~/.claude hooks/settings 同步(不需專案;install 與 _install_hooks_py 共用)。
    ①copy 現役 hooks ②刪已撤除 hook 殘留真檔 ③跑 merge-claude-settings(_prune_dangling 剪懸空註冊)。
    來源=src_repo(install 用來源 repo 自身、update 用專案 vendored copy);寫 ~/.claude(HOME 隔離可測)。
    設計:Projects/install全域hook同步_計劃。"""
    import subprocess, shutil
    chooks = Path.home() / ".claude" / "hooks"
    chooks.mkdir(parents=True, exist_ok=True)
    src_dir = src_repo / "scripts" / "hooks" / "claude"
    for f in _GLOBAL_CLAUDE_HOOKS:            # ① 現役 hooks copy
        s = src_dir / f
        if s.exists():
            shutil.copy2(s, chooks / f)
    for f in _RETIRED_CLAUDE_HOOKS:           # ② 撤除 hook 殘留真檔主動刪
        stale = chooks / f
        if stale.exists() or stale.is_symlink():
            stale.unlink()
    merge = src_repo / "scripts" / "merge-claude-settings.py"  # ③ merge+prune 懸空(含②剛變懸空的)
    if merge.exists():
        subprocess.run([sys.executable, str(merge)])


def _teardown_global_claude(src_repo: Path):
    """_sync_global_claude 的移除半邊(teardown 用):清全域 ~/.claude 的我方 hook + 剪其懸空註冊。
    ①先驗 settings.json 可解析→壞則跳過+warn、★不刪 .py★(不製造懸空,std F6)②rm 我方現役+撤除 hook
    ③跑 merge --prune-only(★只剪懸空、不 re-add★——預設 merge 會把 hook 加回,抵銷 teardown)。
    須在 deinit 刪掉 vendored merge-claude-settings.py 之前跑(std F5,由 cmd_teardown 順序保證)。
    設計:Projects/teardown一鍵拆機_計劃。回 True=已處理 / False=因 settings 壞跳過。"""
    import subprocess, json
    chome = Path.home() / ".claude"
    chooks, settings = chome / "hooks", chome / "settings.json"
    if settings.exists():                     # ① 先驗可解析(壞 → 不半做)
        try:
            json.loads(settings.read_text(encoding="utf-8"))
        except Exception as e:
            print(f"  ⚠ ~/.claude/settings.json 無法解析({e}),跳過全域 hook 清理"
                  "(避免刪了檔卻剪不掉註冊、留懸空)", file=sys.stderr)
            return False
    removed = []                              # ② rm 我方 hook 真檔
    for f in _GLOBAL_CLAUDE_HOOKS + _RETIRED_CLAUDE_HOOKS:
        p = chooks / f
        if p.exists() or p.is_symlink():
            p.unlink(); removed.append(f)
    merge = src_repo / "scripts" / "merge-claude-settings.py"   # ③ prune-only 剪懸空我方註冊
    if merge.exists() and settings.exists():
        subprocess.run([sys.executable, str(merge), "--prune-only"])
    print(f"  ✓ 全域 hook 清理:移除 {len(removed)} 檔 + 剪懸空我方註冊" if removed
          else "  ✓ 全域 hook:無我方殘留")
    return True


def _install_hooks_py(root: Path):
    import subprocess
    # ① git config core.hooksPath(專案本地)
    subprocess.run(["git", "-C", str(root), "config", "core.hooksPath", "scripts/hooks"])
    # ②③ 全域 hooks/settings 同步(委派共用函式,消雙寫;來源=專案 vendored copy)
    _sync_global_claude(root)
    print("  ✓ hooks:core.hooksPath + 全域 Claude hooks 同步(copy+撤除清理+settings)")


def _confirm_tty(prompt):
    """三階互動確認(curl|bash 安全;設計:Projects/bootstrap一鍵對稱_計劃 std F1/F2/F3):
    回 True(答 y/yes)/False(其他答案=拒絕)/None(非互動或無人回答→呼叫端跳過)。
    ①stdin.isatty→input();EOFError 落入②非當 False(isatty 撒謊時別誤判拒絕)
    ②os.open(tty,O_RDWR) 低階 fd(★r+ 開法對 tty 會炸 not seekable★)+os.write prompt
      +select timeout(有控制終端≠有人回答,防 readline 永久掛)+os.read
    ③皆不可→None。嚴禁在非 isatty 時讀 sys.stdin(curl|bash 下那是腳本殘文管線)。
    測試接縫:LUMOS_TTY(預設 /dev/tty;單元測指 pty slave)/LUMOS_TTY_TIMEOUT(預設 30s)。"""
    import os, select
    def _norm(ans):
        return ans.strip().lower() in ("y", "yes")   # 嚴格答案+預設 N(F2-B 殘文緩解)
    if sys.stdin.isatty():
        try:
            return _norm(input(prompt))
        except EOFError:
            pass                                     # isatty 撒謊 → 試 ②(F2-A)
    tty_path = os.environ.get("LUMOS_TTY", "/dev/tty")
    try:
        timeout = float(os.environ.get("LUMOS_TTY_TIMEOUT", "30"))
    except ValueError:
        timeout = 30.0
    try:
        fd = os.open(tty_path, os.O_RDWR)
    except OSError:
        return None
    try:
        os.write(fd, prompt.encode("utf-8"))
        readable, _, _ = select.select([fd], [], [], timeout)
        if not readable:
            os.write(fd, "\n(無回應,視為略過)\n".encode("utf-8"))
            return None
        data = os.read(fd, 256)
        if not data:
            return None
        return _norm(data.decode("utf-8", errors="replace"))
    except OSError:
        return None
    finally:
        os.close(fd)


def _self_repo_origin(script=None):
    """執行中腳本所屬 clone 的 origin URL(全域 lumos=symlink 進來源 clone,resolve 後可定位)。
    非 git repo/無 origin/git 不可用/★非工具鏈本體★ → None(呼叫端退硬編碼預設)。
    用途=鏡像自足(2026-08-19):從 Citrus_Lumos_Full 之類鏡像 clone 裝起的機器,bootstrap
    自動 clone 的預設來源=鏡像自己,不會漏回上游 repo。
    ★身分探針(單審 blocker 修)★:vendored 進業務專案的 scripts/lumos 是普通已提交檔——沒有
    這道探針,在業務 repo 裡跑 bootstrap 會把★業務 repo 的 origin★clone 成工具鏈來源,且全域
    symlink 從此指錯、無聲。判別鍵=skills/lumos-project-notes/SKILL.md(user-scope skill 唯一
    源,永不 vendor 進消費專案;同 install.py 來源 repo 判定慣例)。"""
    import subprocess
    repo = Path(script or __file__).resolve().parent.parent
    if not (repo / ".git").exists():
        return None
    if not (repo / "skills" / "lumos-project-notes" / "SKILL.md").is_file():
        return None   # vendored 消費副本/無關 repo:不信其 origin
    try:
        r = subprocess.run(["git", "-C", str(repo), "remote", "get-url", "origin"],
                           capture_output=True, text=True)
    except OSError:
        return None
    u = r.stdout.strip()
    return u if (r.returncode == 0 and u) else None


def _bootstrap_url(lumos_url=None, script=None):
    """bootstrap 預設 clone URL 解析鏈:旗標 > $LUMOS_URL > 本 clone origin(鏡像自足,含身分探針)
    > 硬編碼上游。抽成函式=解析順序可被行為測試釘住(單審抓到原字串包含斷言=假綠)。"""
    import os
    return (lumos_url or os.environ.get("LUMOS_URL") or _self_repo_origin(script=script)
            or "https://github.com/citrus-android-developer/Citrus_Lumos_Full")


def cmd_bootstrap(lumos_url=None, lumos_home=None, pull=False, init=False, allow_stale=False):
    """一鍵在專案內裝好一切:自動 clone Lumos(若缺)→ user-scope skills → 全域 lumos → 專案層自動接線。
    專案層四分流(設計:Projects/bootstrap一鍵對稱_計劃):有 vault+vendored→接 hooks｜有 vault 無
    vendored(中間態)→提示跑 init 補齊｜無 vault→_confirm_tty 確認(y 才 auto-init;--init 免確認)｜
    非 git→跳過只做機器層。--pull:既有 Lumos clone 也 git pull 拉最新。
    冪等:auto-init 只在無 vault 時觸發;cmd_init 一律 force=False+no_pull=True(pull 政策歸 step1)。
    失敗傳播(std F8):各步查 returncode,任一失敗最終 rc=1,不吞錯照印成功。"""
    import os, subprocess
    home = Path(lumos_home or os.environ.get("LUMOS_HOME")
                or (Path.home() / "harness" / "lumos-toolchain")).expanduser()
    url = _bootstrap_url(lumos_url)   # 解析鏈:旗標>env>本 clone origin(鏡像自足+身分探針)>硬編碼
    # 1) 確保 Lumos 來源在(缺則自動 clone;--pull 則既有 clone 也拉最新)
    # 存在性判定=scripts/lumos(真正要執行的檔;code-loop r1 F3:與 get.sh 同判準,免部分 clone 下兩端不一致)
    if (home / "scripts" / "lumos").exists():
        if pull:
            print(f"[1/3] Lumos 來源已在,git pull 更新: {home}")
            # 與 _vendor_toolchain 共用政策:有 remote 卻拉不到就中止,不拿可能過期的
            # 來源往下走(step3 的 auto-init 會把它 vendor 進專案 → 同一個降版坑)。
            if _pull_source_or_abort(home, allow_stale) is None:
                return 2
        else:
            print(f"[1/3] Lumos 來源已在: {home}（--pull 可拉最新 skills）")
    else:
        print(f"[1/3] clone Lumos → {home} …")
        home.parent.mkdir(parents=True, exist_ok=True)
        if subprocess.run(["git", "clone", url, str(home)]).returncode != 0:
            print(f"ERROR: clone 失敗。手動 `git clone {url} {home}` 後重試", file=sys.stderr)
            return 2
    # 2) 全域 lumos → 指向 Lumos 來源(非 vendored copy);install --force 已連帶裝 user-scope skills
    print("[2/3] 裝全域 lumos(+ user-scope skills)…")
    failures = []
    rc2 = subprocess.run([sys.executable, str(home / "scripts" / "lumos"),
                          "install", "--force"]).returncode
    if rc2 != 0:                                  # std F8:不吞錯
        print(f"  ⚠ install --force 失敗 rc={rc2}", file=sys.stderr)
        failures.append("install")
    # 3) 專案層自動接線(四分流;git toplevel 才算專案)
    try:
        root = Path(subprocess.check_output(["git", "rev-parse", "--show-toplevel"],
                                            text=True, stderr=subprocess.DEVNULL).strip())
    except Exception:
        root = None
    if root is None:
        print("[3/3] 非 git repo,跳過專案層(機器層已裝;到專案內再跑 bootstrap 或 lumos init)")
    else:
        os.environ["LUMOS_HOME"] = str(home)      # std F6:cmd_init 內 _lumos_src 讀此傳導自訂 home
        vault = _vault_in(root)
        vendored = (root / "scripts" / "merge-claude-settings.py").exists()
        if vault is not None and vendored:        # ① 已是專案 → 接 hooks(git config 每機器要重接)
            print(f"[3/3] 裝 repo hooks（{root}）…")
            try:
                _install_hooks_py(root)
            except Exception as e:
                print(f"  ⚠ hooks 安裝失敗:{e}", file=sys.stderr)
                failures.append("hooks")
        elif vault is not None:                   # ② 中間態(F5:_vault_in 只看名稱,別疊自動動作)
            print(f"[3/3] ⚠ {root} 有 vault({vault.name})但無 vendored 工具——"
                  "跑 `lumos init` 補齊(不自動動)", file=sys.stderr)
        else:                                     # ③ 無 vault → 確認後 auto-init
            go = init
            if not go:
                ans = _confirm_tty(f"[3/3] 要把 {root} 建成 lumos 專案(建架構圖+工具+hooks)嗎? [y/N] ")
                if ans is None:
                    print("[3/3] 非互動環境,跳過建專案(要建:互動跑或加 --init)")
                go = (ans is True)
            if go:
                print(f"[3/3] 初始化 lumos 專案（{root}）…")
                try:
                    rc3 = cmd_init(force=False, no_pull=True)   # F7:pull 政策歸 step1;永不 force
                except Exception as e:                           # code-loop r1 F2:init 內部炸(權限/磁碟)別裸 traceback
                    print(f"  ⚠ init 失敗:{e}", file=sys.stderr)
                    failures.append("init")
                else:
                    # code-loop r1 F2:cmd_init 對 vendor 失敗只印警告仍回 0(rc 判定是死碼)
                    # → 後驗實體:vault 與 vendored 工具都真的在才算成功,半成品要反映在最終 rc
                    if rc3 or _vault_in(root) is None \
                            or not (root / "scripts" / "merge-claude-settings.py").exists():
                        print("  ⚠ init 未完整(vault 或 vendored 工具缺,詳見上方訊息)", file=sys.stderr)
                        failures.append("init")
    if failures:
        print(f"\n✗ bootstrap 部分失敗:{', '.join(failures)}(其餘步驟已完成)", file=sys.stderr)
        return 1
    print("\n✓ bootstrap 完成。最後一步:**重啟 Claude Code session**(L1/L3 hooks 要 session start 才載入)。")
    return 0


def _slugify_vault(name: str):
    """repo basename → vault slug:小寫、非英數轉 -、收斂連續 -、去頭尾 -、去既有 -knowledge 尾。"""
    s = re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")
    if s.endswith("-knowledge"):
        s = s[:-len("-knowledge")]
    return s or "project"


def cmd_init(name=None, force=False, with_hooks=True, no_pull=False, allow_stale=False):
    """在當前 repo 初始化知識架構圖:建 docs/<slug>-knowledge/{6 個資料夾} + .gitignore,
    預設並 vendor 工具組 + 裝 pre-commit/pre-push 閘(--no-hooks 只建架構圖輕量版)。
    像 `openspec init`:一行開好就能 `lumos new`。
    分工:init = 專案層(架構圖 + 該 repo 的 hooks);bootstrap = 機器層(clone Lumos/skills/全域 lumos),一輩子一次。
    序列(既有 vault 非 force):只 _reinject_claude_block(讀本機已 vendor 範本,不 pull、不重裝 hooks)→ early-return。
    序列(新 vault 或 --force):_vendor_toolchain(pull + copy2 + hooks + reinject) → scaffold → 完成。
    no_hooks 路徑(不分新/既有):只 _reinject_claude_block(讀本機已 vendor 範本,無則靜默)。"""
    import subprocess
    try:
        root = Path(subprocess.check_output(
            ["git", "rev-parse", "--show-toplevel"], text=True, stderr=subprocess.DEVNULL).strip())
    except Exception:
        root = Path.cwd()
    existing = _vault_in(root)
    # slug 決定順序:① --name 顯式 ② 既有 vault 的 slug ③ repo basename。
    # ②必須先於③:否則既有 vault 上跑 --force 會用 repo basename 當 slug,
    # 建錯一個空 vault + 把 CLAUDE.md {{KG}} 路徑寫錯(現場事故:basename landmarkmember
    # vs 既有 vault landmark-knowledge)。既有 vault 的資料夾名即權威 slug,不重新 slugify。
    if name:
        slug = _slugify_vault(name)
    elif existing is not None and existing.name.endswith("-knowledge"):
        slug = existing.name[:-len("-knowledge")]
    else:
        slug = _slugify_vault(root.name)

    # ── Step 1: reinject CLAUDE.md(依路徑輕/重分流)─────────────────────
    # 既有 vault 非 force:只 reinject(輕量);不 pull、不重裝 hooks。
    # 新 vault 或 --force:完整 _vendor_toolchain(pull + copy2 + hooks + reinject)。
    # no_hooks 路徑:一律只 reinject(讀本機已 vendor 範本,無則靜默)。
    def _do_reinject():
        ri = _reinject_claude_block(root, slug)
        if ri.status == "updated":
            print("  CLAUDE.md 紀律區塊已更新")
        elif ri.status in ("created", "appended"):
            print(f"  CLAUDE.md 紀律區塊已注入({ri.status})")
        elif ri.status == "sentinel_broken":
            print("  ⚠ CLAUDE.md sentinel 半壞,未自動覆蓋,請檢查", file=sys.stderr)
        # unchanged / no_template → 靜默

    if with_hooks:
        src = _lumos_src()
        if root.resolve() == src.resolve():
            print("\n  (當前就是 Lumos 來源本身,跳過 vendor/hooks;CLAUDE.md 紀律區塊照刷)")
            _do_reinject()   # 2026-08-05 修:原本連 reinject 一起跳過,範本更新後來源 repo 自己永不刷新
        elif existing is not None and not force:
            # 既有 vault 非 force:輕量路徑,只刷新 CLAUDE.md 紀律區塊
            _do_reinject()
        else:
            # 新 vault 或 --force:完整 vendor(pull + copy2 + hooks + reinject)
            print(f"lumos init — 在 {root} 建架構圖 vault: docs/{slug}-knowledge/")
            print("\n裝 hooks:vendor 工具組 + 啟用 pre-commit/pre-push 閘…")
            rc = _vendor_toolchain(src, root, slug, no_pull=no_pull, allow_stale=allow_stale)
            # _vendor_toolchain 已呼叫 _install_hooks_py + _reinject_claude_block;不重複
            if rc is None:
                print("  ⚠ 來源不可用,略過 hooks(架構圖已建好)。日後補裝:lumos update")
    else:
        # no_hooks:讀本機 vendored 範本執行 reinject(無範本 → no_template → 靜默)
        _do_reinject()

    # ── Step 2: existing/force 判定 ───────────────────────────────────
    if existing is not None and not force:
        print(f"✓ 此 repo 已有 vault: {existing.relative_to(root)}")
        print("  (要另建用 --name <slug>;要在既有 vault 上重裝/更新 hooks 與工具組用 --force,vault 內容不動)")
        return 0

    # ── Step 3: scaffold 架構圖資料(新 vault;既有 vault 內部 kg.exists() guard 保護) ──
    if not with_hooks:
        print(f"lumos init — 在 {root} 建架構圖 vault: docs/{slug}-knowledge/")
    _scaffold_project(root, slug)  # 6 夾 + .gitignore + MOC/index.md;既有 vault 自動 skip 保護資料

    print("\n✓ init 完成。開始用:")
    print(f"    cd {root}")
    print("    lumos new system <模組名>     # 建第一個系統節點")
    print("    lumos doctor                  # 健檢")
    if with_hooks:
        print("  (已裝 pre-commit/pre-push 閘:改 code 沒更新架構圖會被擋)")
    return 0


def _vault_in(d: Path):
    """d 之下是否有 vault: docs/*-knowledge 或 docs/knowledge(專案佈局),
    或 d 本身就是 vault root(standalone,如核心 repo:有 MOC/ + Verification|Systems)。"""
    docs = d / "docs"
    if docs.is_dir():
        for sub in sorted(docs.iterdir()):
            if sub.is_dir() and sub.name.endswith("-knowledge"):
                return sub
        if (docs / "knowledge").is_dir():
            return docs / "knowledge"
    # standalone vault root(核心 repo 等):MOC/ + (Verification/ 或 Systems/)
    if (d / "MOC").is_dir() and ((d / "Verification").is_dir() or (d / "Systems").is_dir()):
        return d
    return None


def find_vault(start: Path):
    """從 cwd 往上走找 vault(全域安裝後可從任何專案子目錄跑)。"""
    start = start.resolve()
    for d in [start, *start.parents]:
        v = _vault_in(d)
        if v is not None:
            return v
        if (d / ".git").exists():  # 到 repo 根還沒找到就停(別爬出專案)
            break
    return None



ANCHOR_FILES = [
    "scripts/test_lumos.py",
    "scripts/test_autonomous_loop.py",
    "scripts/hooks/pre-commit",
    "scripts/hooks/pre-push",
    "scripts/hooks/post-commit",
]
_ANCHOR_BASELINE_REL = "governance/anchor-baseline.json"


def _anchor_repo_root(repo):
    """--repo 顯式優先;省略時 cwd 逐層向上找 .git(同 refcheck 慣例)。失敗印錯回 None。"""
    if repo is not None:
        p = Path(repo)
        if not p.is_dir():
            print(f"ERROR: --repo 不是目錄: {repo}", file=sys.stderr)
            return None
        return p
    for cand in (Path.cwd(), *Path.cwd().parents):
        if (cand / ".git").exists():
            return cand
    print("ERROR: cwd 逐層向上找不到 .git repo,請用 --repo 指定", file=sys.stderr)
    return None


def _quote_norm(s):
    """quote-check 的唯一正規化(T2 design-loop重設計):NFC → 剝 markdown 強調記號(*/`)
    → 空白(含全形\u3000/換行)摺疊單空格。★抽取與比對共用這一份——嚴禁第二份實作★
    (2026-08-02 教訓:預檢與主迴圈兩份實作當場漂移)。不做 lower(保留大小寫語意)。"""
    import re
    import unicodedata
    s = unicodedata.normalize("NFC", s)
    # Landmark 真場實測(2026-08-04):blockquote 折行的續行 > 記號會進 hay,引句永遠比不中
    s = re.sub(r"(?m)^\s*>\s?", "", s)
    s = s.replace("*", "").replace("`", "")
    return " ".join(s.split())


_QUOTE_MIN_NORM_LEN = 10   # 錨定紀律「引句 ≥10 字」轉機械(r1 否決席:一字引句必然錨得到=紀律被架空)


def _quote_rows(rtext, stext):
    """quote-check 核心(T4 抽出供 CLI 與 disposal gate 共用——★單一實作★):
    回 [{'quote','ok'},...];零引句回 None(呼叫端 fail loud)。
    引句止於★同型★閉引號:「…」內容許『』(r1 s1 席:原 [^」』]+ 在巢狀『就截斷,
    「規則『甲」被當前綴錨到,編造的後半永遠沒被驗);norm 後不足下限判 miss。"""
    import re
    # 標籤容錯(Landmark 真場實測 2026-08-04):席位自然寫成 **引句**：/**引句（註記）**：——
    # 只認裸「引句：」會把整份合規報告判成抽零條;容忍可選（…）註記與 * 強調記號
    _Q_LABEL = r"引句(?:（[^）\n]{0,40}）)?\**[：:]\s*"
    quotes = [m.group(1) if m.group(1) is not None else m.group(2)
              for m in re.finditer(_Q_LABEL + r"(?:「([^」]+)」|『([^』]+)』)", rtext)]
    # r3 修(s2 席):引號型態不成對(「…』)抽不出來會整條靜默消失=編造引句的逃逸口——
    # 「引句：」標記數 > 成功抽取數時,差額以格式 miss 入列(fail loud,不採信)
    n_markers = len(re.findall(_Q_LABEL + r"[「『]", rtext))
    if not quotes and not n_markers:
        return None
    hay = _quote_norm(stext)
    hay_ns = hay.replace(" ", "")
    rows = []
    for q in quotes:
        nq = _quote_norm(q)
        too_short = len(nq) < _QUOTE_MIN_NORM_LEN
        # CJK 折行 fallback(Landmark 真場實測):快照句中折行使 norm 後多一個空格,
        # 連續引句子字串必 miss——空白全剝再比一次(存在性檢查,黏合誤中風險可忽略:
        # 引句有 10 字下限,跨句黏合要恰好湊出同字序)
        anchored = nq in hay or nq.replace(" ", "") in hay_ns
        rows.append({"quote": q, "ok": (not too_short) and anchored,
                     **({"too_short": True} if too_short else {})})
    for _ in range(n_markers - len(quotes)):
        rows.append({"quote": "(引號未閉合/開閉型態不符,無法抽取)", "ok": False, "malformed": True})
    return rows


def _loop_status_disposal(rounds, loop_id, spec, n_badlines=0, root=None, bad_linenos=None):
    """[T4] 處置閘(design-loop重設計 三):四條合取,全部讀側可重算——
    ①G3 hash 鏈 ②處置集合重算(不信寫側) ③留痕重驗(判定輪★全部★帶留痕欄的席,
    report/snapshot 存在且 sha 一致——r1 否決席:原只驗 carrier,竄改 missed 席報告照樣 PASS)
    ④quote-check 對 carrier 的帳面 snapshot 全 ok。
    ★canary caught/missed 不進合取(d4:觀測非閘;missed 不作廢 findings)★。
    壞行 fail-closed(r1 四席重疊:原壞行靜默跳過→latest 判錯輪可偽 PASS);
    round-id 非連續重現 rc2(reuse panel 守衛;原 OrderedDict 首現序拿錯輪)。
    留痕路徑:非絕對路徑以 repo root(root)解析(與寫側落帳慣例對稱)。
    exit 0=收斂 / 1=未過 / 2=帳面損壞或參數錯。"""
    from collections import OrderedDict
    if n_badlines:
        print(f"ERROR: canary-log 含 {n_badlines} 行不可解析——disposal 閘 fail-closed"
              "(壞行使「判定輪=最後一輪」不可信;修帳或隔離壞行後再問)"
              + (f"——壞行行號: {bad_linenos}" if bad_linenos else "")
              + "(帳在 git 版控下,diff 定位一分鐘可修;全帳域檢查=共用帳完整性,同 settle 前例)",
              file=sys.stderr)
        return 2
    # r3 修:round 與 round-less 混用=rc2(同 panel 混用守衛精神;原樣混排會落進
    # 「非連續重現」的誤導訊息,或與內部 __seq 鍵互動出偽輪)
    n_round_ = sum(1 for r in rounds if "round" in r)
    if rounds and 0 < n_round_ < len(rounds):
        print("ERROR: 本 loop 混用帶 round 與無 round 的記錄——disposal 判定輪不可定義,"
              "統一補 --round 或全部不帶", file=sys.stderr)
        return 2
    groups = OrderedDict()
    for r in rounds:
        rid_ = r.get("round")
        if rid_ is None:
            # round-less 逐筆自成一輪(r2 回歸修:併成單一 __legacy 組會讓較早 carrier
            # 冒充最新判定/合法 legacy 第二筆假 rc2;守衛只管顯式 round-id)
            groups[f"__seq{len(groups)}"] = [r]
            continue
        if rid_.startswith("__"):
            # r3 修(3 席重疊):防舊帳/手改帳撞內部鍵(寫側已擋新寫入,讀側防守舊資料)
            print(f"ERROR: 帳面 round-id {rid_!r} 撞內部保留字首 __(手改帳或舊版寫入)", file=sys.stderr)
            return 2
        if rid_ in groups and next(reversed(groups)) != rid_:
            # 同 panel 守衛:round-id 被其他輪隔開後重現=append-only 帳次序損壞
            print(f"ERROR: round-id {rid_!r} 非連續重現(被其他輪隔開;append-only 帳次序損壞)",
                  file=sys.stderr)
            return 2
        groups.setdefault(rid_, []).append(r)
    if not groups:
        print(f"⏳ 無記錄 ({loop_id})")
        return 1
    rid, latest = next(reversed(groups.items()))

    def _prov_path(p):
        pp = Path(p)
        return pp if pp.is_absolute() or root is None else Path(root) / pp
    fails = []
    # ── ① G3 hash 鏈(fail-closed:unbound 也擋——disposal 是新閘,無舊帳包袱) ──
    try:
        err, info = _hash_chain_check([latest], spec)
    except OSError as e:
        print(f"ERROR: 讀不到 --spec {spec}: {e}", file=sys.stderr)
        return 2
    if err:
        print(f"[disposal] G3 hash: ✗ — {err}")
        fails.append("G3")
    elif info == "unbound":
        print("[disposal] G3 hash: ✗ — 判定輪未綁 hash(disposal 閘 fail-closed,record 帶 --spec/--reviewed)")
        fails.append("G3")
    else:
        print(f"[disposal] G3 hash: ✓ — {info}")
    # ── ② 處置集合(輪級重算,不信寫側) ──
    carriers = [r for r in latest if "findings_set" in r]
    if len(carriers) > 1:
        print(f"ERROR: 判定輪 {rid} 有 {len(carriers)} 筆帶處置帳(每輪至多一筆;同 clusters 慣例)", file=sys.stderr)
        return 2
    carrier = carriers[0] if carriers else None
    if carrier is None:
        print("[disposal] 處置集合: ✗ — 判定輪無處置帳(record 帶 --findings-set/--folded-set/--accepted-set)")
        fails.append("無處置帳")
    else:
        F = set(carrier.get("findings_set") or [])
        FO = set(carrier.get("folded_set") or [])
        AC = set(carrier.get("accepted_set") or [])
        reasons = carrier.get("accept_reasons") or {}
        bad = None
        if FO & AC:
            bad = f"folded∩accepted 非空: {sorted(FO & AC)}"
        elif FO | AC != F:
            bad = f"未處置: {sorted(F - FO - AC)}"
        elif set(reasons) != AC or any(not str(v).strip() for v in reasons.values()):
            bad = "accepted 理由缺席或空"
        elif AC and any(r.get("severity") == "blocker" for r in latest):
            bad = "★輪內有 blocker 席,accepted 必須為空(d1;輪級重算,不信寫側單席視角)★"
        if bad:
            print(f"[disposal] 處置集合: ✗ — {bad}")
            fails.append("處置集合")
        else:
            print(f"[disposal] 處置集合: ✓ — {len(F)} 條全處置(折 {len(FO)}/放行 {len(AC)},理由齊)")
    # ── ③ 留痕重驗(判定輪全席) + ④ quote-check(carrier) ──
    if carrier is not None:
        rp, sp = carrier.get("report_path"), carrier.get("snapshot_path")
        if not rp or not sp:
            print("[disposal] 留痕: ✗ — 判定輪未帶 report/snapshot(留痕缺席)")
            fails.append("留痕缺席")
        else:
            ok = True
            n_files = 0
            # 全席重驗:T6 定錨後每席都被迫留痕,讀側就得每席都重驗——
            # 只驗 carrier 等於把 missed 席留痕降回「寫側形式要求」(r1 否決席 finding)。
            for i, r in enumerate(latest, 1):
                for label, key in (("report", "report_path"), ("snapshot", "snapshot_path")):
                    pth = r.get(key)
                    if not pth:
                        # r2 回歸修(否決席):缺欄席不得靜默跳過——「全席重驗」對缺欄席
                        # 也要成立,否則定錨前搶跑的席=讀側盲區
                        print(f"[disposal] 留痕: ✗ — {rid}.{i} 未帶 {label}(disposal 判定輪全席都要留痕)")
                        fails.append("留痕")
                        ok = False
                        continue
                    n_files += 1
                    want = r.get(key.replace("_path", "_sha256"))
                    try:
                        got = _sha256_file(_prov_path(pth))
                    except OSError:
                        print(f"[disposal] 留痕: ✗ — {rid}.{i} {label} 讀不到({pth})——record 完刪檔照樣擋")
                        fails.append("留痕")
                        ok = False
                        continue
                    if got != want:
                        print(f"[disposal] 留痕: ✗ — {rid}.{i} {label} sha256 與帳面不符(事後被改)")
                        fails.append("留痕")
                        ok = False
            if ok:
                print(f"[disposal] 留痕: ✓ — 判定輪全席 {n_files} 份留痕存在且 sha256 與帳面一致")
                try:
                    rows = _quote_rows(_prov_path(rp).read_text(encoding="utf-8"),
                                       _prov_path(sp).read_text(encoding="utf-8"))
                except (OSError, UnicodeDecodeError) as e:
                    # sha 讀二進位過了,text 讀可炸(非 UTF-8)——FAIL 不 traceback(r1 s4 席)
                    print(f"[disposal] quote-check: ✗ — 報告/快照讀不成文字({e.__class__.__name__})")
                    fails.append("quote")
                    rows = None
                else:
                    if rows is None:
                        print("[disposal] quote-check: ✗ — 報告零引句(驗不了≠通過)")
                        fails.append("quote")
                    else:
                        miss = [q for q in rows if not q["ok"]]
                        n_short = sum(1 for q in rows if q.get("too_short"))
                        if miss:
                            print(f"[disposal] quote-check: ✗ — {len(miss)}/{len(rows)} 條錨不到快照"
                                  + (f"(其中 {n_short} 條低於 {_QUOTE_MIN_NORM_LEN} 字下限)" if n_short else ""))
                            fails.append("quote")
                        else:
                            print(f"[disposal] quote-check: ✓ — {len(rows)} 條引句全數錨定")
    # ── canary 觀測(不進合取——d4;none=停用制無植入輪——d5) ──
    ca = sum(1 for r in latest if r.get("kind") == "caught")
    mi = sum(1 for r in latest if r.get("kind") == "missed")
    nn = sum(1 for r in latest if r.get("kind") == "none")
    print(f"[disposal] canary(觀測,不進合取): caught {ca} / missed {mi}"
          + (f" / none {nn}(協議停用,d5)" if nn else "")
          + ("——missed 席 findings ★不作廢★(d4),供跨輪累積帳" if mi else ""))
    for i, r in enumerate(latest, 1):
        print(f"  {rid}.{i}\t{r.get('kind','?')}\t{r.get('severity','-')}\t{r.get('auditor','')}")
    if fails:
        print(f"⛔ DISPOSAL GATE FAIL ({loop_id} 輪 {rid}: {'/'.join(fails)})")
        return 1
    print(f"✅ DISPOSAL GATE PASS ({loop_id} 輪 {rid}: G3 ∧ 處置全清 ∧ 留痕可重算 ∧ 引句全錨定)")
    return 0


def cmd_quote_check(report, spec, as_json=False):
    """錨定檢查(T2,vault-free):報告內每條「引句：「…」」norm 後須為凍結快照 norm 後的
    子字串。rc0=全 ok、rc1=有 miss、rc2=IO/零引句(★驗不了≠通過,fail loud★)。
    ★比對對象必須是派工當下的凍結快照,不是現檔★——對現檔跑,finding 折入後引句會
    「自我成真」(重設計 r1 Codex 折入:循環自證)。"""
    import json
    import re
    try:
        rtext = Path(report).read_text(encoding="utf-8")
        stext = Path(spec).read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError) as e:
        # UnicodeDecodeError 非 OSError——非 UTF-8 檔原本直接 traceback(r1 s4 席)
        print(f"ERROR: 讀不到檔案: {e}", file=sys.stderr)
        return 2
    rows = _quote_rows(rtext, stext)
    if rows is None:
        print("ERROR: 報告內抽不到任何「引句：「…」」——驗不了≠通過;"
              "席報告未遵守派工格式時,先補引句再記帳。\n"
              "  常見原因(Landmark 首測實錄):①標籤粗體/註記變體已容錯(**引句**：/引句（註）：可抽),"
              "但『引文:』『Quote:』等別名不認 ②引號用半形 \"…\" 或【…】(只認「」『』) "
              "③引句與標籤不同行 ④開閉引號不成對(會以格式 miss 入列,非零條)", file=sys.stderr)
        return 2
    miss = [r for r in rows if not r["ok"]]
    if as_json:
        print(json.dumps({"report": str(report), "spec": str(spec),
                          "total": len(rows), "miss": len(miss), "quotes": rows},
                         ensure_ascii=False))
    else:
        for i, r in enumerate(rows, 1):
            mark = "✓" if r["ok"] else "✗"
            short = f"(<{_QUOTE_MIN_NORM_LEN} 字下限)" if r.get("too_short") else ""
            print(f"  {mark} #{i} 「{r['quote'][:60]}」{short}")
        print(f"{'✅ 全數錨定' if not miss else f'⛔ {len(miss)}/{len(rows)} 條錨不到(miss 條不採信)'}"
              f"(正規化=NFC+剝 */`+空白摺疊;比對對象應為派工凍結快照)")
    return 0 if not miss else 1




_CJK_RE = re.compile(r"[\u4e00-\u9fff]")
_NODE_SUFFIX_RE = re.compile(r"(_計劃|_實作計畫|_調研)$")
_NODE_DATEPFX_RE = re.compile(r"^\d{4}-\d{2}-\d{2}_")


def _lc_strip_stem(node_rel):
    """節點檔名 stem 剝節點型後綴與日期前綴(D2 防泛用尾綴誤報,plan:連結缺失補全 r1)。"""
    s = Path(node_rel).stem
    s = _NODE_DATEPFX_RE.sub("", s)
    s = _NODE_SUFFIX_RE.sub("", s)
    return s


def _lc_lcs_cjk(a, b):
    """最長公共連續子字串;回其中 CJK 字元數(演算法明文=逐對 LCS-substring)。"""
    if not a or not b:
        return 0
    best = ""
    # O(len(a)*len(b)) 樸素 DP;stem 長度小,夠用
    prev = [0] * (len(b) + 1)
    for i in range(1, len(a) + 1):
        cur = [0] * (len(b) + 1)
        for j in range(1, len(b) + 1):
            if a[i - 1] == b[j - 1]:
                cur[j] = prev[j - 1] + 1
                if cur[j] > len(best):
                    best = a[i - cur[j]:i]
        prev = cur
    return sum(1 for ch in best if _CJK_RE.match(ch))


def cmd_link_candidates(code_file=None, goldset=None, repo=None, as_json=False):
    """[S1 連結缺失補全,2026-08-07](plan:Projects/連結缺失補全_計劃;borrow TLR 離線候選
    +pitfalls-gapfill 人裁姿勢)。code→節點補鏈候選生成,★唯讀恆 rc0、不寫任何檔★——
    補引用=人裁後的正常架構圖編輯(合約候選:自動寫入=maker bias 閉環,人閘不可拆)。

    偵測器(全決定論,零 LLM):
    - D1 純文字提及:節點可見文字(_visible_lines keep_fenced=False+INLINE_CODE_RE 剝——
      即 search 的 include_code=False 同款組合;勿用保留 inline-code 的 _strip_fences_text)
      含完整路徑/完整檔名;或含 stem 且 stem≥6 字元且含 _ 或 -(複合詞判準,防 config/system
      這類單詞洪水)。
    - D2 鄰居家族:direct 節點集 D 的單跳雙向鄰居(邊型統一四種:related/body-wikilink/
      plan_refs/verified_by,不遞迴),且 (a) 剝後綴 stem 與某 d 的 LCS-substring ≥4 CJK
      (防「_實作計畫」泛用尾綴誤報——r1 實測 11 檔同尾) 或 (b) 經 plan_refs/verified_by
      單跳相連。
    已 direct(含 basename-match)去重不出候選。CLI:code_file 與 goldset 互斥必居其一,
    goldset 路徑為參數(vendored 工具不得寫死本專案治具路徑,合約候選)。
    輸出 schema 封閉:{"file", "candidates":[{"node","signal","evidence","via"}]}。
    """
    import json
    import os
    if bool(code_file) == bool(goldset):
        print("ERROR: <code-file> 與 --all-goldset 互斥且必居其一", file=sys.stderr)
        return 2
    repo_root = Path(repo or ".").resolve()
    vault = _vault_in(repo_root)
    if vault is None:
        print("ERROR: vault 找不到(--repo 未指向含 docs/*-knowledge 的目錄)", file=sys.stderr)
        return 2
    env = Env(vault)
    files = []
    if goldset:
        try:
            gs = json.loads(Path(goldset).read_text(encoding="utf-8"))
            files = sorted({c["file"] for c in gs.get("edit", []) if c.get("file")})
        except (OSError, ValueError, TypeError) as e:
            print(f"ERROR: goldset 讀取/格式失敗: {e}", file=sys.stderr)
            return 2
    else:
        rp = str(code_file)
        if os.path.isabs(rp):
            rp = os.path.relpath(rp, str(repo_root))
        if not (repo_root / rp).exists():
            print(f"ERROR: code 檔不存在: {rp}", file=sys.stderr)
            return 2
        files = [rp]

    # 節點文字/鄰接一次建(全庫 ~240 節點,單進程)
    texts = {}
    for node_rel in env.notes:
        try:
            texts[node_rel] = (env.vault / node_rel).read_text(encoding="utf-8-sig",
                                                               errors="replace")
        except OSError:
            texts[node_rel] = ""
    stems = {rel: Path(rel).name for rel in texts}
    def _resolve(name):
        name = name.strip()
        for rel in texts:
            if rel == name or rel == name + ".md" or Path(rel).stem == name:
                return rel
        return None
    adj = {rel: {} for rel in texts}   # rel -> {nbr: set(edge_types)}
    _WIKI = re.compile(r"\[\[([^\]|#]+)")
    for rel, note in env.notes.items():
        edges = []
        for fld in ("related", "plan_refs", "verified_by"):
            for v in as_list(note.fields.get(fld)):
                m = _WIKI.match(str(v)) or re.match(r"(.+)", str(v).strip("[]\" "))
                tgt = _resolve(m.group(1)) if m else None
                if tgt:
                    edges.append((tgt, fld))
        for m in _WIKI.finditer(texts[rel]):
            tgt = _resolve(m.group(1))
            if tgt:
                edges.append((tgt, "body-wikilink"))
        for tgt, ty in edges:
            if tgt == rel:
                continue
            adj[rel].setdefault(tgt, set()).add(ty)
            adj[tgt].setdefault(rel, set()).add(ty)   # 單跳雙向

    out_all = []
    for rel_file in files:
        pairs = _impact_reverse_lookup(rel_file, env, repo_root)
        direct = {n for n, _h in pairs}
        base = Path(rel_file).name
        stem = Path(rel_file).stem
        stem_ok = len(stem) >= 6 and ("_" in stem or "-" in stem)
        cands = {}
        # D1
        for rel, text in texts.items():
            if rel in direct:
                continue
            ev = []
            for _no, ln in _visible_lines(text.split("\n"), keep_fenced=False):
                probe = INLINE_CODE_RE.sub("", ln)
                if rel_file in probe or base in probe or (stem_ok and stem in probe):
                    ev.append(ln.strip()[:120])
            if ev:
                cands[rel] = {"node": rel, "signal": "plain-text",
                              "evidence": ev[:3], "via": []}
        # D2
        for d in direct:
            d_stem = _lc_strip_stem(d)
            for nbr, types in adj.get(d, {}).items():
                if nbr in direct:
                    continue
                hit_a = _lc_lcs_cjk(_lc_strip_stem(nbr), d_stem) >= 4
                hit_b = bool(types & {"plan_refs", "verified_by"})
                if hit_a or hit_b:
                    c = cands.get(nbr)
                    if c:
                        c["signal"] = "both"
                        if d not in c["via"]:
                            c["via"].append(d)
                    else:
                        cands[nbr] = {"node": nbr, "signal": "neighbor-family",
                                      "evidence": [], "via": [d]}
        result = {"file": rel_file,
                  "candidates": sorted(cands.values(), key=lambda c: c["node"])}
        out_all.append(result)
        if not as_json:
            print(f"link-candidates {rel_file}: {len(result['candidates'])} 筆候選"
                  f"(direct {len(direct)} 已去重)")
            if not result["candidates"]:
                print("  無")
            for c in result["candidates"]:
                via = f"  via {','.join(c['via'])}" if c["via"] else ""
                ev = f"  「{c['evidence'][0][:60]}」" if c["evidence"] else ""
                print(f"  [{c['signal']}] {c['node']}{via}{ev}")
    if as_json:
        print(json.dumps(out_all[0] if code_file else out_all, ensure_ascii=False))
    if not as_json:
        print("  ★唯讀候選,不寫檔;補引用=人裁後的正常架構圖編輯(人閘省不掉)★")
    return 0




# ═══ diff 變異測試(S4,plan:驗證層去模型化;「植針考測試」取代「植針考人」)═══

_MUTATE_CAP_DEFAULT = 100


def _mutate_gen(src_text, target_lines):
    """對 python 源碼生成變異(ast NodeTransformer;字串/註解天然免疫)。
    target_lines: set[int]——只變異這些行(diff 的 + 行)所在的節點。
    回 [(lineno, op_desc, mutated_src)];等價變異由人裁剔除,v1 不判。"""
    import ast
    import copy
    try:
        tree = ast.parse(src_text)
    except SyntaxError:
        return []
    muts = []
    _CMP = {ast.Eq: ast.NotEq, ast.NotEq: ast.Eq, ast.Lt: ast.GtE, ast.GtE: ast.Lt,
            ast.Gt: ast.LtE, ast.LtE: ast.Gt}

    # 收集候選:(node, 描述, 產生 mutated tree 的函式)
    cands = []
    for node in ast.walk(tree):
        ln = getattr(node, "lineno", None)
        if ln is None or ln not in target_lines:
            continue
        if isinstance(node, ast.Compare):
            for i, op in enumerate(node.ops):
                rep = _CMP.get(type(op))
                if rep:
                    cands.append((ln, f"cmp:{type(op).__name__}->{rep.__name__}", ("cmp", node, i, rep)))
                # 僅 Compare 運算元的 int 常數 ±1(排除無關數字)
            for operand in [node.left, *node.comparators]:
                if isinstance(operand, ast.Constant) and isinstance(operand.value, int) \
                        and not isinstance(operand.value, bool):
                    cands.append((getattr(operand, "lineno", ln), f"const:{operand.value}+1",
                                  ("const", operand, 1)))
                    cands.append((getattr(operand, "lineno", ln), f"const:{operand.value}-1",
                                  ("const", operand, -1)))
        elif isinstance(node, ast.BoolOp):
            new_op = ast.Or() if isinstance(node.op, ast.And) else ast.And()
            cands.append((ln, f"bool:{type(node.op).__name__}->{type(new_op).__name__}",
                          ("bool", node, new_op)))

    import ast as _ast
    for ln, desc, spec in cands:
        tree2 = copy.deepcopy(tree)
        # 以 (lineno,col) 定位對應節點再改(deepcopy 後 node 身分變了)
        kind = spec[0]
        target_ln = getattr(spec[1], "lineno", ln)
        target_col = getattr(spec[1], "col_offset", None)
        applied = False
        for n2 in _ast.walk(tree2):
            if getattr(n2, "lineno", None) != target_ln or getattr(n2, "col_offset", None) != target_col:
                continue
            if kind == "cmp" and isinstance(n2, _ast.Compare):
                n2.ops[spec[2]] = spec[3]()
                applied = True; break
            if kind == "const" and isinstance(n2, _ast.Constant):
                n2.value = n2.value + spec[2]
                applied = True; break
            if kind == "bool" and isinstance(n2, _ast.BoolOp):
                n2.op = spec[2]
                applied = True; break
        if applied:
            try:
                muts.append((ln, desc, _ast.unparse(tree2)))
            except Exception:
                pass
    return muts


def _mutate_diff_targets(root, diff_range):
    """回 {rel_py_path: set(新增/修改行號)}——只取 unified diff 的 + 行。"""
    import subprocess
    r = subprocess.run(["git", "-C", str(root), "diff", "--unified=0", "--no-color", diff_range],
                       capture_output=True, text=True)
    if r.returncode != 0:
        return None
    targets = {}
    cur = None
    new_ln = 0
    for line in r.stdout.splitlines():
        if line.startswith("+++ b/"):
            cur = line[6:]
            if not cur.endswith(".py"):
                cur = None
        elif line.startswith("@@") and cur:
            import re as _re
            m = _re.search(r"\+(\d+)", line)
            new_ln = int(m.group(1)) if m else 0
        elif cur and line.startswith("+") and not line.startswith("+++"):
            targets.setdefault(cur, set()).add(new_ln)
            new_ln += 1
        elif cur and not line.startswith("-"):
            new_ln += 1
    return targets


def cmd_mutate(diff_range=None, repo=None, as_json=False, budget=None):
    """[S4] diff 變異測試 v1。對 diff + 行生成 ast 變異→worktree 套用→testmap 選測跑→殺/活。
    rc0=觀測有效;基礎設施失敗(worktree/baseline 全紅/git)=rc2 fail loud;--diff 缺=rc2。
    ★恆觀測不進閘★;cap 決定性(sha256 排序);baseline 非綠 abort(殺率不被紅測試灌水)。"""
    import json
    import subprocess
    import tempfile
    import shutil
    import hashlib
    if not diff_range:
        print("ERROR: mutate 需 --diff <range>", file=sys.stderr)
        return 2
    root = _anchor_repo_root(repo)
    if root is None:
        print("ERROR: 找不到 repo root", file=sys.stderr)
        return 2
    cap = int(budget) if budget else _MUTATE_CAP_DEFAULT
    targets = _mutate_diff_targets(root, diff_range)
    if targets is None:
        print(f"ERROR: git diff 失敗(range={diff_range})", file=sys.stderr)
        return 2
    # 選測:對原始 diff range 跑 testmap affected 取聯集
    tm = subprocess.run([sys.executable, str(Path(__file__).resolve()), "testmap", "affected",
                         "--diff", diff_range, "--repo", str(root), "--json"],
                        capture_output=True, text=True)
    tests_for = set()
    map_stale = False
    try:
        tmd = json.loads(tm.stdout.strip().splitlines()[-1])
        tests_for = {s["test"] for s in tmd.get("suggests", [])}
        map_stale = bool(tmd.get("stale"))
    except (ValueError, IndexError, KeyError):
        tests_for = set()
    # 生成全部變異(決定性 sha256 排序後套 cap)
    all_muts = []
    for rel, lines in sorted(targets.items()):
        try:
            src_text = (root / rel).read_text(encoding="utf-8")
        except OSError:
            continue
        for ln, desc, msrc in _mutate_gen(src_text, lines):
            key = hashlib.sha256(f"{diff_range}|{rel}:{ln}|{desc}".encode()).hexdigest()
            all_muts.append({"file": rel, "line": ln, "op": desc, "_src": msrc, "_key": key})
    all_muts.sort(key=lambda m: m["_key"])
    truncated = max(0, len(all_muts) - cap)
    run_muts = all_muts[:cap]

    # baseline 前置只跑一次(乾淨樹選測集全綠才續;非綠 abort——殺率不可信)
    # ——★baseline 提到迴圈外★:原每變異重跑 baseline=N× 浪費(自審抓回);選測集乾淨結果與變異無關。
    has_work = bool(run_muts) and bool(tests_for)
    if has_work:
        wt0 = Path(tempfile.mkdtemp(prefix="lumos-mut-base-"))
        try:
            r0 = subprocess.run(["git", "-C", str(root), "worktree", "add", "--detach", "-q",
                                 str(wt0), "HEAD"], capture_output=True, text=True)
            if r0.returncode != 0:
                print(f"ERROR: worktree 建立失敗: {r0.stderr[:200]}", file=sys.stderr)
                return 2
            for tst in sorted(tests_for):
                tp = wt0 / tst
                if not tp.exists():
                    continue
                try:
                    br = subprocess.run([sys.executable, str(tp)], cwd=str(wt0),
                                        capture_output=True, text=True, timeout=300)
                except subprocess.TimeoutExpired:
                    print("ERROR: baseline 測試逾時——選測集過重,--mutation-budget 縮或改 per-file 測試",
                          file=sys.stderr)
                    return 2
                if br.returncode != 0:
                    print("ERROR: baseline 非全綠(選測集在乾淨樹已紅/flaky)——殺率不可信,abort",
                          file=sys.stderr)
                    return 2
        finally:
            subprocess.run(["git", "-C", str(root), "worktree", "remove", "--force", str(wt0)],
                           capture_output=True)
            shutil.rmtree(wt0, ignore_errors=True)

    results = []
    for m in run_muts:
        if not tests_for:
            m2 = {k: v for k, v in m.items() if not k.startswith("_")}
            m2["bucket"] = "no-test-selected"
            results.append(m2)
            continue
        wt = Path(tempfile.mkdtemp(prefix="lumos-mut-"))
        try:
            r = subprocess.run(["git", "-C", str(root), "worktree", "add", "--detach", "-q",
                                str(wt), "HEAD"], capture_output=True, text=True)
            if r.returncode != 0:
                print(f"ERROR: worktree 建立失敗: {r.stderr[:200]}", file=sys.stderr)
                return 2
            # 套變異(baseline 已在迴圈外驗過)
            (wt / m["file"]).write_text(m["_src"], encoding="utf-8")
            killed = False
            for tst in sorted(tests_for):
                tp = wt / tst
                if not tp.exists():
                    continue
                try:
                    tr = subprocess.run([sys.executable, str(tp)], cwd=str(wt),
                                        capture_output=True, text=True, timeout=120)
                except subprocess.TimeoutExpired:
                    killed = True   # timeout 算殺(變異致無窮迴圈)
                    break
                if tr.returncode != 0:
                    killed = True
                    break
            m2 = {k: v for k, v in m.items() if not k.startswith("_")}
            m2["bucket"] = "killed" if killed else "survived"
            results.append(m2)
        finally:
            subprocess.run(["git", "-C", str(root), "worktree", "remove", "--force", str(wt)],
                           capture_output=True)
            shutil.rmtree(wt, ignore_errors=True)

    buckets = {}
    for m in results:
        buckets[m["bucket"]] = buckets.get(m["bucket"], 0) + 1
    scored = buckets.get("killed", 0) + buckets.get("survived", 0)
    kill_rate = round(buckets.get("killed", 0) / scored, 4) if scored else None
    out = {"diff": diff_range, "mutants": results, "buckets": buckets,
           "kill_rate": kill_rate, "truncated": truncated, "map_stale": map_stale}
    if as_json:
        print(json.dumps(out, ensure_ascii=False))
    else:
        print(f"mutate {diff_range}: {len(results)} 變異 | 殺率 {kill_rate} | 桶 {buckets}"
              + (f" | 截斷 {truncated}" if truncated else "")
              + (" | ⚠map_stale" if map_stale else ""))
        for m in results:
            if m["bucket"] == "survived":
                print(f"  ⛑活口 {m['file']}:{m['line']} {m['op']}(無測試殺得死=測試網的洞)")
        print("  ★觀測非閘:殺得死機械變異≠殺得死真缺陷;等價變異誤列活口需人裁剔除★")
    return 0


def cmd_seat_check(report, dispatch, ledger=None, as_json=False):
    """[S1 有講沒做對帳,2026-08-06](plan:Projects/驗證層自證三件_計劃;borrow evidra
    protocol_violation)。收貨第三道(前兩道=quote-check/refcheck 既有直用):
    - unreported = dispatch 宣告的 materials 在報告零觸及(路徑/檔名字串機械比對;
      `lens` 為觀測欄位★不進判定★——抽象詞無機械 oracle,plan r2 折入)
    - out_of_scope = 報告引句(「引句：「…」」抽取,同 quote-check 單一實作)錨不進
      ★任何一份★ material(scope 三集合:materials=必查;repo 查證引用恆合法——本檢查
      只驗引句錨定,不碰 file:line 證據;引句出界才記越界)
    - materials 為空 → vacuous 豁免(不判兩類)
    恆 rc0(觀測不擋,升閘須另過 loop);輸入壞損 rc2 fail loud。--ledger 時 out_of_scope
    逐條 append {round,seat,quote,reason}(越界另記一本、不進收斂帳)。
    ★射程:測的是報告與留痕的協議內一致性——席一致地說謊(引句自編但恰好錨得進)抓不到★"""
    import json
    try:
        rtext = Path(report).read_text(encoding="utf-8")
        disp = json.loads(Path(dispatch).read_text(encoding="utf-8"))
        materials = disp.get("materials") or []
        assert isinstance(materials, list)
    except (OSError, UnicodeDecodeError, ValueError, AssertionError) as e:
        print(f"ERROR: 讀 report/dispatch 失敗: {e}", file=sys.stderr)
        return 2
    out = {"report": str(report), "round": disp.get("round"), "seat": disp.get("seat"),
           "lens": disp.get("lens"), "unreported": [], "out_of_scope": [], "vacuous": False}
    if not materials:
        out["vacuous"] = True
        if as_json:
            print(json.dumps(out, ensure_ascii=False))
        else:
            print("seat-check: materials 為空 → vacuous 豁免(不判 unreported/out_of_scope)")
        return 0
    mat_texts = {}
    for mp in materials:
        try:
            mat_texts[mp] = _quote_norm(Path(mp).read_text(encoding="utf-8"))
        except (OSError, UnicodeDecodeError):
            mat_texts[mp] = None   # 材料讀不到:不能當被觸及,也不能當錨定海;記 unreported 候選
    # ① unreported:material 的路徑或檔名都沒出現在報告文字
    for mp in materials:
        name = Path(mp).name
        if mp not in rtext and name not in rtext:
            out["unreported"].append(mp)
    # ② out_of_scope:引句錨不進任何 material(空白剝除 fallback 同 _quote_rows)
    quotes = _quote_rows(rtext, "") or []
    for q in quotes:
        if q.get("malformed"):
            continue
        nq = _quote_norm(q["quote"])
        anchored = any(h is not None and (nq in h or nq.replace(" ", "") in h.replace(" ", ""))
                       for h in mat_texts.values())
        if not anchored:
            out["out_of_scope"].append(q["quote"])
    if ledger and out["out_of_scope"]:
        try:
            with open(ledger, "a", encoding="utf-8") as f:
                for q in out["out_of_scope"]:
                    f.write(json.dumps({"round": disp.get("round"), "seat": disp.get("seat"),
                                        "quote": q, "reason": "引句錨不進任何派工 material"},
                                       ensure_ascii=False) + "\n")
        except OSError as e:
            print(f"ERROR: 越界帳寫入失敗: {e}", file=sys.stderr)
            return 2
    if as_json:
        print(json.dumps(out, ensure_ascii=False))
    else:
        print(f"seat-check {Path(report).name}: unreported {len(out['unreported'])}"
              f" / out_of_scope {len(out['out_of_scope'])}(materials {len(materials)};觀測恆 rc0)")
        for mp in out["unreported"]:
            print(f"  ⚠ unreported: {mp}(dispatch 宣告要查,報告零觸及)")
        for q in out["out_of_scope"]:
            print(f"  ⚠ out_of_scope: 「{q[:50]}」(錨不進任何 material{';已記越界帳' if ledger else ''})")
        print("  ★觀測非閘:抓的是協議內一致性;lens 不判定;證據 file:line 恆合法★")
    return 0


def cmd_anchor_verify(repo=None, as_json=False):
    """錨點完整性核對:baseline 內每個錨點檔算 sha256 比對。
    全符 rc=0;mismatch/缺檔 rc=1;baseline 不存在 rc=0+警示(漸進採用);參數錯 rc=2。
    只證「驗證器檔案沒被動過」,不證測試本身寫得對(spec 誠實天花板)。"""
    import json
    import hashlib
    repo_root = _anchor_repo_root(repo)
    if repo_root is None:
        return 2
    bp = repo_root / _ANCHOR_BASELINE_REL
    if not bp.exists():
        print("anchor: baseline 不存在(未啟用)——`lumos anchor approve --note` 建立後生效")
        return 0
    try:
        data = json.loads(bp.read_text(encoding="utf-8"))
    except (OSError, ValueError) as e:
        print(f"ERROR: baseline 讀取失敗: {e}", file=sys.stderr)
        return 2
    mismatches = []
    for rel, expected in sorted(data.get("anchors", {}).items()):
        f = repo_root / rel
        if not f.is_file():
            mismatches.append({"file": rel, "expected": expected, "actual": "(缺檔)"})
            continue
        actual = hashlib.sha256(f.read_bytes()).hexdigest()
        if actual != expected:
            mismatches.append({"file": rel, "expected": expected, "actual": actual})
    if as_json:
        print(json.dumps({"ok": not mismatches, "mismatches": mismatches}, ensure_ascii=False))
    elif mismatches:
        print("✗ anchor verify 失敗——驗證器檔案與 baseline 不符:")
        for m in mismatches:
            act = m["actual"] if m["actual"] == "(缺檔)" else m["actual"][:16] + "…"
            print(f"  {m['file']}(期望 {m['expected'][:16]}… 實際 {act})")
        print("非刻意 → git checkout 還原;刻意改錨點 → lumos anchor approve --note \"理由\"")
    else:
        print(f"✓ anchor verify — {len(data.get('anchors', {}))} 個錨點全符")
    return 1 if mismatches else 0


def cmd_anchor_approve(repo=None, note=None, vault=None):
    """重算全部錨點 sha256 寫回 baseline + governance-log 留痕(anchor-approve 事件)。
    改錨點檔的唯一合法路徑;--note 必填(空理由=無資訊留痕)。"""
    import json
    import hashlib
    import datetime
    if not note or not note.strip():
        print("ERROR: --note 必填(留痕理由)", file=sys.stderr)
        return 2
    repo_root = _anchor_repo_root(repo)
    if repo_root is None:
        return 2
    anchors, absent = {}, []
    for rel in ANCHOR_FILES:
        f = repo_root / rel
        if f.is_file():
            anchors[rel] = hashlib.sha256(f.read_bytes()).hexdigest()
        else:
            absent.append(rel)
    if absent:
        print(f"⚠ 錨點檔缺失(不入 baseline): {', '.join(absent)}")
    bp = repo_root / _ANCHOR_BASELINE_REL
    prev = {}
    if bp.exists():
        try:
            prev = json.loads(bp.read_text(encoding="utf-8")).get("anchors", {})
        except (OSError, ValueError):
            prev = {}
    changed = sorted({k for k in anchors if anchors[k] != prev.get(k)} | (set(prev) - set(anchors)))
    bp.parent.mkdir(parents=True, exist_ok=True)
    payload = {"version": 1, "anchors": anchors,
               "approved_at": datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
               "note": note}
    bp.write_text(json.dumps(payload, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    v = vault or find_vault(Path.cwd())
    if v is None:
        print("⚠ 無 vault:baseline 已寫,governance-log 留痕跳過")
    else:
        _append_governance_log(v, [{"gate": "anchor-approve", "kind": "approved",
                                    "hard": False, "nodes": changed, "note": note}])
    print(f"✓ anchor approve — {len(anchors)} 個錨點寫入 baseline({len(changed)} 個變更)")
    return 0


def _validate_repo_ref(repo_root, token, line):
    """驗一條 repo 內檔案指涉:回 (status, excerpt)。status ∈ missing/line_out_of_range/ok。
    _refcheck_scan 與 check_regen_provenance(Check J 的 [src:] 驗證)共用——
    J-c 不得走 _refcheck_scan 抽取入口(inline-code 抽取 + top_dirs 靜默過濾會把假目錄放行,
    正是 J-c 要擋的幻覺;此 helper 直收已解析 path/line,無靜默過濾)。
    token 消毒(code-review blocker 修):空/絕對路徑/含 .. 一律 missing——top_dirs 過濾
    被拆掉時它隱含的安全性(空值/絕對/traversal 天然進不了 top_dirs)必須在此顯式補回,
    否則 [src: ]/[src:/etc/passwd]/[src:../..] 會 resolve 到 repo 外真實存在的路徑而判 ok。"""
    token = token.strip()
    from pathlib import PurePosixPath, PureWindowsPath
    if (not token
            or PurePosixPath(token).is_absolute() or PureWindowsPath(token).is_absolute()
            or ".." in PurePosixPath(token).parts):
        return "missing", ""
    target = repo_root / token
    if not target.exists():
        return "missing", ""
    if target.is_dir() or not line:
        return "ok", ""
    if "-" in line:
        lo, hi = (int(x) for x in line.split("-", 1))
    else:
        lo = hi = int(line)
    try:
        file_lines = target.read_text(encoding="utf-8-sig", errors="replace").splitlines()
    except OSError:
        file_lines = None
    if file_lines is None or lo < 1 or hi > len(file_lines):
        return "line_out_of_range", ""
    if lo == hi:
        return "ok", file_lines[lo - 1]
    return "ok", file_lines[lo - 1] + "\n…\n" + file_lines[hi - 1]


def _refcheck_scan(text, repo_root):
    """refcheck 抽取+核對核心(不列印):回 (claims, n_missing, n_oor, n_ok)。
    cmd_refcheck 與 loop status --gate(G1 錨)共用;抽取規則見 cmd_refcheck docstring。
    核對段走 _validate_repo_ref(與 Check J 共用);抽取段(inline-code+top_dirs 過濾)維持原規則。"""
    top_dirs = {p.name for p in repo_root.iterdir() if p.is_dir() and not p.name.startswith(".")}
    _suffix_re = re.compile(r":([^/]+)$")
    # ★不可換回 FENCE_RE★(見 _visible_lines):此處餵 G1 硬閘與 impact hook
    spans = [s.strip("`") for s in INLINE_CODE_RE.findall(_strip_fences_text(text))]
    seen = set()
    claims = []
    for raw in spans:
        if "://" in raw or any(c in raw for c in "*<>?"):
            continue
        m = _suffix_re.search(raw)
        if m:
            token, sfx = raw[:m.start()], m.group(1)
            line = sfx if re.fullmatch(r"\d+(?:-\d+)?", sfx) else ""
        else:
            token, line = raw, ""
        if "/" not in token or (token, line) in seen:
            continue
        if token.split("/")[0] not in top_dirs:
            continue
        seen.add((token, line))
        status, excerpt = _validate_repo_ref(repo_root, token, line)
        claim = {"token": token, "line": line, "status": status, "excerpt": excerpt}
        if status == "ok" and (repo_root / token).is_dir():
            claim["dir"] = True
        claims.append(claim)

    n_missing = sum(1 for c in claims if c["status"] == "missing")
    n_oor = sum(1 for c in claims if c["status"] == "line_out_of_range")
    n_ok = sum(1 for c in claims if c["status"] == "ok")
    return claims, n_missing, n_oor, n_ok


